  "dialogues": [
    {
      "id": "tamsin",
      "nodes": [
        {
          "choices": [
            {
              "next": "offer",
              "text": "I'm here about the dead in the keep."
            },
            {
              "next": "about",
              "text": "Who are you?"
            },
            {
              "next": "bye",
              "text": "Just passing through."
            }
          ],
          "id": "greet",
          "text": "Another Warden? The last one went up that hill and came back in a sack."
        },
        {
          "choices": [
            {
              "next": "offer",
              "text": "About the keep..."
            },
            {
              "next": "bye",
              "text": "Goodbye."
            }
          ],
          "id": "about",
          "text": "Tamsin. I keep the herbs, mend the cuts, and bury who I can't mend. Those red draughts in the courtyard are mine."
        },
        {
          "choices": [
            {
              "do": [
                {
                  "op": "start_quest",
                  "quest": "quiet-the-courtyard"
                }
              ],
              "next": "accept",
              "text": "I'll do it."
            },
            {
              "next": "bye",
              "text": "Not yet."
            }
          ],
          "id": "offer",
          "text": "The dead walk that courtyard every night now. Put three of them back in the ground and come tell me. I'll sleep easier."
        },
        {
          "id": "accept",
          "next": "",
          "text": "Mind the draughts. Drink them, don't admire them."
        },
        {
          "id": "progress",
          "next": "",
          "text": "Still breathing? Good. Three of them, Warden. Then come back and tell me."
        },
        {
          "id": "thanks",
          "next": "",
          "text": "You did it, then. Quieter up there already, I can feel it in my knees. The Wardens chose right, for once."
        },
        {
          "id": "bye",
          "next": "",
          "text": "Hmph. Walk careful."
        }
      ],
      "speaker": "character/villager",
      "start": "greet",
      "starts": [
        {
          "if": [
            {
              "is": "completed",
              "quest": "quiet-the-courtyard"
            }
          ],
          "node": "thanks"
        },
        {
          "if": [
            {
              "is": "active",
              "quest": "quiet-the-courtyard"
            }
          ],
          "node": "progress"
        }
      ]
    }
