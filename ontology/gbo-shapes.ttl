# GBO shapes: SHACL for the library and for built places
#
# GENERATED from data/places/ by the engine (engine/places/OntologyExport.cpp).
# Don't edit: change the JSON files and regenerate (ontology/README.md).

@prefix gbo:     <https://w3id.org/aige/gbo#> .
@prefix gbl:     <https://w3id.org/aige/gbo/library#> .
@prefix gbb:     <https://w3id.org/aige/gbo/build#> .
@prefix gbv:     <https://w3id.org/aige/gbo/vocab#> .
@prefix gbr:     <https://w3id.org/aige/gbo/role#> .
@prefix gbx:     <https://w3id.org/aige/gbo/relation#> .
@prefix gbd:     <https://w3id.org/aige/gbo/rule#> .
@prefix gbs:     <https://w3id.org/aige/gbo/shapes#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/aige/gbo/shapes>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aige/gbo/shapes/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gbo> ;
    dcterms:title "GBO shapes: SHACL for the library and for built places"@en ;
    dcterms:description "Shapes that check the library itself (every module has a level and an id, every field a type, every design rule a source) and, per module, the fields and parts of a built place described in GBO terms. Conditions (gbo:when) and aggregate constraints (gbo:constraint) are beyond SHACL Core; the engine evaluates them."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

# --- The library ---

gbs:ModuleShape
    a sh:NodeShape ;
    sh:targetClass gbo:Module ;
    sh:property [
        sh:path gbo:moduleId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ], [
        sh:path gbo:level ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( gbo:Site gbo:Network gbo:Zone gbo:Parcel gbo:Feature gbo:Dressing gbo:AbstractPart )
    ], [
        sh:path rdfs:label ;
        sh:minCount 1
    ], [
        sh:path gbo:hasField ;
        sh:class gbo:Field
    ], [
        sh:path gbo:hasSlot ;
        sh:class gbo:Slot
    ], [
        sh:path gbo:hasChildRule ;
        sh:class gbo:ChildRule
    ], [
        sh:path gbo:allowedIn ;
        sh:class gbo:BuildType
    ], [
        sh:path gbo:constraint ;
        sh:datatype gbo:Expression
    ] .

gbs:FieldShape
    a sh:NodeShape ;
    sh:targetClass gbo:Field ;
    sh:property [
        sh:path gbo:fieldName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ], [
        sh:path gbo:fieldType ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:vocabulary ;
        sh:maxCount 1 ;
        sh:class skos:ConceptScheme
    ], [
        sh:path gbo:defaultValue ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ] .

gbs:QuantityFieldShape
    a sh:NodeShape ;
    sh:targetClass gbo:QuantityField ;
    sh:property [
        sh:path gbo:fieldType ;
        sh:in ( gbo:count gbo:density gbo:share gbo:area gbo:size gbo:length gbo:spacing gbo:width gbo:ratio )
    ] .

gbs:QualityFieldShape
    a sh:NodeShape ;
    sh:targetClass gbo:QualityField ;
    sh:property [
        sh:path gbo:fieldType ;
        sh:in ( gbo:enum gbo:enumSet gbo:mix gbo:tags gbo:description gbo:bool gbo:assetChoice )
    ] .

gbs:DensityFieldShape
    a sh:NodeShape ;
    sh:targetSubjectsOf gbo:densityLevels ;
    sh:property [
        sh:path gbo:densityLevels ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ], [
        sh:path gbo:fieldType ;
        sh:hasValue gbo:density
    ] .

gbs:SlotShape
    a sh:NodeShape ;
    sh:targetClass gbo:Slot ;
    sh:property [
        sh:path gbo:slotName ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:essential ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ], [
        sh:path gbo:needsRole ;
        sh:minCount 1 ;
        sh:class gbo:Role
    ] .

gbs:ChildRuleShape
    a sh:NodeShape ;
    sh:targetClass gbo:ChildRule ;
    sh:property [
        sh:path gbo:child ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:minCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ], [
        sh:path gbo:weight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0
    ], [
        sh:path gbo:countField ;
        sh:maxCount 1 ;
        sh:class gbo:Field
    ] .

gbs:RelationUseShape
    a sh:NodeShape ;
    sh:targetClass gbo:RelationUse ;
    sh:property [
        sh:path gbo:relationType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gbo:RelationType
    ], [
        sh:path gbo:members ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ], [
        sh:path gbo:weight ;
        sh:maxCount 1 ;
        sh:minExclusive 0
    ] .

gbs:SitePreferenceShape
    a sh:NodeShape ;
    sh:targetClass gbo:SitePreference ;
    sh:property [
        sh:path gbo:criterion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:weight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive -1 ;
        sh:maxInclusive 1
    ] .

gbs:BuildTypeShape
    a sh:NodeShape ;
    sh:targetClass gbo:BuildType ;
    sh:property [
        sh:path gbo:rootModule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gbo:Module
    ], [
        sh:path gbo:component ;
        sh:class gbo:Module
    ], [
        sh:path gbo:hasScale ;
        sh:minCount 1 ;
        sh:class gbo:ScaleClass
    ] .

gbs:ScaleClassShape
    a sh:NodeShape ;
    sh:targetClass gbo:ScaleClass ;
    sh:property [
        sh:path gbo:minBuildings ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxBuildings ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:minSide ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxSide ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:minZones ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxZones ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "a scale class's ranges run low to high" ;
        sh:prefixes <https://w3id.org/aige/gbo/shapes> ;
        sh:select "SELECT $this WHERE { $this gbo:minBuildings ?a ; gbo:maxBuildings ?b . FILTER (?a > ?b) }"
    ] .

gbs:RelationTypeShape
    a sh:NodeShape ;
    sh:targetClass gbo:RelationType ;
    sh:property [
        sh:path gbo:minMembers ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1
    ], [
        sh:path gbo:hardByDefault ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] .

gbs:DesignRuleShape
    a sh:NodeShape ;
    sh:targetClass gbo:DesignRule ;
    sh:property [
        sh:path gbo:ruleText ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:source ;
        sh:minCount 1 ;
        sh:message "every design rule names its source"
    ] .

gbs:ConceptShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1
    ], [
        sh:path skos:prefLabel ;
        sh:minCount 1
    ], [
        sh:path skos:notation ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<https://w3id.org/aige/gbo/shapes>
    sh:declare [
        sh:prefix "gbo" ;
        sh:namespace "https://w3id.org/aige/gbo#"^^xsd:anyURI
    ] .

# --- Built places, per module ---

gbs:BenchShape
    a sh:NodeShape ;
    sh:targetClass gbl:Bench ;
    sh:property [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:BridgeShape
    a sh:NodeShape ;
    sh:targetClass gbl:Bridge ;
    sh:property [
        sh:path gbl:Bridge.length ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 30.0
    ], [
        sh:path gbl:Bridge.width ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 5.0
    ], [
        sh:path gbl:Bridge.material ;
        sh:maxCount 1 ;
        sh:in ( gbv:material.wood gbv:material.wicker gbv:material.thatch gbv:material.stone gbv:material.brick gbv:material.plaster gbv:material.iron )
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:CastleWardShape
    a sh:NodeShape ;
    sh:targetClass gbl:CastleWard ;
    sh:property [
        sh:path gbl:CastleWard.area ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 400.0
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Road
        ] ;
        sh:qualifiedMaxCount 60
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Subplace
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Road
        ] [
            sh:class gbl:Subplace
        ] )
    ] .

gbs:ClearingShape
    a sh:NodeShape ;
    sh:targetClass gbl:Clearing ;
    sh:property [
        sh:path gbl:Clearing.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 3.0 ;
                sh:maxInclusive 20.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 3.0 ;
                sh:maxInclusive 20.0
            ]
        ]
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:NatureScatter
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:NatureScatter
        ] )
    ] .

gbs:ClutterShape
    a sh:NodeShape ;
    sh:targetClass gbl:Clutter ;
    sh:property [
        sh:path gbl:Clutter.items ;
        sh:maxCount 1 ;
        sh:in ( "none" "rare" "some" "common" "abundant" )
    ], [
        sh:path gbl:Clutter.theme ;
        sh:maxCount 1 ;
        sh:in ( gbv:clutter-theme.farm gbv:clutter-theme.market gbv:clutter-theme.workshop gbv:clutter-theme.dock gbv:clutter-theme.military )
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:CommonsShape
    a sh:NodeShape ;
    sh:targetClass gbl:Commons ;
    sh:property [
        sh:path gbl:Commons.area ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 50.0
    ], [
        sh:path gbl:Commons.trees ;
        sh:maxCount 1 ;
        sh:in ( "none" "rare" "some" "common" "abundant" )
    ], [
        sh:path gbl:Commons.kind ;
        sh:maxCount 1 ;
        sh:in ( "green" "park" "orchard" )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Meadow
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:NatureScatter
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Orchard
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Pond
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Road
        ] ;
        sh:qualifiedMaxCount 60
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Meadow
        ] [
            sh:class gbl:NatureScatter
        ] [
            sh:class gbl:Orchard
        ] [
            sh:class gbl:Pond
        ] [
            sh:class gbl:Road
        ] )
    ] .

gbs:CourtyardShape
    a sh:NodeShape ;
    sh:targetClass gbl:Courtyard ;
    sh:property [
        sh:path gbl:Courtyard.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:Courtyard.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:surface.grass gbv:surface.dirt gbv:surface.gravel gbv:surface.paved gbv:surface.cobble gbv:surface.plank )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Clutter
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Clutter
        ] )
    ] .

gbs:CraftsmenWardShape
    a sh:NodeShape ;
    sh:targetClass gbl:CraftsmenWard ;
    sh:property [
        sh:path gbl:CraftsmenWard.area ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 100.0
    ], [
        sh:path gbl:CraftsmenWard.plots ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 2000
    ], [
        sh:path gbl:CraftsmenWard.trades ;
        sh:in ( gbv:trade.smith gbv:trade.carpenter gbv:trade.tanner gbv:trade.potter gbv:trade.weaver gbv:trade.mason gbv:trade.baker gbv:trade.brewer )
    ], [
        sh:path gbl:CraftsmenWard.wealth ;
        sh:maxCount 1 ;
        sh:in ( gbv:wealth.poor gbv:wealth.common gbv:wealth.rich )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:HousePlot
        ] ;
        sh:qualifiedMaxCount 400
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:LumberYard
        ] ;
        sh:qualifiedMaxCount 4
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Road
        ] ;
        sh:qualifiedMaxCount 60
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WorkshopPlot
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 400
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:HousePlot
        ] [
            sh:class gbl:LumberYard
        ] [
            sh:class gbl:Road
        ] [
            sh:class gbl:WorkshopPlot
        ] )
    ] .

gbs:DockShape
    a sh:NodeShape ;
    sh:targetClass gbl:Dock ;
    sh:property [
        sh:path gbl:Dock.boats ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 20
    ], [
        sh:path gbl:Dock.length ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 2.0 ;
        sh:maxInclusive 60.0
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:DocksShape
    a sh:NodeShape ;
    sh:targetClass gbl:Docks ;
    sh:property [
        sh:path gbl:Docks.area ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 100.0
    ], [
        sh:path gbl:Docks.piers ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 40
    ], [
        sh:path gbl:Docks.plots ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 2000
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Dock
        ] ;
        sh:qualifiedMinCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:FishMarket
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Road
        ] ;
        sh:qualifiedMaxCount 60
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WarehousePlot
        ] ;
        sh:qualifiedMaxCount 40
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Dock
        ] [
            sh:class gbl:FishMarket
        ] [
            sh:class gbl:Road
        ] [
            sh:class gbl:WarehousePlot
        ] )
    ] .

gbs:DoorstepSetShape
    a sh:NodeShape ;
    sh:targetClass gbl:DoorstepSet ;
    sh:property [
        sh:path gbl:DoorstepSet.items ;
        sh:maxCount 1 ;
        sh:in ( "none" "rare" "some" "common" "abundant" )
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:FarmlandRingShape
    a sh:NodeShape ;
    sh:targetClass gbl:FarmlandRing ;
    sh:property [
        sh:path gbl:FarmlandRing.area ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 400.0
    ], [
        sh:path gbl:FarmlandRing.farmsteads ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 200
    ], [
        sh:path gbl:FarmlandRing.fields ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1000
    ], [
        sh:path gbl:FarmlandRing.crops ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:HedgeLine
        ] ;
        sh:qualifiedMaxCount 400
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:MillPlot
        ] ;
        sh:qualifiedMaxCount 4
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Orchard
        ] ;
        sh:qualifiedMaxCount 40
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Pasture
        ] ;
        sh:qualifiedMaxCount 200
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Pond
        ] ;
        sh:qualifiedMaxCount 10
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Road
        ] ;
        sh:qualifiedMaxCount 60
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Subplace
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Farmstead
        ] [
            sh:class gbl:Field
        ] [
            sh:class gbl:HedgeLine
        ] [
            sh:class gbl:MillPlot
        ] [
            sh:class gbl:Orchard
        ] [
            sh:class gbl:Pasture
        ] [
            sh:class gbl:Pond
        ] [
            sh:class gbl:Road
        ] [
            sh:class gbl:Subplace
        ] )
    ] .

gbs:FarmsteadShape
    a sh:NodeShape ;
    sh:targetClass gbl:Farmstead ;
    sh:property [
        sh:path gbl:Farmstead.fields ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 20
    ], [
        sh:path gbl:Farmstead.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 8.0 ;
                sh:maxInclusive 60.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 8.0 ;
                sh:maxInclusive 60.0
            ]
        ]
    ], [
        sh:path gbl:Farmstead.farm-kind ;
        sh:maxCount 1 ;
        sh:in ( "arable" "livestock" "mixed" )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Farmyard
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:FenceLine
        ] ;
        sh:qualifiedMaxCount 8
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Garden
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Pasture
        ] ;
        sh:qualifiedMaxCount 4
    ], [
        sh:path gbo:hasPart ;
