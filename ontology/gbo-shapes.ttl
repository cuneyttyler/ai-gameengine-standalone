# GBO shapes: SHACL for the library and for built places
#
# GENERATED from data/places/ by the engine (engine/places/OntologyExport.cpp).
# Don't edit: change the JSON files and regenerate (ontology/README.md).

@prefix gbo:     <https://w3id.org/aige/gbo#> .
@prefix gbl:     <https://w3id.org/aige/gbo/library#> .
@prefix gbb:     <https://w3id.org/aige/gbo/build#> .
@prefix gbv:     <https://w3id.org/aige/gbo/vocab#> .
@prefix gbr:     <https://w3id.org/aige/gbo/role#> .
@prefix gbx:     <https://w3id.org/aige/gbo/relation#> .
@prefix gbd:     <https://w3id.org/aige/gbo/rule#> .
@prefix gbs:     <https://w3id.org/aige/gbo/shapes#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/aige/gbo/shapes>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aige/gbo/shapes/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gbo> ;
    dcterms:title "GBO shapes: SHACL for the library and for built places"@en ;
    dcterms:description "Shapes that check the library itself (every module has a level and an id, every field a type, every design rule a source) and, per module, the fields and parts of a built place described in GBO terms. Conditions (gbo:when) and aggregate constraints (gbo:constraint) are beyond SHACL Core; the engine evaluates them."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

# --- The library ---

gbs:ModuleShape
    a sh:NodeShape ;
    sh:targetClass gbo:Module ;
    sh:property [
        sh:path gbo:moduleId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ], [
        sh:path gbo:level ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( gbo:Site gbo:Network gbo:Zone gbo:Parcel gbo:Feature gbo:Dressing gbo:AbstractPart )
    ], [
        sh:path rdfs:label ;
        sh:minCount 1
    ], [
        sh:path gbo:hasField ;
        sh:class gbo:Field
    ], [
        sh:path gbo:hasSlot ;
        sh:class gbo:Slot
    ], [
        sh:path gbo:hasChildRule ;
        sh:class gbo:ChildRule
    ], [
        sh:path gbo:allowedIn ;
        sh:class gbo:BuildType
    ], [
        sh:path gbo:constraint ;
        sh:datatype gbo:Expression
    ] .

gbs:FieldShape
    a sh:NodeShape ;
    sh:targetClass gbo:Field ;
    sh:property [
        sh:path gbo:fieldName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ], [
        sh:path gbo:fieldType ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:vocabulary ;
        sh:maxCount 1 ;
        sh:class skos:ConceptScheme
    ], [
        sh:path gbo:defaultValue ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ] .

gbs:QuantityFieldShape
    a sh:NodeShape ;
    sh:targetClass gbo:QuantityField ;
    sh:property [
        sh:path gbo:fieldType ;
        sh:in ( gbo:count gbo:density gbo:share gbo:area gbo:size gbo:length gbo:spacing gbo:width gbo:ratio )
    ] .

gbs:QualityFieldShape
    a sh:NodeShape ;
    sh:targetClass gbo:QualityField ;
    sh:property [
        sh:path gbo:fieldType ;
        sh:in ( gbo:enum gbo:enumSet gbo:mix gbo:tags gbo:description gbo:bool gbo:assetChoice )
    ] .

gbs:DensityFieldShape
    a sh:NodeShape ;
    sh:targetSubjectsOf gbo:densityLevels ;
    sh:property [
        sh:path gbo:densityLevels ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ], [
        sh:path gbo:fieldType ;
        sh:hasValue gbo:density
    ] .

gbs:SlotShape
    a sh:NodeShape ;
    sh:targetClass gbo:Slot ;
    sh:property [
        sh:path gbo:slotName ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:essential ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ], [
        sh:path gbo:needsRole ;
        sh:minCount 1 ;
        sh:class gbo:Role
    ] .

gbs:ChildRuleShape
    a sh:NodeShape ;
    sh:targetClass gbo:ChildRule ;
    sh:property [
        sh:path gbo:child ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:minCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ], [
        sh:path gbo:weight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0
    ], [
        sh:path gbo:countField ;
        sh:maxCount 1 ;
        sh:class gbo:Field
    ] .

gbs:RelationUseShape
    a sh:NodeShape ;
    sh:targetClass gbo:RelationUse ;
    sh:property [
        sh:path gbo:relationType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gbo:RelationType
    ], [
        sh:path gbo:members ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:JSON
    ], [
        sh:path gbo:weight ;
        sh:maxCount 1 ;
        sh:minExclusive 0
    ] .

gbs:SitePreferenceShape
    a sh:NodeShape ;
    sh:targetClass gbo:SitePreference ;
    sh:property [
        sh:path gbo:criterion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:weight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive -1 ;
        sh:maxInclusive 1
    ] .

gbs:BuildTypeShape
    a sh:NodeShape ;
    sh:targetClass gbo:BuildType ;
    sh:property [
        sh:path gbo:rootModule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gbo:Module
    ], [
        sh:path gbo:component ;
        sh:class gbo:Module
    ], [
        sh:path gbo:hasScale ;
        sh:minCount 1 ;
        sh:class gbo:ScaleClass
    ] .

gbs:ScaleClassShape
    a sh:NodeShape ;
    sh:targetClass gbo:ScaleClass ;
    sh:property [
        sh:path gbo:minBuildings ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxBuildings ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:minSide ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxSide ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:minZones ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ], [
        sh:path gbo:maxZones ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "a scale class's ranges run low to high" ;
        sh:prefixes <https://w3id.org/aige/gbo/shapes> ;
        sh:select "SELECT $this WHERE { $this gbo:minBuildings ?a ; gbo:maxBuildings ?b . FILTER (?a > ?b) }"
    ] .

gbs:RelationTypeShape
    a sh:NodeShape ;
    sh:targetClass gbo:RelationType ;
    sh:property [
        sh:path gbo:minMembers ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1
    ], [
        sh:path gbo:hardByDefault ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] .

gbs:DesignRuleShape
    a sh:NodeShape ;
    sh:targetClass gbo:DesignRule ;
    sh:property [
        sh:path gbo:ruleText ;
        sh:minCount 1 ;
        sh:maxCount 1
    ], [
        sh:path gbo:source ;
        sh:minCount 1 ;
        sh:message "every design rule names its source"
    ] .

gbs:ConceptShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1
    ], [
        sh:path skos:prefLabel ;
        sh:minCount 1
    ], [
        sh:path skos:notation ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<https://w3id.org/aige/gbo/shapes>
    sh:declare [
        sh:prefix "gbo" ;
        sh:namespace "https://w3id.org/aige/gbo#"^^xsd:anyURI
    ] .

# --- Built places, per module ---

gbs:AbandonedCartShape
    a sh:NodeShape ;
    sh:targetClass gbl:AbandonedCart ;
    sh:property [
        sh:path gbl:AbandonedCart.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 3.0 ;
                sh:maxInclusive 8.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 3.0 ;
                sh:maxInclusive 8.0
            ]
        ]
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:AltarSetShape
    a sh:NodeShape ;
    sh:targetClass gbl:AltarSet ;
    sh:property [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:AmbienceShape
    a sh:NodeShape ;
    sh:targetClass gbl:Ambience ;
    sh:property [
        sh:path gbl:Ambience.debris ;
        sh:maxCount 1 ;
        sh:in ( "none" "rare" "some" "common" "abundant" )
    ], [
        sh:path gbl:Ambience.lights ;
        sh:maxCount 1 ;
        sh:in ( "none" "rare" "some" "common" "abundant" )
    ], [
        sh:path gbl:Ambience.mood ;
        sh:maxCount 1 ;
        sh:in ( "gloomy" "eerie" "grand" )
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:ApartmentKitchenShape
    a sh:NodeShape ;
    sh:targetClass gbl:ApartmentKitchen ;
    sh:property [
        sh:path gbl:ApartmentKitchen.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:ApartmentKitchen.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:floor-surface.wood-floor gbv:floor-surface.stone-floor gbv:floor-surface.dirt gbv:floor-surface.tile-floor gbv:floor-surface.carpet gbv:floor-surface.concrete )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:ModernKitchenSet
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:OfficeLights
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:ModernKitchenSet
        ] [
            sh:class gbl:OfficeLights
        ] )
    ] .

gbs:ApartmentLivingShape
    a sh:NodeShape ;
    sh:targetClass gbl:ApartmentLiving ;
    sh:property [
        sh:path gbl:ApartmentLiving.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:ApartmentLiving.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:floor-surface.wood-floor gbv:floor-surface.stone-floor gbv:floor-surface.dirt gbv:floor-surface.tile-floor gbv:floor-surface.carpet gbv:floor-surface.concrete )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:OfficeLights
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:SofaSet
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:OfficeLights
        ] [
            sh:class gbl:SofaSet
        ] )
    ] .

gbs:ApartmentPlotShape
    a sh:NodeShape ;
    sh:targetClass gbl:ApartmentPlot ;
    sh:property [
        sh:path gbl:ApartmentPlot.setback ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 8.0
    ], [
        sh:path gbl:ApartmentPlot.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 3.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 3.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:ApartmentPlot.condition ;
        sh:maxCount 1 ;
        sh:in ( gbv:condition.new gbv:condition.lived-in gbv:condition.worn gbv:condition.ruined )
    ], [
        sh:path gbl:ApartmentPlot.height ;
        sh:maxCount 1 ;
        sh:in ( gbv:apartment-kind.low-rise gbv:apartment-kind.mid-rise gbv:apartment-kind.high-rise )
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:ArmouryShape
    a sh:NodeShape ;
    sh:targetClass gbl:Armoury ;
    sh:property [
        sh:path gbl:Armoury.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:Armoury.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:floor-surface.wood-floor gbv:floor-surface.stone-floor gbv:floor-surface.dirt gbv:floor-surface.tile-floor gbv:floor-surface.carpet gbv:floor-surface.concrete )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:RoomLights
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:ShelfWall
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:StorageSet
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WallDecor
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:RoomLights
        ] [
            sh:class gbl:ShelfWall
        ] [
            sh:class gbl:StorageSet
        ] [
            sh:class gbl:WallDecor
        ] )
    ] .

gbs:BackStoreShape
    a sh:NodeShape ;
    sh:targetClass gbl:BackStore ;
    sh:property [
        sh:path gbl:BackStore.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:BackStore.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:floor-surface.wood-floor gbv:floor-surface.stone-floor gbv:floor-surface.dirt gbv:floor-surface.tile-floor gbv:floor-surface.carpet gbv:floor-surface.concrete )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:RoomLights
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:StorageSet
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WallDecor
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:RoomLights
        ] [
            sh:class gbl:StorageSet
        ] [
            sh:class gbl:WallDecor
        ] )
    ] .

gbs:BaileyShape
    a sh:NodeShape ;
    sh:targetClass gbl:Bailey ;
    sh:property [
        sh:path gbl:Bailey.area ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 100.0
    ], [
        sh:path gbl:Bailey.plots ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 120
    ], [
        sh:path gbl:Bailey.role ;
        sh:maxCount 1 ;
        sh:in ( "inner" "outer" )
    ], [
        sh:path gbl:Bailey.street-style ;
        sh:maxCount 1 ;
        sh:in ( gbv:layout.organic gbv:layout.grid gbv:layout.radial gbv:layout.linear-along-road gbv:layout.linear-along-river )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:BarracksPlot
        ] ;
        sh:qualifiedMaxCount 4
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:ChapelPlot
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Clutter
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Garden
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:KeepPlot
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:SmithyPlot
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:StablesPlot
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:StorehousePlot
        ] ;
        sh:qualifiedMaxCount 4
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:TrainingYard
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WellPlaza
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:BarracksPlot
        ] [
            sh:class gbl:ChapelPlot
        ] [
            sh:class gbl:Clutter
        ] [
            sh:class gbl:Garden
        ] [
            sh:class gbl:KeepPlot
        ] [
            sh:class gbl:SmithyPlot
        ] [
            sh:class gbl:StablesPlot
        ] [
            sh:class gbl:StorehousePlot
        ] [
            sh:class gbl:TrainingYard
        ] [
            sh:class gbl:WellPlaza
        ] )
    ] .

gbs:BarSetShape
    a sh:NodeShape ;
    sh:targetClass gbl:BarSet ;
    sh:property [
        sh:path gbl:BarSet.stools ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 10
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:BarracksDormShape
    a sh:NodeShape ;
    sh:targetClass gbl:BarracksDorm ;
    sh:property [
        sh:path gbl:BarracksDorm.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 40.0
            ]
        ]
    ], [
        sh:path gbl:BarracksDorm.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:floor-surface.wood-floor gbv:floor-surface.stone-floor gbv:floor-surface.dirt gbv:floor-surface.tile-floor gbv:floor-surface.carpet gbv:floor-surface.concrete )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:BunkSet
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:RoomLights
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WallDecor
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:BunkSet
        ] [
