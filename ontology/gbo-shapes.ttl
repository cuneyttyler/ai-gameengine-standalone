    ] .

gbs:MallPlotShape
    a sh:NodeShape ;
    sh:targetClass gbl:MallPlot ;
    sh:property [
        sh:path gbl:MallPlot.setback ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 8.0
    ], [
        sh:path gbl:MallPlot.size ;
