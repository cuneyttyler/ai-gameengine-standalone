    sh:targetClass gbl:Lookout ;
    sh:property [
        sh:path gbl:Lookout.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 1.0 ;
                sh:maxInclusive 4.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 1.0 ;
                sh:maxInclusive 4.0
            ]
        ]
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

gbs:LootCacheShape
    a sh:NodeShape ;
    sh:targetClass gbl:LootCache ;
    sh:property [
        sh:path gbl:LootCache.items ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 12
    ], [
        sh:path gbl:LootCache.rarity ;
        sh:maxCount 1 ;
        sh:in ( gbv:rarity.common gbv:rarity.uncommon gbv:rarity.rare gbv:rarity.legendary )
    ], [
        sh:path gbo:hasPart ;
        sh:maxCount 0
    ] .

