gbs:ManorPlotShape
    a sh:NodeShape ;
    sh:targetClass gbl:ManorPlot ;
    sh:property [
        sh:path gbl:ManorPlot.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 10.0 ;
                sh:maxInclusive 60.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 10.0 ;
                sh:maxInclusive 60.0
            ]
        ]
    ], [
        sh:path gbl:ManorPlot.grandeur ;
        sh:maxCount 1 ;
        sh:in ( "modest" "grand" )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Courtyard
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:FormalGarden
        ] ;
        sh:qualifiedMaxCount 2
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Fountain
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Courtyard
        ] [
            sh:class gbl:FormalGarden
        ] [
            sh:class gbl:Fountain
        ] )
    ] .

gbs:MarketSquareShape
    a sh:NodeShape ;
    sh:targetClass gbl:MarketSquare ;
    sh:property [
        sh:path gbl:MarketSquare.crowd ;
        sh:maxCount 1 ;
        sh:in ( "none" "rare" "some" "common" "abundant" )
    ], [
        sh:path gbl:MarketSquare.size ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path gbo:sizeW ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 6.0 ;
                sh:maxInclusive 60.0
            ] ;
            sh:property [
                sh:path gbo:sizeH ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 6.0 ;
                sh:maxInclusive 60.0
            ]
        ]
    ], [
        sh:path gbl:MarketSquare.stalls ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 200
    ], [
        sh:path gbl:MarketSquare.centrepiece ;
        sh:maxCount 1 ;
        sh:in ( "well" "fountain" "statue" "cross" "none" )
    ], [
        sh:path gbl:MarketSquare.surface ;
        sh:maxCount 1 ;
        sh:in ( gbv:surface.grass gbv:surface.dirt gbv:surface.gravel gbv:surface.paved gbv:surface.cobble gbv:surface.plank gbv:surface.asphalt gbv:surface.concrete gbv:surface.plaza gbv:surface.lawn gbv:surface.sports-court )
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:Clutter
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:MarketStalls
        ] ;
        sh:qualifiedMaxCount 4
    ], [
        sh:path gbo:hasPart ;
        sh:qualifiedValueShape [
            sh:class gbl:WellPlaza
        ] ;
        sh:qualifiedMaxCount 1
    ], [
        sh:path gbo:hasPart ;
        sh:or ( [
            sh:class gbl:Clutter
        ] [
            sh:class gbl:MarketStalls
        ] [
            sh:class gbl:WellPlaza
        ] )
    ] .

