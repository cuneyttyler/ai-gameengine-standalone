    gbo:component gbl:FloorLevel, gbl:Hall, gbl:Stairwell, gbl:Storage, gbl:Cellar, gbl:LivingRoom, gbl:Kitchen, gbl:Bedroom, gbl:DiningRoom, gbl:TavernHall, gbl:GuestRoom, gbl:ShopFloor, gbl:BackStore, gbl:WorkshopRoom, gbl:Forge, gbl:Nave, gbl:Sanctuary, gbl:Vestry, gbl:GreatHall, gbl:ThroneRoom, gbl:Armoury, gbl:BarracksDorm, gbl:Library, gbl:Study, gbl:Treasury, gbl:Cells, gbl:DiningSet, gbl:BedSet, gbl:HearthSet, gbl:BarSet, gbl:WorkSet, gbl:ForgeSet, gbl:ShelfWall, gbl:DisplaySet, gbl:AltarSet, gbl:ThroneSet, gbl:StorageSet, gbl:Pews, gbl:BunkSet, gbl:KitchenSet, gbl:DeskSet, gbl:WardrobeSet, gbl:RoomLights, gbl:WallDecor, gbl:FloorClutter ;
    gbo:stages "[\"room programme\",\"floor plan\",\"doors & windows\",\"furniture groups\",\"small objects\",\"wall decor & lights\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[],\"style\":{\"condition\":\"condition\",\"wealth\":\"wealth\"}}"^^rdf:JSON ;
