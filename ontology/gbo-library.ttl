gbl:TownhouseBlock.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:TownhouseBlock ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 6.0 ;
    gbo:minHeight 6.0 ;
    gbo:maxWidth 40.0 ;
