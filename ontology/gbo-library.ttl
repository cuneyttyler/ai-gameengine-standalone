gbl:TownhouseBlock.slot.townhouse
    a gbo:Slot ;
    gbo:slotName "townhouse" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:townhouse .

gbl:TownhouseBlock.child.courtyard
    a gbo:ChildRule ;
    gbo:child gbl:Courtyard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 ;
    gbo:when "courtyard"^^gbo:Expression .

gbl:TrailNetwork
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Network, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Trail network"@en ;
    rdfs:comment "Trails linking the entrances and every point of interest."@en ;
    gbo:moduleId "trail-network" ;
    gbo:level gbo:Network ;
