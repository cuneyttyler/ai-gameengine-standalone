gbl:ParkDistrict.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 10 ;
    gbo:weight 0.3 .

gbl:ParkDistrict.child.sports-court
    a gbo:ChildRule ;
    gbo:child gbl:SportsCourt ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.4 .

gbl:ParkingGaragePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Parking, gbl:BuildingParcel, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Parking garage plot"@en ;
    rdfs:comment "A multi-storey parking garage."@en ;
    gbo:moduleId "parking-garage-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:ParkingGaragePlot.setback, gbl:ParkingGaragePlot.size, gbl:ParkingGaragePlot.condition ;
    gbo:hasSlot gbl:ParkingGaragePlot.slot.car, gbl:ParkingGaragePlot.slot.parking-garage ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:ParkingGaragePlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:ParkingGaragePlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ParkingGaragePlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ParkingGaragePlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[8,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ParkingGaragePlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:ParkingGaragePlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:ParkingGaragePlot.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:ParkingGaragePlot.slot.parking-garage
    a gbo:Slot ;
    gbo:slotName "parking-garage" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:parking-garage .

gbl:ParkingLot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Parking, gbl:OpenSpace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Parking lot"@en ;
    rdfs:comment "An open car park on asphalt, its bays full of cars."@en ;
    gbo:moduleId "parking-lot" ;
    gbo:level gbo:Parcel ;
