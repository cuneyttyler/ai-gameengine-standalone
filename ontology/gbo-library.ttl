gbl:Subplace
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:AbstractPart, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Nested place"@en ;
    rdfs:comment "A whole place built inside this one (a castle in a town, a farmland ring): its own Brief, Spec and layout, inside a region the parent solves."@en ;
    gbo:moduleId "subplace" ;
    gbo:level gbo:AbstractPart ;
    gbo:hasField gbl:Subplace.area, gbl:Subplace.buildType ;
    gbo:origin "engine" .

gbl:Subplace.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Subplace ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 16.0 ;
    gbo:defaultValue "[400,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Subplace.buildType
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "buildType"@en ;
    rdfs:domain gbl:Subplace ;
    gbo:fieldName "buildType" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"settlement\""^^rdf:JSON ;
    gbo:vocabulary gbv:build-type .

gbl:Suburb
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Park
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Playground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RetailPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SchoolPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SuburbanHousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Park gbl:Playground gbl:RetailPlot gbl:Road gbl:SchoolPlot gbl:SuburbanHousePlot )
        ]
    ] ;
    rdfs:label "Suburb"@en ;
    rdfs:comment "Detached family houses with lawns and driveways on quiet streets."@en ;
    gbo:moduleId "suburb" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:Suburb.area, gbl:Suburb.footprint-density, gbl:Suburb.plots, gbl:Suburb.density, gbl:Suburb.street-style, gbl:Suburb.wealth ;
    gbo:hasSlot gbl:Suburb.slot.car ;
    gbo:hasChildRule gbl:Suburb.child.park, gbl:Suburb.child.playground, gbl:Suburb.child.retail-plot, gbl:Suburb.child.road, gbl:Suburb.child.school-plot, gbl:Suburb.child.suburban-house-plot ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.downtown\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":20}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "edge" ;
        gbo:weight 1.5
    ] ;
    gbo:origin "engine" .

gbl:Suburb.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Suburb ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Suburb.footprint-density
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "footprint-density"@en ;
    rdfs:comment "built cells / district cells"@en ;
    rdfs:domain gbl:Suburb ;
    gbo:fieldName "footprint-density" ;
    gbo:fieldType gbo:ratio ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1.0 ;
    gbo:defaultValue "[0.35,0.7]"^^rdf:JSON .

gbl:Suburb.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Suburb ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[12,50]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Suburb.density
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "density"@en ;
    rdfs:domain gbl:Suburb ;
    gbo:fieldName "density" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"sparse\""^^rdf:JSON ;
    gbo:allowedValue "sparse", "medium", "dense" ;
    gbo:askedInConfirmation true .

gbl:Suburb.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this district's own street pattern; unset, the city's"@en ;
    rdfs:domain gbl:Suburb ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:Suburb.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:Suburb ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:Suburb.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:Suburb.child.park
    a gbo:ChildRule ;
    gbo:child gbl:Park ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.2 .

gbl:Suburb.child.playground
    a gbo:ChildRule ;
    gbo:child gbl:Playground ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.2 .

gbl:Suburb.child.retail-plot
    a gbo:ChildRule ;
