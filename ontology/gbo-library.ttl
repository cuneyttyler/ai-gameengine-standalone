    rdfs:domain gbl:Site ;
    gbo:fieldName "build-type" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"settlement\""^^rdf:JSON ;
    gbo:allowedValue "settlement", "castle", "camp", "farmland", "dungeon", "wilderness" ;
    gbo:askedInConfirmation true .

gbl:Site.name
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:domain gbl:Site ;
    gbo:fieldName "name" ;
    gbo:fieldType gbo:description .

gbl:Site.scale-class
    a gbo:QualityField, owl:DatatypeProperty ;
