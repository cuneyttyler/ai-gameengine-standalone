    gbo:hasField gbl:BiomeZone.area, gbl:BiomeZone.biome ;
    gbo:hasSlot gbl:BiomeZone.slot.bush, gbl:BiomeZone.slot.rock, gbl:BiomeZone.slot.tree ;
    gbo:origin "engine" .

gbl:BiomeZone.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:BiomeZone ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[4000,40000]"^^rdf:JSON ;
