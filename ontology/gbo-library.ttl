gbl:MarketSquare
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:OpenSpace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MarketStalls
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WellPlaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clutter gbl:MarketStalls gbl:WellPlaza )
        ]
    ] ;
    rdfs:label "Market square"@en ;
    rdfs:comment "An open square with stalls and a centrepiece."@en ;
    gbo:moduleId "market-square" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:MarketSquare.crowd, gbl:MarketSquare.size, gbl:MarketSquare.stalls, gbl:MarketSquare.centrepiece, gbl:MarketSquare.surface ;
    gbo:hasSlot gbl:MarketSquare.slot.centrepiece, gbl:MarketSquare.slot.ground, gbl:MarketSquare.slot.stall ;
    gbo:hasChildRule gbl:MarketSquare.child.clutter, gbl:MarketSquare.child.market-stalls, gbl:MarketSquare.child.well-plaza ;
    gbo:constraint "stalls * 6 <= size.w * size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self.centrepiece\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 1.0
    ], [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.8
    ] ;
    gbo:origin "engine" .

