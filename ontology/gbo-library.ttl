    rdfs:domain gbl:Bridge ;
    gbo:fieldName "material" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood\""^^rdf:JSON ;
    gbo:vocabulary gbv:material .

gbl:Bridge.slot.bridge
    a gbo:Slot ;
    gbo:slotName "bridge" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bridge ;
    gbo:conceptsFrom gbl:Bridge.material .

gbl:BuildingInterior
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FloorLevel
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:FloorLevel
    ] ;
    rdfs:label "Building interior"@en ;
    rdfs:comment "The inside of a building: its floors, rooms, doors, stairs and furniture."@en ;
    gbo:moduleId "building-interior" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:BuildingInterior.floors, gbl:BuildingInterior.rooms, gbl:BuildingInterior.condition, gbl:BuildingInterior.floor, gbl:BuildingInterior.kind, gbl:BuildingInterior.notes, gbl:BuildingInterior.wealth ;
    gbo:hasSlot gbl:BuildingInterior.slot.door, gbl:BuildingInterior.slot.wall, gbl:BuildingInterior.slot.window ;
    gbo:hasChildRule gbl:BuildingInterior.child.floor-level ;
    gbo:constraint "within(self.rooms, count(descendants(class: Room)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:BuildingInterior.floors
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "floors"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "floors" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "1"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:BuildingInterior.rooms
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rooms"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "rooms" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[4,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:BuildingInterior.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:BuildingInterior.floor
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "floor"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "floor" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:BuildingInterior.kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"house\""^^rdf:JSON ;
    gbo:vocabulary gbv:building-kind ;
    gbo:askedInConfirmation true .

gbl:BuildingInterior.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:BuildingInterior.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:BuildingInterior ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:BuildingInterior.slot.door
    a gbo:Slot ;
    gbo:slotName "door" ;
    gbo:essential true ;
    gbo:needsRole gbr:door .

gbl:BuildingInterior.slot.wall
    a gbo:Slot ;
    gbo:slotName "wall" ;
    gbo:essential true ;
    gbo:needsRole gbr:wall-piece-set .

gbl:BuildingInterior.slot.window
    a gbo:Slot ;
    gbo:slotName "window" ;
    gbo:essential false ;
    gbo:needsRole gbr:window .

gbl:BuildingInterior.child.floor-level
    a gbo:ChildRule ;
    gbo:child gbl:FloorLevel ;
    gbo:minCount 1 ;
    gbo:maxCount 6 ;
    gbo:countField gbl:BuildingInterior.floors ;
    gbo:weight 1.0 .

gbl:BunkSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Bunks"@en ;
    rdfs:comment "Beds in a row for the garrison or the guests."@en ;
    gbo:moduleId "bunk-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:BunkSet.slot.bed, gbl:BunkSet.slot.bed2, gbl:BunkSet.slot.chest ;
    gbo:origin "engine" .

gbl:BunkSet.slot.bed
    a gbo:Slot ;
    gbo:slotName "bed" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bed .

gbl:BunkSet.slot.bed2
    a gbo:Slot ;
    gbo:slotName "bed2" ;
    gbo:essential false ;
    gbo:needsRole gbr:bed .

gbl:BunkSet.slot.chest
    a gbo:Slot ;
    gbo:slotName "chest" ;
    gbo:essential false ;
    gbo:needsRole gbr:chest .

gbl:Camp
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CampGround
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CampGround
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Wall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:CampGround gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:River gbl:Road gbl:Wall )
        ]
    ] ;
    rdfs:label "Camp"@en ;
    rdfs:comment "A camp of tents: military, nomad, bandit or hunters, round its fires."@en ;
    gbo:moduleId "camp" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:camp ;
    gbo:hasField gbl:Camp.area, gbl:Camp.tents, gbl:Camp.condition, gbl:Camp.kind, gbl:Camp.notes, gbl:Camp.relief, gbl:Camp.walled, gbl:Camp.woods ;
    gbo:hasChildRule gbl:Camp.child.camp-ground, gbl:Camp.child.forest, gbl:Camp.child.ground, gbl:Camp.child.lake, gbl:Camp.child.meadow, gbl:Camp.child.river, gbl:Camp.child.road, gbl:Camp.child.wall ;
    gbo:constraint "within(self.tents, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression, "walled != 'none' implies count(children(wall)) >= 1"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Camp.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[1600,6400]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Camp.tents
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "tents"@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "tents" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 400.0 ;
    gbo:defaultValue "[6,20]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Camp.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:Camp.kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"military\""^^rdf:JSON ;
    gbo:vocabulary gbv:camp-kind ;
    gbo:askedInConfirmation true .

gbl:Camp.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Camp.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gentle\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" ;
    gbo:askedInConfirmation true .

gbl:Camp.walled
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "walled"@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "walled" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"none\""^^rdf:JSON ;
    gbo:allowedValue "none", "palisade" ;
    gbo:askedInConfirmation true .

gbl:Camp.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:comment "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."@en ;
    rdfs:domain gbl:Camp ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" ;
    gbo:askedInConfirmation true .

gbl:Camp.child.camp-ground
    a gbo:ChildRule ;
    gbo:child gbl:CampGround ;
    gbo:minCount 1 ;
    gbo:maxCount 6 ;
    gbo:weight 1.0 .

gbl:Camp.child.forest
    a gbo:ChildRule ;
    gbo:child gbl:Forest ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.5 .

gbl:Camp.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Camp.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.1 .

gbl:Camp.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:Camp.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.2 .

gbl:Camp.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 10 ;
    gbo:weight 1.0 .

gbl:Camp.child.wall
    a gbo:ChildRule ;
    gbo:child gbl:Wall ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 ;
    gbo:when "walled != 'none'"^^gbo:Expression .

gbl:CampGround
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CampfireRing
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CampfireRing
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CommandTentPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HorseLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lookout
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SupplyArea
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TentPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TentPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:CampfireRing gbl:Clutter gbl:CommandTentPlot gbl:HorseLine gbl:Lookout gbl:SupplyArea gbl:TentPlot )
        ]
    ] ;
    rdfs:label "Camp ground"@en ;
    rdfs:comment "Tents in rows or rings round their fires, with the camp's stores and horses."@en ;
    gbo:moduleId "camp-ground" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:camp ;
    gbo:hasField gbl:CampGround.area, gbl:CampGround.tents, gbl:CampGround.street-style ;
    gbo:hasChildRule gbl:CampGround.child.campfire-ring, gbl:CampGround.child.clutter, gbl:CampGround.child.command-tent-plot, gbl:CampGround.child.horse-line, gbl:CampGround.child.lookout, gbl:CampGround.child.supply-area, gbl:CampGround.child.tent-plot ;
    gbo:origin "engine" .

gbl:CampGround.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CampGround ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[600,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CampGround.tents
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "tents"@en ;
    rdfs:domain gbl:CampGround ;
    gbo:fieldName "tents" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 400.0 ;
    gbo:defaultValue "[6,20]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:CampGround.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:domain gbl:CampGround ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"grid\""^^rdf:JSON ;
    gbo:vocabulary gbv:layout .

gbl:CampGround.child.campfire-ring
    a gbo:ChildRule ;
    gbo:child gbl:CampfireRing ;
    gbo:minCount 1 ;
    gbo:maxCount 8 ;
    gbo:weight 0.9 .

gbl:CampGround.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:CampGround.child.command-tent-plot
    a gbo:ChildRule ;
    gbo:child gbl:CommandTentPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:CampGround.child.horse-line
    a gbo:ChildRule ;
    gbo:child gbl:HorseLine ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.5 .

gbl:CampGround.child.lookout
    a gbo:ChildRule ;
    gbo:child gbl:Lookout ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.4 .

gbl:CampGround.child.supply-area
    a gbo:ChildRule ;
    gbo:child gbl:SupplyArea ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.6 .

gbl:CampGround.child.tent-plot
    a gbo:ChildRule ;
    gbo:child gbl:TentPlot ;
    gbo:minCount 1 ;
    gbo:maxCount 400 ;
    gbo:weight 1.0 .

gbl:CampfireRing
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Campfire"@en ;
    rdfs:comment "A ring of stones round a fire, logs to sit on."@en ;
    gbo:moduleId "campfire-ring" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:camp, gbb:wilderness ;
    gbo:hasField gbl:CampfireRing.size ;
    gbo:hasSlot gbl:CampfireRing.slot.campfire, gbl:CampfireRing.slot.log ;
    gbo:origin "engine" .

gbl:CampfireRing.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:CampfireRing ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 8.0 ;
    gbo:maxHeight 8.0 ;
    gbo:defaultValue "{\"h\":[3,4],\"w\":[3,4]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:CampfireRing.slot.campfire
    a gbo:Slot ;
    gbo:slotName "campfire" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:campfire .

gbl:CampfireRing.slot.log
    a gbo:Slot ;
    gbo:slotName "log" ;
    gbo:essential false ;
    gbo:needsRole gbr:log .

gbl:Campsite
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:PointOfInterest, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Campsite"@en ;
    rdfs:comment "A traveller's camp: a tent or two round a fire."@en ;
    gbo:moduleId "campsite" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:wilderness ;
    gbo:hasField gbl:Campsite.size, gbl:Campsite.tents ;
    gbo:hasSlot gbl:Campsite.slot.campfire, gbl:Campsite.slot.log, gbl:Campsite.slot.tent ;
    gbo:origin "engine" .

gbl:Campsite.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Campsite ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 14.0 ;
    gbo:maxHeight 14.0 ;
    gbo:defaultValue "{\"h\":[6,8],\"w\":[6,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Campsite.tents
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "tents"@en ;
    rdfs:domain gbl:Campsite ;
    gbo:fieldName "tents" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON .

gbl:Campsite.slot.campfire
    a gbo:Slot ;
    gbo:slotName "campfire" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:campfire .

gbl:Campsite.slot.log
    a gbo:Slot ;
    gbo:slotName "log" ;
    gbo:essential false ;
    gbo:needsRole gbr:log .

gbl:Campsite.slot.tent
    a gbo:Slot ;
    gbo:slotName "tent" ;
    gbo:essential false ;
    gbo:needsRole gbr:tent .

gbl:Castle
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bailey
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bailey
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CurtainWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CurtainWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Moat
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Bailey gbl:CurtainWall gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:Moat gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "Castle"@en ;
    rdfs:comment "A castle: curtain wall with towers and a gatehouse, a moat, baileys, the keep."@en ;
    gbo:moduleId "castle" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:castle ;
    gbo:hasField gbl:Castle.area, gbl:Castle.buildings, gbl:Castle.rings, gbl:Castle.condition, gbl:Castle.kind, gbl:Castle.notes, gbl:Castle.relief, gbl:Castle.woods ;
    gbo:hasChildRule gbl:Castle.child.bailey, gbl:Castle.child.curtain-wall, gbl:Castle.child.forest, gbl:Castle.child.ground, gbl:Castle.child.lake, gbl:Castle.child.meadow, gbl:Castle.child.moat, gbl:Castle.child.river, gbl:Castle.child.road ;
    gbo:constraint "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Castle.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[3600,14400]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Castle.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 120.0 ;
    gbo:defaultValue "[4,12]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Castle.rings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rings"@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "rings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 3.0 ;
    gbo:defaultValue "1"^^rdf:JSON .

gbl:Castle.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition ;
    gbo:askedInConfirmation true .

gbl:Castle.kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"keep-and-wall\""^^rdf:JSON ;
    gbo:vocabulary gbv:castle-kind ;
    gbo:askedInConfirmation true .

gbl:Castle.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Castle.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gentle\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" ;
    gbo:askedInConfirmation true .

gbl:Castle.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:comment "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."@en ;
    rdfs:domain gbl:Castle ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" ;
    gbo:askedInConfirmation true .

gbl:Castle.child.bailey
    a gbo:ChildRule ;
    gbo:child gbl:Bailey ;
    gbo:minCount 1 ;
    gbo:maxCount 3 ;
    gbo:weight 1.0 .

gbl:Castle.child.curtain-wall
    a gbo:ChildRule ;
    gbo:child gbl:CurtainWall ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Castle.child.forest
    a gbo:ChildRule ;
    gbo:child gbl:Forest ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.4 .

gbl:Castle.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Castle.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.1 .

gbl:Castle.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.4 .

gbl:Castle.child.moat
    a gbo:ChildRule ;
    gbo:child gbl:Moat ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Castle.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.2 .

gbl:Castle.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 6 ;
    gbo:weight 1.0 .

gbl:CastleWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Subplace
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Subplace
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Road gbl:Subplace )
        ]
    ] ;
    rdfs:label "Castle ward"@en ;
    rdfs:comment "Holds a castle, built as its own nested place."@en ;
    gbo:moduleId "castle-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:CastleWard.area ;
    gbo:hasChildRule gbl:CastleWard.child.road, gbl:CastleWard.child.subplace ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.9
    ] ;
    gbo:origin "engine" .

gbl:CastleWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CastleWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[1600,10000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CastleWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:CastleWard.child.subplace
    a gbo:ChildRule ;
    gbo:child gbl:Subplace ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:CaveChamber
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:DungeonRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ambience
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Encounter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Ambience gbl:Encounter )
        ]
    ] ;
    rdfs:label "Cave chamber"@en ;
    rdfs:comment "A natural chamber, its walls irregular."@en ;
    gbo:moduleId "cave-chamber" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:CaveChamber.danger, gbl:CaveChamber.size ;
    gbo:hasSlot gbl:CaveChamber.slot.rock ;
    gbo:hasChildRule gbl:CaveChamber.child.ambience, gbl:CaveChamber.child.encounter ;
    gbo:origin "engine" .

gbl:CaveChamber.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "danger"@en ;
    rdfs:domain gbl:CaveChamber ;
    gbo:fieldName "danger" ;
    gbo:fieldType gbo:count ;
