        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Bed set"@en ;
    rdfs:comment "A bed against the wall, a chest at its foot."@en ;
    gbo:moduleId "bed-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasSlot gbl:BedSet.slot.bed, gbl:BedSet.slot.chest, gbl:BedSet.slot.nightstand, gbl:BedSet.slot.rug ;
    gbo:origin "engine" .

gbl:BedSet.slot.bed
    a gbo:Slot ;
    gbo:slotName "bed" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bed .

gbl:BedSet.slot.chest
    a gbo:Slot ;
    gbo:slotName "chest" ;
    gbo:essential false ;
    gbo:needsRole gbr:chest .

gbl:BedSet.slot.nightstand
    a gbo:Slot ;
    gbo:slotName "nightstand" ;
    gbo:essential false ;
