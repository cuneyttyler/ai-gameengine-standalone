gbl:Farmstead.child.pasture
    a gbo:ChildRule ;
    gbo:child gbl:Pasture ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.6 .

gbl:Farmyard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Farmyard"@en ;
    rdfs:comment "An open farmyard with farm clutter."@en ;
    gbo:moduleId "farmyard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Farmyard.size, gbl:Farmyard.surface ;
    gbo:hasSlot gbl:Farmyard.slot.ground ;
    gbo:hasChildRule gbl:Farmyard.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:Farmyard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Farmyard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Farmyard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Farmyard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:Farmyard.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:Farmyard.surface .

gbl:Farmyard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:FenceLine
    a owl:Class, gbo:Module ;
