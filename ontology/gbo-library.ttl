gbl:Site
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Site"@en ;
    rdfs:comment "A place of the region: a settlement, castle, camp or dungeon, built later as a place of its own."@en ;
    gbo:moduleId "site" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:region ;
    gbo:hasField gbl:Site.size, gbl:Site.build-type, gbl:Site.name, gbl:Site.scale-class ;
    gbo:hasSlot gbl:Site.slot.marker ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.road\"]"^^rdf:JSON ;
        gbo:weight 0.5 ;
        gbo:arguments "{\"d0\":0,\"d1\":12}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Site.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Site ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 8.0 ;
    gbo:minHeight 8.0 ;
    gbo:maxWidth 120.0 ;
    gbo:maxHeight 120.0 ;
    gbo:defaultValue "{\"h\":[16,30],\"w\":[16,30]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Site.build-type
    a gbo:QualityField, owl:DatatypeProperty ;
