gbl:Meadow.slot.grass
    a gbo:Slot ;
    gbo:slotName "grass" ;
    gbo:essential false ;
    gbo:needsRole gbr:grass .

gbl:MeetingRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MeetingSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MeetingSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:MeetingSet gbl:OfficeLights )
        ]
    ] ;
    rdfs:label "Meeting room"@en ;
    rdfs:comment "A meeting table and a whiteboard."@en ;
    gbo:moduleId "meeting-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:MeetingRoom.size, gbl:MeetingRoom.surface ;
    gbo:hasSlot gbl:MeetingRoom.slot.floor ;
    gbo:hasChildRule gbl:MeetingRoom.child.meeting-set, gbl:MeetingRoom.child.office-lights ;
    gbo:origin "engine" .

gbl:MeetingRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:MeetingRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,6],\"w\":[3,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:MeetingRoom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:MeetingRoom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"carpet\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:MeetingRoom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:MeetingRoom.child.meeting-set
    a gbo:ChildRule ;
    gbo:child gbl:MeetingSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:MeetingRoom.child.office-lights
    a gbo:ChildRule ;
    gbo:child gbl:OfficeLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:MeetingSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Meeting table"@en ;
    rdfs:comment "A meeting table with chairs round it and a whiteboard."@en ;
    gbo:moduleId "meeting-set" ;
