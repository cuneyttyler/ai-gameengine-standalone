gbl:Wall
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Network, gbl:LinearFeature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Wall"@en ;
    rdfs:comment "A town wall or palisade with towers and gates, enclosing zones."@en ;
    gbo:moduleId "wall" ;
    gbo:level gbo:Network ;
    gbo:hasField gbl:Wall.gates, gbl:Wall.length, gbl:Wall.towers, gbl:Wall.condition, gbl:Wall.height-look, gbl:Wall.material ;
    gbo:hasSlot gbl:Wall.slot.gate, gbl:Wall.slot.tower, gbl:Wall.slot.wall ;
    gbo:constraint "gates >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:encloses ;
        gbo:members "[\"self\",\"parent\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:hard true
    ] ;
    gbo:origin "engine" .

