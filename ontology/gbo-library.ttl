gbl:MerchantWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShopPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TownhouseBlock
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WarehousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Road gbl:ShopPlot gbl:TownhouseBlock gbl:WarehousePlot )
        ]
    ] ;
    rdfs:label "Merchants' ward"@en ;
    rdfs:comment "Shops, warehouses and townhouses of merchants."@en ;
    gbo:moduleId "merchant-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:MerchantWard.area, gbl:MerchantWard.plots, gbl:MerchantWard.street-style, gbl:MerchantWard.wealth ;
    gbo:hasChildRule gbl:MerchantWard.child.road, gbl:MerchantWard.child.shop-plot, gbl:MerchantWard.child.townhouse-block, gbl:MerchantWard.child.warehouse-plot ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.market-ward\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":20}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.6
    ] ;
    gbo:origin "engine" .

gbl:MerchantWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:MerchantWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[800,3000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:MerchantWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:MerchantWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:MerchantWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:MerchantWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:MerchantWard.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:MerchantWard ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"rich\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth .

gbl:MerchantWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:MerchantWard.child.shop-plot
    a gbo:ChildRule ;
    gbo:child gbl:ShopPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 400 ;
    gbo:weight 1.0 .

gbl:MerchantWard.child.townhouse-block
    a gbo:ChildRule ;
    gbo:child gbl:TownhouseBlock ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:weight 0.5 .

gbl:MerchantWard.child.warehouse-plot
    a gbo:ChildRule ;
    gbo:child gbl:WarehousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:weight 0.6 .

gbl:MillPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Yard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Yard
    ] ;
    rdfs:label "Mill plot"@en ;
    rdfs:comment "A wind or water mill with a yard. A water mill needs a river."@en ;
    gbo:moduleId "mill-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:MillPlot.size, gbl:MillPlot.mill ;
    gbo:hasSlot gbl:MillPlot.slot.mill ;
    gbo:hasChildRule gbl:MillPlot.child.yard ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.3
    ], [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 0.4
    ] ;
    gbo:origin "engine" .

gbl:MillPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:MillPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 5.0 ;
    gbo:minHeight 5.0 ;
    gbo:maxWidth 24.0 ;
    gbo:maxHeight 24.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[8,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:MillPlot.mill
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "mill"@en ;
    rdfs:domain gbl:MillPlot ;
    gbo:fieldName "mill" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wind\""^^rdf:JSON ;
    gbo:allowedValue "wind", "water" ;
    gbo:askedInConfirmation true .

gbl:MillPlot.slot.mill
    a gbo:Slot ;
    gbo:slotName "mill" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:mill ;
    gbo:conceptsFrom gbl:MillPlot.mill .

gbl:MillPlot.child.yard
    a gbo:ChildRule ;
    gbo:child gbl:Yard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Moat
