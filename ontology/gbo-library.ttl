gbl:Nave
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:AltarSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:AltarSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pews
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pews
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:AltarSet gbl:Pews gbl:RoomLights gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Nave"@en ;
    rdfs:comment "Pews facing the altar."@en ;
    gbo:moduleId "nave" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasField gbl:Nave.size, gbl:Nave.surface ;
    gbo:hasSlot gbl:Nave.slot.floor ;
    gbo:hasChildRule gbl:Nave.child.altar-set, gbl:Nave.child.pews, gbl:Nave.child.room-lights, gbl:Nave.child.wall-decor ;
    gbo:origin "engine" .

