    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:PublicService, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Police station plot"@en ;
