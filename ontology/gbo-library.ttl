    gbo:hasSlot gbl:Hallway.slot.floor ;
    gbo:hasChildRule gbl:Hallway.child.office-lights ;
    gbo:origin "engine" .

gbl:Hallway.size
    a gbo:QuantityField, owl:ObjectProperty ;
