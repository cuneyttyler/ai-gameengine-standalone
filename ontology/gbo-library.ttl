gbl:BiomeZone.slot.rock
    a gbo:Slot ;
    gbo:slotName "rock" ;
    gbo:essential false ;
    gbo:needsRole gbr:rock .

gbl:BiomeZone.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tree .

gbl:BossArena
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:DungeonRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ambience
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:LootCache
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Ambience gbl:LootCache )
        ]
    ] ;
    rdfs:label "Boss arena"@en ;
    rdfs:comment "A great hall where the boss waits."@en ;
    gbo:moduleId "boss-arena" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:BossArena.danger, gbl:BossArena.size ;
    gbo:hasSlot gbl:BossArena.slot.boss, gbl:BossArena.slot.pillar ;
    gbo:hasChildRule gbl:BossArena.child.ambience, gbl:BossArena.child.loot-cache ;
    gbo:origin "engine" .

gbl:BossArena.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "danger"@en ;
    rdfs:domain gbl:BossArena ;
    gbo:fieldName "danger" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "5"^^rdf:JSON .

gbl:BossArena.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:BossArena ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[15,21],\"w\":[15,21]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:BossArena.slot.boss
    a gbo:Slot ;
    gbo:slotName "boss" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:boss .

gbl:BossArena.slot.pillar
    a gbo:Slot ;
    gbo:slotName "pillar" ;
    gbo:essential false ;
    gbo:needsRole gbr:pillar .

gbl:BossArena.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:BossArena.child.loot-cache
    a gbo:ChildRule ;
    gbo:child gbl:LootCache ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Bridge
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Crossing, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
