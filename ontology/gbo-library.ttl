# GBO library: modules, vocabularies, roles, relations and rules
#
# GENERATED from data/places/ by the engine (engine/places/OntologyExport.cpp).
# Don't edit: change the JSON files and regenerate (ontology/README.md).

@prefix gbo:     <https://w3id.org/aige/gbo#> .
@prefix gbl:     <https://w3id.org/aige/gbo/library#> .
@prefix gbb:     <https://w3id.org/aige/gbo/build#> .
@prefix gbv:     <https://w3id.org/aige/gbo/vocab#> .
@prefix gbr:     <https://w3id.org/aige/gbo/role#> .
@prefix gbx:     <https://w3id.org/aige/gbo/relation#> .
@prefix gbd:     <https://w3id.org/aige/gbo/rule#> .
@prefix gbs:     <https://w3id.org/aige/gbo/shapes#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/aige/gbo/library>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aige/gbo/library/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gbo> ;
    dcterms:title "GBO library: modules, vocabularies, roles, relations and rules"@en ;
    dcterms:description "The engine's place library in GBO terms: every module with its fields, slots, child rules, constraints, relations and site preferences; the module classes; the build types with their scale tables; the concept schemes; the asset roles; the spatial relation types; and the design rules with their sources."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

# --- Module classes ---

gbl:BuildingParcel
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Building parcel"@en ;
    rdfs:comment "A parcel whose primary object is a building."@en .

gbl:Civic
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Civic building"@en ;
    rdfs:comment "A temple, guard post or other public building."@en .

gbl:Commercial
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Workplace ;
    rdfs:label "Commercial"@en ;
    rdfs:comment "A parcel that sells: shops, a mall, restaurants, a hotel, a gas station."@en .

gbl:Crossing
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Crossing"@en ;
    rdfs:comment "Carries a path over an obstacle."@en .

gbl:District
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Ward ;
    rdfs:label "District"@en ;
    rdfs:comment "A zone of a modern city with its own use: a downtown, a suburb, an industrial estate."@en .

gbl:DungeonRoom
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Room ;
    rdfs:label "Dungeon room"@en ;
    rdfs:comment "A room or chamber of a dungeon or cave."@en .

gbl:Dwelling
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Dwelling"@en ;
    rdfs:comment "A parcel people live on."@en .

gbl:Fortification
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Fortification"@en ;
    rdfs:comment "Walls, towers and gates that defend a place."@en .

gbl:FurnitureGroup
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Furniture group"@en ;
    rdfs:comment "An anchor piece and the pieces around it (a table and its chairs)."@en .

gbl:Industrial
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Workplace ;
    rdfs:label "Industrial"@en ;
    rdfs:comment "A parcel that makes or stores goods: a factory, a logistics warehouse."@en .

gbl:Infrastructure
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Infrastructure"@en ;
    rdfs:comment "What a place runs on: roads, parking, transit, utilities."@en .

gbl:InteriorRoom
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Room ;
    rdfs:label "Interior room"@en ;
    rdfs:comment "A room of a building."@en .

gbl:Level
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Level"@en ;
    rdfs:comment "A floor of a building or a level of a dungeon: laid out on its own, linked by stairs."@en .

gbl:LinearFeature
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Linear feature"@en ;
    rdfs:comment "Something built along a line of cells: walls, fences, hedges."@en .

gbl:MixedUse
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Dwelling, gbl:Workplace ;
    rdfs:label "Mixed use"@en ;
    rdfs:comment "Homes over shops or offices."@en .

gbl:NatureArea
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Nature area"@en ;
    rdfs:comment "A forest, meadow or rock field."@en .

gbl:Office
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Workplace ;
    rdfs:label "Office"@en ;
    rdfs:comment "A parcel of offices: a tower, an office building."@en .

gbl:OpenSpace
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Open space"@en ;
    rdfs:comment "A square or plaza: open ground with a centrepiece."@en .

gbl:Park
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:OpenSpace, gbl:PlantedArea ;
    rdfs:label "Park"@en ;
    rdfs:comment "A public green: lawns, trees, paths, benches."@en .

gbl:Parking
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Infrastructure ;
    rdfs:label "Parking"@en ;
    rdfs:comment "Where vehicles stand: a lot, a garage."@en .

gbl:PlantedArea
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Planted area"@en ;
    rdfs:comment "Ground given to plants: gardens, beds, fields, orchards, meadows."@en .

gbl:PointOfInterest
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Point of interest"@en ;
    rdfs:comment "Something worth walking to in the wild: a ruin, a shrine, a cave mouth."@en .

gbl:PublicService
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Civic ;
    rdfs:label "Public service"@en ;
    rdfs:comment "A school, hospital, police or fire station, city hall."@en .

gbl:Room
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Room"@en ;
    rdfs:comment "A room of an interior or a dungeon: the unit they are counted in."@en .

gbl:Site
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Site"@en ;
    rdfs:comment "A place within a region, built later as a place of its own."@en .

gbl:Transit
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Infrastructure ;
    rdfs:label "Transit"@en ;
    rdfs:comment "Where people board public transport: a station, a stop."@en .

gbl:Ward
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Ward"@en ;
    rdfs:comment "A zone of a settlement with its own character."@en .

gbl:WaterBody
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Body of water"@en ;
    rdfs:comment "A river, lake or pond."@en .

gbl:WaterSource
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Water source"@en ;
    rdfs:comment "Where people draw water: a well or fountain."@en .

gbl:Workplace
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Workplace"@en ;
    rdfs:comment "A parcel people work on."@en .

gbl:Yard
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Yard"@en ;
    rdfs:comment "Open ground belonging to a parcel."@en .

# --- Modules ---

gbl:AbandonedCart
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:PointOfInterest, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Abandoned cart"@en ;
    rdfs:comment "A broken cart by the trail, its load spilled."@en ;
    gbo:moduleId "abandoned-cart" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:wilderness ;
    gbo:hasField gbl:AbandonedCart.size ;
    gbo:hasSlot gbl:AbandonedCart.slot.cart, gbl:AbandonedCart.slot.crate, gbl:AbandonedCart.slot.sack ;
    gbo:origin "engine" .

gbl:AbandonedCart.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:AbandonedCart ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 8.0 ;
    gbo:maxHeight 8.0 ;
    gbo:defaultValue "{\"h\":[3,4],\"w\":[4,5]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:AbandonedCart.slot.cart
    a gbo:Slot ;
    gbo:slotName "cart" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:cart .

gbl:AbandonedCart.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:AbandonedCart.slot.sack
    a gbo:Slot ;
    gbo:slotName "sack" ;
    gbo:essential false ;
    gbo:needsRole gbr:sack .

gbl:AltarSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Altar"@en ;
    rdfs:comment "An altar at the far end, candles and a lectern."@en ;
    gbo:moduleId "altar-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasSlot gbl:AltarSet.slot.altar, gbl:AltarSet.slot.candle, gbl:AltarSet.slot.lectern ;
    gbo:origin "engine" .

gbl:AltarSet.slot.altar
    a gbo:Slot ;
    gbo:slotName "altar" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:altar .

gbl:AltarSet.slot.candle
    a gbo:Slot ;
    gbo:slotName "candle" ;
    gbo:essential false ;
    gbo:needsRole gbr:candle .

gbl:AltarSet.slot.lectern
    a gbo:Slot ;
    gbo:slotName "lectern" ;
    gbo:essential false ;
    gbo:needsRole gbr:lectern .

gbl:Ambience
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Ambience"@en ;
    rdfs:comment "Torches on the walls, debris on the floor."@en ;
    gbo:moduleId "ambience" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:Ambience.debris, gbl:Ambience.lights, gbl:Ambience.mood ;
    gbo:hasSlot gbl:Ambience.slot.debris, gbl:Ambience.slot.light ;
    gbo:origin "engine" .

gbl:Ambience.debris
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "debris"@en ;
    rdfs:domain gbl:Ambience ;
    gbo:fieldName "debris" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.02,0.05,0.1,0.16]"^^rdf:JSON .

gbl:Ambience.lights
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "lights"@en ;
    rdfs:domain gbl:Ambience ;
    gbo:fieldName "lights" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.02,0.05,0.1,0.16]"^^rdf:JSON .

gbl:Ambience.mood
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "mood"@en ;
    rdfs:domain gbl:Ambience ;
    gbo:fieldName "mood" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gloomy\""^^rdf:JSON ;
    gbo:allowedValue "gloomy", "eerie", "grand" .

gbl:Ambience.slot.debris
    a gbo:Slot ;
    gbo:slotName "debris" ;
    gbo:essential false ;
    gbo:needsRole gbr:debris .

gbl:Ambience.slot.light
    a gbo:Slot ;
    gbo:slotName "light" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:light-prop .

gbl:ApartmentKitchen
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ModernKitchenSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ModernKitchenSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:ModernKitchenSet gbl:OfficeLights )
        ]
    ] ;
    rdfs:label "Kitchen"@en ;
    rdfs:comment "A fitted kitchen."@en ;
    gbo:moduleId "apartment-kitchen" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:ApartmentKitchen.size, gbl:ApartmentKitchen.surface ;
    gbo:hasSlot gbl:ApartmentKitchen.slot.floor ;
    gbo:hasChildRule gbl:ApartmentKitchen.child.modern-kitchen-set, gbl:ApartmentKitchen.child.office-lights ;
    gbo:origin "engine" .

gbl:ApartmentKitchen.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ApartmentKitchen ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,6],\"w\":[3,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ApartmentKitchen.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:ApartmentKitchen ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"tile-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:ApartmentKitchen.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:ApartmentKitchen.child.modern-kitchen-set
    a gbo:ChildRule ;
    gbo:child gbl:ModernKitchenSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ApartmentKitchen.child.office-lights
    a gbo:ChildRule ;
    gbo:child gbl:OfficeLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:ApartmentLiving
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SofaSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SofaSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:OfficeLights gbl:SofaSet )
        ]
    ] ;
    rdfs:label "Living room"@en ;
    rdfs:comment "A sofa, a television, a coffee table."@en ;
    gbo:moduleId "apartment-living" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:ApartmentLiving.size, gbl:ApartmentLiving.surface ;
    gbo:hasSlot gbl:ApartmentLiving.slot.floor ;
    gbo:hasChildRule gbl:ApartmentLiving.child.office-lights, gbl:ApartmentLiving.child.sofa-set ;
    gbo:origin "engine" .

gbl:ApartmentLiving.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ApartmentLiving ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,6],\"w\":[3,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ApartmentLiving.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:ApartmentLiving ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:ApartmentLiving.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:ApartmentLiving.child.office-lights
    a gbo:ChildRule ;
    gbo:child gbl:OfficeLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:ApartmentLiving.child.sofa-set
    a gbo:ChildRule ;
    gbo:child gbl:SofaSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ApartmentPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Apartment plot"@en ;
    rdfs:comment "An apartment block or tower with a courtyard, bikes and bins."@en ;
    gbo:moduleId "apartment-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:ApartmentPlot.setback, gbl:ApartmentPlot.size, gbl:ApartmentPlot.condition, gbl:ApartmentPlot.height ;
    gbo:hasSlot gbl:ApartmentPlot.slot.apartment-block, gbl:ApartmentPlot.slot.bicycle, gbl:ApartmentPlot.slot.street-light, gbl:ApartmentPlot.slot.trash-bin, gbl:ApartmentPlot.slot.tree ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:ApartmentPlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:ApartmentPlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ApartmentPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ApartmentPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[5,8],\"w\":[6,9]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ApartmentPlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:ApartmentPlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:ApartmentPlot.height
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "height"@en ;
    rdfs:domain gbl:ApartmentPlot ;
    gbo:fieldName "height" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"mid-rise\""^^rdf:JSON ;
    gbo:vocabulary gbv:apartment-kind ;
    gbo:askedInConfirmation true .

gbl:ApartmentPlot.slot.apartment-block
    a gbo:Slot ;
    gbo:slotName "apartment-block" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:apartment-block, gbr:apartment-tower ;
    gbo:conceptsFrom gbl:ApartmentPlot.height .

gbl:ApartmentPlot.slot.bicycle
    a gbo:Slot ;
    gbo:slotName "bicycle" ;
    gbo:essential false ;
    gbo:needsRole gbr:bicycle .

gbl:ApartmentPlot.slot.street-light
    a gbo:Slot ;
    gbo:slotName "street-light" ;
    gbo:essential false ;
    gbo:needsRole gbr:street-light .

gbl:ApartmentPlot.slot.trash-bin
    a gbo:Slot ;
    gbo:slotName "trash-bin" ;
    gbo:essential false ;
    gbo:needsRole gbr:trash-bin .

gbl:ApartmentPlot.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential false ;
    gbo:needsRole gbr:tree .

gbl:Armoury
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
