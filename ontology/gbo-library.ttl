    gbo:fieldName "scale-class" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"village\""^^rdf:JSON ;
    gbo:allowedValue "hamlet", "village", "large-village", "town", "city", "small", "medium", "large" ;
