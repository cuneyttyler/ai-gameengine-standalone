    gbo:child gbl:DeskSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Library.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
