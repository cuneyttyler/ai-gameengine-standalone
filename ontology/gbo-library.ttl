    gbo:primary true ;
    gbo:needsRole gbr:chest .

gbl:SecretRoom.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:SecretRoom.child.loot-cache
    a gbo:ChildRule ;
    gbo:child gbl:LootCache ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Settlement
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ward
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ward
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RockField
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Wall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Ward gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:River gbl:Road gbl:RockField gbl:Wall )
        ]
    ] ;
    rdfs:label "Settlement"@en ;
    rdfs:comment "A hamlet, village, town or city: wards, roads, walls and the ground."@en ;
    gbo:moduleId "settlement" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Settlement.area, gbl:Settlement.block-size, gbl:Settlement.buildings, gbl:Settlement.arrangement, gbl:Settlement.block-fill, gbl:Settlement.block-use, gbl:Settlement.building-cover, gbl:Settlement.building-shape, gbl:Settlement.condition, gbl:Settlement.coverage, gbl:Settlement.frontage, gbl:Settlement.layout, gbl:Settlement.lot-layout, gbl:Settlement.notes, gbl:Settlement.open-space, gbl:Settlement.relief, gbl:Settlement.site-fit, gbl:Settlement.street-grid, gbl:Settlement.style, gbl:Settlement.walled, gbl:Settlement.woods, gbl:Settlement.zone-shape ;
    gbo:hasChildRule gbl:Settlement.child.Ward, gbl:Settlement.child.forest, gbl:Settlement.child.ground, gbl:Settlement.child.lake, gbl:Settlement.child.meadow, gbl:Settlement.child.river, gbl:Settlement.child.road, gbl:Settlement.child.rock-field, gbl:Settlement.child.wall ;
    gbo:constraint "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression, "sum(children().area) <= 0.85 * self.area"^^gbo:Expression, "walled != 'none' implies count(children(wall)) >= 1"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Settlement.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[3600,10000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Settlement.block-size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "block-size"@en ;
    rdfs:comment "A block of the shared street grid, street to street"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "block-size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 8.0 ;
    gbo:minHeight 8.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[16,20],\"w\":[16,20]}"^^rdf:JSON ;
    gbo:unit "cells" ;
    gbo:askedInConfirmation true .

gbl:Settlement.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 5000.0 ;
    gbo:defaultValue "[15,60]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Settlement.arrangement
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "arrangement"@en ;
    rdfs:comment "How the small things are set out (lamps, trees, benches, cars, bicycles, bushes): scattered as they come, or ordered: evenly spaced along edges, in lines and mirrored pairs"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "arrangement" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"natural\""^^rdf:JSON ;
    gbo:vocabulary gbv:arrangement ;
    gbo:askedInConfirmation true .

gbl:Settlement.block-fill
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "block-fill"@en ;
    rdfs:comment "Lots along the streets with open land behind, or lots back to back so the blocks are built through"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "block-fill" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"frontage\""^^rdf:JSON ;
    gbo:vocabulary gbv:block-fill ;
    gbo:askedInConfirmation true .

gbl:Settlement.block-use
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "block-use"@en ;
    rdfs:comment "One kind of building per block, or mixed"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "block-use" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"mixed\""^^rdf:JSON ;
    gbo:vocabulary gbv:block-use ;
    gbo:askedInConfirmation true .

gbl:Settlement.building-cover
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "building-cover"@en ;
    rdfs:comment "Buildings fill their lots, or keep their planned footprints"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "building-cover" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"planned\""^^rdf:JSON ;
    gbo:vocabulary gbv:building-cover ;
    gbo:askedInConfirmation true .

gbl:Settlement.building-shape
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "building-shape"@en ;
    rdfs:comment "Buildings square, with rounded corners, or following their lots and streets"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "building-shape" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"square\""^^rdf:JSON ;
    gbo:vocabulary gbv:building-shape ;
    gbo:askedInConfirmation true .

gbl:Settlement.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition ;
    gbo:askedInConfirmation true .

gbl:Settlement.coverage
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "coverage"@en ;
    rdfs:comment "Open land between the zones, or zones covering the whole place"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "coverage" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"partial\""^^rdf:JSON ;
    gbo:vocabulary gbv:coverage ;
    gbo:askedInConfirmation true .

gbl:Settlement.frontage
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "frontage"@en ;
    rdfs:comment "One building line along a street, or each its own setback"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "frontage" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"varied\""^^rdf:JSON ;
    gbo:vocabulary gbv:frontage ;
    gbo:askedInConfirmation true .

gbl:Settlement.layout
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "layout"@en ;
    rdfs:comment "street patterns and their shares; the plan gives each ward one of them"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "layout" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"organic\":1.0}"^^rdf:JSON ;
    gbo:vocabulary gbv:layout ;
    gbo:askedInConfirmation true .

gbl:Settlement.lot-layout
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "lot-layout"@en ;
    rdfs:comment "How a block is divided into lots"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "lot-layout" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"packed\""^^rdf:JSON ;
    gbo:vocabulary gbv:lot-layout ;
    gbo:askedInConfirmation true .

gbl:Settlement.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Settlement.open-space
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "open-space"@en ;
    rdfs:comment "How much of each zone is open space (parks, plazas, parking) rather than buildings"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "open-space" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:vocabulary gbv:open-space ;
    gbo:askedInConfirmation true .

gbl:Settlement.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gentle\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" ;
    gbo:askedInConfirmation true .

gbl:Settlement.site-fit
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "site-fit"@en ;
    rdfs:comment "How big the site is: sized to the plan's content, or to the scale"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "site-fit" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"scale\""^^rdf:JSON ;
    gbo:vocabulary gbv:site-fit ;
    gbo:askedInConfirmation true .

gbl:Settlement.street-grid
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-grid"@en ;
    rdfs:comment "Each zone its own streets, or one street grid for the whole place, lined up with its main roads"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "street-grid" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"per-zone\""^^rdf:JSON ;
    gbo:vocabulary gbv:street-grid ;
    gbo:askedInConfirmation true .

gbl:Settlement.style
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "style"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "style" ;
    gbo:fieldType gbo:tags ;
    gbo:defaultValue "[]"^^rdf:JSON .

gbl:Settlement.walled
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "walled"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "walled" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"none\""^^rdf:JSON ;
    gbo:allowedValue "none", "palisade", "stone" ;
    gbo:askedInConfirmation true .

gbl:Settlement.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:comment "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" ;
    gbo:askedInConfirmation true .

gbl:Settlement.zone-shape
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "zone-shape"@en ;
    rdfs:comment "How the zones are shaped: grown from seeds (organic), or rectangles cut along the main roads (planned)"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "zone-shape" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"grown\""^^rdf:JSON ;
    gbo:vocabulary gbv:zone-shape ;
    gbo:askedInConfirmation true .

gbl:Settlement.child.Ward
    a gbo:ChildRule ;
    gbo:child gbl:Ward ;
    gbo:minCount 1 ;
    gbo:maxCount 60 ;
    gbo:weight 1.0 .

gbl:Settlement.child.forest
    a gbo:ChildRule ;
    gbo:child gbl:Forest ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.4 .

gbl:Settlement.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Settlement.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.1 .

gbl:Settlement.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.3 .

gbl:Settlement.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.3 .

gbl:Settlement.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 400 ;
    gbo:weight 1.0 .

gbl:Settlement.child.rock-field
    a gbo:ChildRule ;
    gbo:child gbl:RockField ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.1 .

gbl:Settlement.child.wall
    a gbo:ChildRule ;
    gbo:child gbl:Wall ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 ;
    gbo:when "walled != 'none'"^^gbo:Expression .

gbl:ShackCluster
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Shack cluster"@en ;
    rdfs:comment "Huddled shacks with clutter between them."@en ;
    gbo:moduleId "shack-cluster" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:ShackCluster.shacks, gbl:ShackCluster.size ;
    gbo:hasSlot gbl:ShackCluster.slot.shack ;
    gbo:hasChildRule gbl:ShackCluster.child.clutter ;
    gbo:origin "engine" .

gbl:ShackCluster.shacks
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "shacks"@en ;
    rdfs:domain gbl:ShackCluster ;
    gbo:fieldName "shacks" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[3,10]"^^rdf:JSON .

gbl:ShackCluster.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ShackCluster ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[6,12],\"w\":[6,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ShackCluster.slot.shack
    a gbo:Slot ;
    gbo:slotName "shack" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:shack .

gbl:ShackCluster.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ShelfWall
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Shelves"@en ;
    rdfs:comment "Shelves along a wall."@en ;
    gbo:moduleId "shelf-wall" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasSlot gbl:ShelfWall.slot.shelf, gbl:ShelfWall.slot.shelf2 ;
    gbo:origin "engine" .

gbl:ShelfWall.slot.shelf
    a gbo:Slot ;
    gbo:slotName "shelf" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:shelf .

gbl:ShelfWall.slot.shelf2
    a gbo:Slot ;
    gbo:slotName "shelf2" ;
    gbo:essential false ;
    gbo:needsRole gbr:shelf .

gbl:ShopFloor
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DisplaySet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DisplaySet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShelfWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:DisplaySet gbl:RoomLights gbl:ShelfWall gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Shop floor"@en ;
    rdfs:comment "Where customers come in: the counter, the goods."@en ;
    gbo:moduleId "shop-floor" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:ShopFloor.size, gbl:ShopFloor.surface ;
    gbo:hasSlot gbl:ShopFloor.slot.floor ;
    gbo:hasChildRule gbl:ShopFloor.child.display-set, gbl:ShopFloor.child.room-lights, gbl:ShopFloor.child.shelf-wall, gbl:ShopFloor.child.wall-decor ;
    gbo:origin "engine" .

gbl:ShopFloor.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ShopFloor ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[5,7]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ShopFloor.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:ShopFloor ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:ShopFloor.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:ShopFloor.child.display-set
    a gbo:ChildRule ;
    gbo:child gbl:DisplaySet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ShopFloor.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:ShopFloor.child.shelf-wall
    a gbo:ChildRule ;
    gbo:child gbl:ShelfWall ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:ShopFloor.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:ShopFront
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Shop front"@en ;
    rdfs:comment "A stall and goods on display before a shop."@en ;
    gbo:moduleId "shop-front" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:ShopFront.slot.crate, gbl:ShopFront.slot.stall ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-front-of ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:ShopFront.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:ShopFront.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stall .

gbl:ShopPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShopFront
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:ShopFront
    ] ;
    rdfs:label "Shop plot"@en ;
    rdfs:comment "A shop with a stall on its front."@en ;
    gbo:moduleId "shop-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:ShopPlot.size, gbl:ShopPlot.goods ;
    gbo:hasSlot gbl:ShopPlot.slot.shop, gbl:ShopPlot.slot.stall ;
    gbo:hasChildRule gbl:ShopPlot.child.shop-front ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 0.5
    ], [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.5
    ] ;
    gbo:origin "engine" .

gbl:ShopPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ShopPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 16.0 ;
    gbo:maxHeight 20.0 ;
    gbo:defaultValue "{\"h\":[6,9],\"w\":[5,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ShopPlot.goods
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "goods"@en ;
    rdfs:domain gbl:ShopPlot ;
    gbo:fieldName "goods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"general\""^^rdf:JSON ;
    gbo:vocabulary gbv:goods .

gbl:ShopPlot.slot.shop
    a gbo:Slot ;
    gbo:slotName "shop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:shop ;
    gbo:conceptsFrom gbl:ShopPlot.goods .

gbl:ShopPlot.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential false ;
    gbo:needsRole gbr:stall .

gbl:ShopPlot.child.shop-front
    a gbo:ChildRule ;
    gbo:child gbl:ShopFront ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

