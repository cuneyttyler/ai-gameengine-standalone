    gbo:essential false ;
    gbo:needsRole gbr:weapon-rack .

gbl:GuardRoom.slot.table
    a gbo:Slot ;
    gbo:slotName "table" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:table .

gbl:GuardRoom.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:GuardRoom.child.encounter
    a gbo:ChildRule ;
    gbo:child gbl:Encounter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:GuardRoom.child.loot-cache
    a gbo:ChildRule ;
    gbo:child gbl:LootCache ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.2 .

