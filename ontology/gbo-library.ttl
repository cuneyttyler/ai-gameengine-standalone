gbl:WorkshopPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clutter gbl:WorkYard )
        ]
    ] ;
    rdfs:label "Workshop plot"@en ;
    rdfs:comment "A craftsman's workshop, maybe with a house, and a work yard."@en ;
    gbo:moduleId "workshop-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:WorkshopPlot.size, gbl:WorkshopPlot.trade ;
    gbo:hasSlot gbl:WorkshopPlot.slot.house, gbl:WorkshopPlot.slot.workshop ;
    gbo:hasChildRule gbl:WorkshopPlot.child.clutter, gbl:WorkshopPlot.child.work-yard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:WorkshopPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkshopPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 20.0 ;
    gbo:maxHeight 24.0 ;
    gbo:defaultValue "{\"h\":[7,11],\"w\":[6,9]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkshopPlot.trade
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "trade"@en ;
    rdfs:domain gbl:WorkshopPlot ;
    gbo:fieldName "trade" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"smith\""^^rdf:JSON ;
    gbo:vocabulary gbv:trade ;
    gbo:askedInConfirmation true .

gbl:WorkshopPlot.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential false ;
    gbo:needsRole gbr:house .

gbl:WorkshopPlot.slot.workshop
    a gbo:Slot ;
    gbo:slotName "workshop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:workshop ;
    gbo:conceptsFrom gbl:WorkshopPlot.trade .

gbl:WorkshopPlot.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopPlot.child.work-yard
    a gbo:ChildRule ;
    gbo:child gbl:WorkYard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StorageSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:RoomLights gbl:StorageSet gbl:WallDecor gbl:WorkSet )
        ]
    ] ;
    rdfs:label "Workshop"@en ;
    rdfs:comment "A workbench and its tools."@en ;
    gbo:moduleId "workshop-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:WorkshopRoom.size, gbl:WorkshopRoom.surface ;
    gbo:hasSlot gbl:WorkshopRoom.slot.floor ;
    gbo:hasChildRule gbl:WorkshopRoom.child.room-lights, gbl:WorkshopRoom.child.storage-set, gbl:WorkshopRoom.child.wall-decor, gbl:WorkshopRoom.child.work-set ;
    gbo:origin "engine" .

gbl:WorkshopRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkshopRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[4,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkshopRoom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:WorkshopRoom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:WorkshopRoom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:WorkshopRoom.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:WorkshopRoom.child.storage-set
    a gbo:ChildRule ;
    gbo:child gbl:StorageSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 .

gbl:WorkshopRoom.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:WorkshopRoom.child.work-set
    a gbo:ChildRule ;
    gbo:child gbl:WorkSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Yard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Yard"@en ;
    rdfs:comment "An open yard with farm clutter."@en ;
    gbo:moduleId "yard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Yard.size, gbl:Yard.surface ;
    gbo:hasSlot gbl:Yard.slot.ground ;
    gbo:hasChildRule gbl:Yard.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:Yard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Yard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Yard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Yard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:Yard.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:Yard.surface .

gbl:Yard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

# --- Build types ---

gbb:camp
    a gbo:BuildType ;
    rdfs:label "Camp"@en ;
    gbo:rootModule gbl:Camp ;
    gbo:component gbl:CampGround, gbl:TentPlot, gbl:CommandTentPlot, gbl:CampfireRing, gbl:SupplyArea, gbl:HorseLine, gbl:Lookout, gbl:TrainingYard, gbl:Wall, gbl:Road, gbl:Clutter, gbl:Forest, gbl:Meadow, gbl:RockField, gbl:River, gbl:Lake, gbl:Pond, gbl:NatureScatter ;
    gbo:stages "[\"site & terrain\",\"lanes\",\"tents\",\"fires & stores\",\"enclosure\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[\"river\",\"lake\",\"hill\"],\"style\":{\"biome\":\"biome\",\"condition\":\"condition\"},\"walled\":[\"none\",\"palisade\"]}"^^rdf:JSON ;
    gbo:hasScale gbb:camp.small-camp, gbb:camp.camp, gbb:camp.war-camp .

gbb:camp.small-camp
    a gbo:ScaleClass ;
    rdfs:label "small-camp"@en ;
    gbo:minBuildings 3 ;
    gbo:maxBuildings 8 ;
    gbo:minSide 30 ;
    gbo:maxSide 50 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:camp.camp
    a gbo:ScaleClass ;
    rdfs:label "camp"@en ;
    gbo:minBuildings 8 ;
    gbo:maxBuildings 24 ;
    gbo:minSide 50 ;
    gbo:maxSide 80 ;
    gbo:minZones 1 ;
    gbo:maxZones 2 .

gbb:camp.war-camp
    a gbo:ScaleClass ;
    rdfs:label "war-camp"@en ;
    gbo:minBuildings 24 ;
    gbo:maxBuildings 80 ;
    gbo:minSide 80 ;
    gbo:maxSide 140 ;
    gbo:minZones 2 ;
    gbo:maxZones 4 .

gbb:castle
    a gbo:BuildType ;
    rdfs:label "Castle"@en ;
    gbo:rootModule gbl:Castle ;
    gbo:component gbl:Bailey, gbl:KeepPlot, gbl:BarracksPlot, gbl:ChapelPlot, gbl:SmithyPlot, gbl:StorehousePlot, gbl:StablesPlot, gbl:TrainingYard, gbl:WellPlaza, gbl:Garden, gbl:CurtainWall, gbl:Moat, gbl:Road, gbl:Clutter, gbl:Forest, gbl:Meadow, gbl:RockField, gbl:River, gbl:Lake, gbl:Pond, gbl:NatureScatter ;
    gbo:stages "[\"site & terrain\",\"curtain wall, towers & gatehouse\",\"baileys\",\"buildings\",\"features\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[\"river\",\"lake\",\"hill\",\"coast\"],\"style\":{\"biome\":\"biome\",\"condition\":\"condition\",\"era\":[\"ancient\",\"medieval\",\"renaissance\"]}}"^^rdf:JSON ;
    gbo:hasScale gbb:castle.tower-house, gbb:castle.castle, gbb:castle.fortress .

gbb:castle.tower-house
    a gbo:ScaleClass ;
    rdfs:label "tower-house"@en ;
    gbo:minBuildings 2 ;
    gbo:maxBuildings 4 ;
    gbo:minSide 40 ;
    gbo:maxSide 60 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:castle.castle
    a gbo:ScaleClass ;
    rdfs:label "castle"@en ;
    gbo:minBuildings 4 ;
    gbo:maxBuildings 12 ;
    gbo:minSide 60 ;
    gbo:maxSide 120 ;
    gbo:minZones 1 ;
    gbo:maxZones 2 .

gbb:castle.fortress
    a gbo:ScaleClass ;
