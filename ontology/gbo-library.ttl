gbl:Dock
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Dock"@en ;
    rdfs:comment "A pier with boats and crates."@en ;
    gbo:moduleId "dock" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Dock.boats, gbl:Dock.length ;
    gbo:hasSlot gbl:Dock.slot.boat, gbl:Dock.slot.crate, gbl:Dock.slot.pier ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:along ;
        gbo:members "[\"self\",\"parent.water\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:hard true ;
        gbo:arguments "{\"offset\":0}"^^rdf:JSON
    ] ;
    gbo:requires gbl:WaterBody ;
    gbo:origin "engine" .

gbl:Dock.boats
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "boats"@en ;
    rdfs:domain gbl:Dock ;
    gbo:fieldName "boats" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[0,3]"^^rdf:JSON .

gbl:Dock.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:Dock ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 2.0 ;
    gbo:maxValue 60.0 ;
    gbo:defaultValue "[4,12]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Dock.slot.boat
    a gbo:Slot ;
    gbo:slotName "boat" ;
    gbo:essential false ;
    gbo:needsRole gbr:boat .

gbl:Dock.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:Dock.slot.pier
    a gbo:Slot ;
    gbo:slotName "pier" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:pier-piece .

gbl:Docks
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Dock
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FishMarket
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WarehousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Dock gbl:FishMarket gbl:Road gbl:WarehousePlot )
        ]
    ] ;
    rdfs:label "Docks"@en ;
    rdfs:comment "Piers, warehouses and a fish market along water."@en ;
    gbo:moduleId "docks" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Docks.area, gbl:Docks.piers, gbl:Docks.plots, gbl:Docks.street-style ;
    gbo:hasChildRule gbl:Docks.child.dock, gbl:Docks.child.fish-market, gbl:Docks.child.road, gbl:Docks.child.warehouse-plot ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:along ;
        gbo:members "[\"self\",\"parent.water\"]"^^rdf:JSON ;
        gbo:weight 3.0 ;
        gbo:hard true ;
        gbo:arguments "{\"offset\":0}"^^rdf:JSON
    ] ;
    gbo:requires gbl:WaterBody ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:Docks.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Docks ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[400,2500]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Docks.piers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "piers"@en ;
    rdfs:domain gbl:Docks ;
    gbo:fieldName "piers" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[1,4]"^^rdf:JSON .

gbl:Docks.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Docks ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[3,15]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Docks.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:Docks ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:Docks.child.dock
    a gbo:ChildRule ;
    gbo:child gbl:Dock ;
    gbo:minCount 1 ;
    gbo:maxCount 40 ;
    gbo:countField gbl:Docks.piers ;
    gbo:weight 1.0 .

gbl:Docks.child.fish-market
    a gbo:ChildRule ;
    gbo:child gbl:FishMarket ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:Docks.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:Docks.child.warehouse-plot
    a gbo:ChildRule ;
    gbo:child gbl:WarehousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 40 ;
    gbo:weight 0.7 .

gbl:DoorstepSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Doorstep"@en ;
    rdfs:comment "Barrels, pots, a bench, a sign or a lamp by the door."@en ;
    gbo:moduleId "doorstep-set" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:DoorstepSet.items ;
    gbo:hasSlot gbl:DoorstepSet.slot.item ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:beside ;
        gbo:members "[\"self\",\"parent.door\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:DoorstepSet.items
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "items"@en ;
    rdfs:domain gbl:DoorstepSet ;
    gbo:fieldName "items" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per door" ;
    gbo:densityLevels "[0.0,0.5,1.0,2.0,3.0]"^^rdf:JSON .

gbl:DoorstepSet.slot.item
    a gbo:Slot ;
    gbo:slotName "item" ;
    gbo:essential false ;
    gbo:needsRole gbr:barrel, gbr:bench, gbr:lamp, gbr:pot, gbr:sign .

gbl:Dungeon
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DungeonLevel
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:DungeonLevel
    ] ;
    rdfs:label "Dungeon"@en ;
    rdfs:comment "A dungeon or cave: rooms on one or more levels, locks and their keys, encounters and loot."@en ;
    gbo:moduleId "dungeon" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:Dungeon.levels, gbl:Dungeon.locks, gbl:Dungeon.loops, gbl:Dungeon.rooms, gbl:Dungeon.secrets, gbl:Dungeon.boss, gbl:Dungeon.condition, gbl:Dungeon.difficulty-curve, gbl:Dungeon.goal, gbl:Dungeon.notes, gbl:Dungeon.theme ;
    gbo:hasChildRule gbl:Dungeon.child.dungeon-level ;
    gbo:constraint "within(self.rooms, count(descendants(class: Room)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Dungeon.levels
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "levels"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "levels" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "1"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Dungeon.locks
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "locks"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "locks" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Dungeon.loops
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "loops"@en ;
    rdfs:comment "extra corridors that make cycles"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "loops" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON .

gbl:Dungeon.rooms
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rooms"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "rooms" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 2.0 ;
    gbo:maxValue 400.0 ;
    gbo:defaultValue "[8,16]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Dungeon.secrets
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "secrets"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "secrets" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "[0,1]"^^rdf:JSON .

gbl:Dungeon.boss
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "boss"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "boss" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "true"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Dungeon.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"worn\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:Dungeon.difficulty-curve
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "difficulty-curve"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "difficulty-curve" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"rising\""^^rdf:JSON ;
    gbo:vocabulary gbv:difficulty-curve .

gbl:Dungeon.goal
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "goal"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "goal" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"treasure\""^^rdf:JSON ;
    gbo:vocabulary gbv:dungeon-goal ;
    gbo:askedInConfirmation true .

gbl:Dungeon.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Dungeon.theme
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "theme"@en ;
    rdfs:domain gbl:Dungeon ;
    gbo:fieldName "theme" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"crypt\""^^rdf:JSON ;
    gbo:vocabulary gbv:dungeon-theme ;
    gbo:askedInConfirmation true .

gbl:Dungeon.child.dungeon-level
    a gbo:ChildRule ;
    gbo:child gbl:DungeonLevel ;
    gbo:minCount 1 ;
    gbo:maxCount 8 ;
    gbo:countField gbl:Dungeon.levels ;
    gbo:weight 1.0 .

gbl:DungeonLevel
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Level, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BarracksRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BossArena
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CaveChamber
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ChasmRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CorridorRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CryptRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:EntranceRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:EntranceRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FloodedRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:GuardRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Junction
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:LibraryRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Prison
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:PuzzleRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SecretRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShrineRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StairsRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Storeroom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TrapRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TreasureRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:BarracksRoom gbl:BossArena gbl:CaveChamber gbl:ChasmRoom gbl:CorridorRoom gbl:CryptRoom gbl:EntranceRoom gbl:FloodedRoom gbl:GuardRoom gbl:Junction gbl:LibraryRoom gbl:Prison gbl:PuzzleRoom gbl:SecretRoom gbl:ShrineRoom gbl:StairsRoom gbl:Storeroom gbl:TrapRoom gbl:TreasureRoom )
        ]
    ] ;
    rdfs:label "Dungeon level"@en ;
    rdfs:comment "One level of the dungeon: its rooms and the corridors and doors between them."@en ;
    gbo:moduleId "dungeon-level" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:DungeonLevel.rooms, gbl:DungeonLevel.floor, gbl:DungeonLevel.theme ;
    gbo:hasSlot gbl:DungeonLevel.slot.door, gbl:DungeonLevel.slot.key, gbl:DungeonLevel.slot.locked-door, gbl:DungeonLevel.slot.secret-door, gbl:DungeonLevel.slot.stairs, gbl:DungeonLevel.slot.torch ;
    gbo:hasChildRule gbl:DungeonLevel.child.barracks-room, gbl:DungeonLevel.child.boss-arena, gbl:DungeonLevel.child.cave-chamber, gbl:DungeonLevel.child.chasm-room, gbl:DungeonLevel.child.corridor-room, gbl:DungeonLevel.child.crypt-room, gbl:DungeonLevel.child.entrance-room, gbl:DungeonLevel.child.flooded-room, gbl:DungeonLevel.child.guard-room, gbl:DungeonLevel.child.junction, gbl:DungeonLevel.child.library-room, gbl:DungeonLevel.child.prison, gbl:DungeonLevel.child.puzzle-room, gbl:DungeonLevel.child.secret-room, gbl:DungeonLevel.child.shrine-room, gbl:DungeonLevel.child.stairs-room, gbl:DungeonLevel.child.storeroom, gbl:DungeonLevel.child.trap-room, gbl:DungeonLevel.child.treasure-room ;
    gbo:origin "engine" .

gbl:DungeonLevel.rooms
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rooms"@en ;
    rdfs:domain gbl:DungeonLevel ;
    gbo:fieldName "rooms" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[6,14]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:DungeonLevel.floor
