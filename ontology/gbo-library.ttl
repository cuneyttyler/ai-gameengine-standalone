    gbo:hasChildRule gbl:Study.child.desk-set, gbl:Study.child.room-lights, gbl:Study.child.wall-decor ;
    gbo:origin "engine" .

gbl:Study.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Study ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,4],\"w\":[3,4]}"^^rdf:JSON ;
