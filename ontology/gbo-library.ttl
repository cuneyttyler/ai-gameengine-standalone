    gbo:fieldName "plants" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.2,0.4,0.7,0.9]"^^rdf:JSON .

gbl:VegetableBed.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:VegetableBed ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 1.0 ;
    gbo:minHeight 1.0 ;
    gbo:maxWidth 8.0 ;
    gbo:maxHeight 8.0 ;
    gbo:defaultValue "{\"h\":[2,4],\"w\":[1,3]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:VegetableBed.crop-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crop-mix"@en ;
    rdfs:domain gbl:VegetableBed ;
