        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:BarracksPlot gbl:ChapelPlot gbl:Clutter gbl:Garden gbl:KeepPlot gbl:SmithyPlot gbl:StablesPlot gbl:StorehousePlot gbl:TrainingYard gbl:WellPlaza )
        ]
    ] ;
    rdfs:label "Bailey"@en ;
