    gbo:defaultValue "[80,600]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Lake.shore
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "shore"@en ;
    rdfs:domain gbl:Lake ;
    gbo:fieldName "shore" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"reeds\""^^rdf:JSON ;
    gbo:allowedValue "sand", "reeds", "rocks" .

