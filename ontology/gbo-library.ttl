    gbo:fieldName "block-use" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"grouped\""^^rdf:JSON ;
    gbo:vocabulary gbv:block-use ;
    gbo:askedInConfirmation true .

gbl:City.building-cover
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "building-cover"@en ;
    rdfs:comment "Buildings fill their lots, or keep their planned footprints"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "building-cover" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"fit\""^^rdf:JSON ;
    gbo:vocabulary gbv:building-cover ;
    gbo:askedInConfirmation true .

gbl:City.building-shape
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "building-shape"@en ;
    rdfs:comment "Buildings square, with rounded corners, or following their lots and streets"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "building-shape" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"fitted\""^^rdf:JSON ;
    gbo:vocabulary gbv:building-shape ;
    gbo:askedInConfirmation true .

gbl:City.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition ;
    gbo:askedInConfirmation true .

gbl:City.coverage
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "coverage"@en ;
    rdfs:comment "Open land between the zones, or zones covering the whole place"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "coverage" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"full\""^^rdf:JSON ;
    gbo:vocabulary gbv:coverage ;
    gbo:askedInConfirmation true .

gbl:City.era
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "era"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "era" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"contemporary\""^^rdf:JSON ;
    gbo:vocabulary gbv:era ;
    gbo:askedInConfirmation true .

gbl:City.frontage
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "frontage"@en ;
    rdfs:comment "One building line along a street, or each its own setback"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "frontage" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"aligned\""^^rdf:JSON ;
    gbo:vocabulary gbv:frontage ;
    gbo:askedInConfirmation true .

gbl:City.layout
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "layout"@en ;
    rdfs:comment "street patterns and their shares; the plan gives each district one of them"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "layout" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"grid\":1.0}"^^rdf:JSON ;
    gbo:vocabulary gbv:layout ;
    gbo:askedInConfirmation true .

gbl:City.lot-layout
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "lot-layout"@en ;
    rdfs:comment "How a block is divided into lots"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "lot-layout" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"rows\""^^rdf:JSON ;
    gbo:vocabulary gbv:lot-layout ;
    gbo:askedInConfirmation true .

gbl:City.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:City.open-space
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "open-space"@en ;
    rdfs:comment "How much of each zone is open space (parks, plazas, parking) rather than buildings"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "open-space" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"few\""^^rdf:JSON ;
    gbo:vocabulary gbv:open-space ;
    gbo:askedInConfirmation true .

gbl:City.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"flat\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" .

gbl:City.site-fit
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "site-fit"@en ;
    rdfs:comment "How big the site is: sized to the plan's content, or to the scale"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "site-fit" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"content\""^^rdf:JSON ;
    gbo:vocabulary gbv:site-fit ;
    gbo:askedInConfirmation true .

gbl:City.street-grid
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-grid"@en ;
    rdfs:comment "Each zone its own streets, or one street grid for the whole place, lined up with its main roads"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "street-grid" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"shared\""^^rdf:JSON ;
    gbo:vocabulary gbv:street-grid ;
    gbo:askedInConfirmation true .

gbl:City.style
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "style"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "style" ;
    gbo:fieldType gbo:tags ;
    gbo:defaultValue "[]"^^rdf:JSON .

gbl:City.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"few\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" .

gbl:City.zone-shape
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "zone-shape"@en ;
    rdfs:comment "How the zones are shaped: grown from seeds (organic), or rectangles cut along the main roads (planned)"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "zone-shape" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"blocks\""^^rdf:JSON ;
    gbo:vocabulary gbv:zone-shape ;
    gbo:askedInConfirmation true .

gbl:City.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:City.child.District
    a gbo:ChildRule ;
    gbo:child gbl:District ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 1.0 .

gbl:City.child.downtown
    a gbo:ChildRule ;
    gbo:child gbl:Downtown ;
    gbo:minCount 1 ;
    gbo:maxCount 4 ;
    gbo:weight 1.0 .

gbl:City.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:City.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.15 .

gbl:City.child.residential-district
    a gbo:ChildRule ;
    gbo:child gbl:ResidentialDistrict ;
    gbo:minCount 1 ;
    gbo:maxCount 12 ;
    gbo:weight 1.0 .

gbl:City.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.25 .

gbl:City.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 8 ;
    gbo:weight 1.0 .

gbl:CityHallPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:PublicService, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "City hall plot"@en ;
    rdfs:comment "City hall on its square, with a flagpole and a fountain."@en ;
    gbo:moduleId "city-hall-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:CityHallPlot.setback, gbl:CityHallPlot.size, gbl:CityHallPlot.condition ;
    gbo:hasSlot gbl:CityHallPlot.slot.city-hall, gbl:CityHallPlot.slot.flagpole, gbl:CityHallPlot.slot.fountain, gbl:CityHallPlot.slot.park-bench, gbl:CityHallPlot.slot.street-light, gbl:CityHallPlot.slot.trash-bin ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:CityHallPlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:CityHallPlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:CityHallPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:CityHallPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[10,14],\"w\":[10,14]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:CityHallPlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:CityHallPlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:CityHallPlot.slot.city-hall
    a gbo:Slot ;
    gbo:slotName "city-hall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:city-hall .

gbl:CityHallPlot.slot.flagpole
    a gbo:Slot ;
    gbo:slotName "flagpole" ;
    gbo:essential false ;
    gbo:needsRole gbr:flagpole .

gbl:CityHallPlot.slot.fountain
    a gbo:Slot ;
    gbo:slotName "fountain" ;
    gbo:essential false ;
    gbo:needsRole gbr:fountain .

gbl:CityHallPlot.slot.park-bench
    a gbo:Slot ;
    gbo:slotName "park-bench" ;
    gbo:essential false ;
    gbo:needsRole gbr:park-bench .

gbl:CityHallPlot.slot.street-light
    a gbo:Slot ;
    gbo:slotName "street-light" ;
    gbo:essential false ;
    gbo:needsRole gbr:street-light .

gbl:CityHallPlot.slot.trash-bin
    a gbo:Slot ;
    gbo:slotName "trash-bin" ;
    gbo:essential false ;
    gbo:needsRole gbr:trash-bin .

gbl:CivicDistrict
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CityHallPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CityHallPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FireStationPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HospitalPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Park
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Plaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:PoliceStationPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SchoolPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:CityHallPlot gbl:FireStationPlot gbl:HospitalPlot gbl:Park gbl:Plaza gbl:PoliceStationPlot gbl:Road gbl:SchoolPlot )
        ]
    ] ;
    rdfs:label "Civic district"@en ;
    rdfs:comment "City hall on a plaza, police and fire stations, a hospital, a school, a park."@en ;
    gbo:moduleId "civic-district" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:CivicDistrict.area, gbl:CivicDistrict.footprint-density, gbl:CivicDistrict.plots, gbl:CivicDistrict.density, gbl:CivicDistrict.street-style, gbl:CivicDistrict.wealth ;
    gbo:hasSlot gbl:CivicDistrict.slot.car ;
    gbo:hasChildRule gbl:CivicDistrict.child.city-hall-plot, gbl:CivicDistrict.child.fire-station-plot, gbl:CivicDistrict.child.hospital-plot, gbl:CivicDistrict.child.park, gbl:CivicDistrict.child.plaza, gbl:CivicDistrict.child.police-station-plot, gbl:CivicDistrict.child.road, gbl:CivicDistrict.child.school-plot ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.downtown\"]"^^rdf:JSON ;
        gbo:weight 1.5 ;
        gbo:arguments "{\"d0\":0,\"d1\":25}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:CivicDistrict.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CivicDistrict ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CivicDistrict.footprint-density
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "footprint-density"@en ;
    rdfs:comment "built cells / district cells"@en ;
    rdfs:domain gbl:CivicDistrict ;
    gbo:fieldName "footprint-density" ;
    gbo:fieldType gbo:ratio ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1.0 ;
    gbo:defaultValue "[0.35,0.7]"^^rdf:JSON .

gbl:CivicDistrict.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:CivicDistrict ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[4,12]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:CivicDistrict.density
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "density"@en ;
    rdfs:domain gbl:CivicDistrict ;
    gbo:fieldName "density" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"medium\""^^rdf:JSON ;
    gbo:allowedValue "sparse", "medium", "dense" ;
    gbo:askedInConfirmation true .

gbl:CivicDistrict.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this district's own street pattern; unset, the city's"@en ;
    rdfs:domain gbl:CivicDistrict ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:CivicDistrict.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:CivicDistrict ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:CivicDistrict.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:CivicDistrict.child.city-hall-plot
    a gbo:ChildRule ;
    gbo:child gbl:CityHallPlot ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:CivicDistrict.child.fire-station-plot
    a gbo:ChildRule ;
    gbo:child gbl:FireStationPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:CivicDistrict.child.hospital-plot
    a gbo:ChildRule ;
    gbo:child gbl:HospitalPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 .

gbl:CivicDistrict.child.park
    a gbo:ChildRule ;
    gbo:child gbl:Park ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:CivicDistrict.child.plaza
    a gbo:ChildRule ;
    gbo:child gbl:Plaza ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.6 .

gbl:CivicDistrict.child.police-station-plot
    a gbo:ChildRule ;
    gbo:child gbl:PoliceStationPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:CivicDistrict.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:CivicDistrict.child.school-plot
    a gbo:ChildRule ;
    gbo:child gbl:SchoolPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:Classroom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ClassroomSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ClassroomSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:ClassroomSet gbl:OfficeLights )
        ]
    ] ;
    rdfs:label "Classroom"@en ;
    rdfs:comment "Desks facing the board."@en ;
    gbo:moduleId "classroom" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:Classroom.size, gbl:Classroom.surface ;
    gbo:hasSlot gbl:Classroom.slot.floor ;
    gbo:hasChildRule gbl:Classroom.child.classroom-set, gbl:Classroom.child.office-lights ;
    gbo:origin "engine" .

gbl:Classroom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Classroom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,6],\"w\":[3,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Classroom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Classroom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"tile-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:Classroom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:Classroom.child.classroom-set
    a gbo:ChildRule ;
    gbo:child gbl:ClassroomSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Classroom.child.office-lights
    a gbo:ChildRule ;
    gbo:child gbl:OfficeLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:ClassroomSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Classroom"@en ;
    rdfs:comment "Rows of school desks facing a whiteboard."@en ;
    gbo:moduleId "classroom-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:ClassroomSet.slot.school-desk, gbl:ClassroomSet.slot.whiteboard ;
    gbo:origin "engine" .

gbl:ClassroomSet.slot.school-desk
    a gbo:Slot ;
    gbo:slotName "school-desk" ;
    gbo:essential false ;
    gbo:needsRole gbr:school-desk .

gbl:ClassroomSet.slot.whiteboard
    a gbo:Slot ;
    gbo:slotName "whiteboard" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:whiteboard .

gbl:Clearing
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CampfireRing
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:CampfireRing gbl:NatureScatter )
        ]
    ] ;
    rdfs:label "Clearing"@en ;
    rdfs:comment "An open space inside a forest."@en ;
    gbo:moduleId "clearing" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Clearing.size ;
    gbo:hasChildRule gbl:Clearing.child.campfire-ring, gbl:Clearing.child.nature-scatter ;
    gbo:origin "engine" .

gbl:Clearing.size
    a gbo:QuantityField, owl:ObjectProperty ;
