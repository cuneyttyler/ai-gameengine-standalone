    gbo:fieldName "rocks" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:RockField.rock-kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "rock-kind"@en ;
    rdfs:domain gbl:RockField ;
    gbo:fieldName "rock-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"granite\""^^rdf:JSON ;
    gbo:allowedValue "granite", "limestone", "sandstone", "mossy" .

gbl:RockField.slot.boulder
    a gbo:Slot ;
    gbo:slotName "boulder" ;
    gbo:essential false ;
    gbo:needsRole gbr:boulder .

gbl:RockField.slot.cliff
    a gbo:Slot ;
    gbo:slotName "cliff" ;
    gbo:essential false ;
    gbo:needsRole gbr:cliff-piece .

gbl:RockField.slot.rock
    a gbo:Slot ;
    gbo:slotName "rock" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:rock .

gbl:Settlement
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ward
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ward
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RockField
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Wall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Ward gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:River gbl:Road gbl:RockField gbl:Wall )
        ]
    ] ;
    rdfs:label "Settlement"@en ;
    rdfs:comment "A hamlet, village, town or city: wards, roads, walls and the ground."@en ;
    gbo:moduleId "settlement" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Settlement.area, gbl:Settlement.buildings, gbl:Settlement.condition, gbl:Settlement.layout, gbl:Settlement.notes, gbl:Settlement.style, gbl:Settlement.walled ;
    gbo:hasChildRule gbl:Settlement.child.Ward, gbl:Settlement.child.forest, gbl:Settlement.child.ground, gbl:Settlement.child.lake, gbl:Settlement.child.meadow, gbl:Settlement.child.river, gbl:Settlement.child.road, gbl:Settlement.child.rock-field, gbl:Settlement.child.wall ;
    gbo:constraint "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression, "sum(children().area) <= 0.85 * self.area"^^gbo:Expression, "walled != 'none' implies count(children(wall)) >= 1"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Settlement.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[3600,10000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Settlement.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 5000.0 ;
    gbo:defaultValue "[15,60]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Settlement.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition ;
    gbo:askedInConfirmation true .

gbl:Settlement.layout
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "layout"@en ;
    rdfs:comment "street patterns and their shares; the plan gives each ward one of them"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "layout" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"organic\":1.0}"^^rdf:JSON ;
    gbo:vocabulary gbv:layout ;
    gbo:askedInConfirmation true .

gbl:Settlement.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Settlement.style
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "style"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "style" ;
    gbo:fieldType gbo:tags ;
    gbo:defaultValue "[]"^^rdf:JSON .

gbl:Settlement.walled
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "walled"@en ;
    rdfs:domain gbl:Settlement ;
    gbo:fieldName "walled" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"none\""^^rdf:JSON ;
    gbo:allowedValue "none", "palisade", "stone" ;
    gbo:askedInConfirmation true .

gbl:Settlement.child.Ward
    a gbo:ChildRule ;
    gbo:child gbl:Ward ;
    gbo:minCount 1 ;
    gbo:maxCount 60 ;
    gbo:weight 1.0 .

gbl:Settlement.child.forest
    a gbo:ChildRule ;
    gbo:child gbl:Forest ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.4 .

gbl:Settlement.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Settlement.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.1 .

gbl:Settlement.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.3 .

gbl:Settlement.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.3 .

gbl:Settlement.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 400 ;
    gbo:weight 1.0 .

gbl:Settlement.child.rock-field
    a gbo:ChildRule ;
    gbo:child gbl:RockField ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.1 .

gbl:Settlement.child.wall
    a gbo:ChildRule ;
    gbo:child gbl:Wall ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 ;
    gbo:when "walled != 'none'"^^gbo:Expression .

gbl:ShackCluster
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Shack cluster"@en ;
    rdfs:comment "Huddled shacks with clutter between them."@en ;
    gbo:moduleId "shack-cluster" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:ShackCluster.shacks, gbl:ShackCluster.size ;
    gbo:hasSlot gbl:ShackCluster.slot.shack ;
    gbo:hasChildRule gbl:ShackCluster.child.clutter ;
    gbo:origin "engine" .

gbl:ShackCluster.shacks
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "shacks"@en ;
    rdfs:domain gbl:ShackCluster ;
    gbo:fieldName "shacks" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[3,10]"^^rdf:JSON .

gbl:ShackCluster.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ShackCluster ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[6,12],\"w\":[6,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ShackCluster.slot.shack
    a gbo:Slot ;
    gbo:slotName "shack" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:shack .

gbl:ShackCluster.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ShopFront
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Shop front"@en ;
    rdfs:comment "A stall and goods on display before a shop."@en ;
    gbo:moduleId "shop-front" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:ShopFront.slot.crate, gbl:ShopFront.slot.stall ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-front-of ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:ShopFront.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:ShopFront.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stall .

gbl:ShopPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShopFront
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:ShopFront
    ] ;
    rdfs:label "Shop plot"@en ;
    rdfs:comment "A shop with a stall on its front."@en ;
    gbo:moduleId "shop-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:ShopPlot.size, gbl:ShopPlot.goods ;
    gbo:hasSlot gbl:ShopPlot.slot.shop, gbl:ShopPlot.slot.stall ;
    gbo:hasChildRule gbl:ShopPlot.child.shop-front ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 0.5
    ], [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.5
    ] ;
    gbo:origin "engine" .

gbl:ShopPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ShopPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 16.0 ;
    gbo:maxHeight 20.0 ;
    gbo:defaultValue "{\"h\":[6,9],\"w\":[5,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ShopPlot.goods
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "goods"@en ;
    rdfs:domain gbl:ShopPlot ;
    gbo:fieldName "goods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"general\""^^rdf:JSON ;
    gbo:vocabulary gbv:goods .

gbl:ShopPlot.slot.shop
    a gbo:Slot ;
    gbo:slotName "shop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:shop ;
    gbo:conceptsFrom gbl:ShopPlot.goods .

gbl:ShopPlot.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential false ;
    gbo:needsRole gbr:stall .

gbl:ShopPlot.child.shop-front
    a gbo:ChildRule ;
    gbo:child gbl:ShopFront ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:Sign
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Sign"@en ;
    rdfs:comment "A sign at the door."@en ;
    gbo:moduleId "sign" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Sign.text ;
    gbo:hasSlot gbl:Sign.slot.sign ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:beside ;
        gbo:members "[\"self\",\"parent.door\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:Sign.text
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "text"@en ;
    rdfs:domain gbl:Sign ;
    gbo:fieldName "text" ;
    gbo:fieldType gbo:description .

gbl:Sign.slot.sign
    a gbo:Slot ;
    gbo:slotName "sign" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:sign .

gbl:Slum
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShackCluster
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShackCluster
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clutter gbl:Road gbl:ShackCluster )
        ]
    ] ;
    rdfs:label "Slum"@en ;
    rdfs:comment "Shacks and clutter, outside the walls or at the edge."@en ;
    gbo:moduleId "slum" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Slum.area, gbl:Slum.plots, gbl:Slum.squalor ;
    gbo:hasChildRule gbl:Slum.child.clutter, gbl:Slum.child.road, gbl:Slum.child.shack-cluster ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.5
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "edge" ;
        gbo:weight 0.8
    ], [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight -0.5
    ] ;
    gbo:origin "engine" .

gbl:Slum.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Slum ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[400,2000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Slum.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Slum ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[5,40]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Slum.squalor
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "squalor"@en ;
    rdfs:domain gbl:Slum ;
    gbo:fieldName "squalor" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"poor\""^^rdf:JSON ;
    gbo:allowedValue "poor", "wretched" .

gbl:Slum.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Slum.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:Slum.child.shack-cluster
    a gbo:ChildRule ;
    gbo:child gbl:ShackCluster ;
    gbo:minCount 1 ;
    gbo:maxCount 200 ;
    gbo:weight 1.0 .

gbl:StableYard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Hay
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Trough
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Hay gbl:Trough )
        ]
    ] ;
    rdfs:label "Stable yard"@en ;
    rdfs:comment "Stables with horses, a trough and hay."@en ;
    gbo:moduleId "stable-yard" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:StableYard.size, gbl:StableYard.stalls ;
    gbo:hasSlot gbl:StableYard.slot.horse, gbl:StableYard.slot.stable ;
    gbo:hasChildRule gbl:StableYard.child.hay, gbl:StableYard.child.trough ;
    gbo:origin "engine" .

gbl:StableYard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:StableYard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[6,10],\"w\":[6,10]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:StableYard.stalls
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "stalls"@en ;
    rdfs:domain gbl:StableYard ;
    gbo:fieldName "stalls" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[2,6]"^^rdf:JSON .

gbl:StableYard.slot.horse
    a gbo:Slot ;
    gbo:slotName "horse" ;
    gbo:essential false ;
    gbo:needsRole gbr:animal ;
    gbo:showsConcept gbv:livestock.horse .

gbl:StableYard.slot.stable
    a gbo:Slot ;
    gbo:slotName "stable" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stable .

gbl:StableYard.child.hay
    a gbo:ChildRule ;
    gbo:child gbl:Hay ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.7 .

gbl:StableYard.child.trough
    a gbo:ChildRule ;
    gbo:child gbl:Trough ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.8 .

gbl:Subplace
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:AbstractPart, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Nested place"@en ;
    rdfs:comment "A whole place built inside this one (a castle in a town, a farmland ring): its own Brief, Spec and layout, inside a region the parent solves."@en ;
    gbo:moduleId "subplace" ;
    gbo:level gbo:AbstractPart ;
    gbo:hasField gbl:Subplace.area, gbl:Subplace.buildType ;
    gbo:origin "engine" .

gbl:Subplace.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Subplace ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 16.0 ;
    gbo:defaultValue "[400,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Subplace.buildType
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "buildType"@en ;
    rdfs:domain gbl:Subplace ;
    gbo:fieldName "buildType" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"settlement\""^^rdf:JSON ;
    gbo:vocabulary gbv:build-type .

gbl:TemplePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Civic, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Graveyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Garden gbl:Graveyard )
        ]
    ] ;
    rdfs:label "Temple plot"@en ;
    rdfs:comment "A temple, church or shrine with its graveyard or garden."@en ;
    gbo:moduleId "temple-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:TemplePlot.size, gbl:TemplePlot.faith ;
    gbo:hasSlot gbl:TemplePlot.slot.temple ;
    gbo:hasChildRule gbl:TemplePlot.child.garden, gbl:TemplePlot.child.graveyard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:focus ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.6
    ] ;
    gbo:origin "engine" .

gbl:TemplePlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:TemplePlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 6.0 ;
    gbo:minHeight 6.0 ;
    gbo:maxWidth 50.0 ;
    gbo:maxHeight 50.0 ;
    gbo:defaultValue "{\"h\":[14,24],\"w\":[12,20]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:TemplePlot.faith
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "faith"@en ;
    rdfs:domain gbl:TemplePlot ;
    gbo:fieldName "faith" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old-faith\""^^rdf:JSON ;
    gbo:vocabulary gbv:faith .

gbl:TemplePlot.slot.temple
    a gbo:Slot ;
    gbo:slotName "temple" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:temple .

gbl:TemplePlot.child.garden
    a gbo:ChildRule ;
    gbo:child gbl:Garden ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:TemplePlot.child.graveyard
    a gbo:ChildRule ;
    gbo:child gbl:Graveyard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:TempleWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Graveyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TemplePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TemplePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Graveyard gbl:HousePlot gbl:Road gbl:TemplePlot )
        ]
    ] ;
    rdfs:label "Temple ward"@en ;
    rdfs:comment "A temple with its graveyard and the houses around it."@en ;
    gbo:moduleId "temple-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:TempleWard.area, gbl:TempleWard.plots, gbl:TempleWard.faith, gbl:TempleWard.grandeur ;
    gbo:hasChildRule gbl:TempleWard.child.graveyard, gbl:TempleWard.child.house-plot, gbl:TempleWard.child.road, gbl:TempleWard.child.temple-plot ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 0.3
    ], [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.6
    ] ;
    gbo:origin "engine" .

gbl:TempleWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[600,2500]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:TempleWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[2,15]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:TempleWard.faith
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "faith"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "faith" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old-faith\""^^rdf:JSON ;
    gbo:vocabulary gbv:faith .

gbl:TempleWard.grandeur
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "grandeur"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "grandeur" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"modest\""^^rdf:JSON ;
    gbo:allowedValue "modest", "grand" .

gbl:TempleWard.child.graveyard
    a gbo:ChildRule ;
    gbo:child gbl:Graveyard ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.7 .

gbl:TempleWard.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:weight 0.5 .

gbl:TempleWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:TempleWard.child.temple-plot
    a gbo:ChildRule ;
    gbo:child gbl:TemplePlot ;
    gbo:minCount 1 ;
    gbo:maxCount 4 ;
    gbo:weight 1.0 .

gbl:TerracedRow
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DoorstepSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:DoorstepSet
    ] ;
    rdfs:label "Terraced row"@en ;
    rdfs:comment "A row of joined houses along a street."@en ;
    gbo:moduleId "terraced-row" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:TerracedRow.houses, gbl:TerracedRow.length, gbl:TerracedRow.house-kind ;
    gbo:hasSlot gbl:TerracedRow.slot.house ;
    gbo:hasChildRule gbl:TerracedRow.child.doorstep-set ;
    gbo:constraint "houses * 3 <= length"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.house\",\"self.house\"]"^^rdf:JSON ;
        gbo:weight 3.0 ;
        gbo:arguments "{\"axis\":\"street\"}"^^rdf:JSON
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:TerracedRow.houses
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "houses"@en ;
    rdfs:domain gbl:TerracedRow ;
    gbo:fieldName "houses" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 2.0 ;
    gbo:maxValue 30.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON .

gbl:TerracedRow.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:TerracedRow ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 4.0 ;
    gbo:defaultValue "[9,30]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:TerracedRow.house-kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "house-kind"@en ;
    rdfs:domain gbl:TerracedRow ;
    gbo:fieldName "house-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"townhouse\""^^rdf:JSON ;
    gbo:vocabulary gbv:house-kind .

gbl:TerracedRow.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:house ;
    gbo:conceptsFrom gbl:TerracedRow.house-kind .

gbl:TerracedRow.child.doorstep-set
    a gbo:ChildRule ;
    gbo:child gbl:DoorstepSet ;
    gbo:minCount 0 ;
    gbo:maxCount 30 ;
    gbo:weight 0.6 .

gbl:TownhouseBlock
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
