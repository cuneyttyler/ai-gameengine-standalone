#
# GENERATED from data/places/ by the engine (engine/places/OntologyExport.cpp).
# Don't edit: change the JSON files and regenerate (ontology/README.md).

@prefix gbo:     <https://w3id.org/aige/gbo#> .
@prefix gbl:     <https://w3id.org/aige/gbo/library#> .
@prefix gbb:     <https://w3id.org/aige/gbo/build#> .
@prefix gbv:     <https://w3id.org/aige/gbo/vocab#> .
@prefix gbr:     <https://w3id.org/aige/gbo/role#> .
@prefix gbx:     <https://w3id.org/aige/gbo/relation#> .
@prefix gbd:     <https://w3id.org/aige/gbo/rule#> .
@prefix gbs:     <https://w3id.org/aige/gbo/shapes#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/aige/gbo/library>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aige/gbo/library/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gbo> ;
    dcterms:title "GBO library: modules, vocabularies, roles, relations and rules"@en ;
    dcterms:description "The engine's place library in GBO terms: every module with its fields, slots, child rules, constraints, relations and site preferences; the module classes; the build types with their scale tables; the concept schemes; the asset roles; the spatial relation types; and the design rules with their sources."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

# --- Module classes ---

gbl:BuildingParcel
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Building parcel"@en ;
    rdfs:comment "A parcel whose primary object is a building."@en .

gbl:Civic
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Civic building"@en ;
    rdfs:comment "A temple, guard post or other public building."@en .

gbl:Crossing
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Crossing"@en ;
    rdfs:comment "Carries a path over an obstacle."@en .

gbl:Dwelling
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Dwelling"@en ;
    rdfs:comment "A parcel people live on."@en .

gbl:LinearFeature
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Linear feature"@en ;
    rdfs:comment "Something built along a line of cells: walls, fences, hedges."@en .

gbl:NatureArea
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Nature area"@en ;
    rdfs:comment "A forest, meadow or rock field."@en .

gbl:OpenSpace
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Open space"@en ;
    rdfs:comment "A square or plaza: open ground with a centrepiece."@en .

gbl:PlantedArea
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Planted area"@en ;
    rdfs:comment "Ground given to plants: gardens, beds, fields, orchards, meadows."@en .

gbl:Ward
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Ward"@en ;
    rdfs:comment "A zone of a settlement with its own character."@en .

gbl:WaterBody
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Body of water"@en ;
    rdfs:comment "A river, lake or pond."@en .

gbl:WaterSource
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Water source"@en ;
    rdfs:comment "Where people draw water: a well or fountain."@en .

gbl:Workplace
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Workplace"@en ;
    rdfs:comment "A parcel people work on."@en .

gbl:Yard
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Yard"@en ;
    rdfs:comment "Open ground belonging to a parcel."@en .

# --- Modules ---

gbl:Bench
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Bench"@en ;
    rdfs:comment "A bench."@en ;
    gbo:moduleId "bench" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:Bench.slot.bench ;
    gbo:origin "engine" .

gbl:Bench.slot.bench
    a gbo:Slot ;
    gbo:slotName "bench" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bench .

gbl:Bridge
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Crossing, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Bridge"@en ;
    rdfs:comment "Carries a road over a river where the two cross."@en ;
    gbo:moduleId "bridge" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Bridge.length, gbl:Bridge.width, gbl:Bridge.material ;
    gbo:hasSlot gbl:Bridge.slot.bridge ;
    gbo:requires gbl:WaterBody ;
    gbo:origin "engine" .

gbl:Bridge.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:Bridge ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:maxValue 30.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Bridge.width
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "width"@en ;
    rdfs:domain gbl:Bridge ;
    gbo:fieldName "width" ;
    gbo:fieldType gbo:width ;
    gbo:minValue 1.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "2"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Bridge.material
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "material"@en ;
    rdfs:domain gbl:Bridge ;
    gbo:fieldName "material" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood\""^^rdf:JSON ;
    gbo:vocabulary gbv:material .

gbl:Bridge.slot.bridge
    a gbo:Slot ;
    gbo:slotName "bridge" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bridge ;
    gbo:conceptsFrom gbl:Bridge.material .

gbl:CastleWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Subplace
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Subplace
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Road gbl:Subplace )
        ]
    ] ;
    rdfs:label "Castle ward"@en ;
    rdfs:comment "Holds a castle, built as its own nested place."@en ;
    gbo:moduleId "castle-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:CastleWard.area ;
    gbo:hasChildRule gbl:CastleWard.child.road, gbl:CastleWard.child.subplace ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.9
    ] ;
    gbo:origin "engine" .

gbl:CastleWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CastleWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[1600,10000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CastleWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:CastleWard.child.subplace
    a gbo:ChildRule ;
    gbo:child gbl:Subplace ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Clearing
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:NatureScatter
    ] ;
    rdfs:label "Clearing"@en ;
    rdfs:comment "An open space inside a forest."@en ;
    gbo:moduleId "clearing" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Clearing.size ;
    gbo:hasChildRule gbl:Clearing.child.nature-scatter ;
    gbo:origin "engine" .

gbl:Clearing.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Clearing ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 20.0 ;
    gbo:maxHeight 20.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Clearing.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Clutter
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Dressing, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Clutter"@en ;
    rdfs:comment "Barrels, crates, sacks and carts near doors and walls."@en ;
    gbo:moduleId "clutter" ;
    gbo:level gbo:Dressing ;
    gbo:hasField gbl:Clutter.items, gbl:Clutter.theme ;
    gbo:hasSlot gbl:Clutter.slot.item ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.door\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":1,\"d1\":4}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Clutter.items
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "items"@en ;
    rdfs:domain gbl:Clutter ;
    gbo:fieldName "items" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.02,0.06,0.12,0.2]"^^rdf:JSON .

gbl:Clutter.theme
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "theme"@en ;
    rdfs:domain gbl:Clutter ;
    gbo:fieldName "theme" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"farm\""^^rdf:JSON ;
    gbo:vocabulary gbv:clutter-theme .

gbl:Clutter.slot.item
    a gbo:Slot ;
    gbo:slotName "item" ;
    gbo:essential false ;
    gbo:needsRole gbr:barrel, gbr:cart, gbr:crate, gbr:sack, gbr:tool .

gbl:Commons
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Orchard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pond
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Meadow gbl:NatureScatter gbl:Orchard gbl:Pond gbl:Road )
        ]
    ] ;
    rdfs:label "Commons"@en ;
    rdfs:comment "A green, park or orchard open to all."@en ;
    gbo:moduleId "commons" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Commons.area, gbl:Commons.trees, gbl:Commons.kind ;
    gbo:hasChildRule gbl:Commons.child.meadow, gbl:Commons.child.nature-scatter, gbl:Commons.child.orchard, gbl:Commons.child.pond, gbl:Commons.child.road ;
    gbo:origin "engine" .

gbl:Commons.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Commons ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 50.0 ;
    gbo:defaultValue "[200,2000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Commons.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Commons ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:Commons.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Commons ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"green\""^^rdf:JSON ;
    gbo:allowedValue "green", "park", "orchard" .

gbl:Commons.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.7 .

gbl:Commons.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:Commons.child.orchard
    a gbo:ChildRule ;
    gbo:child gbl:Orchard ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 .

gbl:Commons.child.pond
    a gbo:ChildRule ;
    gbo:child gbl:Pond ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 .

gbl:Commons.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:Courtyard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Courtyard"@en ;
    rdfs:comment "An open courtyard with market clutter."@en ;
    gbo:moduleId "courtyard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Courtyard.size, gbl:Courtyard.surface ;
    gbo:hasSlot gbl:Courtyard.slot.ground ;
    gbo:hasChildRule gbl:Courtyard.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:Courtyard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Courtyard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Courtyard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Courtyard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:Courtyard.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:Courtyard.surface .

gbl:Courtyard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:CraftsmenWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:LumberYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkshopPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkshopPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:HousePlot gbl:LumberYard gbl:Road gbl:WorkshopPlot )
        ]
    ] ;
    rdfs:label "Craftsmen's ward"@en ;
    rdfs:comment "Workshops and their houses, downstream and at the edge."@en ;
    gbo:moduleId "craftsmen-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:CraftsmenWard.area, gbl:CraftsmenWard.plots, gbl:CraftsmenWard.trades, gbl:CraftsmenWard.wealth ;
    gbo:hasChildRule gbl:CraftsmenWard.child.house-plot, gbl:CraftsmenWard.child.lumber-yard, gbl:CraftsmenWard.child.road, gbl:CraftsmenWard.child.workshop-plot ;
    gbo:constraint "count(children(workshop-plot)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.patrician-ward\"]"^^rdf:JSON ;
        gbo:weight 1.5 ;
        gbo:arguments "{\"d\":20}"^^rdf:JSON
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "downstream" ;
        gbo:weight 0.7
    ], [
        a gbo:SitePreference ;
        gbo:criterion "edge" ;
        gbo:weight 0.4
    ] ;
    gbo:origin "engine" .

gbl:CraftsmenWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[800,3000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CraftsmenWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:CraftsmenWard.trades
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "trades"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "trades" ;
    gbo:fieldType gbo:enumSet ;
    gbo:defaultValue "[\"smith\",\"carpenter\"]"^^rdf:JSON ;
    gbo:vocabulary gbv:trade ;
    gbo:askedInConfirmation true .

gbl:CraftsmenWard.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth .

gbl:CraftsmenWard.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 400 ;
    gbo:weight 0.5 .

gbl:CraftsmenWard.child.lumber-yard
    a gbo:ChildRule ;
    gbo:child gbl:LumberYard ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:CraftsmenWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

