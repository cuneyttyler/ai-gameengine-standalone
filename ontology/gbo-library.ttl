gbl:Dungeon
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DungeonLevel
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:DungeonLevel
    ] ;
    rdfs:label "Dungeon"@en ;
    rdfs:comment "A dungeon or cave: rooms on one or more levels, locks and their keys, encounters and loot."@en ;
    gbo:moduleId "dungeon" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:Dungeon.levels, gbl:Dungeon.locks, gbl:Dungeon.loops, gbl:Dungeon.rooms, gbl:Dungeon.secrets, gbl:Dungeon.boss, gbl:Dungeon.condition, gbl:Dungeon.difficulty-curve, gbl:Dungeon.goal, gbl:Dungeon.notes, gbl:Dungeon.theme ;
    gbo:hasChildRule gbl:Dungeon.child.dungeon-level ;
    gbo:constraint "within(self.rooms, count(descendants(class: Room)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Dungeon.levels
    a gbo:QuantityField, owl:DatatypeProperty ;
