gbl:City
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:District
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Downtown
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Downtown
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ResidentialDistrict
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "12"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ResidentialDistrict
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:District gbl:Downtown gbl:Ground gbl:Lake gbl:ResidentialDistrict gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "City"@en ;
    rdfs:comment "A modern city, or a section of one: districts on a grid of avenues and streets with sidewalks."@en ;
    gbo:moduleId "city" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:City.area, gbl:City.block-size, gbl:City.buildings, gbl:City.arrangement, gbl:City.block-fill, gbl:City.block-use, gbl:City.building-cover, gbl:City.building-shape, gbl:City.condition, gbl:City.coverage, gbl:City.era, gbl:City.frontage, gbl:City.layout, gbl:City.lot-layout, gbl:City.notes, gbl:City.open-space, gbl:City.relief, gbl:City.site-fit, gbl:City.street-grid, gbl:City.style, gbl:City.woods, gbl:City.zone-shape ;
    gbo:hasSlot gbl:City.slot.car ;
    gbo:hasChildRule gbl:City.child.District, gbl:City.child.downtown, gbl:City.child.ground, gbl:City.child.lake, gbl:City.child.residential-district, gbl:City.child.river, gbl:City.child.road ;
    gbo:origin "engine" .

gbl:City.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[6400,40000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:City.block-size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "block-size"@en ;
    rdfs:comment "A block of the shared street grid, street to street"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "block-size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 8.0 ;
    gbo:minHeight 8.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[16,20],\"w\":[16,20]}"^^rdf:JSON ;
    gbo:unit "cells" ;
    gbo:askedInConfirmation true .

gbl:City.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 5000.0 ;
    gbo:defaultValue "[40,200]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:City.arrangement
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "arrangement"@en ;
    rdfs:comment "How the small things are set out (lamps, trees, benches, cars, bicycles, bushes): scattered as they come, or ordered: evenly spaced along edges, in lines and mirrored pairs"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "arrangement" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"ordered\""^^rdf:JSON ;
    gbo:vocabulary gbv:arrangement ;
    gbo:askedInConfirmation true .

gbl:City.block-fill
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "block-fill"@en ;
    rdfs:comment "Lots along the streets with open land behind, or lots back to back so the blocks are built through"@en ;
    rdfs:domain gbl:City ;
    gbo:fieldName "block-fill" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"full\""^^rdf:JSON ;
    gbo:vocabulary gbv:block-fill ;
    gbo:askedInConfirmation true .

gbl:City.block-use
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "block-use"@en ;
