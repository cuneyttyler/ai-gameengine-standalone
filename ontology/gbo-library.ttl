    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Nave ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[7,10]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Nave.surface
