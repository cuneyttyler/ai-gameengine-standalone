    gbo:fieldName "biome" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"temperate\""^^rdf:JSON ;
    gbo:vocabulary gbv:biome .

gbl:Wilds.slot.bush
    a gbo:Slot ;
    gbo:slotName "bush" ;
    gbo:essential false ;
    gbo:needsRole gbr:bush .

gbl:Wilds.slot.rock
    a gbo:Slot ;
    gbo:slotName "rock" ;
    gbo:essential false ;
    gbo:needsRole gbr:rock .

gbl:Wilds.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tree .

gbl:Wilds.child.PointOfInterest
    a gbo:ChildRule ;
    gbo:child gbl:PointOfInterest ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 1.0 .

gbl:Wilds.child.clearing
    a gbo:ChildRule ;
    gbo:child gbl:Clearing ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.4 .

gbl:Wilds.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:WorkSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Workbench"@en ;
    rdfs:comment "A workbench with its tools and a stool."@en ;
    gbo:moduleId "work-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasSlot gbl:WorkSet.slot.stool, gbl:WorkSet.slot.tools, gbl:WorkSet.slot.workbench ;
    gbo:origin "engine" .

gbl:WorkSet.slot.stool
    a gbo:Slot ;
    gbo:slotName "stool" ;
    gbo:essential false ;
    gbo:needsRole gbr:stool .

gbl:WorkSet.slot.tools
    a gbo:Slot ;
    gbo:slotName "tools" ;
    gbo:essential false ;
    gbo:needsRole gbr:tool .

gbl:WorkSet.slot.workbench
    a gbo:Slot ;
    gbo:slotName "workbench" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:workbench .

gbl:WorkYard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Work yard"@en ;
    rdfs:comment "An open work yard with workshop clutter."@en ;
    gbo:moduleId "work-yard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:WorkYard.size, gbl:WorkYard.surface ;
    gbo:hasSlot gbl:WorkYard.slot.ground ;
    gbo:hasChildRule gbl:WorkYard.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:WorkYard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkYard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkYard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:WorkYard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:WorkYard.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:WorkYard.surface .

gbl:WorkYard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clutter gbl:WorkYard )
        ]
    ] ;
    rdfs:label "Workshop plot"@en ;
    rdfs:comment "A craftsman's workshop, maybe with a house, and a work yard."@en ;
    gbo:moduleId "workshop-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:WorkshopPlot.size, gbl:WorkshopPlot.trade ;
    gbo:hasSlot gbl:WorkshopPlot.slot.house, gbl:WorkshopPlot.slot.workshop ;
    gbo:hasChildRule gbl:WorkshopPlot.child.clutter, gbl:WorkshopPlot.child.work-yard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:WorkshopPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkshopPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 20.0 ;
    gbo:maxHeight 24.0 ;
    gbo:defaultValue "{\"h\":[7,11],\"w\":[6,9]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkshopPlot.trade
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "trade"@en ;
    rdfs:domain gbl:WorkshopPlot ;
    gbo:fieldName "trade" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"smith\""^^rdf:JSON ;
    gbo:vocabulary gbv:trade ;
    gbo:askedInConfirmation true .

gbl:WorkshopPlot.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential false ;
    gbo:needsRole gbr:house .

gbl:WorkshopPlot.slot.workshop
    a gbo:Slot ;
    gbo:slotName "workshop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:workshop ;
    gbo:conceptsFrom gbl:WorkshopPlot.trade .

gbl:WorkshopPlot.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopPlot.child.work-yard
    a gbo:ChildRule ;
    gbo:child gbl:WorkYard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StorageSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:RoomLights gbl:StorageSet gbl:WallDecor gbl:WorkSet )
        ]
    ] ;
    rdfs:label "Workshop"@en ;
    rdfs:comment "A workbench and its tools."@en ;
    gbo:moduleId "workshop-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:WorkshopRoom.size, gbl:WorkshopRoom.surface ;
    gbo:hasSlot gbl:WorkshopRoom.slot.floor ;
    gbo:hasChildRule gbl:WorkshopRoom.child.room-lights, gbl:WorkshopRoom.child.storage-set, gbl:WorkshopRoom.child.wall-decor, gbl:WorkshopRoom.child.work-set ;
    gbo:origin "engine" .

gbl:WorkshopRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkshopRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[4,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkshopRoom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:WorkshopRoom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:WorkshopRoom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:WorkshopRoom.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:WorkshopRoom.child.storage-set
    a gbo:ChildRule ;
    gbo:child gbl:StorageSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 .

gbl:WorkshopRoom.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:WorkshopRoom.child.work-set
    a gbo:ChildRule ;
    gbo:child gbl:WorkSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Yard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
