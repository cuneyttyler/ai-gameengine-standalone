    gbo:hasSlot gbl:SecretRoom.slot.chest ;
    gbo:hasChildRule gbl:SecretRoom.child.ambience, gbl:SecretRoom.child.loot-cache ;
    gbo:origin "engine" .

gbl:SecretRoom.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
