gbl:InnPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Sign
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StableYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Yard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Sign gbl:StableYard gbl:Yard )
        ]
    ] ;
    rdfs:label "Inn plot"@en ;
    rdfs:comment "An inn with its stable and yard, and a sign at the door."@en ;
    gbo:moduleId "inn-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:InnPlot.rooms, gbl:InnPlot.size, gbl:InnPlot.standing ;
    gbo:hasSlot gbl:InnPlot.slot.inn, gbl:InnPlot.slot.stable ;
    gbo:hasChildRule gbl:InnPlot.child.sign, gbl:InnPlot.child.stable-yard, gbl:InnPlot.child.yard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.8
    ] ;
    gbo:origin "engine" .

