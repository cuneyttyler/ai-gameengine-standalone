    rdfs:domain gbl:MarketWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[6,20]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:MarketWard.bustle
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "bustle"@en ;
    rdfs:domain gbl:MarketWard ;
    gbo:fieldName "bustle" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"busy\""^^rdf:JSON ;
    gbo:allowedValue "quiet", "busy" .

gbl:MarketWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:MarketWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:MarketWard.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:MarketWard ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth .

gbl:MarketWard.child.inn-plot
    a gbo:ChildRule ;
    gbo:child gbl:InnPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 0.6 .

gbl:MarketWard.child.market-square
    a gbo:ChildRule ;
    gbo:child gbl:MarketSquare ;
    gbo:minCount 1 ;
    gbo:maxCount 2 ;
    gbo:weight 1.0 .

gbl:MarketWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:MarketWard.child.shop-plot
    a gbo:ChildRule ;
    gbo:child gbl:ShopPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:weight 0.8 .

gbl:MarketWard.child.well-plaza
    a gbo:ChildRule ;
    gbo:child gbl:WellPlaza ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.5 .

