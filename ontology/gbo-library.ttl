    gbo:hasSlot gbl:BathroomSet.slot.shower, gbl:BathroomSet.slot.sink, gbl:BathroomSet.slot.toilet ;
    gbo:origin "engine" .

gbl:BathroomSet.slot.shower
    a gbo:Slot ;
    gbo:slotName "shower" ;
    gbo:essential false ;
    gbo:needsRole gbr:shower .

gbl:BathroomSet.slot.sink
    a gbo:Slot ;
    gbo:slotName "sink" ;
    gbo:essential false ;
    gbo:needsRole gbr:sink .

gbl:BathroomSet.slot.toilet
    a gbo:Slot ;
    gbo:slotName "toilet" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:toilet .

gbl:BedSet
