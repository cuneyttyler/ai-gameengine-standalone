    gbo:fieldType gbo:size ;
    gbo:minWidth 6.0 ;
    gbo:minHeight 6.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[10,16],\"w\":[10,16]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:InnPlot.standing
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "standing"@en ;
    rdfs:domain gbl:InnPlot ;
    gbo:fieldName "standing" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"humble\""^^rdf:JSON ;
    gbo:allowedValue "humble", "fine" .

gbl:InnPlot.slot.inn
    a gbo:Slot ;
    gbo:slotName "inn" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:inn .

gbl:InnPlot.slot.stable
    a gbo:Slot ;
    gbo:slotName "stable" ;
    gbo:essential false ;
    gbo:needsRole gbr:stable .

gbl:InnPlot.child.sign
    a gbo:ChildRule ;
    gbo:child gbl:Sign ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:InnPlot.child.stable-yard
