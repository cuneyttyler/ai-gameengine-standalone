gbl:GuardRoom.child.loot-cache
    a gbo:ChildRule ;
    gbo:child gbl:LootCache ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.2 .

gbl:GuestRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
