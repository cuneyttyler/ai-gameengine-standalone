gbl:ManorPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Courtyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FormalGarden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Fountain
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Courtyard gbl:FormalGarden gbl:Fountain )
        ]
    ] ;
    rdfs:label "Manor plot"@en ;
    rdfs:comment "A manor behind a wall, with a formal garden, courtyard and fountain."@en ;
    gbo:moduleId "manor-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
