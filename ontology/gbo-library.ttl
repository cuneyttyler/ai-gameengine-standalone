gbl:Road
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Network, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bridge
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Bridge
    ] ;
    rdfs:label "Road"@en ;
    rdfs:comment "A road, street, lane or trail; connects anchors and reuses roads already there."@en ;
    gbo:moduleId "road" ;
    gbo:level gbo:Network ;
    gbo:hasField gbl:Road.length, gbl:Road.width, gbl:Road.class, gbl:Road.surface ;
    gbo:hasSlot gbl:Road.slot.terrain ;
    gbo:hasChildRule gbl:Road.child.bridge ;
    gbo:constraint "class == 'main' implies width >= 2"^^gbo:Expression, "class == 'trail' implies width <= 2"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Road.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[10,300]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Road.width
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "width"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "width" ;
    gbo:fieldType gbo:width ;
    gbo:minValue 1.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "2"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Road.class
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "class"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "class" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"street\""^^rdf:JSON ;
    gbo:vocabulary gbv:road-class ;
    gbo:askedInConfirmation true .

gbl:Road.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface ;
    gbo:askedInConfirmation true .

gbl:Road.slot.terrain
    a gbo:Slot ;
    gbo:slotName "terrain" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:road-terrain ;
    gbo:conceptsFrom gbl:Road.surface .

gbl:Road.child.bridge
    a gbo:ChildRule ;
    gbo:child gbl:Bridge ;
    gbo:minCount 0 ;
    gbo:maxCount 10 ;
    gbo:weight 0.3 .

