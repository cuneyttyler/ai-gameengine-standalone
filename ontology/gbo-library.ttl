gbl:Nave.child.altar-set
    a gbo:ChildRule ;
    gbo:child gbl:AltarSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Nave.child.pews
    a gbo:ChildRule ;
