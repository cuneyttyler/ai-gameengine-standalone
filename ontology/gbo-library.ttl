gbl:BiomeZone.biome
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "biome"@en ;
    rdfs:domain gbl:BiomeZone ;
    gbo:fieldName "biome" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"forest\""^^rdf:JSON ;
    gbo:vocabulary gbv:biome-kind ;
    gbo:askedInConfirmation true .

gbl:BiomeZone.slot.bush
    a gbo:Slot ;
