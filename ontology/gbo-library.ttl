gbl:Lake
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, gbl:WaterBody, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Dock
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Dock
    ] ;
    rdfs:label "Lake"@en ;
    rdfs:comment "A lake or large pond with a shore."@en ;
    gbo:moduleId "lake" ;
    gbo:level gbo:Site ;
    gbo:hasField gbl:Lake.area, gbl:Lake.shore ;
    gbo:hasSlot gbl:Lake.slot.shore, gbl:Lake.slot.water ;
    gbo:hasChildRule gbl:Lake.child.dock ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.road\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":2}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Lake.area
    a gbo:QuantityField, owl:DatatypeProperty ;
