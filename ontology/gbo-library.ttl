gbl:Farmstead
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Farmyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmyard gbl:FenceLine gbl:Field gbl:Garden gbl:Pasture )
        ]
    ] ;
    rdfs:label "Farmstead"@en ;
    rdfs:comment "A farmhouse and barn with a farmyard, fields, pasture and garden."@en ;
    gbo:moduleId "farmstead" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Farmstead.fields, gbl:Farmstead.size, gbl:Farmstead.farm-kind ;
    gbo:hasSlot gbl:Farmstead.slot.barn, gbl:Farmstead.slot.farmhouse, gbl:Farmstead.slot.shed ;
    gbo:hasChildRule gbl:Farmstead.child.farmyard, gbl:Farmstead.child.fence-line, gbl:Farmstead.child.field, gbl:Farmstead.child.garden, gbl:Farmstead.child.pasture ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self.barn\",\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"d0\":1,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "flat" ;
        gbo:weight 0.5
    ] ;
    gbo:origin "engine" .

