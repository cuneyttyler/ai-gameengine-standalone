gbl:CommercialDistrict
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:GasStationPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MallPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "12"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ParkingLot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RestaurantPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "80"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RetailPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SupermarketPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:GasStationPlot gbl:MallPlot gbl:ParkingLot gbl:RestaurantPlot gbl:RetailPlot gbl:Road gbl:SupermarketPlot )
        ]
    ] ;
    rdfs:label "Commercial district"@en ;
    rdfs:comment "Shops, a supermarket or mall, restaurants and a gas station, with parking."@en ;
    gbo:moduleId "commercial-district" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:CommercialDistrict.area, gbl:CommercialDistrict.footprint-density, gbl:CommercialDistrict.plots, gbl:CommercialDistrict.density, gbl:CommercialDistrict.street-style, gbl:CommercialDistrict.wealth ;
    gbo:hasSlot gbl:CommercialDistrict.slot.car ;
    gbo:hasChildRule gbl:CommercialDistrict.child.gas-station-plot, gbl:CommercialDistrict.child.mall-plot, gbl:CommercialDistrict.child.parking-lot, gbl:CommercialDistrict.child.restaurant-plot, gbl:CommercialDistrict.child.retail-plot, gbl:CommercialDistrict.child.road, gbl:CommercialDistrict.child.supermarket-plot ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:CommercialDistrict.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CommercialDistrict ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CommercialDistrict.footprint-density
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "footprint-density"@en ;
    rdfs:comment "built cells / district cells"@en ;
    rdfs:domain gbl:CommercialDistrict ;
    gbo:fieldName "footprint-density" ;
    gbo:fieldType gbo:ratio ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1.0 ;
    gbo:defaultValue "[0.35,0.7]"^^rdf:JSON .

gbl:CommercialDistrict.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:CommercialDistrict ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[8,30]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:CommercialDistrict.density
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "density"@en ;
    rdfs:domain gbl:CommercialDistrict ;
    gbo:fieldName "density" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"medium\""^^rdf:JSON ;
    gbo:allowedValue "sparse", "medium", "dense" ;
    gbo:askedInConfirmation true .

gbl:CommercialDistrict.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this district's own street pattern; unset, the city's"@en ;
