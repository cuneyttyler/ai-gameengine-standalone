gbl:River
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, gbl:WaterBody, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bridge
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Bridge
    ] ;
    rdfs:label "River"@en ;
    rdfs:comment "A river crossing the place, with banks and crossings."@en ;
    gbo:moduleId "river" ;
    gbo:level gbo:Site ;
    gbo:hasField gbl:River.bends, gbl:River.crossings, gbl:River.length, gbl:River.width, gbl:River.banks, gbl:River.flow ;
    gbo:hasSlot gbl:River.slot.bank, gbl:River.slot.reeds, gbl:River.slot.water ;
    gbo:hasChildRule gbl:River.child.bridge ;
    gbo:constraint "crossings <= bends + 4"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
