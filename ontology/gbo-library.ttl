    gbo:vocabulary gbv:material .

gbl:FenceLine.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fence-piece-set ;
    gbo:conceptsFrom gbl:FenceLine.material .

gbl:Field
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Field"@en ;
    rdfs:comment "A field of one crop in rows."@en ;
    gbo:moduleId "field" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Field.rows, gbl:Field.size, gbl:Field.crop, gbl:Field.season ;
    gbo:hasSlot gbl:Field.slot.crop, gbl:Field.slot.tilled ;
    gbo:constraint "rows <= size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.road\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Field.rows
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rows"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "rows" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[4,12]"^^rdf:JSON .

gbl:Field.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 80.0 ;
    gbo:maxHeight 80.0 ;
    gbo:defaultValue "{\"h\":[8,20],\"w\":[10,24]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Field.crop
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crop"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "crop" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wheat\""^^rdf:JSON ;
    gbo:allowedValue "wheat", "barley", "vegetables", "flax" .

gbl:Field.season
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "season"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "season" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"summer\""^^rdf:JSON ;
    gbo:allowedValue "spring", "summer", "harvest" .

gbl:Field.slot.crop
    a gbo:Slot ;
    gbo:slotName "crop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:crop ;
    gbo:conceptsFrom gbl:Field.crop .

gbl:Field.slot.tilled
    a gbo:Slot ;
    gbo:slotName "tilled" ;
    gbo:essential true ;
    gbo:needsRole gbr:tilled-terrain .

gbl:FishMarket
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Fish market"@en ;
    rdfs:comment "Fish stalls by the water."@en ;
    gbo:moduleId "fish-market" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:FishMarket.stalls ;
    gbo:hasSlot gbl:FishMarket.slot.stall ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.dock\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:FishMarket.stalls
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "stalls"@en ;
    rdfs:domain gbl:FishMarket ;
    gbo:fieldName "stalls" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[2,6]"^^rdf:JSON .

gbl:FishMarket.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stall ;
    gbo:showsConcept gbv:goods.fish .

gbl:Forest
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clearing gbl:NatureScatter )
        ]
    ] ;
    rdfs:label "Forest"@en ;
    rdfs:comment "Woodland, denser in the middle than at its edges."@en ;
    gbo:moduleId "forest" ;
    gbo:level gbo:Zone ;
    gbo:hasField gbl:Forest.area, gbl:Forest.clearings, gbl:Forest.trees, gbl:Forest.age, gbl:Forest.kind ;
    gbo:hasSlot gbl:Forest.slot.bush, gbl:Forest.slot.log, gbl:Forest.slot.mushroom, gbl:Forest.slot.tree ;
    gbo:hasChildRule gbl:Forest.child.clearing, gbl:Forest.child.nature-scatter ;
    gbo:origin "engine" .

gbl:Forest.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 20.0 ;
    gbo:defaultValue "[200,2000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Forest.clearings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "clearings"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "clearings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[0,2]"^^rdf:JSON .

gbl:Forest.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.08,0.2,0.35,0.55]"^^rdf:JSON .

gbl:Forest.age
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "age"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "age" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old\""^^rdf:JSON ;
    gbo:allowedValue "young", "old" .

gbl:Forest.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"mixed\""^^rdf:JSON ;
    gbo:allowedValue "deciduous", "conifer", "mixed" .

gbl:Forest.slot.bush
    a gbo:Slot ;
    gbo:slotName "bush" ;
    gbo:essential false ;
    gbo:needsRole gbr:bush .

gbl:Forest.slot.log
    a gbo:Slot ;
    gbo:slotName "log" ;
    gbo:essential false ;
    gbo:needsRole gbr:log .

gbl:Forest.slot.mushroom
    a gbo:Slot ;
    gbo:slotName "mushroom" ;
    gbo:essential false ;
    gbo:needsRole gbr:mushroom .

gbl:Forest.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tree .

gbl:Forest.child.clearing
    a gbo:ChildRule ;
    gbo:child gbl:Clearing ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:countField gbl:Forest.clearings ;
    gbo:weight 0.5 .

gbl:Forest.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:FormalGarden
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:HedgeLine
    ] ;
    rdfs:label "Formal garden"@en ;
    rdfs:comment "Hedges and flowers laid out symmetrically, perhaps around a centrepiece."@en ;
    gbo:moduleId "formal-garden" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:FormalGarden.flowers, gbl:FormalGarden.hedges, gbl:FormalGarden.size, gbl:FormalGarden.centre, gbl:FormalGarden.flower-mix, gbl:FormalGarden.symmetry ;
    gbo:hasSlot gbl:FormalGarden.slot.flower, gbl:FormalGarden.slot.hedge, gbl:FormalGarden.slot.statue ;
    gbo:hasChildRule gbl:FormalGarden.child.hedge-line ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:symmetric ;
        gbo:members "[\"self.hedge\",\"self.flower\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"axis\":\"long\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:FormalGarden.flowers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "flowers"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "flowers" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:FormalGarden.hedges
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "hedges"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "hedges" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[2,8]"^^rdf:JSON .

gbl:FormalGarden.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[8,14],\"w\":[8,14]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FormalGarden.centre
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "centre"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "centre" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"statue\""^^rdf:JSON ;
    gbo:allowedValue "fountain", "statue", "none" .

gbl:FormalGarden.flower-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "flower-mix"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "flower-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"lavender\":0.4,\"rose\":0.6}"^^rdf:JSON ;
    gbo:vocabulary gbv:flower-kind .

gbl:FormalGarden.symmetry
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "symmetry"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "symmetry" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "true"^^rdf:JSON .

gbl:FormalGarden.slot.flower
    a gbo:Slot ;
    gbo:slotName "flower" ;
    gbo:essential true ;
    gbo:needsRole gbr:flower ;
    gbo:conceptsFrom gbl:FormalGarden.flower-mix .

gbl:FormalGarden.slot.hedge
    a gbo:Slot ;
    gbo:slotName "hedge" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:hedge .

gbl:FormalGarden.slot.statue
    a gbo:Slot ;
    gbo:slotName "statue" ;
    gbo:essential false ;
    gbo:needsRole gbr:fountain, gbr:statue ;
    gbo:when "centre != 'none'"^^gbo:Expression .

gbl:FormalGarden.child.hedge-line
    a gbo:ChildRule ;
    gbo:child gbl:HedgeLine ;
    gbo:minCount 0 ;
    gbo:maxCount 40 ;
    gbo:countField gbl:FormalGarden.hedges ;
    gbo:weight 1.0 .

gbl:Fountain
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:WaterSource, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Fountain"@en ;
    rdfs:comment "A fountain."@en ;
    gbo:moduleId "fountain" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:Fountain.slot.fountain ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:Fountain.slot.fountain
    a gbo:Slot ;
    gbo:slotName "fountain" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fountain .

gbl:FountainSquare
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:OpenSpace, gbl:WaterSource, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FormalGarden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:FormalGarden
    ] ;
    rdfs:label "Fountain square"@en ;
    rdfs:comment "A square with a fountain and a formal garden."@en ;
    gbo:moduleId "fountain-square" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:FountainSquare.size ;
    gbo:hasSlot gbl:FountainSquare.slot.fountain ;
    gbo:hasChildRule gbl:FountainSquare.child.formal-garden ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:FountainSquare.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FountainSquare ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 5.0 ;
    gbo:minHeight 5.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[8,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FountainSquare.slot.fountain
    a gbo:Slot ;
    gbo:slotName "fountain" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fountain .

gbl:FountainSquare.child.formal-garden
    a gbo:ChildRule ;
    gbo:child gbl:FormalGarden ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.6 .

gbl:FrontYard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DoorstepSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:DoorstepSet
    ] ;
    rdfs:label "Front yard"@en ;
    rdfs:comment "The strip between the house and the street."@en ;
    gbo:moduleId "front-yard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:FrontYard.depth, gbl:FrontYard.surface ;
    gbo:hasSlot gbl:FrontYard.slot.path ;
    gbo:hasChildRule gbl:FrontYard.child.doorstep-set ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-front-of ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:FrontYard.depth
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "depth"@en ;
    rdfs:domain gbl:FrontYard ;
    gbo:fieldName "depth" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FrontYard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:FrontYard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:FrontYard.slot.path
    a gbo:Slot ;
    gbo:slotName "path" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:FrontYard.surface .

gbl:FrontYard.child.doorstep-set
    a gbo:ChildRule ;
    gbo:child gbl:DoorstepSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:Garden
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FenceLine gbl:VegetableBed )
        ]
    ] ;
    rdfs:label "Garden"@en ;
    rdfs:comment "A vegetable, flower or herb garden behind the house, maybe fenced."@en ;
    gbo:moduleId "garden" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Garden.beds, gbl:Garden.flowers, gbl:Garden.size, gbl:Garden.crop-mix, gbl:Garden.fenced, gbl:Garden.flower-mix, gbl:Garden.kind, gbl:Garden.path ;
    gbo:hasSlot gbl:Garden.slot.bed, gbl:Garden.slot.extra, gbl:Garden.slot.fence, gbl:Garden.slot.plant ;
    gbo:hasChildRule gbl:Garden.child.fence-line, gbl:Garden.child.vegetable-bed ;
    gbo:constraint "size.w * size.h >= 4"^^gbo:Expression, "beds * 2 <= size.w * size.h"^^gbo:Expression, "fenced implies asset(fence) != 'missing'"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.primary.back\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":2}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Garden.beds
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "beds"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "beds" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "[1,3]"^^rdf:JSON .

gbl:Garden.flowers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "flowers"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "flowers" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:Garden.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 12.0 ;
    gbo:maxHeight 10.0 ;
    gbo:defaultValue "{\"h\":[2,4],\"w\":[3,5]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Garden.crop-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crop-mix"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "crop-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:vocabulary gbv:crop-kind ;
    gbo:when "kind in [vegetable, mixed]"^^gbo:Expression ;
    gbo:askedInConfirmation true .

gbl:Garden.fenced
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fenced"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "fenced" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "true"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Garden.flower-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "flower-mix"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "flower-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:vocabulary gbv:flower-kind ;
    gbo:when "kind in [flower, mixed]"^^gbo:Expression ;
    gbo:askedInConfirmation true .

gbl:Garden.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"vegetable\""^^rdf:JSON ;
    gbo:allowedValue "vegetable", "flower", "herb", "mixed" ;
    gbo:askedInConfirmation true .

gbl:Garden.path
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "path"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "path" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:allowedValue "none", "dirt", "gravel", "stone" .

gbl:Garden.slot.bed
    a gbo:Slot ;
    gbo:slotName "bed" ;
    gbo:essential false ;
    gbo:needsRole gbr:garden-bed .

gbl:Garden.slot.extra
    a gbo:Slot ;
    gbo:slotName "extra" ;
    gbo:essential false ;
    gbo:needsRole gbr:garden-prop .

gbl:Garden.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential false ;
    gbo:needsRole gbr:fence-piece-set ;
    gbo:when "fenced"^^gbo:Expression .

gbl:Garden.slot.plant
    a gbo:Slot ;
    gbo:slotName "plant" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:crop, gbr:flower, gbr:herb ;
    gbo:conceptsFrom gbl:Garden.crop-mix, gbl:Garden.flower-mix .

gbl:Garden.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 ;
    gbo:when "fenced"^^gbo:Expression .

gbl:Garden.child.vegetable-bed
    a gbo:ChildRule ;
    gbo:child gbl:VegetableBed ;
    gbo:minCount 0 ;
    gbo:maxCount 12 ;
    gbo:countField gbl:Garden.beds ;
    gbo:weight 1.0 ;
    gbo:when "kind in [vegetable, mixed]"^^gbo:Expression .

gbl:GateWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:GuardPost
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:InnPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MarketStalls
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StableYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:GuardPost gbl:InnPlot gbl:MarketStalls gbl:Road gbl:StableYard )
        ]
    ] ;
    rdfs:label "Gate ward"@en ;
    rdfs:comment "Inns, stables and a guard post at a gate."@en ;
    gbo:moduleId "gate-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:GateWard.area, gbl:GateWard.plots, gbl:GateWard.traffic ;
    gbo:hasChildRule gbl:GateWard.child.guard-post, gbl:GateWard.child.inn-plot, gbl:GateWard.child.market-stalls, gbl:GateWard.child.road, gbl:GateWard.child.stable-yard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.wall.gate\"]"^^rdf:JSON ;
        gbo:weight 3.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:requires gbl:Wall ;
    gbo:origin "engine" .

gbl:GateWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:GateWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[400,1500]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:GateWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:GateWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[3,12]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:GateWard.traffic
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "traffic"@en ;
    rdfs:domain gbl:GateWard ;
    gbo:fieldName "traffic" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"busy\""^^rdf:JSON ;
    gbo:allowedValue "quiet", "busy" .

gbl:GateWard.child.guard-post
    a gbo:ChildRule ;
    gbo:child gbl:GuardPost ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.8 .

gbl:GateWard.child.inn-plot
    a gbo:ChildRule ;
    gbo:child gbl:InnPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.8 .

gbl:GateWard.child.market-stalls
    a gbo:ChildRule ;
    gbo:child gbl:MarketStalls ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.4 .

gbl:GateWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:GateWard.child.stable-yard
    a gbo:ChildRule ;
    gbo:child gbl:StableYard ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.6 .

gbl:Graveyard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FenceLine gbl:NatureScatter )
        ]
    ] ;
    rdfs:label "Graveyard"@en ;
    rdfs:comment "Graves and headstones, fenced, with a few trees."@en ;
    gbo:moduleId "graveyard" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Graveyard.graves, gbl:Graveyard.size, gbl:Graveyard.age, gbl:Graveyard.fenced ;
    gbo:hasSlot gbl:Graveyard.slot.crypt, gbl:Graveyard.slot.grave, gbl:Graveyard.slot.headstone ;
    gbo:hasChildRule gbl:Graveyard.child.fence-line, gbl:Graveyard.child.nature-scatter ;
    gbo:constraint "graves * 2 <= size.w * size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 1.5
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.grave\",\"self.grave\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"axis\":\"x\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Graveyard.graves
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "graves"@en ;
    rdfs:domain gbl:Graveyard ;
    gbo:fieldName "graves" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 400.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON .

gbl:Graveyard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Graveyard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 50.0 ;
    gbo:maxHeight 50.0 ;
    gbo:defaultValue "{\"h\":[8,14],\"w\":[8,14]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Graveyard.age
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "age"@en ;
    rdfs:domain gbl:Graveyard ;
    gbo:fieldName "age" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old\""^^rdf:JSON ;
    gbo:allowedValue "fresh", "old" .

gbl:Graveyard.fenced
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fenced"@en ;
    rdfs:domain gbl:Graveyard ;
    gbo:fieldName "fenced" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "true"^^rdf:JSON .

gbl:Graveyard.slot.crypt
    a gbo:Slot ;
    gbo:slotName "crypt" ;
    gbo:essential false ;
    gbo:needsRole gbr:crypt .

gbl:Graveyard.slot.grave
    a gbo:Slot ;
    gbo:slotName "grave" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:grave .

gbl:Graveyard.slot.headstone
    a gbo:Slot ;
    gbo:slotName "headstone" ;
    gbo:essential false ;
    gbo:needsRole gbr:headstone .

gbl:Graveyard.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 ;
    gbo:when "fenced"^^gbo:Expression .

gbl:Graveyard.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Ground
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Ground"@en ;
    rdfs:comment "The base terrain under everything else."@en ;
    gbo:moduleId "ground" ;
    gbo:level gbo:Site ;
    gbo:hasField gbl:Ground.area, gbl:Ground.terrain, gbl:Ground.variation ;
    gbo:hasSlot gbl:Ground.slot.tile, gbl:Ground.slot.variant ;
    gbo:origin "engine" .

gbl:Ground.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Ground ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[400,400]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Ground.terrain
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "terrain"@en ;
    rdfs:domain gbl:Ground ;
    gbo:fieldName "terrain" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"grass\""^^rdf:JSON ;
    gbo:vocabulary gbv:terrain-kind ;
    gbo:askedInConfirmation true .

gbl:Ground.variation
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "variation"@en ;
    rdfs:domain gbl:Ground ;
    gbo:fieldName "variation" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"low\""^^rdf:JSON ;
    gbo:allowedValue "none", "low", "high" .

gbl:Ground.slot.tile
    a gbo:Slot ;
    gbo:slotName "tile" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:ground-tile ;
    gbo:conceptsFrom gbl:Ground.terrain .

gbl:Ground.slot.variant
    a gbo:Slot ;
    gbo:slotName "variant" ;
    gbo:essential false ;
    gbo:needsRole gbr:ground-tile .

gbl:GroundDecals
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Dressing, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Ground decals"@en ;
    rdfs:comment "Puddles, dirt, leaves and flower patches on the ground."@en ;
    gbo:moduleId "ground-decals" ;
    gbo:level gbo:Dressing ;
    gbo:hasField gbl:GroundDecals.patches, gbl:GroundDecals.kind ;
    gbo:hasSlot gbl:GroundDecals.slot.decal ;
    gbo:origin "engine" .

gbl:GroundDecals.patches
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "patches"@en ;
    rdfs:domain gbl:GroundDecals ;
    gbo:fieldName "patches" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"rare\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:GroundDecals.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:GroundDecals ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enumSet ;
    gbo:defaultValue "[\"dirt\",\"leaves\"]"^^rdf:JSON ;
    gbo:allowedValue "puddle", "dirt", "leaves", "flowers" .

gbl:GroundDecals.slot.decal
    a gbo:Slot ;
    gbo:slotName "decal" ;
    gbo:essential false ;
    gbo:needsRole gbr:decal .

gbl:GuardPost
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Civic, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Guard post"@en ;
    rdfs:comment "A guard tower or post with military clutter."@en ;
    gbo:moduleId "guard-post" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:GuardPost.size ;
    gbo:hasSlot gbl:GuardPost.slot.tower ;
    gbo:hasChildRule gbl:GuardPost.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:GuardPost.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:GuardPost ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 16.0 ;
    gbo:maxHeight 16.0 ;
    gbo:defaultValue "{\"h\":[5,8],\"w\":[5,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:GuardPost.slot.tower
    a gbo:Slot ;
    gbo:slotName "tower" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:guard-tower .

gbl:GuardPost.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Hay
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Hay"@en ;
    rdfs:comment "A hay pile or stack of bales."@en ;
    gbo:moduleId "hay" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:Hay.slot.hay ;
    gbo:origin "engine" .

gbl:Hay.slot.hay
    a gbo:Slot ;
    gbo:slotName "hay" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:hay .

gbl:HedgeLine
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:LinearFeature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Hedge"@en ;
    rdfs:comment "A hedge along an edge (pieces, or bushes in a line)."@en ;
    gbo:moduleId "hedge-line" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:HedgeLine.length, gbl:HedgeLine.kind ;
    gbo:hasSlot gbl:HedgeLine.slot.hedge ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:along ;
        gbo:members "[\"self\",\"parent\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"offset\":0}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:HedgeLine.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:HedgeLine ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[4,60]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HedgeLine.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:HedgeLine ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wild\""^^rdf:JSON ;
    gbo:allowedValue "box", "wild" .

gbl:HedgeLine.slot.hedge
    a gbo:Slot ;
    gbo:slotName "hedge" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bush, gbr:hedge-piece-set .

gbl:HousePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DoorstepSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FrontYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:DoorstepSet gbl:FenceLine gbl:FrontYard gbl:Garden )
        ]
    ] ;
    rdfs:label "House plot"@en ;
    rdfs:comment "A house on its plot, facing the street, with a yard and maybe a garden."@en ;
    gbo:moduleId "house-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:HousePlot.setback, gbl:HousePlot.size, gbl:HousePlot.condition, gbl:HousePlot.fenced, gbl:HousePlot.house-kind, gbl:HousePlot.wealth ;
    gbo:hasSlot gbl:HousePlot.slot.fence, gbl:HousePlot.slot.house, gbl:HousePlot.slot.outbuilding ;
    gbo:hasChildRule gbl:HousePlot.child.doorstep-set, gbl:HousePlot.child.fence-line, gbl:HousePlot.child.front-yard, gbl:HousePlot.child.garden ;
    gbo:constraint "count(children(garden)) <= 2"^^gbo:Expression, "size.w * size.h >= 12"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self.outbuilding\",\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:HousePlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "[0,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HousePlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 16.0 ;
    gbo:maxHeight 20.0 ;
    gbo:defaultValue "{\"h\":[6,10],\"w\":[5,7]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HousePlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:HousePlot.fenced
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fenced"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "fenced" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "false"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:HousePlot.house-kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "house-kind"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "house-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"cottage\""^^rdf:JSON ;
    gbo:vocabulary gbv:house-kind ;
    gbo:askedInConfirmation true .

gbl:HousePlot.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth .

gbl:HousePlot.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential false ;
    gbo:needsRole gbr:fence-piece-set ;
    gbo:when "fenced"^^gbo:Expression .

gbl:HousePlot.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:house ;
    gbo:conceptsFrom gbl:HousePlot.house-kind .

gbl:HousePlot.slot.outbuilding
    a gbo:Slot ;
    gbo:slotName "outbuilding" ;
    gbo:essential false ;
    gbo:needsRole gbr:outbuilding .

gbl:HousePlot.child.doorstep-set
    a gbo:ChildRule ;
    gbo:child gbl:DoorstepSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:HousePlot.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
