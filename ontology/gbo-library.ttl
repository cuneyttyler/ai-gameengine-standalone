gbl:BedSet.slot.rug
    a gbo:Slot ;
    gbo:slotName "rug" ;
    gbo:essential false ;
    gbo:needsRole gbr:rug .

gbl:Bedroom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BedSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BedSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WardrobeSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:BedSet gbl:RoomLights gbl:WallDecor gbl:WardrobeSet )
        ]
    ] ;
    rdfs:label "Bedroom"@en ;
    rdfs:comment "A bed, a chest, a wardrobe."@en ;
    gbo:moduleId "bedroom" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasField gbl:Bedroom.size, gbl:Bedroom.surface ;
    gbo:hasSlot gbl:Bedroom.slot.floor ;
    gbo:hasChildRule gbl:Bedroom.child.bed-set, gbl:Bedroom.child.room-lights, gbl:Bedroom.child.wall-decor, gbl:Bedroom.child.wardrobe-set ;
    gbo:origin "engine" .

gbl:Bedroom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Bedroom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,5],\"w\":[3,5]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Bedroom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Bedroom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:Bedroom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:Bedroom.child.bed-set
    a gbo:ChildRule ;
    gbo:child gbl:BedSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Bedroom.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Bedroom.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:Bedroom.child.wardrobe-set
    a gbo:ChildRule ;
    gbo:child gbl:WardrobeSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 .

gbl:Bench
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
