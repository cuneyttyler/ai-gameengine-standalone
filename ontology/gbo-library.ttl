    gbo:defaultValue "\"high\""^^rdf:JSON ;
    gbo:allowedValue "low", "high" .

gbl:Wall.material
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "material"@en ;
    rdfs:domain gbl:Wall ;
    gbo:fieldName "material" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"stone\""^^rdf:JSON ;
    gbo:vocabulary gbv:material ;
    gbo:askedInConfirmation true .

gbl:Wall.slot.gate
    a gbo:Slot ;
    gbo:slotName "gate" ;
    gbo:essential true ;
    gbo:needsRole gbr:gate .

gbl:Wall.slot.tower
    a gbo:Slot ;
    gbo:slotName "tower" ;
    gbo:essential false ;
    gbo:needsRole gbr:tower .

gbl:Wall.slot.wall
    a gbo:Slot ;
    gbo:slotName "wall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:wall-piece-set ;
    gbo:conceptsFrom gbl:Wall.material .

gbl:WallDecor
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Wall decor"@en ;
    rdfs:comment "Paintings, banners and trophies on the walls."@en ;
    gbo:moduleId "wall-decor" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasField gbl:WallDecor.items ;
    gbo:hasSlot gbl:WallDecor.slot.decor ;
    gbo:origin "engine" .

gbl:WallDecor.items
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "items"@en ;
    rdfs:domain gbl:WallDecor ;
    gbo:fieldName "items" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 10.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON .

gbl:WallDecor.slot.decor
    a gbo:Slot ;
    gbo:slotName "decor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:wall-decor .

gbl:WardrobeSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Wardrobe"@en ;
    rdfs:comment "A wardrobe against a wall."@en ;
    gbo:moduleId "wardrobe-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasSlot gbl:WardrobeSet.slot.wardrobe ;
    gbo:origin "engine" .

gbl:WardrobeSet.slot.wardrobe
    a gbo:Slot ;
    gbo:slotName "wardrobe" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:wardrobe .

gbl:WarehousePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Warehouse plot"@en ;
    rdfs:comment "A warehouse with goods stacked around it."@en ;
    gbo:moduleId "warehouse-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement, gbb:harbour ;
    gbo:hasField gbl:WarehousePlot.size, gbl:WarehousePlot.goods ;
    gbo:hasSlot gbl:WarehousePlot.slot.warehouse ;
    gbo:hasChildRule gbl:WarehousePlot.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:WarehousePlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WarehousePlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 5.0 ;
    gbo:minHeight 5.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[8,14],\"w\":[8,14]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WarehousePlot.goods
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "goods"@en ;
    rdfs:domain gbl:WarehousePlot ;
    gbo:fieldName "goods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"general\""^^rdf:JSON ;
    gbo:vocabulary gbv:goods .

gbl:WarehousePlot.slot.warehouse
    a gbo:Slot ;
    gbo:slotName "warehouse" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:warehouse .

gbl:WarehousePlot.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:Waterfront
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ApartmentPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HotelPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Park
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Plaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RestaurantPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:ApartmentPlot gbl:HotelPlot gbl:Park gbl:Plaza gbl:RestaurantPlot gbl:Road )
        ]
    ] ;
    rdfs:label "Waterfront"@en ;
    rdfs:comment "Along the water: a promenade, restaurants, a hotel, apartments, a park."@en ;
    gbo:moduleId "waterfront" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:Waterfront.area, gbl:Waterfront.footprint-density, gbl:Waterfront.plots, gbl:Waterfront.density, gbl:Waterfront.street-style, gbl:Waterfront.wealth ;
    gbo:hasSlot gbl:Waterfront.slot.car ;
    gbo:hasChildRule gbl:Waterfront.child.apartment-plot, gbl:Waterfront.child.hotel-plot, gbl:Waterfront.child.park, gbl:Waterfront.child.plaza, gbl:Waterfront.child.restaurant-plot, gbl:Waterfront.child.road ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:requires gbl:WaterBody ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:Waterfront.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Waterfront ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Waterfront.footprint-density
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "footprint-density"@en ;
    rdfs:comment "built cells / district cells"@en ;
    rdfs:domain gbl:Waterfront ;
    gbo:fieldName "footprint-density" ;
    gbo:fieldType gbo:ratio ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1.0 ;
    gbo:defaultValue "[0.35,0.7]"^^rdf:JSON .

gbl:Waterfront.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Waterfront ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[6,24]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Waterfront.density
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "density"@en ;
    rdfs:domain gbl:Waterfront ;
    gbo:fieldName "density" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"medium\""^^rdf:JSON ;
    gbo:allowedValue "sparse", "medium", "dense" ;
    gbo:askedInConfirmation true .

gbl:Waterfront.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this district's own street pattern; unset, the city's"@en ;
    rdfs:domain gbl:Waterfront ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:Waterfront.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:Waterfront ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:Waterfront.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:Waterfront.child.apartment-plot
    a gbo:ChildRule ;
    gbo:child gbl:ApartmentPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 30 ;
    gbo:weight 0.6 .

gbl:Waterfront.child.hotel-plot
    a gbo:ChildRule ;
    gbo:child gbl:HotelPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:Waterfront.child.park
    a gbo:ChildRule ;
    gbo:child gbl:Park ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.4 .

gbl:Waterfront.child.plaza
    a gbo:ChildRule ;
    gbo:child gbl:Plaza ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.5 .

gbl:Waterfront.child.restaurant-plot
    a gbo:ChildRule ;
    gbo:child gbl:RestaurantPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 1.0 .

gbl:Waterfront.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 40 ;
    gbo:weight 0.6 .

gbl:WellPlaza
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:OpenSpace, gbl:WaterSource, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bench
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Bench gbl:Clutter )
        ]
    ] ;
    rdfs:label "Well plaza"@en ;
    rdfs:comment "A small open space around a well."@en ;
    gbo:moduleId "well-plaza" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement, gbb:castle ;
    gbo:hasField gbl:WellPlaza.size, gbl:WellPlaza.well-kind ;
    gbo:hasSlot gbl:WellPlaza.slot.well ;
    gbo:hasChildRule gbl:WellPlaza.child.bench, gbl:WellPlaza.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:WellPlaza.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WellPlaza ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 12.0 ;
    gbo:maxHeight 12.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[4,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WellPlaza.well-kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "well-kind"@en ;
    rdfs:domain gbl:WellPlaza ;
    gbo:fieldName "well-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"roofed\""^^rdf:JSON ;
    gbo:allowedValue "open", "roofed", "pump" .

gbl:WellPlaza.slot.well
    a gbo:Slot ;
    gbo:slotName "well" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:well ;
    gbo:conceptsFrom gbl:WellPlaza.well-kind .

gbl:WellPlaza.child.bench
    a gbo:ChildRule ;
    gbo:child gbl:Bench ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.5 .

gbl:WellPlaza.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:Wilderness
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RockField
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TrailNetwork
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TrailNetwork
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Wilds
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Wilds
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:River gbl:RockField gbl:TrailNetwork gbl:Wilds )
        ]
    ] ;
    rdfs:label "Wilderness"@en ;
    rdfs:comment "Wild land: forest, meadow, rock and water, trails to its points of interest."@en ;
    gbo:moduleId "wilderness" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:wilderness ;
    gbo:hasField gbl:Wilderness.area, gbl:Wilderness.pois, gbl:Wilderness.biome, gbl:Wilderness.notes, gbl:Wilderness.relief, gbl:Wilderness.woods ;
    gbo:hasChildRule gbl:Wilderness.child.forest, gbl:Wilderness.child.ground, gbl:Wilderness.child.lake, gbl:Wilderness.child.meadow, gbl:Wilderness.child.river, gbl:Wilderness.child.rock-field, gbl:Wilderness.child.trail-network, gbl:Wilderness.child.wilds ;
    gbo:constraint "within(self.pois, count(descendants(class: PointOfInterest)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Wilderness.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Wilderness ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[6400,40000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Wilderness.pois
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "pois"@en ;
    rdfs:comment "points of interest: ruins, shrines, cave mouths"@en ;
    rdfs:domain gbl:Wilderness ;
    gbo:fieldName "pois" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 60.0 ;
    gbo:defaultValue "[2,6]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Wilderness.biome
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "biome"@en ;
    rdfs:domain gbl:Wilderness ;
    gbo:fieldName "biome" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"temperate\""^^rdf:JSON ;
    gbo:vocabulary gbv:biome ;
    gbo:askedInConfirmation true .

gbl:Wilderness.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Wilderness ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Wilderness.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."@en ;
    rdfs:domain gbl:Wilderness ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gentle\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" ;
    gbo:askedInConfirmation true .

gbl:Wilderness.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:comment "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."@en ;
    rdfs:domain gbl:Wilderness ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" ;
    gbo:askedInConfirmation true .

gbl:Wilderness.child.forest
    a gbo:ChildRule ;
    gbo:child gbl:Forest ;
    gbo:minCount 1 ;
    gbo:maxCount 10 ;
    gbo:weight 1.0 .

gbl:Wilderness.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Wilderness.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 .

gbl:Wilderness.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.6 .

gbl:Wilderness.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.4 .

gbl:Wilderness.child.rock-field
    a gbo:ChildRule ;
    gbo:child gbl:RockField ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:Wilderness.child.trail-network
    a gbo:ChildRule ;
    gbo:child gbl:TrailNetwork ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Wilderness.child.wilds
    a gbo:ChildRule ;
    gbo:child gbl:Wilds ;
    gbo:minCount 1 ;
    gbo:maxCount 8 ;
    gbo:weight 1.0 .

gbl:Wilds
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:PointOfInterest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clearing
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:PointOfInterest gbl:Clearing gbl:NatureScatter )
        ]
    ] ;
    rdfs:label "Wilds"@en ;
    rdfs:comment "Wild land between the trails, with its points of interest along them."@en ;
    gbo:moduleId "wilds" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:wilderness ;
    gbo:hasField gbl:Wilds.area, gbl:Wilds.pois, gbl:Wilds.trees, gbl:Wilds.biome ;
    gbo:hasSlot gbl:Wilds.slot.bush, gbl:Wilds.slot.rock, gbl:Wilds.slot.tree ;
    gbo:hasChildRule gbl:Wilds.child.PointOfInterest, gbl:Wilds.child.clearing, gbl:Wilds.child.nature-scatter ;
    gbo:origin "engine" .

gbl:Wilds.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Wilds ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 200.0 ;
    gbo:defaultValue "[2000,20000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Wilds.pois
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "pois"@en ;
    rdfs:domain gbl:Wilds ;
    gbo:fieldName "pois" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 60.0 ;
    gbo:defaultValue "[2,6]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Wilds.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
