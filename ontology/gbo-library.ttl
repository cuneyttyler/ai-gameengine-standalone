    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[6,12],\"w\":[6,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ParkingLot.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:ParkingLot ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"asphalt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:ParkingLot.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:ParkingLot.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:square-terrain ;
    gbo:conceptsFrom gbl:ParkingLot.surface .

gbl:ParkingLot.slot.parking-meter
    a gbo:Slot ;
    gbo:slotName "parking-meter" ;
    gbo:essential false ;
    gbo:needsRole gbr:parking-meter .

gbl:ParkingLot.slot.street-light
    a gbo:Slot ;
    gbo:slotName "street-light" ;
    gbo:essential false ;
    gbo:needsRole gbr:street-light .

gbl:Pasture
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Trough
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FenceLine gbl:Trough )
        ]
    ] ;
    rdfs:label "Pasture"@en ;
    rdfs:comment "Fenced grazing with animals and a trough."@en ;
    gbo:moduleId "pasture" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:Pasture.animals, gbl:Pasture.size, gbl:Pasture.livestock-mix ;
    gbo:hasSlot gbl:Pasture.slot.animal, gbl:Pasture.slot.fence ;
    gbo:hasChildRule gbl:Pasture.child.fence-line, gbl:Pasture.child.trough ;
    gbo:constraint "animals * 6 <= size.w * size.h"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Pasture.animals
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "animals"@en ;
    rdfs:domain gbl:Pasture ;
    gbo:fieldName "animals" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[3,12]"^^rdf:JSON .

gbl:Pasture.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Pasture ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 80.0 ;
    gbo:maxHeight 80.0 ;
    gbo:defaultValue "{\"h\":[10,20],\"w\":[10,20]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Pasture.livestock-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "livestock-mix"@en ;
    rdfs:domain gbl:Pasture ;
    gbo:fieldName "livestock-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"cow\":0.4,\"sheep\":0.6}"^^rdf:JSON ;
    gbo:vocabulary gbv:livestock .

gbl:Pasture.slot.animal
    a gbo:Slot ;
    gbo:slotName "animal" ;
    gbo:essential false ;
    gbo:needsRole gbr:animal ;
    gbo:conceptsFrom gbl:Pasture.livestock-mix .

gbl:Pasture.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fence-piece-set .

gbl:Pasture.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Pasture.child.trough
    a gbo:ChildRule ;
    gbo:child gbl:Trough ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.6 .

gbl:PastureLand
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HedgeLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pond
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StableYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmstead gbl:HedgeLine gbl:Pasture gbl:Pond gbl:StableYard )
        ]
    ] ;
    rdfs:label "Pasture land"@en ;
    rdfs:comment "Grazing land: fenced pastures, a farmstead or two and their stables."@en ;
    gbo:moduleId "pasture-land" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:farmland ;
    gbo:hasField gbl:PastureLand.area, gbl:PastureLand.farmsteads, gbl:PastureLand.livestock-mix, gbl:PastureLand.street-style ;
    gbo:hasChildRule gbl:PastureLand.child.farmstead, gbl:PastureLand.child.hedge-line, gbl:PastureLand.child.pasture, gbl:PastureLand.child.pond, gbl:PastureLand.child.stable-yard ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "flat" ;
        gbo:weight 0.4
    ] ;
    gbo:origin "engine" .

gbl:PastureLand.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:PastureLand.farmsteads
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "farmsteads"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "farmsteads" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 100.0 ;
    gbo:defaultValue "[1,3]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:PastureLand.livestock-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "livestock-mix"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "livestock-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"cow\":0.4,\"horse\":0.1,\"sheep\":0.5}"^^rdf:JSON ;
    gbo:vocabulary gbv:livestock ;
    gbo:askedInConfirmation true .

gbl:PastureLand.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:PastureLand.child.farmstead
    a gbo:ChildRule ;
    gbo:child gbl:Farmstead ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:countField gbl:PastureLand.farmsteads ;
    gbo:weight 1.0 .

gbl:PastureLand.child.hedge-line
    a gbo:ChildRule ;
    gbo:child gbl:HedgeLine ;
    gbo:minCount 0 ;
    gbo:maxCount 8 ;
    gbo:weight 0.4 .

gbl:PastureLand.child.pasture
    a gbo:ChildRule ;
    gbo:child gbl:Pasture ;
    gbo:minCount 1 ;
    gbo:maxCount 20 ;
    gbo:weight 0.9 .

gbl:PastureLand.child.pond
    a gbo:ChildRule ;
    gbo:child gbl:Pond ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.2 .

gbl:PastureLand.child.stable-yard
    a gbo:ChildRule ;
    gbo:child gbl:StableYard ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:PatricianWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FormalGarden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FountainSquare
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ManorPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ManorPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FormalGarden gbl:FountainSquare gbl:ManorPlot gbl:Road )
        ]
    ] ;
    rdfs:label "Patrician ward"@en ;
    rdfs:comment "Manors with formal gardens, on high ground near the castle."@en ;
    gbo:moduleId "patrician-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:PatricianWard.area, gbl:PatricianWard.plots, gbl:PatricianWard.grandeur, gbl:PatricianWard.street-style ;
    gbo:hasChildRule gbl:PatricianWard.child.formal-garden, gbl:PatricianWard.child.fountain-square, gbl:PatricianWard.child.manor-plot, gbl:PatricianWard.child.road ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.castle-ward\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":30}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.8
    ], [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 0.2
    ] ;
    gbo:origin "engine" .

gbl:PatricianWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[800,3000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:PatricianWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[3,15]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:PatricianWard.grandeur
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "grandeur"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "grandeur" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"modest\""^^rdf:JSON ;
    gbo:allowedValue "modest", "grand" ;
    gbo:askedInConfirmation true .

gbl:PatricianWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:PatricianWard.child.formal-garden
    a gbo:ChildRule ;
    gbo:child gbl:FormalGarden ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 0.5 .

gbl:PatricianWard.child.fountain-square
    a gbo:ChildRule ;
    gbo:child gbl:FountainSquare ;
    gbo:minCount 0 ;
