    gbo:rootModule gbl:Dungeon ;
    gbo:component gbl:DungeonLevel, gbl:EntranceRoom, gbl:StairsRoom, gbl:CorridorRoom, gbl:Junction, gbl:GuardRoom, gbl:BarracksRoom, gbl:TreasureRoom, gbl:TrapRoom, gbl:PuzzleRoom, gbl:BossArena, gbl:ShrineRoom, gbl:Prison, gbl:CryptRoom, gbl:LibraryRoom, gbl:Storeroom, gbl:FloodedRoom, gbl:CaveChamber, gbl:ChasmRoom, gbl:SecretRoom, gbl:Encounter, gbl:LootCache, gbl:Trap, gbl:Ambience ;
