    gbo:hasField gbl:GuestRoom.size, gbl:GuestRoom.surface ;
    gbo:hasSlot gbl:GuestRoom.slot.floor ;
    gbo:hasChildRule gbl:GuestRoom.child.bed-set, gbl:GuestRoom.child.room-lights, gbl:GuestRoom.child.wall-decor ;
