gbl:NatureScatter
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Dressing, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Nature scatter"@en ;
    rdfs:comment "Trees, bushes, rocks and flowers scattered in free cells."@en ;
    gbo:moduleId "nature-scatter" ;
    gbo:level gbo:Dressing ;
    gbo:hasField gbl:NatureScatter.bushes, gbl:NatureScatter.flowers, gbl:NatureScatter.rocks, gbl:NatureScatter.trees, gbl:NatureScatter.biome ;
    gbo:hasSlot gbl:NatureScatter.slot.bush, gbl:NatureScatter.slot.flower, gbl:NatureScatter.slot.rock, gbl:NatureScatter.slot.tree ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.road\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":1}"^^rdf:JSON
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.door\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":2}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

