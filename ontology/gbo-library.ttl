    gbo:fieldName "floor" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"stone-floor\""^^rdf:JSON ;
    gbo:allowedValue "stone-floor", "cave-floor", "dirt" .

gbl:DungeonLevel.theme
