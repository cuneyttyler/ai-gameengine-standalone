    gbo:hasField gbl:ParkingLot.cars, gbl:ParkingLot.size, gbl:ParkingLot.surface ;
    gbo:hasSlot gbl:ParkingLot.slot.car, gbl:ParkingLot.slot.ground, gbl:ParkingLot.slot.parking-meter, gbl:ParkingLot.slot.street-light ;
    gbo:origin "engine" .

gbl:ParkingLot.cars
    a gbo:QuantityField, owl:DatatypeProperty ;
