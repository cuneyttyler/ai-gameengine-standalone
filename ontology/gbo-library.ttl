gbl:WellPlaza
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:OpenSpace, gbl:WaterSource, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bench
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Bench gbl:Clutter )
        ]
    ] ;
    rdfs:label "Well plaza"@en ;
    rdfs:comment "A small open space around a well."@en ;
    gbo:moduleId "well-plaza" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:WellPlaza.size, gbl:WellPlaza.well-kind ;
    gbo:hasSlot gbl:WellPlaza.slot.well ;
    gbo:hasChildRule gbl:WellPlaza.child.bench, gbl:WellPlaza.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:WellPlaza.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WellPlaza ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 12.0 ;
    gbo:maxHeight 12.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[4,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WellPlaza.well-kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "well-kind"@en ;
    rdfs:domain gbl:WellPlaza ;
    gbo:fieldName "well-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"roofed\""^^rdf:JSON ;
    gbo:allowedValue "open", "roofed", "pump" .

gbl:WellPlaza.slot.well
    a gbo:Slot ;
    gbo:slotName "well" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:well ;
    gbo:conceptsFrom gbl:WellPlaza.well-kind .

gbl:WellPlaza.child.bench
    a gbo:ChildRule ;
    gbo:child gbl:Bench ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.5 .

gbl:WellPlaza.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:WorkYard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Work yard"@en ;
    rdfs:comment "An open work yard with workshop clutter."@en ;
    gbo:moduleId "work-yard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:WorkYard.size, gbl:WorkYard.surface ;
    gbo:hasSlot gbl:WorkYard.slot.ground ;
    gbo:hasChildRule gbl:WorkYard.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:WorkYard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkYard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkYard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:WorkYard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:WorkYard.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:WorkYard.surface .

gbl:WorkYard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clutter gbl:WorkYard )
        ]
    ] ;
    rdfs:label "Workshop plot"@en ;
    rdfs:comment "A craftsman's workshop, maybe with a house, and a work yard."@en ;
    gbo:moduleId "workshop-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:WorkshopPlot.size, gbl:WorkshopPlot.trade ;
    gbo:hasSlot gbl:WorkshopPlot.slot.house, gbl:WorkshopPlot.slot.workshop ;
    gbo:hasChildRule gbl:WorkshopPlot.child.clutter, gbl:WorkshopPlot.child.work-yard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:WorkshopPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:WorkshopPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 20.0 ;
    gbo:maxHeight 24.0 ;
    gbo:defaultValue "{\"h\":[7,11],\"w\":[6,9]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:WorkshopPlot.trade
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "trade"@en ;
    rdfs:domain gbl:WorkshopPlot ;
    gbo:fieldName "trade" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"smith\""^^rdf:JSON ;
    gbo:vocabulary gbv:trade ;
    gbo:askedInConfirmation true .

gbl:WorkshopPlot.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential false ;
    gbo:needsRole gbr:house .

gbl:WorkshopPlot.slot.workshop
    a gbo:Slot ;
    gbo:slotName "workshop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:workshop ;
    gbo:conceptsFrom gbl:WorkshopPlot.trade .

gbl:WorkshopPlot.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:WorkshopPlot.child.work-yard
    a gbo:ChildRule ;
    gbo:child gbl:WorkYard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:Yard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
