gbl:Harbour
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Docks
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Docks
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MarketSquare
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Docks gbl:Ground gbl:HousePlot gbl:Lake gbl:MarketSquare gbl:Meadow gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "Harbour"@en ;
    rdfs:comment "A harbour on its own: docks with piers, warehouses and a fish market along the water, the houses and lanes of the people who work there."@en ;
    gbo:moduleId "harbour" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:harbour ;
    gbo:hasField gbl:Harbour.area, gbl:Harbour.buildings, gbl:Harbour.piers, gbl:Harbour.condition, gbl:Harbour.notes, gbl:Harbour.relief, gbl:Harbour.water ;
    gbo:hasChildRule gbl:Harbour.child.docks, gbl:Harbour.child.ground, gbl:Harbour.child.house-plot, gbl:Harbour.child.lake, gbl:Harbour.child.market-square, gbl:Harbour.child.meadow, gbl:Harbour.child.river, gbl:Harbour.child.road ;
    gbo:constraint "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Harbour.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[1600,6400]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Harbour.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 400.0 ;
    gbo:defaultValue "[4,20]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Harbour.piers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "piers"@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "piers" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[2,5]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Harbour.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:Harbour.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Harbour.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land away from the water."@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"flat\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" .

gbl:Harbour.water
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "water"@en ;
    rdfs:comment "What the docks are on: a river's bank or a lake's (or the sea's) shore."@en ;
    rdfs:domain gbl:Harbour ;
    gbo:fieldName "water" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"river\""^^rdf:JSON ;
    gbo:allowedValue "river", "lake" ;
    gbo:askedInConfirmation true .

gbl:Harbour.child.docks
    a gbo:ChildRule ;
    gbo:child gbl:Docks ;
    gbo:minCount 1 ;
    gbo:maxCount 3 ;
    gbo:weight 1.0 .

gbl:Harbour.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Harbour.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 40 ;
    gbo:weight 0.5 .

gbl:Harbour.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 ;
    gbo:when "water == 'lake'"^^gbo:Expression .

gbl:Harbour.child.market-square
    a gbo:ChildRule ;
    gbo:child gbl:MarketSquare ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.2 .

gbl:Harbour.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.2 .

gbl:Harbour.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 ;
    gbo:when "water == 'river'"^^gbo:Expression .

gbl:Harbour.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 20 ;
    gbo:weight 1.0 .

gbl:Hay
    a owl:Class, gbo:Module ;
