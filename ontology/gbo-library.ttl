    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Desk"@en ;
    rdfs:comment "A desk and its chair, a bookcase near."@en ;
    gbo:moduleId "desk-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:DeskSet.slot.bookshelf, gbl:DeskSet.slot.chair, gbl:DeskSet.slot.desk ;
    gbo:origin "engine" .

gbl:DeskSet.slot.bookshelf
    a gbo:Slot ;
    gbo:slotName "bookshelf" ;
    gbo:essential false ;
    gbo:needsRole gbr:bookshelf .

gbl:DeskSet.slot.chair
    a gbo:Slot ;
    gbo:slotName "chair" ;
    gbo:essential false ;
    gbo:needsRole gbr:chair .

gbl:DeskSet.slot.desk
    a gbo:Slot ;
    gbo:slotName "desk" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:desk .

gbl:DiningRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DiningSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DiningSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShelfWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:DiningSet gbl:RoomLights gbl:ShelfWall gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Dining room"@en ;
    rdfs:comment "A table for the household."@en ;
    gbo:moduleId "dining-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:DiningRoom.size, gbl:DiningRoom.surface ;
    gbo:hasSlot gbl:DiningRoom.slot.floor ;
    gbo:hasChildRule gbl:DiningRoom.child.dining-set, gbl:DiningRoom.child.room-lights, gbl:DiningRoom.child.shelf-wall, gbl:DiningRoom.child.wall-decor ;
    gbo:origin "engine" .

gbl:DiningRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:DiningRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[4,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:DiningRoom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:DiningRoom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:DiningRoom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:DiningRoom.child.dining-set
    a gbo:ChildRule ;
    gbo:child gbl:DiningSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:DiningRoom.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:DiningRoom.child.shelf-wall
    a gbo:ChildRule ;
    gbo:child gbl:ShelfWall ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:DiningRoom.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:DiningSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
