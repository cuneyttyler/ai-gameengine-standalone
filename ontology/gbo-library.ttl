# --- Relation types ---

gbx:adjacent
    a gbo:RelationType ;
    rdfs:label "adjacent"@en ;
    rdfs:comment "a and b share an edge without overlapping"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:against
    a gbo:RelationType ;
    rdfs:label "against"@en ;
    rdfs:comment "a stands with its back to b (a chest against a wall)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:aligned
    a gbo:RelationType ;
    rdfs:label "aligned"@en ;
    rdfs:comment "a lies along b, parallel to it (a car on its road, on its side of it)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:along
    a gbo:RelationType ;
    rdfs:label "along"@en ;
    rdfs:comment "a runs along path or line b at an offset"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "offset" ;
    gbo:hardByDefault false .

gbx:away-from
    a gbo:RelationType ;
    rdfs:label "away-from"@en ;
    rdfs:comment "a keeps at least d from b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "d" ;
    gbo:hardByDefault false .

gbx:behind
    a gbo:RelationType ;
    rdfs:label "behind"@en ;
    rdfs:comment "a is behind b, in b's facing frame"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "gap" ;
    gbo:hardByDefault false .

gbx:beside
    a gbo:RelationType ;
    rdfs:label "beside"@en ;
    rdfs:comment "a is to the side of b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:between
    a gbo:RelationType ;
    rdfs:label "between"@en ;
    rdfs:comment "a lies on the segment between b and c"@en ;
    gbo:minMembers 3 ;
    gbo:maxMembers 3 ;
    gbo:hardByDefault false .

gbx:center
    a gbo:RelationType ;
    rdfs:label "center"@en ;
    rdfs:comment "a sits at its parent's centre"@en ;
    gbo:minMembers 1 ;
    gbo:maxMembers 1 ;
    gbo:hardByDefault false .

gbx:coloured-by
    a gbo:RelationType ;
    rdfs:label "coloured-by"@en ;
    rdfs:comment "a's art takes its colours from b (a wall from the background it stands on)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:corner
    a gbo:RelationType ;
    rdfs:label "corner"@en ;
    rdfs:comment "a sits in a corner of its parent"@en ;
    gbo:minMembers 1 ;
    gbo:maxMembers 1 ;
    gbo:argument "corner" ;
    gbo:hardByDefault false .

gbx:crosses
    a gbo:RelationType ;
    rdfs:label "crosses"@en ;
    rdfs:comment "path a passes through b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:debris-of
    a gbo:RelationType ;
    rdfs:label "debris-of"@en ;
    rdfs:comment "a came from b (rubble of a wall)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:east-of
    a gbo:RelationType ;
    rdfs:label "east-of"@en ;
    rdfs:comment "a lies right of (east of) b on the map"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:edge
    a gbo:RelationType ;
    rdfs:label "edge"@en ;
    rdfs:comment "a touches its parent's border"@en ;
    gbo:minMembers 1 ;
    gbo:maxMembers 1 ;
    gbo:argument "side" ;
    gbo:hardByDefault false .

gbx:encloses
    a gbo:RelationType ;
    rdfs:label "encloses"@en ;
    rdfs:comment "line a closes a loop around region b (gaps only at gates)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault true .

gbx:faces
    a gbo:RelationType ;
    rdfs:label "faces"@en ;
    rdfs:comment "a's facing points toward b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:far
    a gbo:RelationType ;
    rdfs:label "far"@en ;
    rdfs:comment "a is at least d from b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "d" ;
    gbo:hardByDefault false .

gbx:focus
    a gbo:RelationType ;
    rdfs:label "focus"@en ;
    rdfs:comment "a closes the view along a straight path run leaving b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:in-east
    a gbo:RelationType ;
    rdfs:label "in-east"@en ;
    rdfs:comment "a lies in the east of the map (its right side); b is \"site\""@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:in-front-of
    a gbo:RelationType ;
    rdfs:label "in-front-of"@en ;
    rdfs:comment "a is in front of b, in b's facing frame"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "gap" ;
    gbo:hardByDefault false .

gbx:in-north
    a gbo:RelationType ;
    rdfs:label "in-north"@en ;
    rdfs:comment "a lies in the north of the map (its top side); b is \"site\""@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:in-row
    a gbo:RelationType ;
    rdfs:label "in-row"@en ;
    rdfs:comment "aligned, with even gaps"@en ;
    gbo:minMembers 2 ;
    gbo:argument "axis", "spacing" ;
    gbo:hardByDefault false .

gbx:in-south
    a gbo:RelationType ;
    rdfs:label "in-south"@en ;
    rdfs:comment "a lies in the south of the map (its bottom side); b is \"site\""@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:in-west
    a gbo:RelationType ;
    rdfs:label "in-west"@en ;
    rdfs:comment "a lies in the west of the map (its left side); b is \"site\""@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:inside
    a gbo:RelationType ;
    rdfs:label "inside"@en ;
    rdfs:comment "every cell of a is in b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault true .

gbx:interest
    a gbo:RelationType ;
    rdfs:label "interest"@en ;
    rdfs:comment "the site's interest for a criterion at a's cells (-1 vetoes)"@en ;
    gbo:minMembers 1 ;
    gbo:maxMembers 1 ;
    gbo:argument "criterion", "weight" ;
    gbo:hardByDefault false .

gbx:leads-to
    a gbo:RelationType ;
    rdfs:label "leads-to"@en ;
    rdfs:comment "a connects here to b (stairs to another level, a gate to a road)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:lights
    a gbo:RelationType ;
    rdfs:label "lights"@en ;
    rdfs:comment "a lights b (a lamp, a brazier)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:made-with
    a gbo:RelationType ;
    rdfs:label "made-with"@en ;
    rdfs:comment "a's art is made together with b's, so they match (stairs with the walls they stand against): b's picture shown when a is painted"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:mounted-on
    a gbo:RelationType ;
    rdfs:label "mounted-on"@en ;
    rdfs:comment "a hangs on b (a torch on a wall)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:near
    a gbo:RelationType ;
    rdfs:label "near"@en ;
    rdfs:comment "a is within d0 of b (score falls to 0 at d1)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "d0", "d1" ;
    gbo:hardByDefault false .

gbx:north-of
    a gbo:RelationType ;
    rdfs:label "north-of"@en ;
    rdfs:comment "a lies above (north of) b on the map"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:on
    a gbo:RelationType ;
    rdfs:label "on"@en ;
    rdfs:comment "a stands on b's top surface"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault true .

gbx:outside
    a gbo:RelationType ;
    rdfs:label "outside"@en ;
    rdfs:comment "no cell of a is in b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault true .

gbx:part-of
    a gbo:RelationType ;
    rdfs:label "part-of"@en ;
    rdfs:comment "a belongs to b (a counter of a shop, a pillar of a hall)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:path-between
    a gbo:RelationType ;
    rdfs:label "path-between"@en ;
    rdfs:comment "a walkable route exists between a and b"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "layer" ;
    gbo:hardByDefault true .

gbx:repeat
    a gbo:RelationType ;
    rdfs:label "repeat"@en ;
    rdfs:comment "members repeat at a spacing"@en ;
    gbo:minMembers 2 ;
    gbo:argument "spacing" ;
    gbo:hardByDefault false .

gbx:set-in
    a gbo:RelationType ;
    rdfs:label "set-in"@en ;
    rdfs:comment "a fills a gap in b (a door in its wall)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:south-of
    a gbo:RelationType ;
    rdfs:label "south-of"@en ;
    rdfs:comment "a lies below (south of) b on the map"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:symmetric
    a gbo:RelationType ;
    rdfs:label "symmetric"@en ;
    rdfs:comment "members are mirrored across the parent's axis"@en ;
    gbo:minMembers 2 ;
    gbo:argument "axis" ;
    gbo:hardByDefault false .

gbx:used-with
    a gbo:RelationType ;
    rdfs:label "used-with"@en ;
    rdfs:comment "a is used with b (a chair at a table)"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

gbx:visible-from
    a gbo:RelationType ;
    rdfs:label "visible-from"@en ;
    rdfs:comment "a straight line from anchor b to a crosses no blocking cell"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:argument "radius" ;
    gbo:hardByDefault false .

gbx:west-of
    a gbo:RelationType ;
    rdfs:label "west-of"@en ;
    rdfs:comment "a lies left of (west of) b on the map"@en ;
    gbo:minMembers 2 ;
    gbo:maxMembers 2 ;
    gbo:hardByDefault false .

# --- Design rules ---

gbd:building-faces-street
    a gbo:DesignRule ;
    gbo:ruleText "A building faces its street and sits at the front setback; outbuildings go behind."@en ;
    gbo:source "Alexander et al., A Pattern Language (1977) (pattern 105, South-facing outdoors; 140, Private terrace on the street)" ;
    gbo:appliesTo gbl:BuildingParcel .

gbd:centrepiece-at-centre
    a gbo:DesignRule ;
    gbo:ruleText "A square's centrepiece stands at its centre."@en ;
    gbo:source "Lynch, The Image of the City (1960) (landmarks and nodes)" ;
    gbo:appliesTo gbl:OpenSpace .

gbd:city-civic-near-downtown
    a gbo:DesignRule ;
    gbo:ruleText "City hall and civic buildings are near the centre, on a plaza."@en ;
    gbo:source "Lynch 1960" ;
    gbo:appliesTo gbl:CivicDistrict .

gbd:city-downtown-at-centre
    a gbo:DesignRule ;
    gbo:ruleText "The downtown with its towers is at the centre, where the avenues cross."@en ;
    gbo:source "Burgess 1925 (concentric zones)" ;
    gbo:appliesTo gbl:Downtown .

gbd:city-height-falls-outward
    a gbo:DesignRule ;
    gbo:ruleText "Buildings are tallest downtown and lower outward; suburbs are low."@en ;
    gbo:source "Alonso 1964 (bid-rent)" ;
    gbo:appliesTo gbl:District .

gbd:city-industry-at-edge
    a gbo:DesignRule ;
    gbo:ruleText "Industry is at the edge, by water, rail or the highway, away from homes."@en ;
    gbo:source "Hoyt 1939 (sectors)" ;
    gbo:appliesTo gbl:IndustrialDistrict .

gbd:city-parking-behind
    a gbo:DesignRule ;
    gbo:ruleText "Large parking lots sit behind or beside big stores, not in front of downtown streets."@en ;
    gbo:source "Jacobs 1961" ;
    gbo:appliesTo gbl:ParkingLot .

gbd:city-parks-within-walk
    a gbo:DesignRule ;
    gbo:ruleText "Every residential district has a park or playground within a short walk."@en ;
    gbo:source "Perry 1929 (neighbourhood unit)" ;
    gbo:appliesTo gbl:ResidentialDistrict .

gbd:city-retail-on-main-roads
    a gbo:DesignRule ;
    gbo:ruleText "Shops and commercial strips line the main roads."@en ;
    gbo:source "Christaller 1933; strip development" ;
    gbo:appliesTo gbl:CommercialDistrict .

gbd:city-schools-in-neighbourhoods
    a gbo:DesignRule ;
    gbo:ruleText "Schools sit inside residential neighbourhoods, not on main roads."@en ;
    gbo:source "Perry 1929" ;
    gbo:appliesTo gbl:SchoolPlot .

gbd:city-sidewalks-everywhere
    a gbo:DesignRule ;
    gbo:ruleText "Streets have sidewalks on both sides, with lamps, trees and bins along them."@en ;
    gbo:source "Jacobs 1961" ;
    gbo:appliesTo gbl:District .

gbd:city-transit-at-centre
    a gbo:DesignRule ;
    gbo:ruleText "The station is downtown, on an avenue."@en ;
    gbo:source "Calthorpe 1993 (TOD)" ;
    gbo:appliesTo gbl:TransitStationPlot .

gbd:craftsmen-downstream
    a gbo:DesignRule ;
    gbo:ruleText "Noisy and smelly trades (tanners, smiths) sit downstream or at the edge, away from patricians."@en ;
    gbo:source "Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:CraftsmenWard .

gbd:density-falls-outward
    a gbo:DesignRule ;
    gbo:ruleText "Building density falls from the centre outward."@en ;
    gbo:source "Lynch, The Image of the City (1960); Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:Ward .

gbd:docks-along-water
    a gbo:DesignRule ;
    gbo:ruleText "Docks lie along the water."@en ;
    gbo:source "Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:Docks .

gbd:farmland-outside
    a gbo:DesignRule ;
    gbo:ruleText "Farmland lies outside the built area."@en ;
    gbo:source "Emilien et al., Procedural Generation of Villages on Arbitrary Terrains, The Visual Computer 28 (2012)" ;
    gbo:appliesTo gbl:FarmlandRing .

gbd:garden-behind-house
    a gbo:DesignRule ;
    gbo:ruleText "A garden lies behind or beside its house, away from the street."@en ;
    gbo:source "Alexander et al., A Pattern Language (1977) (pattern 173, Garden wall)" ;
    gbo:appliesTo gbl:Garden .

gbd:gate-ward-at-gates
    a gbo:DesignRule ;
    gbo:ruleText "A gate ward forms at each gate."@en ;
    gbo:source "Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:GateWard .

gbd:landmark-closes-view
    a gbo:DesignRule ;
    gbo:ruleText "A temple closes the view at the end of a street."@en ;
    gbo:source "Lynch, The Image of the City (1960)" ;
    gbo:appliesTo gbl:TemplePlot .

gbd:market-at-centre
    a gbo:DesignRule ;
    gbo:ruleText "The market sits at the centre, on the main road."@en ;
    gbo:source "Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:MarketWard ;
    gbo:impliesRelation "{\"members\":[\"self\"],\"type\":\"center\"}"^^rdf:JSON .

gbd:patricians-high-ground
    a gbo:DesignRule ;
    gbo:ruleText "Patricians live on high ground, near the castle."@en ;
    gbo:source "Emilien et al., Procedural Generation of Villages on Arbitrary Terrains, The Visual Computer 28 (2012)" ;
    gbo:appliesTo gbl:PatricianWard ;
    gbo:impliesRelation "{\"args\":{\"criterion\":\"high-ground\",\"weight\":0.8},\"members\":[\"self\"],\"type\":\"interest\"}"^^rdf:JSON .

gbd:plots-street-access
    a gbo:DesignRule ;
    gbo:ruleText "Every plot has access to a street."@en ;
    gbo:source "Emilien et al., Procedural Generation of Villages on Arbitrary Terrains, The Visual Computer 28 (2012)" ;
    gbo:appliesTo gbl:BuildingParcel .

gbd:residential-around-centre
    a gbo:DesignRule ;
    gbo:ruleText "Residential wards sit around the centre."@en ;
    gbo:source "Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:ResidentialWard .

gbd:slum-outside
    a gbo:DesignRule ;
    gbo:ruleText "The slum lies outside the walls or at the edge."@en ;
    gbo:source "Watabou, Medieval Fantasy City Generator (2016)" ;
    gbo:appliesTo gbl:Slum .

