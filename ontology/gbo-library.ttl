gbl:ParkDistrict
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Park
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Park
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Playground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Plaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SportsCourt
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Park gbl:Playground gbl:Plaza gbl:Road gbl:SportsCourt )
        ]
    ] ;
    rdfs:label "City park"@en ;
    rdfs:comment "A large green park: lawns, trees, paths, a pond, playgrounds and sports courts."@en ;
    gbo:moduleId "park-district" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:ParkDistrict.area, gbl:ParkDistrict.footprint-density, gbl:ParkDistrict.plots, gbl:ParkDistrict.density, gbl:ParkDistrict.street-style, gbl:ParkDistrict.wealth ;
    gbo:hasSlot gbl:ParkDistrict.slot.car ;
    gbo:hasChildRule gbl:ParkDistrict.child.park, gbl:ParkDistrict.child.playground, gbl:ParkDistrict.child.plaza, gbl:ParkDistrict.child.road, gbl:ParkDistrict.child.sports-court ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:ParkDistrict.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:ParkDistrict ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:ParkDistrict.footprint-density
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "footprint-density"@en ;
    rdfs:comment "built cells / district cells"@en ;
    rdfs:domain gbl:ParkDistrict ;
    gbo:fieldName "footprint-density" ;
    gbo:fieldType gbo:ratio ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1.0 ;
    gbo:defaultValue "[0.35,0.7]"^^rdf:JSON .

gbl:ParkDistrict.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:ParkDistrict ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[2,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:ParkDistrict.density
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "density"@en ;
    rdfs:domain gbl:ParkDistrict ;
    gbo:fieldName "density" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"sparse\""^^rdf:JSON ;
    gbo:allowedValue "sparse", "medium", "dense" ;
    gbo:askedInConfirmation true .

gbl:ParkDistrict.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this district's own street pattern; unset, the city's"@en ;
    rdfs:domain gbl:ParkDistrict ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:ParkDistrict.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:ParkDistrict ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:ParkDistrict.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:ParkDistrict.child.park
    a gbo:ChildRule ;
    gbo:child gbl:Park ;
    gbo:minCount 1 ;
    gbo:maxCount 6 ;
    gbo:weight 1.0 .

gbl:ParkDistrict.child.playground
    a gbo:ChildRule ;
    gbo:child gbl:Playground ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.5 .

gbl:ParkDistrict.child.plaza
    a gbo:ChildRule ;
