gbl:Farmland
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FarmlandRing
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "12"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FarmlandRing
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:PastureLand
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FarmlandRing gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:PastureLand gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "Farmland"@en ;
    rdfs:comment "Countryside: farmsteads among fields, pastures and orchards, tracks between them."@en ;
    gbo:moduleId "farmland" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:farmland ;
    gbo:hasField gbl:Farmland.area, gbl:Farmland.farmsteads, gbl:Farmland.condition, gbl:Farmland.crop-mix, gbl:Farmland.livestock-mix, gbl:Farmland.notes, gbl:Farmland.relief, gbl:Farmland.woods ;
    gbo:hasChildRule gbl:Farmland.child.farmland-ring, gbl:Farmland.child.forest, gbl:Farmland.child.ground, gbl:Farmland.child.lake, gbl:Farmland.child.meadow, gbl:Farmland.child.pasture-land, gbl:Farmland.child.river, gbl:Farmland.child.road ;
    gbo:constraint "within(self.farmsteads, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Farmland.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[6400,22500]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Farmland.farmsteads
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "farmsteads"@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "farmsteads" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Farmland.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition ;
    gbo:askedInConfirmation true .

gbl:Farmland.crop-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crop-mix"@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "crop-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"barley\":0.3,\"cabbage\":0.2,\"wheat\":0.5}"^^rdf:JSON ;
    gbo:vocabulary gbv:crop-kind ;
    gbo:askedInConfirmation true .

gbl:Farmland.livestock-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "livestock-mix"@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "livestock-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"cow\":0.4,\"pig\":0.2,\"sheep\":0.4}"^^rdf:JSON ;
    gbo:vocabulary gbv:livestock .

gbl:Farmland.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Farmland.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gentle\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" ;
    gbo:askedInConfirmation true .

gbl:Farmland.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:comment "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."@en ;
    rdfs:domain gbl:Farmland ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" ;
    gbo:askedInConfirmation true .

gbl:Farmland.child.farmland-ring
    a gbo:ChildRule ;
    gbo:child gbl:FarmlandRing ;
    gbo:minCount 1 ;
    gbo:maxCount 12 ;
    gbo:weight 1.0 .

gbl:Farmland.child.forest
    a gbo:ChildRule ;
    gbo:child gbl:Forest ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.4 .

gbl:Farmland.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Farmland.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.1 .

gbl:Farmland.child.meadow
    a gbo:ChildRule ;
    gbo:child gbl:Meadow ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.4 .

gbl:Farmland.child.pasture-land
    a gbo:ChildRule ;
    gbo:child gbl:PastureLand ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.6 .

gbl:Farmland.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 .

gbl:Farmland.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 40 ;
    gbo:weight 1.0 .

gbl:FarmlandRing
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HedgeLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MillPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Orchard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pond
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Subplace
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmstead gbl:Field gbl:HedgeLine gbl:MillPlot gbl:Orchard gbl:Pasture gbl:Pond gbl:Road gbl:Subplace )
        ]
    ] ;
    rdfs:label "Farmland ring"@en ;
    rdfs:comment "Fields and farmsteads outside the settlement (a nested farmland place)."@en ;
    gbo:moduleId "farmland-ring" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:FarmlandRing.area, gbl:FarmlandRing.farmsteads, gbl:FarmlandRing.fields, gbl:FarmlandRing.crops, gbl:FarmlandRing.street-style ;
    gbo:hasChildRule gbl:FarmlandRing.child.farmstead, gbl:FarmlandRing.child.field, gbl:FarmlandRing.child.hedge-line, gbl:FarmlandRing.child.mill-plot, gbl:FarmlandRing.child.orchard, gbl:FarmlandRing.child.pasture, gbl:FarmlandRing.child.pond, gbl:FarmlandRing.child.road, gbl:FarmlandRing.child.subplace ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:outside ;
        gbo:members "[\"self\",\"parent.wall\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "flat" ;
        gbo:weight 0.6
    ], [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 0.3
    ] ;
    gbo:origin "engine" .

gbl:FarmlandRing.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:FarmlandRing ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[2000,20000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:FarmlandRing.farmsteads
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "farmsteads"@en ;
    rdfs:domain gbl:FarmlandRing ;
    gbo:fieldName "farmsteads" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[2,10]"^^rdf:JSON .

gbl:FarmlandRing.fields
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "fields"@en ;
    rdfs:domain gbl:FarmlandRing ;
    gbo:fieldName "fields" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1000.0 ;
    gbo:defaultValue "[4,30]"^^rdf:JSON .

gbl:FarmlandRing.crops
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crops"@en ;
    rdfs:domain gbl:FarmlandRing ;
    gbo:fieldName "crops" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"barley\":0.3,\"cabbage\":0.2,\"wheat\":0.5}"^^rdf:JSON ;
    gbo:vocabulary gbv:crop-kind .

gbl:FarmlandRing.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:FarmlandRing ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:FarmlandRing.child.farmstead
    a gbo:ChildRule ;
    gbo:child gbl:Farmstead ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:countField gbl:FarmlandRing.farmsteads ;
    gbo:weight 1.0 .

gbl:FarmlandRing.child.field
    a gbo:ChildRule ;
    gbo:child gbl:Field ;
    gbo:minCount 0 ;
    gbo:maxCount 1000 ;
    gbo:countField gbl:FarmlandRing.fields ;
    gbo:weight 1.0 .

gbl:FarmlandRing.child.hedge-line
    a gbo:ChildRule ;
    gbo:child gbl:HedgeLine ;
    gbo:minCount 0 ;
    gbo:maxCount 400 ;
    gbo:weight 0.5 .

gbl:FarmlandRing.child.mill-plot
    a gbo:ChildRule ;
    gbo:child gbl:MillPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:FarmlandRing.child.orchard
    a gbo:ChildRule ;
    gbo:child gbl:Orchard ;
    gbo:minCount 0 ;
    gbo:maxCount 40 ;
    gbo:weight 0.3 .

gbl:FarmlandRing.child.pasture
    a gbo:ChildRule ;
    gbo:child gbl:Pasture ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:weight 0.6 .

gbl:FarmlandRing.child.pond
    a gbo:ChildRule ;
    gbo:child gbl:Pond ;
    gbo:minCount 0 ;
    gbo:maxCount 10 ;
    gbo:weight 0.2 .

gbl:FarmlandRing.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:FarmlandRing.child.subplace
    a gbo:ChildRule ;
    gbo:child gbl:Subplace ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.1 .

gbl:Farmstead
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Farmyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmyard gbl:FenceLine gbl:Field gbl:Garden gbl:Pasture )
        ]
    ] ;
    rdfs:label "Farmstead"@en ;
    rdfs:comment "A farmhouse and barn with a farmyard, fields, pasture and garden."@en ;
    gbo:moduleId "farmstead" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:Farmstead.fields, gbl:Farmstead.size, gbl:Farmstead.farm-kind ;
    gbo:hasSlot gbl:Farmstead.slot.barn, gbl:Farmstead.slot.farmhouse, gbl:Farmstead.slot.shed ;
    gbo:hasChildRule gbl:Farmstead.child.farmyard, gbl:Farmstead.child.fence-line, gbl:Farmstead.child.field, gbl:Farmstead.child.garden, gbl:Farmstead.child.pasture ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self.barn\",\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"d0\":1,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "flat" ;
        gbo:weight 0.5
    ] ;
    gbo:origin "engine" .

gbl:Farmstead.fields
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "fields"@en ;
    rdfs:domain gbl:Farmstead ;
    gbo:fieldName "fields" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[1,4]"^^rdf:JSON .

gbl:Farmstead.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Farmstead ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 8.0 ;
    gbo:minHeight 8.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[14,24],\"w\":[14,24]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Farmstead.farm-kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "farm-kind"@en ;
    rdfs:domain gbl:Farmstead ;
    gbo:fieldName "farm-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"mixed\""^^rdf:JSON ;
    gbo:allowedValue "arable", "livestock", "mixed" ;
    gbo:askedInConfirmation true .

gbl:Farmstead.slot.barn
    a gbo:Slot ;
    gbo:slotName "barn" ;
    gbo:essential true ;
    gbo:needsRole gbr:barn .

gbl:Farmstead.slot.farmhouse
    a gbo:Slot ;
    gbo:slotName "farmhouse" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:farmhouse .

gbl:Farmstead.slot.shed
    a gbo:Slot ;
    gbo:slotName "shed" ;
    gbo:essential false ;
    gbo:needsRole gbr:shed .

gbl:Farmstead.child.farmyard
    a gbo:ChildRule ;
    gbo:child gbl:Farmyard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:Farmstead.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 0 ;
    gbo:maxCount 8 ;
    gbo:weight 0.6 .

gbl:Farmstead.child.field
    a gbo:ChildRule ;
    gbo:child gbl:Field ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:countField gbl:Farmstead.fields ;
    gbo:weight 0.7 .

gbl:Farmstead.child.garden
    a gbo:ChildRule ;
    gbo:child gbl:Garden ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.5 .

gbl:Farmstead.child.pasture
    a gbo:ChildRule ;
    gbo:child gbl:Pasture ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.6 .

gbl:Farmyard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Farmyard"@en ;
    rdfs:comment "An open farmyard with farm clutter."@en ;
    gbo:moduleId "farmyard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Farmyard.size, gbl:Farmyard.surface ;
    gbo:hasSlot gbl:Farmyard.slot.ground ;
    gbo:hasChildRule gbl:Farmyard.child.clutter ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:Farmyard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Farmyard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Farmyard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Farmyard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:Farmyard.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:Farmyard.surface .

gbl:Farmyard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:FenceLine
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:LinearFeature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Fence"@en ;
    rdfs:comment "A fence run along a region's edge, with gaps for gates."@en ;
    gbo:moduleId "fence-line" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:FenceLine.gaps, gbl:FenceLine.length, gbl:FenceLine.material ;
    gbo:hasSlot gbl:FenceLine.slot.fence ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:along ;
        gbo:members "[\"self\",\"parent\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"offset\":0}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:FenceLine.gaps
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "gaps"@en ;
    rdfs:domain gbl:FenceLine ;
    gbo:fieldName "gaps" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 10.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON .

gbl:FenceLine.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:FenceLine ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[4,60]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FenceLine.material
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "material"@en ;
    rdfs:domain gbl:FenceLine ;
    gbo:fieldName "material" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood\""^^rdf:JSON ;
    gbo:vocabulary gbv:material .

gbl:FenceLine.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fence-piece-set ;
    gbo:conceptsFrom gbl:FenceLine.material .

gbl:Field
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Field"@en ;
    rdfs:comment "A field of one crop in rows."@en ;
    gbo:moduleId "field" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:Field.rows, gbl:Field.size, gbl:Field.crop, gbl:Field.season, gbl:Field.surface ;
    gbo:hasSlot gbl:Field.slot.crop, gbl:Field.slot.tilled ;
    gbo:constraint "rows <= size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.road\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Field.rows
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rows"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "rows" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[4,12]"^^rdf:JSON .

gbl:Field.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 80.0 ;
    gbo:maxHeight 80.0 ;
    gbo:defaultValue "{\"h\":[8,20],\"w\":[10,24]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Field.crop
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crop"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "crop" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wheat\""^^rdf:JSON ;
    gbo:allowedValue "wheat", "barley", "vegetables", "flax" .

gbl:Field.season
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "season"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "season" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"summer\""^^rdf:JSON ;
    gbo:allowedValue "spring", "summer", "harvest" .

gbl:Field.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:comment "The ground of the field: tilled soil, its own tile (made or found like grass and dirt)"@en ;
    rdfs:domain gbl:Field ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"tilled\""^^rdf:JSON ;
    gbo:vocabulary gbv:terrain-kind .

gbl:Field.slot.crop
    a gbo:Slot ;
    gbo:slotName "crop" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:crop ;
    gbo:conceptsFrom gbl:Field.crop .

gbl:Field.slot.tilled
    a gbo:Slot ;
    gbo:slotName "tilled" ;
    gbo:essential true ;
    gbo:needsRole gbr:tilled-terrain .

gbl:FireStationPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:PublicService, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Fire station plot"@en ;
    rdfs:comment "A fire station with its engines in front."@en ;
    gbo:moduleId "fire-station-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:FireStationPlot.setback, gbl:FireStationPlot.size, gbl:FireStationPlot.condition ;
    gbo:hasSlot gbl:FireStationPlot.slot.fire-station, gbl:FireStationPlot.slot.fire-truck, gbl:FireStationPlot.slot.street-light, gbl:FireStationPlot.slot.trash-bin ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:FireStationPlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:FireStationPlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FireStationPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FireStationPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[6,8],\"w\":[7,9]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FireStationPlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:FireStationPlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:FireStationPlot.slot.fire-station
    a gbo:Slot ;
    gbo:slotName "fire-station" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fire-station .

gbl:FireStationPlot.slot.fire-truck
    a gbo:Slot ;
    gbo:slotName "fire-truck" ;
    gbo:essential false ;
    gbo:needsRole gbr:fire-truck .

gbl:FireStationPlot.slot.street-light
    a gbo:Slot ;
    gbo:slotName "street-light" ;
    gbo:essential false ;
    gbo:needsRole gbr:street-light .

gbl:FireStationPlot.slot.trash-bin
    a gbo:Slot ;
    gbo:slotName "trash-bin" ;
    gbo:essential false ;
    gbo:needsRole gbr:trash-bin .

gbl:FishMarket
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Fish market"@en ;
    rdfs:comment "Fish stalls by the water."@en ;
    gbo:moduleId "fish-market" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:harbour ;
    gbo:hasField gbl:FishMarket.stalls ;
    gbo:hasSlot gbl:FishMarket.slot.stall ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.dock\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":6}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:FishMarket.stalls
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "stalls"@en ;
    rdfs:domain gbl:FishMarket ;
    gbo:fieldName "stalls" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[2,6]"^^rdf:JSON .

gbl:FishMarket.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stall ;
    gbo:showsConcept gbv:goods.fish .

gbl:FloodedRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:DungeonRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ambience
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Ambience
    ] ;
    rdfs:label "Flooded room"@en ;
    rdfs:comment "Standing water to wade through."@en ;
    gbo:moduleId "flooded-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:FloodedRoom.danger, gbl:FloodedRoom.size ;
    gbo:hasSlot gbl:FloodedRoom.slot.debris ;
    gbo:hasChildRule gbl:FloodedRoom.child.ambience ;
    gbo:origin "engine" .

gbl:FloodedRoom.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "danger"@en ;
    rdfs:domain gbl:FloodedRoom ;
    gbo:fieldName "danger" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "1"^^rdf:JSON .

gbl:FloodedRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FloodedRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[10,15],\"w\":[10,15]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FloodedRoom.slot.debris
    a gbo:Slot ;
    gbo:slotName "debris" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:debris .

gbl:FloodedRoom.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:FloorClutter
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Clutter"@en ;
    rdfs:comment "Things left lying about."@en ;
    gbo:moduleId "floor-clutter" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasField gbl:FloorClutter.items ;
    gbo:hasSlot gbl:FloorClutter.slot.item ;
    gbo:origin "engine" .

gbl:FloorClutter.items
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "items"@en ;
    rdfs:domain gbl:FloorClutter ;
    gbo:fieldName "items" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"rare\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.01,0.03,0.06,0.1]"^^rdf:JSON .

gbl:FloorClutter.slot.item
    a gbo:Slot ;
    gbo:slotName "item" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:prop .

gbl:FloorLevel
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Level, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:InteriorRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:InteriorRoom
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:InteriorRoom
    ] ;
    rdfs:label "Floor"@en ;
    rdfs:comment "One floor of the building: its rooms, the hall between them, the stairs."@en ;
    gbo:moduleId "floor-level" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:interior, gbb:courtyard ;
    gbo:hasField gbl:FloorLevel.rooms, gbl:FloorLevel.level ;
    gbo:hasSlot gbl:FloorLevel.slot.door, gbl:FloorLevel.slot.stairs, gbl:FloorLevel.slot.window ;
    gbo:hasChildRule gbl:FloorLevel.child.InteriorRoom ;
    gbo:origin "engine" .

gbl:FloorLevel.rooms
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rooms"@en ;
    rdfs:domain gbl:FloorLevel ;
    gbo:fieldName "rooms" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 60.0 ;
    gbo:defaultValue "[3,6]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:FloorLevel.level
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "level"@en ;
    rdfs:domain gbl:FloorLevel ;
    gbo:fieldName "level" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"ground\""^^rdf:JSON ;
    gbo:allowedValue "ground", "upper", "cellar" .

gbl:FloorLevel.slot.door
    a gbo:Slot ;
    gbo:slotName "door" ;
    gbo:essential true ;
    gbo:needsRole gbr:door .

gbl:FloorLevel.slot.stairs
    a gbo:Slot ;
    gbo:slotName "stairs" ;
    gbo:essential false ;
    gbo:needsRole gbr:stairs .

gbl:FloorLevel.slot.window
    a gbo:Slot ;
    gbo:slotName "window" ;
    gbo:essential false ;
    gbo:needsRole gbr:window .

gbl:FloorLevel.child.InteriorRoom
    a gbo:ChildRule ;
    gbo:child gbl:InteriorRoom ;
    gbo:minCount 1 ;
    gbo:maxCount 60 ;
    gbo:weight 1.0 .

gbl:Forest
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clearing gbl:NatureScatter )
        ]
    ] ;
    rdfs:label "Forest"@en ;
    rdfs:comment "Woodland, denser in the middle than at its edges."@en ;
    gbo:moduleId "forest" ;
    gbo:level gbo:Zone ;
    gbo:hasField gbl:Forest.area, gbl:Forest.clearings, gbl:Forest.trees, gbl:Forest.age, gbl:Forest.kind ;
    gbo:hasSlot gbl:Forest.slot.bush, gbl:Forest.slot.log, gbl:Forest.slot.mushroom, gbl:Forest.slot.tree ;
    gbo:hasChildRule gbl:Forest.child.clearing, gbl:Forest.child.nature-scatter ;
    gbo:origin "engine" .

gbl:Forest.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 20.0 ;
    gbo:defaultValue "[200,2000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Forest.clearings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "clearings"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "clearings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[0,2]"^^rdf:JSON .

gbl:Forest.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.08,0.2,0.35,0.55]"^^rdf:JSON .

gbl:Forest.age
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "age"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "age" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old\""^^rdf:JSON ;
    gbo:allowedValue "young", "old" .

gbl:Forest.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Forest ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"mixed\""^^rdf:JSON ;
    gbo:allowedValue "deciduous", "conifer", "mixed" .

gbl:Forest.slot.bush
    a gbo:Slot ;
    gbo:slotName "bush" ;
    gbo:essential false ;
    gbo:needsRole gbr:bush .

gbl:Forest.slot.log
    a gbo:Slot ;
    gbo:slotName "log" ;
    gbo:essential false ;
    gbo:needsRole gbr:log .

gbl:Forest.slot.mushroom
    a gbo:Slot ;
    gbo:slotName "mushroom" ;
    gbo:essential false ;
    gbo:needsRole gbr:mushroom .

gbl:Forest.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tree .

gbl:Forest.child.clearing
    a gbo:ChildRule ;
    gbo:child gbl:Clearing ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:countField gbl:Forest.clearings ;
    gbo:weight 0.5 .

gbl:Forest.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:Forge
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ForgeSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ForgeSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:ForgeSet gbl:RoomLights gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Forge"@en ;
    rdfs:comment "The anvil and the hearth."@en ;
    gbo:moduleId "forge" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:Forge.size, gbl:Forge.surface ;
    gbo:hasSlot gbl:Forge.slot.floor ;
    gbo:hasChildRule gbl:Forge.child.forge-set, gbl:Forge.child.room-lights, gbl:Forge.child.wall-decor ;
    gbo:origin "engine" .

gbl:Forge.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Forge ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,6],\"w\":[4,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Forge.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Forge ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"stone-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:Forge.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:Forge.child.forge-set
    a gbo:ChildRule ;
    gbo:child gbl:ForgeSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Forge.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Forge.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:ForgeSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Forge"@en ;
    rdfs:comment "An anvil by the hearth."@en ;
    gbo:moduleId "forge-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:ForgeSet.slot.anvil, gbl:ForgeSet.slot.hearth, gbl:ForgeSet.slot.rack ;
    gbo:origin "engine" .

gbl:ForgeSet.slot.anvil
    a gbo:Slot ;
    gbo:slotName "anvil" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:anvil .

gbl:ForgeSet.slot.hearth
    a gbo:Slot ;
    gbo:slotName "hearth" ;
    gbo:essential false ;
    gbo:needsRole gbr:fireplace .

gbl:ForgeSet.slot.rack
    a gbo:Slot ;
    gbo:slotName "rack" ;
    gbo:essential false ;
    gbo:needsRole gbr:weapon-rack .

gbl:FormalGarden
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:HedgeLine
    ] ;
    rdfs:label "Formal garden"@en ;
    rdfs:comment "Hedges and flowers laid out symmetrically, perhaps around a centrepiece."@en ;
    gbo:moduleId "formal-garden" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:FormalGarden.flowers, gbl:FormalGarden.hedges, gbl:FormalGarden.size, gbl:FormalGarden.centre, gbl:FormalGarden.flower-mix, gbl:FormalGarden.symmetry ;
    gbo:hasSlot gbl:FormalGarden.slot.flower, gbl:FormalGarden.slot.hedge, gbl:FormalGarden.slot.statue ;
    gbo:hasChildRule gbl:FormalGarden.child.hedge-line ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:symmetric ;
        gbo:members "[\"self.hedge\",\"self.flower\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"axis\":\"long\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:FormalGarden.flowers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "flowers"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "flowers" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:FormalGarden.hedges
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "hedges"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "hedges" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 40.0 ;
    gbo:defaultValue "[2,8]"^^rdf:JSON .

gbl:FormalGarden.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[8,14],\"w\":[8,14]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FormalGarden.centre
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "centre"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "centre" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"statue\""^^rdf:JSON ;
    gbo:allowedValue "fountain", "statue", "none" .

gbl:FormalGarden.flower-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "flower-mix"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "flower-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"lavender\":0.4,\"rose\":0.6}"^^rdf:JSON ;
    gbo:vocabulary gbv:flower-kind .

gbl:FormalGarden.symmetry
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "symmetry"@en ;
    rdfs:domain gbl:FormalGarden ;
    gbo:fieldName "symmetry" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "true"^^rdf:JSON .

gbl:FormalGarden.slot.flower
    a gbo:Slot ;
    gbo:slotName "flower" ;
    gbo:essential true ;
    gbo:needsRole gbr:flower ;
    gbo:conceptsFrom gbl:FormalGarden.flower-mix .

gbl:FormalGarden.slot.hedge
    a gbo:Slot ;
    gbo:slotName "hedge" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:hedge .

gbl:FormalGarden.slot.statue
    a gbo:Slot ;
    gbo:slotName "statue" ;
    gbo:essential false ;
    gbo:needsRole gbr:fountain, gbr:statue ;
    gbo:when "centre != 'none'"^^gbo:Expression .

gbl:FormalGarden.child.hedge-line
    a gbo:ChildRule ;
    gbo:child gbl:HedgeLine ;
    gbo:minCount 0 ;
    gbo:maxCount 40 ;
    gbo:countField gbl:FormalGarden.hedges ;
    gbo:weight 1.0 .

gbl:Fountain
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:WaterSource, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Fountain"@en ;
    rdfs:comment "A fountain."@en ;
    gbo:moduleId "fountain" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:Fountain.slot.fountain ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:Fountain.slot.fountain
    a gbo:Slot ;
    gbo:slotName "fountain" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fountain .

gbl:FountainSquare
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:OpenSpace, gbl:WaterSource, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FormalGarden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:FormalGarden
    ] ;
    rdfs:label "Fountain square"@en ;
    rdfs:comment "A square with a fountain and a formal garden."@en ;
    gbo:moduleId "fountain-square" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:FountainSquare.size ;
    gbo:hasSlot gbl:FountainSquare.slot.fountain ;
    gbo:hasChildRule gbl:FountainSquare.child.formal-garden ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:FountainSquare.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FountainSquare ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 5.0 ;
    gbo:minHeight 5.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[8,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FountainSquare.slot.fountain
    a gbo:Slot ;
    gbo:slotName "fountain" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fountain .

gbl:FountainSquare.child.formal-garden
    a gbo:ChildRule ;
    gbo:child gbl:FormalGarden ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.6 .

gbl:FrontYard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DoorstepSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:DoorstepSet
    ] ;
    rdfs:label "Front yard"@en ;
    rdfs:comment "The strip between the house and the street."@en ;
    gbo:moduleId "front-yard" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:FrontYard.depth, gbl:FrontYard.surface ;
    gbo:hasSlot gbl:FrontYard.slot.path ;
    gbo:hasChildRule gbl:FrontYard.child.doorstep-set ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-front-of ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:FrontYard.depth
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "depth"@en ;
    rdfs:domain gbl:FrontYard ;
    gbo:fieldName "depth" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FrontYard.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:FrontYard ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:FrontYard.slot.path
    a gbo:Slot ;
    gbo:slotName "path" ;
    gbo:essential false ;
    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:FrontYard.surface .

gbl:FrontYard.child.doorstep-set
    a gbo:ChildRule ;
    gbo:child gbl:DoorstepSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:Garden
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FenceLine gbl:VegetableBed )
        ]
    ] ;
    rdfs:label "Garden"@en ;
    rdfs:comment "A vegetable, flower or herb garden behind the house, maybe fenced."@en ;
    gbo:moduleId "garden" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:farmland, gbb:castle ;
    gbo:hasField gbl:Garden.beds, gbl:Garden.flowers, gbl:Garden.size, gbl:Garden.crop-mix, gbl:Garden.fenced, gbl:Garden.flower-mix, gbl:Garden.kind, gbl:Garden.path ;
    gbo:hasSlot gbl:Garden.slot.bed, gbl:Garden.slot.extra, gbl:Garden.slot.fence, gbl:Garden.slot.plant ;
    gbo:hasChildRule gbl:Garden.child.fence-line, gbl:Garden.child.vegetable-bed ;
    gbo:constraint "size.w * size.h >= 4"^^gbo:Expression, "beds * 2 <= size.w * size.h"^^gbo:Expression, "fenced implies asset(fence) != 'missing'"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self\",\"parent.primary\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.primary.back\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":2}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Garden.beds
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "beds"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "beds" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "[1,3]"^^rdf:JSON .

gbl:Garden.flowers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "flowers"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "flowers" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:Garden.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 12.0 ;
    gbo:maxHeight 10.0 ;
    gbo:defaultValue "{\"h\":[2,4],\"w\":[3,5]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Garden.crop-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "crop-mix"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "crop-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:vocabulary gbv:crop-kind ;
    gbo:when "kind in [vegetable, mixed]"^^gbo:Expression ;
    gbo:askedInConfirmation true .

gbl:Garden.fenced
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fenced"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "fenced" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "true"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Garden.flower-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "flower-mix"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "flower-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:vocabulary gbv:flower-kind ;
    gbo:when "kind in [flower, mixed]"^^gbo:Expression ;
    gbo:askedInConfirmation true .

gbl:Garden.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"vegetable\""^^rdf:JSON ;
    gbo:allowedValue "vegetable", "flower", "herb", "mixed" ;
    gbo:askedInConfirmation true .

gbl:Garden.path
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "path"@en ;
    rdfs:domain gbl:Garden ;
    gbo:fieldName "path" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:allowedValue "none", "dirt", "gravel", "stone" .

gbl:Garden.slot.bed
    a gbo:Slot ;
    gbo:slotName "bed" ;
    gbo:essential false ;
    gbo:needsRole gbr:garden-bed .

gbl:Garden.slot.extra
    a gbo:Slot ;
    gbo:slotName "extra" ;
    gbo:essential false ;
    gbo:needsRole gbr:garden-prop .

gbl:Garden.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential false ;
    gbo:needsRole gbr:fence-piece-set ;
    gbo:when "fenced"^^gbo:Expression .

gbl:Garden.slot.plant
    a gbo:Slot ;
    gbo:slotName "plant" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:crop, gbr:flower, gbr:herb ;
    gbo:conceptsFrom gbl:Garden.crop-mix, gbl:Garden.flower-mix .

gbl:Garden.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 ;
    gbo:when "fenced"^^gbo:Expression .

gbl:Garden.child.vegetable-bed
    a gbo:ChildRule ;
    gbo:child gbl:VegetableBed ;
    gbo:minCount 0 ;
    gbo:maxCount 12 ;
    gbo:countField gbl:Garden.beds ;
    gbo:weight 1.0 ;
    gbo:when "kind in [vegetable, mixed]"^^gbo:Expression .

gbl:GasStationPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Commercial, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Gas station plot"@en ;
    rdfs:comment "A gas station: pumps under a canopy, a shop, cars filling up."@en ;
    gbo:moduleId "gas-station-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:GasStationPlot.setback, gbl:GasStationPlot.size, gbl:GasStationPlot.condition ;
    gbo:hasSlot gbl:GasStationPlot.slot.car, gbl:GasStationPlot.slot.fuel-pump, gbl:GasStationPlot.slot.gas-station, gbl:GasStationPlot.slot.street-light ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:GasStationPlot.setback
