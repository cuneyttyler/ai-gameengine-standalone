    rdfs:domain gbl:Clearing ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 20.0 ;
    gbo:maxHeight 20.0 ;
    gbo:defaultValue "{\"h\":[4,8],\"w\":[4,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Clearing.child.campfire-ring
    a gbo:ChildRule ;
    gbo:child gbl:CampfireRing ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:Clearing.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Clutter
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Dressing, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Clutter"@en ;
    rdfs:comment "Barrels, crates, sacks and carts near doors and walls."@en ;
    gbo:moduleId "clutter" ;
    gbo:level gbo:Dressing ;
    gbo:hasField gbl:Clutter.items, gbl:Clutter.theme ;
    gbo:hasSlot gbl:Clutter.slot.item ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.door\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":1,\"d1\":4}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Clutter.items
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "items"@en ;
    rdfs:domain gbl:Clutter ;
    gbo:fieldName "items" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.02,0.06,0.12,0.2]"^^rdf:JSON .

gbl:Clutter.theme
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "theme"@en ;
    rdfs:domain gbl:Clutter ;
    gbo:fieldName "theme" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"farm\""^^rdf:JSON ;
    gbo:vocabulary gbv:clutter-theme .

gbl:Clutter.slot.item
    a gbo:Slot ;
    gbo:slotName "item" ;
    gbo:essential false ;
    gbo:needsRole gbr:barrel, gbr:cart, gbr:crate, gbr:sack, gbr:tool .

