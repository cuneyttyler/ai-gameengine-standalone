gbl:GuestRoom.child.bed-set
    a gbo:ChildRule ;
    gbo:child gbl:BedSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:GuestRoom.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:GuestRoom.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

