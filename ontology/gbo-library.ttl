gbl:Hay
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Hay"@en ;
    rdfs:comment "A hay pile or stack of bales."@en ;
    gbo:moduleId "hay" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:Hay.slot.hay ;
    gbo:origin "engine" .

gbl:Hay.slot.hay
    a gbo:Slot ;
    gbo:slotName "hay" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:hay .

gbl:HearthSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Hearth"@en ;
    rdfs:comment "A fireplace on the wall, chairs and a rug before it."@en ;
    gbo:moduleId "hearth-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:HearthSet.slot.chair, gbl:HearthSet.slot.fireplace, gbl:HearthSet.slot.rug, gbl:HearthSet.slot.woodpile ;
    gbo:origin "engine" .

gbl:HearthSet.slot.chair
    a gbo:Slot ;
    gbo:slotName "chair" ;
    gbo:essential false ;
    gbo:needsRole gbr:chair .

gbl:HearthSet.slot.fireplace
    a gbo:Slot ;
    gbo:slotName "fireplace" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fireplace .

gbl:HearthSet.slot.rug
    a gbo:Slot ;
    gbo:slotName "rug" ;
    gbo:essential false ;
    gbo:needsRole gbr:rug .

gbl:HearthSet.slot.woodpile
    a gbo:Slot ;
    gbo:slotName "woodpile" ;
    gbo:essential false ;
    gbo:needsRole gbr:log-pile .

gbl:Heartland
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Landmark
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Site
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Landmark gbl:Site )
        ]
    ] ;
    rdfs:label "Heartland"@en ;
    rdfs:comment "The settled land: the region's sites and landmarks, and the roads between them."@en ;
    gbo:moduleId "heartland" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:region ;
    gbo:hasField gbl:Heartland.area, gbl:Heartland.sites, gbl:Heartland.trees ;
    gbo:hasSlot gbl:Heartland.slot.tree ;
    gbo:hasChildRule gbl:Heartland.child.landmark, gbl:Heartland.child.site ;
    gbo:origin "engine" .

gbl:Heartland.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Heartland ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[10000,80000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Heartland.sites
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "sites"@en ;
    rdfs:domain gbl:Heartland ;
    gbo:fieldName "sites" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Heartland.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Heartland ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"rare\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.005,0.015,0.04,0.08]"^^rdf:JSON .

gbl:Heartland.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tree .

gbl:Heartland.child.landmark
    a gbo:ChildRule ;
    gbo:child gbl:Landmark ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 0.5 .

gbl:Heartland.child.site
    a gbo:ChildRule ;
    gbo:child gbl:Site ;
    gbo:minCount 1 ;
    gbo:maxCount 80 ;
    gbo:countField gbl:Heartland.sites ;
    gbo:weight 1.0 .

gbl:HedgeLine
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:LinearFeature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Hedge"@en ;
    rdfs:comment "A hedge along an edge (pieces, or bushes in a line)."@en ;
    gbo:moduleId "hedge-line" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:HedgeLine.length, gbl:HedgeLine.kind ;
    gbo:hasSlot gbl:HedgeLine.slot.hedge ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:along ;
        gbo:members "[\"self\",\"parent\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"offset\":0}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:HedgeLine.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:HedgeLine ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[4,60]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HedgeLine.kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:HedgeLine ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wild\""^^rdf:JSON ;
    gbo:allowedValue "box", "wild" .

gbl:HedgeLine.slot.hedge
    a gbo:Slot ;
    gbo:slotName "hedge" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:bush, gbr:hedge-piece-set .

gbl:HorseLine
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Horse line"@en ;
    rdfs:comment "Horses tethered in a row."@en ;
    gbo:moduleId "horse-line" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:camp ;
    gbo:hasField gbl:HorseLine.horses, gbl:HorseLine.size ;
    gbo:hasSlot gbl:HorseLine.slot.horse, gbl:HorseLine.slot.post ;
    gbo:origin "engine" .

gbl:HorseLine.horses
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "horses"@en ;
    rdfs:domain gbl:HorseLine ;
    gbo:fieldName "horses" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[2,5]"^^rdf:JSON .

gbl:HorseLine.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:HorseLine ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 16.0 ;
    gbo:maxHeight 6.0 ;
    gbo:defaultValue "{\"h\":[2,3],\"w\":[6,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HorseLine.slot.horse
    a gbo:Slot ;
    gbo:slotName "horse" ;
    gbo:essential false ;
    gbo:needsRole gbr:horse .

gbl:HorseLine.slot.post
    a gbo:Slot ;
    gbo:slotName "post" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:hitching-post .

gbl:HousePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DoorstepSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FrontYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:DoorstepSet gbl:FenceLine gbl:FrontYard gbl:Garden )
        ]
    ] ;
    rdfs:label "House plot"@en ;
    rdfs:comment "A house on its plot, facing the street, with a yard and maybe a garden."@en ;
    gbo:moduleId "house-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:HousePlot.setback, gbl:HousePlot.size, gbl:HousePlot.condition, gbl:HousePlot.fenced, gbl:HousePlot.house-kind, gbl:HousePlot.wealth ;
    gbo:hasSlot gbl:HousePlot.slot.fence, gbl:HousePlot.slot.house, gbl:HousePlot.slot.outbuilding ;
    gbo:hasChildRule gbl:HousePlot.child.doorstep-set, gbl:HousePlot.child.fence-line, gbl:HousePlot.child.front-yard, gbl:HousePlot.child.garden ;
    gbo:constraint "count(children(garden)) <= 2"^^gbo:Expression, "size.w * size.h >= 12"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:behind ;
        gbo:members "[\"self.outbuilding\",\"self.primary\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:HousePlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "[0,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HousePlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 16.0 ;
    gbo:maxHeight 20.0 ;
    gbo:defaultValue "{\"h\":[6,10],\"w\":[5,7]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:HousePlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:HousePlot.fenced
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fenced"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "fenced" ;
    gbo:fieldType gbo:bool ;
    gbo:defaultValue "false"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:HousePlot.house-kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "house-kind"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "house-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"cottage\""^^rdf:JSON ;
    gbo:vocabulary gbv:house-kind ;
    gbo:askedInConfirmation true .

gbl:HousePlot.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:HousePlot ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth .

gbl:HousePlot.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential false ;
    gbo:needsRole gbr:fence-piece-set ;
    gbo:when "fenced"^^gbo:Expression .

gbl:HousePlot.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:house ;
    gbo:conceptsFrom gbl:HousePlot.house-kind .

gbl:HousePlot.slot.outbuilding
    a gbo:Slot ;
    gbo:slotName "outbuilding" ;
    gbo:essential false ;
    gbo:needsRole gbr:outbuilding .

gbl:HousePlot.child.doorstep-set
    a gbo:ChildRule ;
    gbo:child gbl:DoorstepSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:HousePlot.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 ;
    gbo:when "fenced"^^gbo:Expression .

gbl:HousePlot.child.front-yard
    a gbo:ChildRule ;
    gbo:child gbl:FrontYard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:HousePlot.child.garden
    a gbo:ChildRule ;
    gbo:child gbl:Garden ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.5 .

gbl:InnPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Workplace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Sign
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StableYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Yard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Sign gbl:StableYard gbl:Yard )
        ]
    ] ;
    rdfs:label "Inn plot"@en ;
    rdfs:comment "An inn with its stable and yard, and a sign at the door."@en ;
    gbo:moduleId "inn-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:InnPlot.rooms, gbl:InnPlot.size, gbl:InnPlot.standing ;
    gbo:hasSlot gbl:InnPlot.slot.inn, gbl:InnPlot.slot.stable ;
    gbo:hasChildRule gbl:InnPlot.child.sign, gbl:InnPlot.child.stable-yard, gbl:InnPlot.child.yard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.8
    ] ;
    gbo:origin "engine" .

gbl:InnPlot.rooms
    a gbo:QuantityField, owl:DatatypeProperty ;
