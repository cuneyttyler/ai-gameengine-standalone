gbl:Downtown
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HotelPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeTowerPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ParkingGaragePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Plaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RestaurantPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "80"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RetailPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TransitStationPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:HotelPlot gbl:OfficePlot gbl:OfficeTowerPlot gbl:ParkingGaragePlot gbl:Plaza gbl:RestaurantPlot gbl:RetailPlot gbl:Road gbl:TransitStationPlot )
        ]
    ] ;
    rdfs:label "Downtown"@en ;
    rdfs:comment "The heart of the city: office towers, hotels, shops at street level, plazas, a station."@en ;
    gbo:moduleId "downtown" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:Downtown.area, gbl:Downtown.footprint-density, gbl:Downtown.plots, gbl:Downtown.density, gbl:Downtown.street-style, gbl:Downtown.wealth ;
    gbo:hasSlot gbl:Downtown.slot.car ;
    gbo:hasChildRule gbl:Downtown.child.hotel-plot, gbl:Downtown.child.office-plot, gbl:Downtown.child.office-tower-plot, gbl:Downtown.child.parking-garage-plot, gbl:Downtown.child.plaza, gbl:Downtown.child.restaurant-plot, gbl:Downtown.child.retail-plot, gbl:Downtown.child.road, gbl:Downtown.child.transit-station-plot ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 2.0
    ], [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:Downtown.area
