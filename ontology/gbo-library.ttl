    gbo:hasChildRule gbl:Bailey.child.barracks-plot, gbl:Bailey.child.chapel-plot, gbl:Bailey.child.clutter, gbl:Bailey.child.garden, gbl:Bailey.child.keep-plot, gbl:Bailey.child.smithy-plot, gbl:Bailey.child.stables-plot, gbl:Bailey.child.storehouse-plot, gbl:Bailey.child.training-yard, gbl:Bailey.child.well-plaza ;
    gbo:origin "engine" .

