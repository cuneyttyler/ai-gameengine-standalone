gbl:Wall.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:Wall ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 4.0 ;
    gbo:defaultValue "[40,800]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Wall.towers
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "towers"@en ;
    rdfs:domain gbl:Wall ;
    gbo:fieldName "towers" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[0,8]"^^rdf:JSON .

gbl:Wall.condition
    a gbo:QualityField, owl:ObjectProperty ;
