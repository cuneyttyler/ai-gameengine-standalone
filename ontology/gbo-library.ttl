gbl:Park.slot.park-bench
    a gbo:Slot ;
    gbo:slotName "park-bench" ;
    gbo:essential false ;
    gbo:needsRole gbr:park-bench .

gbl:Park.slot.picnic-table
    a gbo:Slot ;
    gbo:slotName "picnic-table" ;
