# --- Build types ---

gbb:settlement
    a gbo:BuildType ;
    rdfs:label "Settlement"@en ;
    gbo:rootModule gbl:Settlement ;
    gbo:component gbl:ResidentialWard, gbl:MarketWard, gbl:CraftsmenWard, gbl:MerchantWard, gbl:PatricianWard, gbl:Slum, gbl:TempleWard, gbl:CastleWard, gbl:GateWard, gbl:Docks, gbl:Commons, gbl:FarmlandRing, gbl:Outskirts, gbl:MarketSquare, gbl:WellPlaza, gbl:HousePlot, gbl:Farmstead, gbl:Garden, gbl:Orchard, gbl:Field, gbl:Graveyard, gbl:Wall, gbl:Road, gbl:River, gbl:Lake, gbl:Pond, gbl:Forest, gbl:Meadow, gbl:FenceLine, gbl:HedgeLine, gbl:NatureScatter, gbl:Clutter, gbl:Lights, gbl:GroundDecals ;
    gbo:stages "[\"site & terrain\",\"networks\",\"zones\",\"streets & parcels\",\"parcel contents\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[\"river\",\"lake\",\"hill\",\"coast\",\"crossroads\"],\"growth\":[\"walled-core\",\"farms-outside\",\"along-road\",\"river-crossing\"],\"layout\":[\"organic\",\"grid\",\"radial\",\"linear-along-road\",\"linear-along-river\"],\"style\":{\"biome\":\"biome\",\"condition\":\"condition\",\"culture\":[\"western\",\"northern\",\"eastern\",\"southern\"],\"era\":[\"ancient\",\"medieval\",\"renaissance\"]},\"walled\":[\"none\",\"palisade\",\"stone\"]}"^^rdf:JSON ;
    gbo:hasScale gbb:settlement.hamlet, gbb:settlement.village, gbb:settlement.large-village, gbb:settlement.town, gbb:settlement.city .

gbb:settlement.hamlet
    a gbo:ScaleClass ;
    rdfs:label "hamlet"@en ;
    gbo:minBuildings 5 ;
    gbo:maxBuildings 15 ;
    gbo:minSide 30 ;
    gbo:maxSide 50 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:settlement.village
    a gbo:ScaleClass ;
    rdfs:label "village"@en ;
    gbo:minBuildings 15 ;
    gbo:maxBuildings 60 ;
    gbo:minSide 60 ;
    gbo:maxSide 100 ;
    gbo:minZones 1 ;
    gbo:maxZones 3 .

gbb:settlement.large-village
    a gbo:ScaleClass ;
    rdfs:label "large-village"@en ;
    gbo:minBuildings 60 ;
    gbo:maxBuildings 150 ;
    gbo:minSide 110 ;
    gbo:maxSide 160 ;
    gbo:minZones 3 ;
    gbo:maxZones 6 .

gbb:settlement.town
    a gbo:ScaleClass ;
    rdfs:label "town"@en ;
    gbo:minBuildings 150 ;
    gbo:maxBuildings 500 ;
    gbo:minSide 180 ;
    gbo:maxSide 300 ;
    gbo:minZones 5 ;
    gbo:maxZones 12 .

gbb:settlement.city
    a gbo:ScaleClass ;
    rdfs:label "city"@en ;
    gbo:minBuildings 500 ;
    gbo:maxBuildings 3000 ;
    gbo:minSide 300 ;
    gbo:maxSide 800 ;
    gbo:minZones 12 ;
    gbo:maxZones 40 .

