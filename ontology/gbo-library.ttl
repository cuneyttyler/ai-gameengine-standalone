    gbo:child gbl:SchoolPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.1 .

gbl:Suburb.child.suburban-house-plot
    a gbo:ChildRule ;
    gbo:child gbl:SuburbanHousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 400 ;
    gbo:weight 1.0 .

gbl:SuburbanHousePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Suburban house plot"@en ;
    rdfs:comment "A detached house with a lawn, a driveway and a car."@en ;
    gbo:moduleId "suburban-house-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:SuburbanHousePlot.setback, gbl:SuburbanHousePlot.size, gbl:SuburbanHousePlot.condition, gbl:SuburbanHousePlot.house-kind, gbl:SuburbanHousePlot.wealth ;
    gbo:hasSlot gbl:SuburbanHousePlot.slot.car, gbl:SuburbanHousePlot.slot.mailbox, gbl:SuburbanHousePlot.slot.suburban-house, gbl:SuburbanHousePlot.slot.trash-bin, gbl:SuburbanHousePlot.slot.tree ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
