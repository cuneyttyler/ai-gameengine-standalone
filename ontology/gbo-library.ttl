gbl:Heartland
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Landmark
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Site
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Landmark gbl:Site )
        ]
    ] ;
    rdfs:label "Heartland"@en ;
    rdfs:comment "The settled land: the region's sites and landmarks, and the roads between them."@en ;
    gbo:moduleId "heartland" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:region ;
    gbo:hasField gbl:Heartland.area, gbl:Heartland.sites, gbl:Heartland.trees ;
    gbo:hasSlot gbl:Heartland.slot.tree ;
    gbo:hasChildRule gbl:Heartland.child.landmark, gbl:Heartland.child.site ;
    gbo:origin "engine" .

gbl:Heartland.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Heartland ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[10000,80000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Heartland.sites
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "sites"@en ;
    rdfs:domain gbl:Heartland ;
    gbo:fieldName "sites" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Heartland.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Heartland ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"rare\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.005,0.015,0.04,0.08]"^^rdf:JSON .

gbl:Heartland.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tree .

gbl:Heartland.child.landmark
    a gbo:ChildRule ;
    gbo:child gbl:Landmark ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 0.5 .

gbl:Heartland.child.site
    a gbo:ChildRule ;
    gbo:child gbl:Site ;
    gbo:minCount 1 ;
    gbo:maxCount 80 ;
    gbo:countField gbl:Heartland.sites ;
    gbo:weight 1.0 .

