gbl:BiomeZone
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Biome"@en ;
    rdfs:comment "A stretch of one kind of land: forest, plains, hills, swamp, desert or tundra."@en ;
