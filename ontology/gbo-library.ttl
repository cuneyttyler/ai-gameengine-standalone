    gbo:weight 0.5 .

gbl:IndustrialDistrict
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FactoryPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:GasStationPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:LogisticsPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ParkingLot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FactoryPlot gbl:GasStationPlot gbl:LogisticsPlot gbl:ParkingLot gbl:Road )
        ]
    ] ;
    rdfs:label "Industrial district"@en ;
    rdfs:comment "Factories and logistics warehouses with yards, trucks and parking."@en ;
    gbo:moduleId "industrial-district" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:IndustrialDistrict.area, gbl:IndustrialDistrict.footprint-density, gbl:IndustrialDistrict.plots, gbl:IndustrialDistrict.density, gbl:IndustrialDistrict.street-style, gbl:IndustrialDistrict.wealth ;
    gbo:hasSlot gbl:IndustrialDistrict.slot.truck ;
    gbo:hasChildRule gbl:IndustrialDistrict.child.factory-plot, gbl:IndustrialDistrict.child.gas-station-plot, gbl:IndustrialDistrict.child.logistics-plot, gbl:IndustrialDistrict.child.parking-lot, gbl:IndustrialDistrict.child.road ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.residential-district\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d\":15}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "downstream" ;
        gbo:weight 0.5
    ], [
        a gbo:SitePreference ;
        gbo:criterion "edge" ;
        gbo:weight 2.0
    ], [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 0.5
    ] ;
    gbo:origin "engine" .

