    rdfs:subClassOf gbo:Feature, gbl:Yard, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Lumber yard"@en ;
    rdfs:comment "Log piles and a saw."@en ;
    gbo:moduleId "lumber-yard" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:LumberYard.piles, gbl:LumberYard.size ;
    gbo:hasSlot gbl:LumberYard.slot.pile, gbl:LumberYard.slot.saw ;
    gbo:origin "engine" .

gbl:LumberYard.piles
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "piles"@en ;
    rdfs:domain gbl:LumberYard ;
    gbo:fieldName "piles" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 30.0 ;
    gbo:defaultValue "[2,6]"^^rdf:JSON .

gbl:LumberYard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:LumberYard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 30.0 ;
    gbo:maxHeight 30.0 ;
    gbo:defaultValue "{\"h\":[6,10],\"w\":[6,10]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:LumberYard.slot.pile
    a gbo:Slot ;
    gbo:slotName "pile" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:log-pile .

gbl:LumberYard.slot.saw
    a gbo:Slot ;
    gbo:slotName "saw" ;
    gbo:essential false ;
    gbo:needsRole gbr:saw .

gbl:MallPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Commercial, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Mall plot"@en ;
    rdfs:comment "A shopping mall surrounded by parking."@en ;
    gbo:moduleId "mall-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:MallPlot.setback, gbl:MallPlot.size, gbl:MallPlot.condition ;
    gbo:hasSlot gbl:MallPlot.slot.car, gbl:MallPlot.slot.mall, gbl:MallPlot.slot.street-light, gbl:MallPlot.slot.trash-bin ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:MallPlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:MallPlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:MallPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:MallPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[14,20],\"w\":[14,20]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:MallPlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:MallPlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:MallPlot.slot.car
    a gbo:Slot ;
    gbo:slotName "car" ;
    gbo:essential false ;
    gbo:needsRole gbr:car .

gbl:MallPlot.slot.mall
    a gbo:Slot ;
    gbo:slotName "mall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:mall .

gbl:MallPlot.slot.street-light
    a gbo:Slot ;
    gbo:slotName "street-light" ;
    gbo:essential false ;
    gbo:needsRole gbr:street-light .

gbl:MallPlot.slot.trash-bin
    a gbo:Slot ;
    gbo:slotName "trash-bin" ;
    gbo:essential false ;
    gbo:needsRole gbr:trash-bin .

gbl:ManorPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Courtyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FormalGarden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Fountain
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Courtyard gbl:FormalGarden gbl:Fountain )
        ]
    ] ;
    rdfs:label "Manor plot"@en ;
    rdfs:comment "A manor behind a wall, with a formal garden, courtyard and fountain."@en ;
    gbo:moduleId "manor-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:ManorPlot.size, gbl:ManorPlot.grandeur ;
    gbo:hasSlot gbl:ManorPlot.slot.manor, gbl:ManorPlot.slot.wall ;
    gbo:hasChildRule gbl:ManorPlot.child.courtyard, gbl:ManorPlot.child.formal-garden, gbl:ManorPlot.child.fountain ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.8
    ] ;
    gbo:origin "engine" .

gbl:ManorPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ManorPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 10.0 ;
    gbo:minHeight 10.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[16,28],\"w\":[16,28]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ManorPlot.grandeur
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "grandeur"@en ;
    rdfs:domain gbl:ManorPlot ;
    gbo:fieldName "grandeur" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"modest\""^^rdf:JSON ;
    gbo:allowedValue "modest", "grand" .

gbl:ManorPlot.slot.manor
    a gbo:Slot ;
    gbo:slotName "manor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:manor .

gbl:ManorPlot.slot.wall
    a gbo:Slot ;
    gbo:slotName "wall" ;
    gbo:essential false ;
    gbo:needsRole gbr:wall-piece-set .

gbl:ManorPlot.child.courtyard
    a gbo:ChildRule ;
    gbo:child gbl:Courtyard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:ManorPlot.child.formal-garden
    a gbo:ChildRule ;
    gbo:child gbl:FormalGarden ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.8 .

gbl:ManorPlot.child.fountain
    a gbo:ChildRule ;
    gbo:child gbl:Fountain ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 .

gbl:MarketSquare
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:OpenSpace, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MarketStalls
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WellPlaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Clutter gbl:MarketStalls gbl:WellPlaza )
        ]
    ] ;
    rdfs:label "Market square"@en ;
    rdfs:comment "An open square with stalls and a centrepiece."@en ;
    gbo:moduleId "market-square" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement, gbb:harbour ;
    gbo:hasField gbl:MarketSquare.crowd, gbl:MarketSquare.size, gbl:MarketSquare.stalls, gbl:MarketSquare.centrepiece, gbl:MarketSquare.surface ;
    gbo:hasSlot gbl:MarketSquare.slot.centrepiece, gbl:MarketSquare.slot.ground, gbl:MarketSquare.slot.stall ;
    gbo:hasChildRule gbl:MarketSquare.child.clutter, gbl:MarketSquare.child.market-stalls, gbl:MarketSquare.child.well-plaza ;
    gbo:constraint "stalls * 6 <= size.w * size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self.centrepiece\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 1.0
    ], [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.8
    ] ;
    gbo:origin "engine" .

gbl:MarketSquare.crowd
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "crowd"@en ;
    rdfs:domain gbl:MarketSquare ;
    gbo:fieldName "crowd" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:MarketSquare.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:MarketSquare ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 6.0 ;
    gbo:minHeight 6.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[10,14]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:MarketSquare.stalls
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "stalls"@en ;
    rdfs:domain gbl:MarketSquare ;
    gbo:fieldName "stalls" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[6,10]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:MarketSquare.centrepiece
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "centrepiece"@en ;
    rdfs:domain gbl:MarketSquare ;
    gbo:fieldName "centrepiece" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"well\""^^rdf:JSON ;
    gbo:allowedValue "well", "fountain", "statue", "cross", "none" ;
    gbo:askedInConfirmation true .

gbl:MarketSquare.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:MarketSquare ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"cobble\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface .

gbl:MarketSquare.slot.centrepiece
    a gbo:Slot ;
    gbo:slotName "centrepiece" ;
    gbo:essential false ;
    gbo:needsRole gbr:fountain, gbr:statue, gbr:well ;
    gbo:when "centrepiece != 'none'"^^gbo:Expression .

gbl:MarketSquare.slot.ground
    a gbo:Slot ;
    gbo:slotName "ground" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:square-terrain ;
    gbo:conceptsFrom gbl:MarketSquare.surface .

gbl:MarketSquare.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential true ;
    gbo:needsRole gbr:stall .

gbl:MarketSquare.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:MarketSquare.child.market-stalls
    a gbo:ChildRule ;
    gbo:child gbl:MarketStalls ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 1.0 .

gbl:MarketSquare.child.well-plaza
    a gbo:ChildRule ;
    gbo:child gbl:WellPlaza ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.4 .

gbl:MarketStalls
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Market stalls"@en ;
    rdfs:comment "Stalls in rows facing each other, or around the edge."@en ;
    gbo:moduleId "market-stalls" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:MarketStalls.stalls, gbl:MarketStalls.goods-mix ;
    gbo:hasSlot gbl:MarketStalls.slot.awning, gbl:MarketStalls.slot.crate, gbl:MarketStalls.slot.stall ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.stall\",\"self.stall\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"axis\":\"x\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:MarketStalls.stalls
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "stalls"@en ;
    rdfs:domain gbl:MarketStalls ;
    gbo:fieldName "stalls" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 100.0 ;
    gbo:defaultValue "[4,10]"^^rdf:JSON .

gbl:MarketStalls.goods-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "goods-mix"@en ;
    rdfs:domain gbl:MarketStalls ;
    gbo:fieldName "goods-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"cloth\":0.2,\"food\":0.4,\"general\":0.4}"^^rdf:JSON ;
    gbo:vocabulary gbv:goods .

gbl:MarketStalls.slot.awning
    a gbo:Slot ;
    gbo:slotName "awning" ;
    gbo:essential false ;
    gbo:needsRole gbr:awning .

gbl:MarketStalls.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:MarketStalls.slot.stall
    a gbo:Slot ;
    gbo:slotName "stall" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stall ;
    gbo:conceptsFrom gbl:MarketStalls.goods-mix .

gbl:MarketWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:InnPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MarketSquare
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MarketSquare
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShopPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WellPlaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:InnPlot gbl:MarketSquare gbl:Road gbl:ShopPlot gbl:WellPlaza )
        ]
    ] ;
    rdfs:label "Market ward"@en ;
    rdfs:comment "The centre: the market square, shops, inns and a well."@en ;
    gbo:moduleId "market-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:MarketWard.area, gbl:MarketWard.plots, gbl:MarketWard.bustle, gbl:MarketWard.street-style, gbl:MarketWard.wealth ;
    gbo:hasChildRule gbl:MarketWard.child.inn-plot, gbl:MarketWard.child.market-square, gbl:MarketWard.child.road, gbl:MarketWard.child.shop-plot, gbl:MarketWard.child.well-plaza ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:center ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:along ;
        gbo:members "[\"self\",\"parent.main-road\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"offset\":0}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 0.9
    ], [
        a gbo:SitePreference ;
        gbo:criterion "main-road" ;
        gbo:weight 0.8
    ] ;
    gbo:origin "engine" .

gbl:MarketWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:MarketWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[600,2500]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:MarketWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
