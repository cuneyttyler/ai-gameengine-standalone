gbl:TownhouseBlock.slot.townhouse
    a gbo:Slot ;
    gbo:slotName "townhouse" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:townhouse .

gbl:TownhouseBlock.child.courtyard
    a gbo:ChildRule ;
    gbo:child gbl:Courtyard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 ;
    gbo:when "courtyard"^^gbo:Expression .

gbl:Trough
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Trough"@en ;
    rdfs:comment "A water trough for animals."@en ;
    gbo:moduleId "trough" ;
    gbo:level gbo:Feature ;
    gbo:hasSlot gbl:Trough.slot.trough ;
    gbo:origin "engine" .

gbl:Trough.slot.trough
    a gbo:Slot ;
    gbo:slotName "trough" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:trough .

gbl:VegetableBed
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Vegetable bed"@en ;
    rdfs:comment "A tilled bed of crops."@en ;
    gbo:moduleId "vegetable-bed" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:VegetableBed.plants, gbl:VegetableBed.size, gbl:VegetableBed.crop-mix ;
    gbo:hasSlot gbl:VegetableBed.slot.crop, gbl:VegetableBed.slot.tilled ;
    gbo:origin "engine" .

gbl:VegetableBed.plants
    a gbo:QuantityField, owl:DatatypeProperty ;
