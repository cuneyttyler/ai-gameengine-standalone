gbl:Meadow.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Meadow ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 10.0 ;
    gbo:defaultValue "[60,1000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Meadow.flowers
    a gbo:QuantityField, owl:DatatypeProperty ;
