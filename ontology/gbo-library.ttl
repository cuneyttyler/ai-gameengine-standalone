gbl:Yard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

# --- Build types ---

gbb:camp
    a gbo:BuildType ;
    rdfs:label "Camp"@en ;
    gbo:rootModule gbl:Camp ;
    gbo:component gbl:CampGround, gbl:TentPlot, gbl:CommandTentPlot, gbl:CampfireRing, gbl:SupplyArea, gbl:HorseLine, gbl:Lookout, gbl:TrainingYard, gbl:Wall, gbl:Road, gbl:Clutter, gbl:Forest, gbl:Meadow, gbl:RockField, gbl:River, gbl:Lake, gbl:Pond, gbl:NatureScatter ;
    gbo:stages "[\"site & terrain\",\"lanes\",\"tents\",\"fires & stores\",\"enclosure\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[\"river\",\"lake\",\"hill\"],\"style\":{\"biome\":\"biome\",\"condition\":\"condition\"},\"walled\":[\"none\",\"palisade\"]}"^^rdf:JSON ;
    gbo:hasScale gbb:camp.small-camp, gbb:camp.camp, gbb:camp.war-camp .

gbb:camp.small-camp
    a gbo:ScaleClass ;
    rdfs:label "small-camp"@en ;
    gbo:minBuildings 3 ;
    gbo:maxBuildings 8 ;
    gbo:minSide 30 ;
    gbo:maxSide 50 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:camp.camp
    a gbo:ScaleClass ;
    rdfs:label "camp"@en ;
    gbo:minBuildings 8 ;
    gbo:maxBuildings 24 ;
    gbo:minSide 50 ;
    gbo:maxSide 80 ;
    gbo:minZones 1 ;
    gbo:maxZones 2 .

gbb:camp.war-camp
    a gbo:ScaleClass ;
    rdfs:label "war-camp"@en ;
    gbo:minBuildings 24 ;
    gbo:maxBuildings 80 ;
    gbo:minSide 80 ;
    gbo:maxSide 140 ;
    gbo:minZones 2 ;
    gbo:maxZones 4 .

gbb:castle
    a gbo:BuildType ;
    rdfs:label "Castle"@en ;
    gbo:rootModule gbl:Castle ;
    gbo:component gbl:Bailey, gbl:KeepPlot, gbl:BarracksPlot, gbl:ChapelPlot, gbl:SmithyPlot, gbl:StorehousePlot, gbl:StablesPlot, gbl:TrainingYard, gbl:WellPlaza, gbl:Garden, gbl:CurtainWall, gbl:Moat, gbl:Road, gbl:Clutter, gbl:Forest, gbl:Meadow, gbl:RockField, gbl:River, gbl:Lake, gbl:Pond, gbl:NatureScatter ;
    gbo:stages "[\"site & terrain\",\"curtain wall, towers & gatehouse\",\"baileys\",\"buildings\",\"features\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[\"river\",\"lake\",\"hill\",\"coast\"],\"style\":{\"biome\":\"biome\",\"condition\":\"condition\",\"era\":[\"ancient\",\"medieval\",\"renaissance\"]}}"^^rdf:JSON ;
    gbo:hasScale gbb:castle.tower-house, gbb:castle.castle, gbb:castle.fortress .

gbb:castle.tower-house
    a gbo:ScaleClass ;
    rdfs:label "tower-house"@en ;
    gbo:minBuildings 2 ;
    gbo:maxBuildings 4 ;
    gbo:minSide 40 ;
    gbo:maxSide 60 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:castle.castle
    a gbo:ScaleClass ;
    rdfs:label "castle"@en ;
    gbo:minBuildings 4 ;
    gbo:maxBuildings 12 ;
    gbo:minSide 60 ;
    gbo:maxSide 120 ;
    gbo:minZones 1 ;
    gbo:maxZones 2 .

gbb:castle.fortress
    a gbo:ScaleClass ;
    rdfs:label "fortress"@en ;
    gbo:minBuildings 12 ;
    gbo:maxBuildings 40 ;
    gbo:minSide 120 ;
    gbo:maxSide 200 ;
    gbo:minZones 2 ;
    gbo:maxZones 3 .

gbb:courtyard
    a gbo:BuildType ;
    rdfs:label "Courtyard"@en ;
    gbo:rootModule gbl:CourtyardComplex ;
    gbo:component gbl:FloorLevel, gbl:Court, gbl:Chamber, gbl:Hall, gbl:Storage, gbl:Cellar, gbl:LivingRoom, gbl:Kitchen, gbl:Bedroom, gbl:DiningRoom, gbl:GuestRoom, gbl:GreatHall, gbl:ThroneRoom, gbl:Library, gbl:Study, gbl:Treasury, gbl:Cells, gbl:Nave, gbl:Sanctuary, gbl:Vestry, gbl:DiningSet, gbl:BedSet, gbl:HearthSet, gbl:WorkSet, gbl:ShelfWall, gbl:DisplaySet, gbl:AltarSet, gbl:ThroneSet, gbl:StorageSet, gbl:DeskSet, gbl:WardrobeSet, gbl:KitchenSet, gbl:Pews, gbl:RoomLights, gbl:WallDecor, gbl:FloorClutter, gbl:Fountain, gbl:Bench, gbl:NatureScatter ;
    gbo:stages "[\"room programme\",\"court and rooms\",\"doors and gates\",\"the court's fountain, benches and plants\",\"furniture\",\"lights and decor\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[],\"style\":{\"condition\":\"condition\",\"wealth\":\"wealth\"}}"^^rdf:JSON ;
    gbo:hasScale gbb:courtyard.small, gbb:courtyard.medium, gbb:courtyard.large .

gbb:courtyard.small
    a gbo:ScaleClass ;
    rdfs:label "small"@en ;
    gbo:minBuildings 2 ;
    gbo:maxBuildings 4 ;
    gbo:minSide 12 ;
    gbo:maxSide 16 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:courtyard.medium
    a gbo:ScaleClass ;
    rdfs:label "medium"@en ;
    gbo:minBuildings 4 ;
    gbo:maxBuildings 8 ;
    gbo:minSide 16 ;
    gbo:maxSide 22 ;
    gbo:minZones 1 ;
    gbo:maxZones 2 .

gbb:courtyard.large
    a gbo:ScaleClass ;
    rdfs:label "large"@en ;
    gbo:minBuildings 8 ;
    gbo:maxBuildings 16 ;
    gbo:minSide 22 ;
    gbo:maxSide 32 ;
    gbo:minZones 1 ;
    gbo:maxZones 3 .

gbb:dungeon
    a gbo:BuildType ;
    rdfs:label "Dungeon"@en ;
    gbo:rootModule gbl:Dungeon ;
    gbo:component gbl:DungeonLevel, gbl:EntranceRoom, gbl:StairsRoom, gbl:CorridorRoom, gbl:Junction, gbl:GuardRoom, gbl:BarracksRoom, gbl:TreasureRoom, gbl:TrapRoom, gbl:PuzzleRoom, gbl:BossArena, gbl:ShrineRoom, gbl:Prison, gbl:CryptRoom, gbl:LibraryRoom, gbl:Storeroom, gbl:FloodedRoom, gbl:CaveChamber, gbl:ChasmRoom, gbl:SecretRoom, gbl:Encounter, gbl:LootCache, gbl:Trap, gbl:Ambience ;
    gbo:stages "[\"mission graph\",\"space graph\",\"geometry\",\"room contents\",\"encounters & loot\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[],\"style\":{\"condition\":\"condition\",\"theme\":\"dungeon-theme\"}}"^^rdf:JSON ;
    gbo:hasScale gbb:dungeon.small, gbb:dungeon.medium, gbb:dungeon.large, gbb:dungeon.huge .

gbb:dungeon.small
    a gbo:ScaleClass ;
    rdfs:label "small"@en ;
    gbo:minBuildings 4 ;
    gbo:maxBuildings 8 ;
    gbo:minSide 45 ;
    gbo:maxSide 68 ;
    gbo:minZones 1 ;
    gbo:maxZones 1 .

gbb:dungeon.medium
    a gbo:ScaleClass ;
    rdfs:label "medium"@en ;
    gbo:minBuildings 8 ;
    gbo:maxBuildings 16 ;
    gbo:minSide 68 ;
    gbo:maxSide 105 ;
    gbo:minZones 1 ;
    gbo:maxZones 2 .

gbb:dungeon.large
    a gbo:ScaleClass ;
    rdfs:label "large"@en ;
    gbo:minBuildings 16 ;
    gbo:maxBuildings 32 ;
    gbo:minSide 105 ;
    gbo:maxSide 150 ;
    gbo:minZones 2 ;
    gbo:maxZones 3 .

gbb:dungeon.huge
    a gbo:ScaleClass ;
    rdfs:label "huge"@en ;
    gbo:minBuildings 32 ;
    gbo:maxBuildings 80 ;
    gbo:minSide 150 ;
    gbo:maxSide 225 ;
    gbo:minZones 3 ;
    gbo:maxZones 6 .

gbb:farmland
    a gbo:BuildType ;
    rdfs:label "Farmland"@en ;
    gbo:rootModule gbl:Farmland ;
    gbo:component gbl:FarmlandRing, gbl:PastureLand, gbl:Farmstead, gbl:MillPlot, gbl:Field, gbl:Pasture, gbl:Orchard, gbl:Garden, gbl:StableYard, gbl:HedgeLine, gbl:FenceLine, gbl:Road, gbl:Clutter, gbl:Forest, gbl:Meadow, gbl:RockField, gbl:River, gbl:Lake, gbl:Pond, gbl:NatureScatter ;
    gbo:stages "[\"site & terrain\",\"tracks\",\"zones\",\"farmsteads\",\"fields & pastures\",\"dressing\"]"^^rdf:JSON ;
    gbo:briefFields "{\"features\":[\"river\",\"lake\",\"hill\",\"crossroads\"],\"style\":{\"biome\":\"biome\",\"condition\":\"condition\"}}"^^rdf:JSON ;
    gbo:hasScale gbb:farmland.farm, gbb:farmland.countryside, gbb:farmland.large-countryside .

