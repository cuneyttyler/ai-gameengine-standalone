gbl:FarmlandRing
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HedgeLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:MillPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Orchard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pond
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Subplace
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmstead gbl:Field gbl:HedgeLine gbl:MillPlot gbl:Orchard gbl:Pasture gbl:Pond gbl:Road gbl:Subplace )
        ]
    ] ;
    rdfs:label "Farmland ring"@en ;
    rdfs:comment "Fields and farmsteads outside the settlement (a nested farmland place)."@en ;
    gbo:moduleId "farmland-ring" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:FarmlandRing.area, gbl:FarmlandRing.farmsteads, gbl:FarmlandRing.fields, gbl:FarmlandRing.crops ;
    gbo:hasChildRule gbl:FarmlandRing.child.farmstead, gbl:FarmlandRing.child.field, gbl:FarmlandRing.child.hedge-line, gbl:FarmlandRing.child.mill-plot, gbl:FarmlandRing.child.orchard, gbl:FarmlandRing.child.pasture, gbl:FarmlandRing.child.pond, gbl:FarmlandRing.child.road, gbl:FarmlandRing.child.subplace ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:outside ;
        gbo:members "[\"self\",\"parent.wall\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "flat" ;
        gbo:weight 0.6
    ], [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 0.3
    ] ;
    gbo:origin "engine" .

gbl:FarmlandRing.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:FarmlandRing ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 400.0 ;
    gbo:defaultValue "[2000,20000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:FarmlandRing.farmsteads
    a gbo:QuantityField, owl:DatatypeProperty ;
