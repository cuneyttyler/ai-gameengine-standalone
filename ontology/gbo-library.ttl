gbl:Orchard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Orchard"@en ;
    rdfs:comment "Fruit trees in grid rows."@en ;
    gbo:moduleId "orchard" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Orchard.size, gbl:Orchard.spacing, gbl:Orchard.trees, gbl:Orchard.fruit-mix ;
    gbo:hasSlot gbl:Orchard.slot.tree ;
    gbo:constraint "trees * 4 <= size.w * size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.tree\",\"self.tree\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"axis\":\"x\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Orchard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[8,16],\"w\":[8,16]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Orchard.spacing
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "spacing"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "spacing" ;
    gbo:fieldType gbo:spacing ;
    gbo:minValue 0.0 ;
    gbo:defaultValue "{\"max\":3,\"min\":2}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Orchard.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 1000.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON .

gbl:Orchard.fruit-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fruit-mix"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "fruit-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"apple\":0.7,\"pear\":0.3}"^^rdf:JSON ;
    gbo:vocabulary gbv:fruit-kind .

gbl:Orchard.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fruit-tree ;
    gbo:conceptsFrom gbl:Orchard.fruit-mix .

gbl:Outskirts
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Farmstead
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
