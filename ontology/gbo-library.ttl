# --- Vocabularies (SKOS) ---

gbv:affordance
    a skos:ConceptScheme ;
    skos:prefLabel "affordance"@en ;
    skos:hasTopConcept gbv:affordance.terrain, gbv:affordance.environmental-object, gbv:affordance.interactive-object, gbv:affordance.item, gbv:affordance.character .

gbv:affordance.terrain
    a skos:Concept ;
    skos:inScheme gbv:affordance ;
    skos:prefLabel "terrain"@en ;
    skos:notation "terrain" ;
    skos:topConceptOf gbv:affordance .

