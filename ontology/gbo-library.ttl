gbl:Region
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BiomeZone
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "16"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BiomeZone
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Heartland
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Heartland
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:BiomeZone gbl:Ground gbl:Heartland gbl:Lake gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "Region"@en ;
    rdfs:comment "A whole region: biomes, its sites (settlements, castles, dungeons), landmarks and the roads between."@en ;
    gbo:moduleId "region" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:region ;
    gbo:hasField gbl:Region.area, gbl:Region.sites, gbl:Region.biome-mix, gbl:Region.climate, gbl:Region.notes, gbl:Region.relief, gbl:Region.woods ;
    gbo:hasChildRule gbl:Region.child.biome-zone, gbl:Region.child.ground, gbl:Region.child.heartland, gbl:Region.child.lake, gbl:Region.child.river, gbl:Region.child.road ;
    gbo:constraint "within(self.sites, count(descendants(class: Site)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Region.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 2500.0 ;
    gbo:defaultValue "[40000,160000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Region.sites
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "sites"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "sites" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Region.biome-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "biome-mix"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "biome-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"forest\":0.4,\"hills\":0.2,\"plains\":0.4}"^^rdf:JSON ;
    gbo:vocabulary gbv:biome-kind ;
    gbo:askedInConfirmation true .

gbl:Region.climate
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "climate"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "climate" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"temperate\""^^rdf:JSON ;
    gbo:vocabulary gbv:climate .

gbl:Region.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Region.relief
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "relief"@en ;
    rdfs:comment "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "relief" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gentle\""^^rdf:JSON ;
    gbo:allowedValue "flat", "gentle", "hilly" ;
    gbo:askedInConfirmation true .

gbl:Region.woods
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "woods"@en ;
    rdfs:comment "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "woods" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:allowedValue "none", "few", "some", "dense" ;
    gbo:askedInConfirmation true .

gbl:Region.child.biome-zone
    a gbo:ChildRule ;
    gbo:child gbl:BiomeZone ;
    gbo:minCount 1 ;
    gbo:maxCount 16 ;
    gbo:weight 1.0 .

gbl:Region.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Region.child.heartland
    a gbo:ChildRule ;
    gbo:child gbl:Heartland ;
    gbo:minCount 1 ;
    gbo:maxCount 4 ;
    gbo:weight 1.0 .

gbl:Region.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.3 .

gbl:Region.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.5 .

gbl:Region.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ResidentialDistrict
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, gbl:District, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ApartmentPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Park
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ParkingLot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Playground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RetailPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RowHouseRow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SchoolPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:ApartmentPlot gbl:Park gbl:ParkingLot gbl:Playground gbl:RetailPlot gbl:Road gbl:RowHouseRow gbl:SchoolPlot )
        ]
    ] ;
    rdfs:label "Residential district"@en ;
    rdfs:comment "Apartment blocks and row houses, a corner shop, a school, small parks."@en ;
    gbo:moduleId "residential-district" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:ResidentialDistrict.area, gbl:ResidentialDistrict.footprint-density, gbl:ResidentialDistrict.plots, gbl:ResidentialDistrict.density, gbl:ResidentialDistrict.street-style, gbl:ResidentialDistrict.wealth ;
    gbo:hasSlot gbl:ResidentialDistrict.slot.car ;
    gbo:hasChildRule gbl:ResidentialDistrict.child.apartment-plot, gbl:ResidentialDistrict.child.park, gbl:ResidentialDistrict.child.parking-lot, gbl:ResidentialDistrict.child.playground, gbl:ResidentialDistrict.child.retail-plot, gbl:ResidentialDistrict.child.road, gbl:ResidentialDistrict.child.row-house-row, gbl:ResidentialDistrict.child.school-plot ;
    gbo:constraint "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.downtown\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":40}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

