    gbo:minCount 1 ;
    gbo:maxCount 2 ;
    gbo:countField gbl:CourtyardComplex.floors ;
    gbo:weight 1.0 .

gbl:CraftsmenWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:LumberYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkshopPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "400"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WorkshopPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:HousePlot gbl:LumberYard gbl:Road gbl:WorkshopPlot )
        ]
    ] ;
    rdfs:label "Craftsmen's ward"@en ;
    rdfs:comment "Workshops and their houses, downstream and at the edge."@en ;
    gbo:moduleId "craftsmen-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:CraftsmenWard.area, gbl:CraftsmenWard.plots, gbl:CraftsmenWard.street-style, gbl:CraftsmenWard.trades, gbl:CraftsmenWard.wealth ;
    gbo:hasChildRule gbl:CraftsmenWard.child.house-plot, gbl:CraftsmenWard.child.lumber-yard, gbl:CraftsmenWard.child.road, gbl:CraftsmenWard.child.workshop-plot ;
    gbo:constraint "count(children(workshop-plot)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:away-from ;
        gbo:members "[\"self\",\"parent.patrician-ward\"]"^^rdf:JSON ;
        gbo:weight 1.5 ;
        gbo:arguments "{\"d\":20}"^^rdf:JSON
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "downstream" ;
        gbo:weight 0.7
    ], [
        a gbo:SitePreference ;
        gbo:criterion "edge" ;
        gbo:weight 0.4
    ] ;
    gbo:origin "engine" .

gbl:CraftsmenWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[800,3000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:CraftsmenWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:CraftsmenWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:CraftsmenWard.trades
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "trades"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "trades" ;
    gbo:fieldType gbo:enumSet ;
    gbo:defaultValue "[\"smith\",\"carpenter\"]"^^rdf:JSON ;
    gbo:vocabulary gbv:trade ;
    gbo:askedInConfirmation true .

gbl:CraftsmenWard.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:CraftsmenWard ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth .

