gbl:Orchard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Orchard"@en ;
    rdfs:comment "Fruit trees in grid rows."@en ;
    gbo:moduleId "orchard" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:Orchard.size, gbl:Orchard.spacing, gbl:Orchard.trees, gbl:Orchard.fruit-mix ;
    gbo:hasSlot gbl:Orchard.slot.tree ;
    gbo:constraint "trees * 4 <= size.w * size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.tree\",\"self.tree\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"axis\":\"x\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Orchard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[8,16],\"w\":[8,16]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Orchard.spacing
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "spacing"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "spacing" ;
    gbo:fieldType gbo:spacing ;
    gbo:minValue 0.0 ;
    gbo:defaultValue "{\"max\":3,\"min\":2}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Orchard.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 1000.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON .

gbl:Orchard.fruit-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fruit-mix"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "fruit-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"apple\":0.7,\"pear\":0.3}"^^rdf:JSON ;
    gbo:vocabulary gbv:fruit-kind .

gbl:Orchard.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fruit-tree ;
    gbo:conceptsFrom gbl:Orchard.fruit-mix .

gbl:Outskirts
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Farmstead
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmstead gbl:HousePlot gbl:NatureScatter gbl:Road )
        ]
    ] ;
    rdfs:label "Outskirts"@en ;
    rdfs:comment "Scattered farmsteads and houses beyond the centre."@en ;
    gbo:moduleId "outskirts" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Outskirts.area, gbl:Outskirts.buildings, gbl:Outskirts.plots, gbl:Outskirts.street-style ;
    gbo:hasChildRule gbl:Outskirts.child.farmstead, gbl:Outskirts.child.house-plot, gbl:Outskirts.child.nature-scatter, gbl:Outskirts.child.road ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.5
    ] ;
    gbo:origin "engine" .

gbl:Outskirts.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[1000,6000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Outskirts.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"rare\""^^rdf:JSON ;
    gbo:unit "buildings per 100 cells" ;
    gbo:densityLevels "[0.0,0.5,1.0,2.0,3.0]"^^rdf:JSON .

gbl:Outskirts.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[4,20]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Outskirts.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:Outskirts.child.farmstead
    a gbo:ChildRule ;
    gbo:child gbl:Farmstead ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:weight 0.7 .

gbl:Outskirts.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:weight 0.8 .

gbl:Outskirts.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:Outskirts.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:Pasture
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FenceLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Trough
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FenceLine gbl:Trough )
        ]
    ] ;
    rdfs:label "Pasture"@en ;
    rdfs:comment "Fenced grazing with animals and a trough."@en ;
    gbo:moduleId "pasture" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:Pasture.animals, gbl:Pasture.size, gbl:Pasture.livestock-mix ;
    gbo:hasSlot gbl:Pasture.slot.animal, gbl:Pasture.slot.fence ;
    gbo:hasChildRule gbl:Pasture.child.fence-line, gbl:Pasture.child.trough ;
    gbo:constraint "animals * 6 <= size.w * size.h"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Pasture.animals
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "animals"@en ;
    rdfs:domain gbl:Pasture ;
    gbo:fieldName "animals" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 200.0 ;
    gbo:defaultValue "[3,12]"^^rdf:JSON .

gbl:Pasture.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Pasture ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 80.0 ;
    gbo:maxHeight 80.0 ;
    gbo:defaultValue "{\"h\":[10,20],\"w\":[10,20]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Pasture.livestock-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "livestock-mix"@en ;
    rdfs:domain gbl:Pasture ;
    gbo:fieldName "livestock-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"cow\":0.4,\"sheep\":0.6}"^^rdf:JSON ;
    gbo:vocabulary gbv:livestock .

gbl:Pasture.slot.animal
    a gbo:Slot ;
    gbo:slotName "animal" ;
    gbo:essential false ;
    gbo:needsRole gbr:animal ;
    gbo:conceptsFrom gbl:Pasture.livestock-mix .

gbl:Pasture.slot.fence
    a gbo:Slot ;
    gbo:slotName "fence" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fence-piece-set .

gbl:Pasture.child.fence-line
    a gbo:ChildRule ;
    gbo:child gbl:FenceLine ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Pasture.child.trough
    a gbo:ChildRule ;
    gbo:child gbl:Trough ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.6 .

gbl:PastureLand
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "8"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HedgeLine
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pasture
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pond
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StableYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmstead gbl:HedgeLine gbl:Pasture gbl:Pond gbl:StableYard )
        ]
    ] ;
    rdfs:label "Pasture land"@en ;
    rdfs:comment "Grazing land: fenced pastures, a farmstead or two and their stables."@en ;
    gbo:moduleId "pasture-land" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:farmland ;
    gbo:hasField gbl:PastureLand.area, gbl:PastureLand.farmsteads, gbl:PastureLand.livestock-mix, gbl:PastureLand.street-style ;
    gbo:hasChildRule gbl:PastureLand.child.farmstead, gbl:PastureLand.child.hedge-line, gbl:PastureLand.child.pasture, gbl:PastureLand.child.pond, gbl:PastureLand.child.stable-yard ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "flat" ;
        gbo:weight 0.4
    ] ;
    gbo:origin "engine" .

gbl:PastureLand.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:PastureLand.farmsteads
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "farmsteads"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "farmsteads" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 100.0 ;
    gbo:defaultValue "[1,3]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:PastureLand.livestock-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "livestock-mix"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "livestock-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"cow\":0.4,\"horse\":0.1,\"sheep\":0.5}"^^rdf:JSON ;
    gbo:vocabulary gbv:livestock ;
    gbo:askedInConfirmation true .

gbl:PastureLand.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:PastureLand ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:PastureLand.child.farmstead
    a gbo:ChildRule ;
    gbo:child gbl:Farmstead ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:countField gbl:PastureLand.farmsteads ;
    gbo:weight 1.0 .

gbl:PastureLand.child.hedge-line
    a gbo:ChildRule ;
    gbo:child gbl:HedgeLine ;
    gbo:minCount 0 ;
    gbo:maxCount 8 ;
    gbo:weight 0.4 .

gbl:PastureLand.child.pasture
    a gbo:ChildRule ;
    gbo:child gbl:Pasture ;
    gbo:minCount 1 ;
    gbo:maxCount 20 ;
    gbo:weight 0.9 .

gbl:PastureLand.child.pond
    a gbo:ChildRule ;
    gbo:child gbl:Pond ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.2 .

gbl:PastureLand.child.stable-yard
    a gbo:ChildRule ;
    gbo:child gbl:StableYard ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:PatricianWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FormalGarden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FountainSquare
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ManorPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ManorPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:FormalGarden gbl:FountainSquare gbl:ManorPlot gbl:Road )
        ]
    ] ;
    rdfs:label "Patrician ward"@en ;
    rdfs:comment "Manors with formal gardens, on high ground near the castle."@en ;
    gbo:moduleId "patrician-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:PatricianWard.area, gbl:PatricianWard.plots, gbl:PatricianWard.grandeur, gbl:PatricianWard.street-style ;
    gbo:hasChildRule gbl:PatricianWard.child.formal-garden, gbl:PatricianWard.child.fountain-square, gbl:PatricianWard.child.manor-plot, gbl:PatricianWard.child.road ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.castle-ward\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":30}"^^rdf:JSON
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.8
    ], [
        a gbo:SitePreference ;
        gbo:criterion "water" ;
        gbo:weight 0.2
    ] ;
    gbo:origin "engine" .

gbl:PatricianWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[800,3000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:PatricianWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[3,15]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:PatricianWard.grandeur
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "grandeur"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "grandeur" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"modest\""^^rdf:JSON ;
    gbo:allowedValue "modest", "grand" ;
    gbo:askedInConfirmation true .

gbl:PatricianWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:PatricianWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:PatricianWard.child.formal-garden
    a gbo:ChildRule ;
    gbo:child gbl:FormalGarden ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 0.5 .

gbl:PatricianWard.child.fountain-square
    a gbo:ChildRule ;
    gbo:child gbl:FountainSquare ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.3 .

gbl:PatricianWard.child.manor-plot
    a gbo:ChildRule ;
    gbo:child gbl:ManorPlot ;
    gbo:minCount 1 ;
    gbo:maxCount 100 ;
    gbo:weight 1.0 .

gbl:PatricianWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:Pews
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Pews"@en ;
    rdfs:comment "Rows of benches facing the altar."@en ;
    gbo:moduleId "pews" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:Pews.rows ;
    gbo:hasSlot gbl:Pews.slot.pew, gbl:Pews.slot.pew2 ;
    gbo:origin "engine" .

gbl:Pews.rows
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rows"@en ;
    rdfs:domain gbl:Pews ;
    gbo:fieldName "rows" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[3,6]"^^rdf:JSON .

gbl:Pews.slot.pew
    a gbo:Slot ;
    gbo:slotName "pew" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:pew .

gbl:Pews.slot.pew2
    a gbo:Slot ;
    gbo:slotName "pew2" ;
    gbo:essential false ;
    gbo:needsRole gbr:pew .

gbl:Pond
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:WaterBody, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Pond"@en ;
    rdfs:comment "A small pond."@en ;
    gbo:moduleId "pond" ;
    gbo:level gbo:Feature ;
    gbo:hasField gbl:Pond.area, gbl:Pond.shore ;
    gbo:hasSlot gbl:Pond.slot.shore, gbl:Pond.slot.water ;
    gbo:origin "engine" .

gbl:Pond.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Pond ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 2.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Pond.shore
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "shore"@en ;
    rdfs:domain gbl:Pond ;
    gbo:fieldName "shore" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"reeds\""^^rdf:JSON ;
    gbo:allowedValue "sand", "reeds", "rocks" .

gbl:Pond.slot.shore
    a gbo:Slot ;
    gbo:slotName "shore" ;
    gbo:essential false ;
    gbo:needsRole gbr:shore-prop .

gbl:Pond.slot.water
    a gbo:Slot ;
    gbo:slotName "water" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:water-terrain .

gbl:Prison
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:DungeonRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ambience
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Encounter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Ambience gbl:Encounter )
        ]
    ] ;
    rdfs:label "Prison"@en ;
    rdfs:comment "Cells, and someone in one."@en ;
    gbo:moduleId "prison" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:Prison.danger, gbl:Prison.size ;
    gbo:hasSlot gbl:Prison.slot.cage, gbl:Prison.slot.prisoner ;
    gbo:hasChildRule gbl:Prison.child.ambience, gbl:Prison.child.encounter ;
    gbo:origin "engine" .

gbl:Prison.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "danger"@en ;
    rdfs:domain gbl:Prison ;
    gbo:fieldName "danger" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "2"^^rdf:JSON .

gbl:Prison.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Prison ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[5,7],\"w\":[6,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Prison.slot.cage
    a gbo:Slot ;
    gbo:slotName "cage" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:cage .

gbl:Prison.slot.prisoner
    a gbo:Slot ;
    gbo:slotName "prisoner" ;
    gbo:essential false ;
    gbo:needsRole gbr:prisoner .

gbl:Prison.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Prison.child.encounter
    a gbo:ChildRule ;
    gbo:child gbl:Encounter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:PuzzleRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:DungeonRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ambience
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Ambience
    ] ;
    rdfs:label "Puzzle room"@en ;
    rdfs:comment "Levers and a sealed way."@en ;
    gbo:moduleId "puzzle-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:PuzzleRoom.danger, gbl:PuzzleRoom.size ;
    gbo:hasSlot gbl:PuzzleRoom.slot.lever, gbl:PuzzleRoom.slot.pillar ;
    gbo:hasChildRule gbl:PuzzleRoom.child.ambience ;
    gbo:origin "engine" .

gbl:PuzzleRoom.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "danger"@en ;
    rdfs:domain gbl:PuzzleRoom ;
    gbo:fieldName "danger" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "1"^^rdf:JSON .

gbl:PuzzleRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:PuzzleRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[5,8],\"w\":[5,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:PuzzleRoom.slot.lever
    a gbo:Slot ;
    gbo:slotName "lever" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:lever .

gbl:PuzzleRoom.slot.pillar
    a gbo:Slot ;
    gbo:slotName "pillar" ;
    gbo:essential false ;
    gbo:needsRole gbr:pillar .

gbl:PuzzleRoom.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Region
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BiomeZone
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "16"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BiomeZone
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Heartland
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Heartland
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:BiomeZone gbl:Ground gbl:Heartland gbl:Lake gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "Region"@en ;
    rdfs:comment "A whole region: biomes, its sites (settlements, castles, dungeons), landmarks and the roads between."@en ;
    gbo:moduleId "region" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:region ;
    gbo:hasField gbl:Region.area, gbl:Region.sites, gbl:Region.biome-mix, gbl:Region.climate, gbl:Region.notes ;
    gbo:hasChildRule gbl:Region.child.biome-zone, gbl:Region.child.ground, gbl:Region.child.heartland, gbl:Region.child.lake, gbl:Region.child.river, gbl:Region.child.road ;
    gbo:constraint "within(self.sites, count(descendants(class: Site)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Region.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 2500.0 ;
    gbo:defaultValue "[40000,160000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Region.sites
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "sites"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "sites" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 80.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Region.biome-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "biome-mix"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "biome-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"forest\":0.4,\"hills\":0.2,\"plains\":0.4}"^^rdf:JSON ;
    gbo:vocabulary gbv:biome-kind ;
    gbo:askedInConfirmation true .

gbl:Region.climate
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "climate"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "climate" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"temperate\""^^rdf:JSON ;
    gbo:vocabulary gbv:climate .

gbl:Region.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:Region ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:Region.child.biome-zone
    a gbo:ChildRule ;
    gbo:child gbl:BiomeZone ;
    gbo:minCount 1 ;
    gbo:maxCount 16 ;
    gbo:weight 1.0 .

gbl:Region.child.ground
    a gbo:ChildRule ;
    gbo:child gbl:Ground ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:Region.child.heartland
    a gbo:ChildRule ;
    gbo:child gbl:Heartland ;
    gbo:minCount 1 ;
    gbo:maxCount 4 ;
    gbo:weight 1.0 .

gbl:Region.child.lake
    a gbo:ChildRule ;
    gbo:child gbl:Lake ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.3 .

gbl:Region.child.river
    a gbo:ChildRule ;
    gbo:child gbl:River ;
    gbo:minCount 0 ;
    gbo:maxCount 3 ;
    gbo:weight 0.5 .

gbl:Region.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ResidentialWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "50"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2000"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TerracedRow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TownhouseBlock
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WellPlaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Garden gbl:HousePlot gbl:Road gbl:TerracedRow gbl:TownhouseBlock gbl:WellPlaza )
        ]
    ] ;
    rdfs:label "Residential ward"@en ;
    rdfs:comment "Houses with their yards and gardens; denser near the centre."@en ;
    gbo:moduleId "residential-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:ResidentialWard.area, gbl:ResidentialWard.footprint-density, gbl:ResidentialWard.plots, gbl:ResidentialWard.density, gbl:ResidentialWard.street-style, gbl:ResidentialWard.wealth ;
    gbo:hasChildRule gbl:ResidentialWard.child.garden, gbl:ResidentialWard.child.house-plot, gbl:ResidentialWard.child.road, gbl:ResidentialWard.child.terraced-row, gbl:ResidentialWard.child.townhouse-block, gbl:ResidentialWard.child.well-plaza ;
    gbo:constraint "count(children(class: BuildingParcel)) >= 1"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:near ;
        gbo:members "[\"self\",\"parent.market-ward\"]"^^rdf:JSON ;
        gbo:weight 1.0 ;
        gbo:arguments "{\"d0\":0,\"d1\":30}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:ResidentialWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:ResidentialWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[1200,4000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:ResidentialWard.footprint-density
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "footprint-density"@en ;
    rdfs:comment "built cells / ward cells"@en ;
    rdfs:domain gbl:ResidentialWard ;
    gbo:fieldName "footprint-density" ;
    gbo:fieldType gbo:ratio ;
    gbo:minValue 0.0 ;
    gbo:maxValue 1.0 ;
    gbo:defaultValue "[0.35,0.65]"^^rdf:JSON .

gbl:ResidentialWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:ResidentialWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[10,40]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:ResidentialWard.density
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "density"@en ;
    rdfs:domain gbl:ResidentialWard ;
    gbo:fieldName "density" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"medium\""^^rdf:JSON ;
    gbo:allowedValue "sparse", "medium", "dense" ;
    gbo:askedInConfirmation true .

gbl:ResidentialWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:ResidentialWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:ResidentialWard.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:ResidentialWard ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:ResidentialWard.child.garden
    a gbo:ChildRule ;
    gbo:child gbl:Garden ;
    gbo:minCount 0 ;
    gbo:maxCount 50 ;
    gbo:weight 0.2 .

gbl:ResidentialWard.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 2000 ;
    gbo:weight 1.0 .

gbl:ResidentialWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:ResidentialWard.child.terraced-row
    a gbo:ChildRule ;
    gbo:child gbl:TerracedRow ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:weight 0.3 .

gbl:ResidentialWard.child.townhouse-block
    a gbo:ChildRule ;
    gbo:child gbl:TownhouseBlock ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:weight 0.2 .

gbl:ResidentialWard.child.well-plaza
    a gbo:ChildRule ;
    gbo:child gbl:WellPlaza ;
    gbo:minCount 0 ;
    gbo:maxCount 6 ;
    gbo:weight 0.4 .

gbl:River
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, gbl:WaterBody, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bridge
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Bridge
    ] ;
    rdfs:label "River"@en ;
    rdfs:comment "A river crossing the place, with banks and crossings."@en ;
    gbo:moduleId "river" ;
    gbo:level gbo:Site ;
    gbo:hasField gbl:River.bends, gbl:River.crossings, gbl:River.length, gbl:River.width, gbl:River.banks, gbl:River.flow ;
    gbo:hasSlot gbl:River.slot.bank, gbl:River.slot.reeds, gbl:River.slot.water ;
    gbo:hasChildRule gbl:River.child.bridge ;
    gbo:constraint "crossings <= bends + 4"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:crosses ;
        gbo:members "[\"self\",\"parent\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:origin "engine" .

gbl:River.bends
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "bends"@en ;
    rdfs:domain gbl:River ;
    gbo:fieldName "bends" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "[1,3]"^^rdf:JSON .

gbl:River.crossings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "crossings"@en ;
    rdfs:domain gbl:River ;
    gbo:fieldName "crossings" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON .

gbl:River.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:River ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[40,200]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:River.width
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "width"@en ;
    rdfs:domain gbl:River ;
    gbo:fieldName "width" ;
    gbo:fieldType gbo:width ;
    gbo:minValue 1.0 ;
    gbo:maxValue 12.0 ;
    gbo:defaultValue "3"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:River.banks
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "banks"@en ;
    rdfs:domain gbl:River ;
    gbo:fieldName "banks" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"natural\""^^rdf:JSON ;
    gbo:allowedValue "natural", "stone" .

gbl:River.flow
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "flow"@en ;
    rdfs:domain gbl:River ;
    gbo:fieldName "flow" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"calm\""^^rdf:JSON ;
    gbo:allowedValue "calm", "fast" .

gbl:River.slot.bank
    a gbo:Slot ;
    gbo:slotName "bank" ;
    gbo:essential false ;
    gbo:needsRole gbr:bank-piece .

gbl:River.slot.reeds
    a gbo:Slot ;
    gbo:slotName "reeds" ;
    gbo:essential false ;
    gbo:needsRole gbr:reed .

gbl:River.slot.water
    a gbo:Slot ;
    gbo:slotName "water" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:water-terrain .

gbl:River.child.bridge
    a gbo:ChildRule ;
    gbo:child gbl:Bridge ;
    gbo:minCount 0 ;
    gbo:maxCount 20 ;
    gbo:weight 0.8 .

gbl:Road
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Network, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bridge
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Bridge
    ] ;
    rdfs:label "Road"@en ;
    rdfs:comment "A road, street, lane or trail; connects anchors and reuses roads already there."@en ;
    gbo:moduleId "road" ;
    gbo:level gbo:Network ;
    gbo:hasField gbl:Road.length, gbl:Road.width, gbl:Road.class, gbl:Road.surface ;
    gbo:hasSlot gbl:Road.slot.terrain ;
    gbo:hasChildRule gbl:Road.child.bridge ;
    gbo:constraint "class == 'main' implies width >= 2"^^gbo:Expression, "class == 'trail' implies width <= 2"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:Road.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 1.0 ;
    gbo:defaultValue "[10,300]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Road.width
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "width"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "width" ;
    gbo:fieldType gbo:width ;
    gbo:minValue 1.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "2"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Road.class
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "class"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "class" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"street\""^^rdf:JSON ;
    gbo:vocabulary gbv:road-class ;
    gbo:askedInConfirmation true .

gbl:Road.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Road ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"dirt\""^^rdf:JSON ;
    gbo:vocabulary gbv:surface ;
    gbo:askedInConfirmation true .

gbl:Road.slot.terrain
    a gbo:Slot ;
    gbo:slotName "terrain" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:road-terrain ;
    gbo:conceptsFrom gbl:Road.surface .

gbl:Road.child.bridge
    a gbo:ChildRule ;
    gbo:child gbl:Bridge ;
    gbo:minCount 0 ;
    gbo:maxCount 10 ;
    gbo:weight 0.3 .

gbl:RockField
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:NatureArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Rock field"@en ;
    rdfs:comment "Rough ground strewn with rocks."@en ;
    gbo:moduleId "rock-field" ;
    gbo:level gbo:Zone ;
    gbo:hasField gbl:RockField.area, gbl:RockField.rocks, gbl:RockField.rock-kind ;
    gbo:hasSlot gbl:RockField.slot.boulder, gbl:RockField.slot.cliff, gbl:RockField.slot.rock ;
    gbo:origin "engine" .

gbl:RockField.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:RockField ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 10.0 ;
    gbo:defaultValue "[40,600]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:RockField.rocks
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rocks"@en ;
    rdfs:domain gbl:RockField ;
    gbo:fieldName "rocks" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.05,0.15,0.3,0.5]"^^rdf:JSON .

gbl:RockField.rock-kind
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "rock-kind"@en ;
    rdfs:domain gbl:RockField ;
    gbo:fieldName "rock-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"granite\""^^rdf:JSON ;
    gbo:allowedValue "granite", "limestone", "sandstone", "mossy" .

gbl:RockField.slot.boulder
    a gbo:Slot ;
    gbo:slotName "boulder" ;
    gbo:essential false ;
    gbo:needsRole gbr:boulder .

gbl:RockField.slot.cliff
    a gbo:Slot ;
    gbo:slotName "cliff" ;
    gbo:essential false ;
    gbo:needsRole gbr:cliff-piece .

gbl:RockField.slot.rock
    a gbo:Slot ;
    gbo:slotName "rock" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:rock .

gbl:RoomLights
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Lights"@en ;
