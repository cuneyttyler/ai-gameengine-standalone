    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:TavernHall.size, gbl:TavernHall.surface ;
    gbo:hasSlot gbl:TavernHall.slot.floor ;
    gbo:hasChildRule gbl:TavernHall.child.bar-set, gbl:TavernHall.child.dining-set, gbl:TavernHall.child.hearth-set, gbl:TavernHall.child.room-lights, gbl:TavernHall.child.wall-decor ;
    gbo:origin "engine" .

gbl:TavernHall.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:TavernHall ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[6,8],\"w\":[7,10]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:TavernHall.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:TavernHall ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:TavernHall.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:TavernHall.child.bar-set
    a gbo:ChildRule ;
    gbo:child gbl:BarSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:TavernHall.child.dining-set
    a gbo:ChildRule ;
    gbo:child gbl:DiningSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:TavernHall.child.hearth-set
    a gbo:ChildRule ;
    gbo:child gbl:HearthSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:TavernHall.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:TavernHall.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:TemplePlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Civic, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Graveyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Garden gbl:Graveyard )
        ]
    ] ;
    rdfs:label "Temple plot"@en ;
    rdfs:comment "A temple, church or shrine with its graveyard or garden."@en ;
    gbo:moduleId "temple-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:TemplePlot.size, gbl:TemplePlot.faith ;
    gbo:hasSlot gbl:TemplePlot.slot.temple ;
    gbo:hasChildRule gbl:TemplePlot.child.garden, gbl:TemplePlot.child.graveyard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:focus ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 1.0
    ] ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.6
    ] ;
    gbo:origin "engine" .

gbl:TemplePlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:TemplePlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 6.0 ;
    gbo:minHeight 6.0 ;
    gbo:maxWidth 50.0 ;
    gbo:maxHeight 50.0 ;
    gbo:defaultValue "{\"h\":[14,24],\"w\":[12,20]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:TemplePlot.faith
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "faith"@en ;
    rdfs:domain gbl:TemplePlot ;
    gbo:fieldName "faith" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old-faith\""^^rdf:JSON ;
    gbo:vocabulary gbv:faith .

gbl:TemplePlot.slot.temple
    a gbo:Slot ;
    gbo:slotName "temple" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:temple .

gbl:TemplePlot.child.garden
    a gbo:ChildRule ;
    gbo:child gbl:Garden ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:TemplePlot.child.graveyard
    a gbo:ChildRule ;
    gbo:child gbl:Graveyard ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:TempleWard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Graveyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TemplePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TemplePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Graveyard gbl:HousePlot gbl:Road gbl:TemplePlot )
        ]
    ] ;
    rdfs:label "Temple ward"@en ;
    rdfs:comment "A temple with its graveyard and the houses around it."@en ;
    gbo:moduleId "temple-ward" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:TempleWard.area, gbl:TempleWard.plots, gbl:TempleWard.faith, gbl:TempleWard.grandeur, gbl:TempleWard.street-style ;
    gbo:hasChildRule gbl:TempleWard.child.graveyard, gbl:TempleWard.child.house-plot, gbl:TempleWard.child.road, gbl:TempleWard.child.temple-plot ;
    gbo:prefersSite [
        a gbo:SitePreference ;
        gbo:criterion "centre" ;
        gbo:weight 0.3
    ], [
        a gbo:SitePreference ;
        gbo:criterion "high-ground" ;
        gbo:weight 0.6
    ] ;
    gbo:origin "engine" .

gbl:TempleWard.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[600,2500]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:TempleWard.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[2,15]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:TempleWard.faith
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "faith"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "faith" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"old-faith\""^^rdf:JSON ;
    gbo:vocabulary gbv:faith .

gbl:TempleWard.grandeur
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "grandeur"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "grandeur" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"modest\""^^rdf:JSON ;
    gbo:allowedValue "modest", "grand" .

gbl:TempleWard.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:TempleWard ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:TempleWard.child.graveyard
    a gbo:ChildRule ;
    gbo:child gbl:Graveyard ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.7 .

gbl:TempleWard.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:weight 0.5 .

gbl:TempleWard.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:TempleWard.child.temple-plot
    a gbo:ChildRule ;
    gbo:child gbl:TemplePlot ;
    gbo:minCount 1 ;
    gbo:maxCount 4 ;
    gbo:weight 1.0 .

gbl:TentPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Clutter
    ] ;
    rdfs:label "Tent"@en ;
    rdfs:comment "A tent on its pitch."@en ;
    gbo:moduleId "tent-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:camp ;
    gbo:hasField gbl:TentPlot.size, gbl:TentPlot.condition ;
    gbo:hasSlot gbl:TentPlot.slot.tent ;
    gbo:hasChildRule gbl:TentPlot.child.clutter ;
    gbo:origin "engine" .

gbl:TentPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:TentPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 8.0 ;
    gbo:maxHeight 8.0 ;
    gbo:defaultValue "{\"h\":[3,4],\"w\":[3,4]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:TentPlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:TentPlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:TentPlot.slot.tent
    a gbo:Slot ;
    gbo:slotName "tent" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:tent .

gbl:TentPlot.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:TerracedRow
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "30"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:DoorstepSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:DoorstepSet
    ] ;
    rdfs:label "Terraced row"@en ;
    rdfs:comment "A row of joined houses along a street."@en ;
    gbo:moduleId "terraced-row" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:TerracedRow.houses, gbl:TerracedRow.length, gbl:TerracedRow.house-kind ;
    gbo:hasSlot gbl:TerracedRow.slot.house ;
    gbo:hasChildRule gbl:TerracedRow.child.doorstep-set ;
    gbo:constraint "houses * 3 <= length"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.house\",\"self.house\"]"^^rdf:JSON ;
        gbo:weight 3.0 ;
        gbo:arguments "{\"axis\":\"street\"}"^^rdf:JSON
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ] ;
    gbo:origin "engine" .

gbl:TerracedRow.houses
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "houses"@en ;
    rdfs:domain gbl:TerracedRow ;
    gbo:fieldName "houses" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 2.0 ;
    gbo:maxValue 30.0 ;
    gbo:defaultValue "[3,8]"^^rdf:JSON .

gbl:TerracedRow.length
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:domain gbl:TerracedRow ;
    gbo:fieldName "length" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 4.0 ;
    gbo:defaultValue "[9,30]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:TerracedRow.house-kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "house-kind"@en ;
    rdfs:domain gbl:TerracedRow ;
    gbo:fieldName "house-kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"townhouse\""^^rdf:JSON ;
    gbo:vocabulary gbv:house-kind .

gbl:TerracedRow.slot.house
    a gbo:Slot ;
    gbo:slotName "house" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:house ;
    gbo:conceptsFrom gbl:TerracedRow.house-kind .

gbl:TerracedRow.child.doorstep-set
    a gbo:ChildRule ;
    gbo:child gbl:DoorstepSet ;
    gbo:minCount 0 ;
    gbo:maxCount 30 ;
    gbo:weight 0.6 .

gbl:ThroneRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ThroneSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ThroneSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:RoomLights gbl:ThroneSet gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Throne room"@en ;
    rdfs:comment "The throne at the far end."@en ;
    gbo:moduleId "throne-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:ThroneRoom.size, gbl:ThroneRoom.surface ;
    gbo:hasSlot gbl:ThroneRoom.slot.floor ;
    gbo:hasChildRule gbl:ThroneRoom.child.room-lights, gbl:ThroneRoom.child.throne-set, gbl:ThroneRoom.child.wall-decor ;
    gbo:origin "engine" .

gbl:ThroneRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ThroneRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[7,10],\"w\":[7,10]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:ThroneRoom.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:ThroneRoom ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"stone-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:ThroneRoom.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:ThroneRoom.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:ThroneRoom.child.throne-set
    a gbo:ChildRule ;
    gbo:child gbl:ThroneSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:ThroneRoom.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:ThroneSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Throne"@en ;
    rdfs:comment "A throne at the far end, banners either side."@en ;
    gbo:moduleId "throne-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:ThroneSet.slot.banner, gbl:ThroneSet.slot.carpet, gbl:ThroneSet.slot.throne ;
    gbo:origin "engine" .

gbl:ThroneSet.slot.banner
    a gbo:Slot ;
    gbo:slotName "banner" ;
    gbo:essential false ;
    gbo:needsRole gbr:banner .

gbl:ThroneSet.slot.carpet
    a gbo:Slot ;
    gbo:slotName "carpet" ;
    gbo:essential false ;
    gbo:needsRole gbr:rug .

gbl:ThroneSet.slot.throne
    a gbo:Slot ;
    gbo:slotName "throne" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:throne .

gbl:TownhouseBlock
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Dwelling, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Courtyard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Courtyard
    ] ;
