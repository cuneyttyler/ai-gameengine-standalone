    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:CraftsmenWard.child.workshop-plot
    a gbo:ChildRule ;
    gbo:child gbl:WorkshopPlot ;
    gbo:minCount 1 ;
    gbo:maxCount 400 ;
    gbo:weight 1.0 .

