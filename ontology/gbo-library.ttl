    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:densityLevels "[0.0,0.3,0.55,0.75,0.9]"^^rdf:JSON .

gbl:ParkingLot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:ParkingLot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
