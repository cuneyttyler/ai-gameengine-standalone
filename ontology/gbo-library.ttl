    gbo:needsRole gbr:path-tile ;
    gbo:conceptsFrom gbl:Courtyard.surface .

gbl:Courtyard.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.8 .

gbl:CourtyardComplex
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:FloorLevel
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:FloorLevel
    ] ;
    rdfs:label "Courtyard"@en ;
    rdfs:comment "A walled courtyard: an open court in the middle, the rooms round it (a hall, chambers, stores). Its floors are storeys (a ground floor, at most one above), each holding the rooms round the court; a room is never a floor."@en ;
    gbo:moduleId "courtyard-complex" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:courtyard ;
    gbo:hasField gbl:CourtyardComplex.floors, gbl:CourtyardComplex.rooms, gbl:CourtyardComplex.condition, gbl:CourtyardComplex.floor, gbl:CourtyardComplex.kind, gbl:CourtyardComplex.notes, gbl:CourtyardComplex.wealth ;
    gbo:hasSlot gbl:CourtyardComplex.slot.door, gbl:CourtyardComplex.slot.wall, gbl:CourtyardComplex.slot.window ;
    gbo:hasChildRule gbl:CourtyardComplex.child.floor-level ;
    gbo:constraint "within(self.rooms, count(descendants(class: Room)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

gbl:CourtyardComplex.floors
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "floors"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "floors" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 3.0 ;
    gbo:defaultValue "1"^^rdf:JSON .

gbl:CourtyardComplex.rooms
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "rooms"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "rooms" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 60.0 ;
    gbo:defaultValue "[3,6]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:CourtyardComplex.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:CourtyardComplex.floor
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "floor"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "floor" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"stone-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:CourtyardComplex.kind
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "kind" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"courtyard\""^^rdf:JSON ;
    gbo:vocabulary gbv:courtyard-kind ;
    gbo:askedInConfirmation true .

gbl:CourtyardComplex.notes
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "notes" ;
    gbo:fieldType gbo:description .

gbl:CourtyardComplex.wealth
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "wealth"@en ;
    rdfs:domain gbl:CourtyardComplex ;
    gbo:fieldName "wealth" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:vocabulary gbv:wealth ;
    gbo:askedInConfirmation true .

gbl:CourtyardComplex.slot.door
    a gbo:Slot ;
    gbo:slotName "door" ;
    gbo:essential true ;
    gbo:needsRole gbr:door .

gbl:CourtyardComplex.slot.wall
    a gbo:Slot ;
    gbo:slotName "wall" ;
    gbo:essential true ;
    gbo:needsRole gbr:wall-piece-set .

gbl:CourtyardComplex.slot.window
    a gbo:Slot ;
    gbo:slotName "window" ;
    gbo:essential false ;
    gbo:needsRole gbr:window .

gbl:CourtyardComplex.child.floor-level
    a gbo:ChildRule ;
