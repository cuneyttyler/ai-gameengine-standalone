    gbo:hasSlot gbl:TownhouseBlock.slot.townhouse ;
    gbo:hasChildRule gbl:TownhouseBlock.child.courtyard ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
