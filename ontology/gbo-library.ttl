# GBO library: modules, vocabularies, roles, relations and rules
#
# GENERATED from data/places/ by the engine (engine/places/OntologyExport.cpp).
# Don't edit: change the JSON files and regenerate (ontology/README.md).

@prefix gbo:     <https://w3id.org/aige/gbo#> .
@prefix gbl:     <https://w3id.org/aige/gbo/library#> .
@prefix gbb:     <https://w3id.org/aige/gbo/build#> .
@prefix gbv:     <https://w3id.org/aige/gbo/vocab#> .
@prefix gbr:     <https://w3id.org/aige/gbo/role#> .
@prefix gbx:     <https://w3id.org/aige/gbo/relation#> .
@prefix gbd:     <https://w3id.org/aige/gbo/rule#> .
@prefix gbs:     <https://w3id.org/aige/gbo/shapes#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/aige/gbo/library>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aige/gbo/library/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gbo> ;
    dcterms:title "GBO library: modules, vocabularies, roles, relations and rules"@en ;
    dcterms:description "The engine's place library in GBO terms: every module with its fields, slots, child rules, constraints, relations and site preferences; the module classes; the build types with their scale tables; the concept schemes; the asset roles; the spatial relation types; and the design rules with their sources."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

# --- Module classes ---

gbl:BuildingParcel
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Building parcel"@en ;
    rdfs:comment "A parcel whose primary object is a building."@en .

gbl:Civic
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Civic building"@en ;
    rdfs:comment "A temple, guard post or other public building."@en .

gbl:Crossing
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Crossing"@en ;
    rdfs:comment "Carries a path over an obstacle."@en .

gbl:DungeonRoom
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Room ;
    rdfs:label "Dungeon room"@en ;
    rdfs:comment "A room or chamber of a dungeon or cave."@en .

gbl:Dwelling
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Dwelling"@en ;
    rdfs:comment "A parcel people live on."@en .

gbl:Fortification
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Fortification"@en ;
    rdfs:comment "Walls, towers and gates that defend a place."@en .

gbl:FurnitureGroup
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Furniture group"@en ;
    rdfs:comment "An anchor piece and the pieces around it (a table and its chairs)."@en .

gbl:InteriorRoom
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:Room ;
    rdfs:label "Interior room"@en ;
    rdfs:comment "A room of a building."@en .

gbl:Level
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Level"@en ;
    rdfs:comment "A floor of a building or a level of a dungeon: laid out on its own, linked by stairs."@en .

gbl:LinearFeature
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Linear feature"@en ;
    rdfs:comment "Something built along a line of cells: walls, fences, hedges."@en .

gbl:NatureArea
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Nature area"@en ;
    rdfs:comment "A forest, meadow or rock field."@en .

gbl:OpenSpace
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Open space"@en ;
    rdfs:comment "A square or plaza: open ground with a centrepiece."@en .

gbl:PlantedArea
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Planted area"@en ;
    rdfs:comment "Ground given to plants: gardens, beds, fields, orchards, meadows."@en .

gbl:PointOfInterest
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Point of interest"@en ;
    rdfs:comment "Something worth walking to in the wild: a ruin, a shrine, a cave mouth."@en .

gbl:Room
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Room"@en ;
    rdfs:comment "A room of an interior or a dungeon: the unit they are counted in."@en .

gbl:Site
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Site"@en ;
    rdfs:comment "A place within a region, built later as a place of its own."@en .

gbl:Ward
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Ward"@en ;
    rdfs:comment "A zone of a settlement with its own character."@en .

gbl:WaterBody
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Body of water"@en ;
    rdfs:comment "A river, lake or pond."@en .

gbl:WaterSource
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Water source"@en ;
    rdfs:comment "Where people draw water: a well or fountain."@en .

gbl:Workplace
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbl:BuildingParcel ;
    rdfs:label "Workplace"@en ;
    rdfs:comment "A parcel people work on."@en .

gbl:Yard
    a owl:Class, gbo:ModuleClass ;
    rdfs:subClassOf gbo:Place ;
    rdfs:label "Yard"@en ;
    rdfs:comment "Open ground belonging to a parcel."@en .

# --- Modules ---

gbl:AbandonedCart
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:PointOfInterest, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Abandoned cart"@en ;
    rdfs:comment "A broken cart by the trail, its load spilled."@en ;
    gbo:moduleId "abandoned-cart" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:wilderness ;
    gbo:hasField gbl:AbandonedCart.size ;
    gbo:hasSlot gbl:AbandonedCart.slot.cart, gbl:AbandonedCart.slot.crate, gbl:AbandonedCart.slot.sack ;
    gbo:origin "engine" .

gbl:AbandonedCart.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:AbandonedCart ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 8.0 ;
    gbo:maxHeight 8.0 ;
    gbo:defaultValue "{\"h\":[3,4],\"w\":[4,5]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:AbandonedCart.slot.cart
    a gbo:Slot ;
    gbo:slotName "cart" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:cart .

gbl:AbandonedCart.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:AbandonedCart.slot.sack
    a gbo:Slot ;
    gbo:slotName "sack" ;
    gbo:essential false ;
    gbo:needsRole gbr:sack .

gbl:AltarSet
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:FurnitureGroup, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Altar"@en ;
    rdfs:comment "An altar at the far end, candles and a lectern."@en ;
    gbo:moduleId "altar-set" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:interior ;
    gbo:hasSlot gbl:AltarSet.slot.altar, gbl:AltarSet.slot.candle, gbl:AltarSet.slot.lectern ;
    gbo:origin "engine" .

gbl:AltarSet.slot.altar
    a gbo:Slot ;
    gbo:slotName "altar" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:altar .

gbl:AltarSet.slot.candle
    a gbo:Slot ;
    gbo:slotName "candle" ;
    gbo:essential false ;
    gbo:needsRole gbr:candle .

gbl:AltarSet.slot.lectern
    a gbo:Slot ;
    gbo:slotName "lectern" ;
    gbo:essential false ;
    gbo:needsRole gbr:lectern .

gbl:Ambience
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Ambience"@en ;
    rdfs:comment "Torches on the walls, debris on the floor."@en ;
    gbo:moduleId "ambience" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:Ambience.debris, gbl:Ambience.lights, gbl:Ambience.mood ;
    gbo:hasSlot gbl:Ambience.slot.debris, gbl:Ambience.slot.light ;
    gbo:origin "engine" .

gbl:Ambience.debris
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "debris"@en ;
    rdfs:domain gbl:Ambience ;
    gbo:fieldName "debris" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.02,0.05,0.1,0.16]"^^rdf:JSON .

gbl:Ambience.lights
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "lights"@en ;
    rdfs:domain gbl:Ambience ;
    gbo:fieldName "lights" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"some\""^^rdf:JSON ;
    gbo:unit "per free cell" ;
    gbo:densityLevels "[0.0,0.02,0.05,0.1,0.16]"^^rdf:JSON .

gbl:Ambience.mood
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "mood"@en ;
    rdfs:domain gbl:Ambience ;
    gbo:fieldName "mood" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"gloomy\""^^rdf:JSON ;
    gbo:allowedValue "gloomy", "eerie", "grand" .

gbl:Ambience.slot.debris
    a gbo:Slot ;
    gbo:slotName "debris" ;
    gbo:essential false ;
    gbo:needsRole gbr:debris .

gbl:Ambience.slot.light
    a gbo:Slot ;
    gbo:slotName "light" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:light-prop .

gbl:Armoury
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ShelfWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StorageSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:RoomLights gbl:ShelfWall gbl:StorageSet gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Armoury"@en ;
    rdfs:comment "Weapons and armour on racks."@en ;
    gbo:moduleId "armoury" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:Armoury.size, gbl:Armoury.surface ;
    gbo:hasSlot gbl:Armoury.slot.floor ;
    gbo:hasChildRule gbl:Armoury.child.room-lights, gbl:Armoury.child.shelf-wall, gbl:Armoury.child.storage-set, gbl:Armoury.child.wall-decor ;
    gbo:origin "engine" .

gbl:Armoury.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Armoury ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[4,5],\"w\":[4,5]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Armoury.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:Armoury ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"stone-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:Armoury.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:Armoury.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:Armoury.child.shelf-wall
    a gbo:ChildRule ;
    gbo:child gbl:ShelfWall ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Armoury.child.storage-set
    a gbo:ChildRule ;
    gbo:child gbl:StorageSet ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Armoury.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:BackStore
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:RoomLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StorageSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StorageSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WallDecor
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:RoomLights gbl:StorageSet gbl:WallDecor )
        ]
    ] ;
    rdfs:label "Back store"@en ;
    rdfs:comment "Stock behind the shop."@en ;
    gbo:moduleId "back-store" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:BackStore.size, gbl:BackStore.surface ;
    gbo:hasSlot gbl:BackStore.slot.floor ;
    gbo:hasChildRule gbl:BackStore.child.room-lights, gbl:BackStore.child.storage-set, gbl:BackStore.child.wall-decor ;
    gbo:origin "engine" .

gbl:BackStore.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:BackStore ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,4],\"w\":[3,4]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:BackStore.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:BackStore ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"wood-floor\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:BackStore.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:BackStore.child.room-lights
    a gbo:ChildRule ;
    gbo:child gbl:RoomLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:BackStore.child.storage-set
    a gbo:ChildRule ;
    gbo:child gbl:StorageSet ;
    gbo:minCount 1 ;
    gbo:maxCount 1 ;
    gbo:weight 1.0 .

gbl:BackStore.child.wall-decor
    a gbo:ChildRule ;
    gbo:child gbl:WallDecor ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.3 .

gbl:Bailey
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:BarracksPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:ChapelPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Clutter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Garden
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:KeepPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:SmithyPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StablesPlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:StorehousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:TrainingYard
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:WellPlaza
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:BarracksPlot gbl:ChapelPlot gbl:Clutter gbl:Garden gbl:KeepPlot gbl:SmithyPlot gbl:StablesPlot gbl:StorehousePlot gbl:TrainingYard gbl:WellPlaza )
        ]
    ] ;
    rdfs:label "Bailey"@en ;
    rdfs:comment "A courtyard inside the wall and the buildings round it."@en ;
    gbo:moduleId "bailey" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:castle ;
    gbo:hasField gbl:Bailey.area, gbl:Bailey.plots, gbl:Bailey.role, gbl:Bailey.street-style ;
    gbo:hasChildRule gbl:Bailey.child.barracks-plot, gbl:Bailey.child.chapel-plot, gbl:Bailey.child.clutter, gbl:Bailey.child.garden, gbl:Bailey.child.keep-plot, gbl:Bailey.child.smithy-plot, gbl:Bailey.child.stables-plot, gbl:Bailey.child.storehouse-plot, gbl:Bailey.child.training-yard, gbl:Bailey.child.well-plaza ;
    gbo:origin "engine" .

gbl:Bailey.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Bailey ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[900,6400]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Bailey.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Bailey ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 120.0 ;
    gbo:defaultValue "[3,10]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Bailey.role
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "role"@en ;
    rdfs:domain gbl:Bailey ;
    gbo:fieldName "role" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"inner\""^^rdf:JSON ;
    gbo:allowedValue "inner", "outer" ;
    gbo:askedInConfirmation true .

gbl:Bailey.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:domain gbl:Bailey ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"organic\""^^rdf:JSON ;
    gbo:vocabulary gbv:layout .

gbl:Bailey.child.barracks-plot
    a gbo:ChildRule ;
    gbo:child gbl:BarracksPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 4 ;
    gbo:weight 0.8 .

gbl:Bailey.child.chapel-plot
    a gbo:ChildRule ;
    gbo:child gbl:ChapelPlot ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.5 .

gbl:Bailey.child.clutter
    a gbo:ChildRule ;
    gbo:child gbl:Clutter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.6 .

gbl:Bailey.child.garden
    a gbo:ChildRule ;
    gbo:child gbl:Garden ;
    gbo:minCount 0 ;
    gbo:maxCount 2 ;
    gbo:weight 0.3 .

gbl:Bailey.child.keep-plot
