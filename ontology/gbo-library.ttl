    gbo:hasSlot gbl:Campsite.slot.campfire, gbl:Campsite.slot.log, gbl:Campsite.slot.tent ;
    gbo:origin "engine" .

gbl:Campsite.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Campsite ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 14.0 ;
    gbo:maxHeight 14.0 ;
    gbo:defaultValue "{\"h\":[6,8],\"w\":[6,8]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Campsite.tents
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "tents"@en ;
    rdfs:domain gbl:Campsite ;
    gbo:fieldName "tents" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 6.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON .

gbl:Campsite.slot.campfire
    a gbo:Slot ;
    gbo:slotName "campfire" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:campfire .

gbl:Campsite.slot.log
    a gbo:Slot ;
    gbo:slotName "log" ;
    gbo:essential false ;
    gbo:needsRole gbr:log .

gbl:Campsite.slot.tent
    a gbo:Slot ;
    gbo:slotName "tent" ;
    gbo:essential false ;
    gbo:needsRole gbr:tent .

gbl:Castle
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Site, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bailey
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Bailey
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CurtainWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:CurtainWall
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Forest
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ground
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Lake
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Meadow
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Moat
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:River
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "6"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Bailey gbl:CurtainWall gbl:Forest gbl:Ground gbl:Lake gbl:Meadow gbl:Moat gbl:River gbl:Road )
        ]
    ] ;
    rdfs:label "Castle"@en ;
    rdfs:comment "A castle: curtain wall with towers and a gatehouse, a moat, baileys, the keep."@en ;
    gbo:moduleId "castle" ;
    gbo:level gbo:Site ;
    gbo:allowedIn gbb:castle ;
    gbo:hasField gbl:Castle.area, gbl:Castle.buildings, gbl:Castle.rings, gbl:Castle.condition, gbl:Castle.kind, gbl:Castle.notes ;
    gbo:hasChildRule gbl:Castle.child.bailey, gbl:Castle.child.curtain-wall, gbl:Castle.child.forest, gbl:Castle.child.ground, gbl:Castle.child.lake, gbl:Castle.child.meadow, gbl:Castle.child.moat, gbl:Castle.child.river, gbl:Castle.child.road ;
    gbo:constraint "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')"^^gbo:Expression ;
    gbo:origin "engine" .

