gbl:OpenOffice
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:InteriorRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeDeskSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "12"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeDeskSet
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:OfficeLights
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:OfficeDeskSet gbl:OfficeLights )
        ]
    ] ;
    rdfs:label "Open-plan office"@en ;
    rdfs:comment "Rows of desks."@en ;
    gbo:moduleId "open-office" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:interior ;
    gbo:hasField gbl:OpenOffice.size, gbl:OpenOffice.surface ;
    gbo:hasSlot gbl:OpenOffice.slot.floor ;
    gbo:hasChildRule gbl:OpenOffice.child.office-desk-set, gbl:OpenOffice.child.office-lights ;
    gbo:origin "engine" .

gbl:OpenOffice.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:OpenOffice ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 2.0 ;
    gbo:minHeight 2.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[3,6],\"w\":[3,6]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:OpenOffice.surface
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "surface"@en ;
    rdfs:domain gbl:OpenOffice ;
    gbo:fieldName "surface" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"carpet\""^^rdf:JSON ;
    gbo:vocabulary gbv:floor-surface .

gbl:OpenOffice.slot.floor
    a gbo:Slot ;
    gbo:slotName "floor" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:floor-tile .

gbl:OpenOffice.child.office-desk-set
    a gbo:ChildRule ;
    gbo:child gbl:OfficeDeskSet ;
    gbo:minCount 2 ;
    gbo:maxCount 12 ;
    gbo:weight 1.0 .

gbl:OpenOffice.child.office-lights
    a gbo:ChildRule ;
    gbo:child gbl:OfficeLights ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:Orchard
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, gbl:PlantedArea, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Orchard"@en ;
    rdfs:comment "Fruit trees in grid rows."@en ;
    gbo:moduleId "orchard" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:settlement, gbb:farmland ;
    gbo:hasField gbl:Orchard.size, gbl:Orchard.spacing, gbl:Orchard.trees, gbl:Orchard.fruit-mix ;
    gbo:hasSlot gbl:Orchard.slot.tree ;
    gbo:constraint "trees * 4 <= size.w * size.h"^^gbo:Expression ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:in-row ;
        gbo:members "[\"self.tree\",\"self.tree\"]"^^rdf:JSON ;
        gbo:weight 2.0 ;
        gbo:arguments "{\"axis\":\"x\"}"^^rdf:JSON
    ] ;
    gbo:origin "engine" .

gbl:Orchard.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 4.0 ;
    gbo:minHeight 4.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[8,16],\"w\":[8,16]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Orchard.spacing
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "spacing"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "spacing" ;
    gbo:fieldType gbo:spacing ;
    gbo:minValue 0.0 ;
    gbo:defaultValue "{\"max\":3,\"min\":2}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Orchard.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 1.0 ;
    gbo:maxValue 1000.0 ;
    gbo:defaultValue "[6,30]"^^rdf:JSON .

gbl:Orchard.fruit-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "fruit-mix"@en ;
    rdfs:domain gbl:Orchard ;
    gbo:fieldName "fruit-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"apple\":0.7,\"pear\":0.3}"^^rdf:JSON ;
    gbo:vocabulary gbv:fruit-kind .

gbl:Orchard.slot.tree
    a gbo:Slot ;
    gbo:slotName "tree" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:fruit-tree ;
    gbo:conceptsFrom gbl:Orchard.fruit-mix .

gbl:Outskirts
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Zone, gbl:Ward, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Farmstead
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "200"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:HousePlot
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:NatureScatter
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "60"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Road
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom [
            a owl:Class ;
            owl:unionOf ( gbl:Farmstead gbl:HousePlot gbl:NatureScatter gbl:Road )
        ]
    ] ;
    rdfs:label "Outskirts"@en ;
    rdfs:comment "Scattered farmsteads and houses beyond the centre."@en ;
    gbo:moduleId "outskirts" ;
    gbo:level gbo:Zone ;
    gbo:allowedIn gbb:settlement ;
    gbo:hasField gbl:Outskirts.area, gbl:Outskirts.buildings, gbl:Outskirts.plots, gbl:Outskirts.street-style ;
    gbo:hasChildRule gbl:Outskirts.child.farmstead, gbl:Outskirts.child.house-plot, gbl:Outskirts.child.nature-scatter, gbl:Outskirts.child.road ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:edge ;
        gbo:members "[\"self\"]"^^rdf:JSON ;
        gbo:weight 1.5
    ] ;
    gbo:origin "engine" .

gbl:Outskirts.area
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "area"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "area" ;
    gbo:fieldType gbo:area ;
    gbo:minValue 100.0 ;
    gbo:defaultValue "[1000,6000]"^^rdf:JSON ;
    gbo:unit "cells²" .

gbl:Outskirts.buildings
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "buildings"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "buildings" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"rare\""^^rdf:JSON ;
    gbo:unit "buildings per 100 cells" ;
    gbo:densityLevels "[0.0,0.5,1.0,2.0,3.0]"^^rdf:JSON .

gbl:Outskirts.plots
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "plots"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "plots" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 2000.0 ;
    gbo:defaultValue "[4,20]"^^rdf:JSON ;
    gbo:askedInConfirmation true .

gbl:Outskirts.street-style
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "street-style"@en ;
    rdfs:comment "this zone's own street pattern; unset, the place's main layout"@en ;
    rdfs:domain gbl:Outskirts ;
    gbo:fieldName "street-style" ;
    gbo:fieldType gbo:enum ;
    gbo:vocabulary gbv:layout .

gbl:Outskirts.child.farmstead
    a gbo:ChildRule ;
    gbo:child gbl:Farmstead ;
    gbo:minCount 0 ;
    gbo:maxCount 100 ;
    gbo:weight 0.7 .

gbl:Outskirts.child.house-plot
    a gbo:ChildRule ;
    gbo:child gbl:HousePlot ;
    gbo:minCount 0 ;
    gbo:maxCount 200 ;
    gbo:weight 0.8 .

gbl:Outskirts.child.nature-scatter
    a gbo:ChildRule ;
    gbo:child gbl:NatureScatter ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.9 .

gbl:Outskirts.child.road
    a gbo:ChildRule ;
    gbo:child gbl:Road ;
    gbo:minCount 0 ;
    gbo:maxCount 60 ;
    gbo:weight 0.6 .

gbl:Park
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Park, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Pond
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Pond
    ] ;
    rdfs:label "Park"@en ;
    rdfs:comment "A public park: lawns crossed by footpaths, trees and flowerbeds, a fountain or statue at its heart, benches and picnic tables, a play corner."@en ;
    gbo:moduleId "park" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:Park.size, gbl:Park.trees, gbl:Park.surface ;
    gbo:hasSlot gbl:Park.slot.bush, gbl:Park.slot.centrepiece, gbl:Park.slot.flowerbed, gbl:Park.slot.ground, gbl:Park.slot.park-bench, gbl:Park.slot.picnic-table, gbl:Park.slot.playground-set, gbl:Park.slot.street-light, gbl:Park.slot.trash-bin, gbl:Park.slot.tree ;
    gbo:hasChildRule gbl:Park.child.pond ;
    gbo:origin "engine" .

gbl:Park.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:Park ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[8,16],\"w\":[8,16]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:Park.trees
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "trees"@en ;
    rdfs:domain gbl:Park ;
    gbo:fieldName "trees" ;
    gbo:fieldType gbo:density ;
    gbo:defaultValue "\"common\""^^rdf:JSON ;
    gbo:densityLevels "[0.0,0.04,0.08,0.14,0.2]"^^rdf:JSON .

gbl:Park.surface
    a gbo:QualityField, owl:ObjectProperty ;
