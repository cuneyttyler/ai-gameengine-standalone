gbl:Encounter
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Feature, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Encounter"@en ;
    rdfs:comment "Enemies waiting in the room."@en ;
    gbo:moduleId "encounter" ;
    gbo:level gbo:Feature ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:Encounter.difficulty, gbl:Encounter.enemies, gbl:Encounter.enemy-mix ;
    gbo:hasSlot gbl:Encounter.slot.enemy ;
    gbo:origin "engine" .

gbl:Encounter.difficulty
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "difficulty"@en ;
    rdfs:domain gbl:Encounter ;
    gbo:fieldName "difficulty" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "2"^^rdf:JSON .

gbl:Encounter.enemies
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "enemies"@en ;
    rdfs:domain gbl:Encounter ;
    gbo:fieldName "enemies" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 20.0 ;
    gbo:defaultValue "[1,3]"^^rdf:JSON .

gbl:Encounter.enemy-mix
    a gbo:QualityField, owl:DatatypeProperty ;
    rdfs:label "enemy-mix"@en ;
    rdfs:domain gbl:Encounter ;
    gbo:fieldName "enemy-mix" ;
    gbo:fieldType gbo:mix ;
    gbo:defaultValue "{\"rat\":0.4,\"skeleton\":0.6}"^^rdf:JSON ;
    gbo:vocabulary gbv:enemy-kind .

gbl:Encounter.slot.enemy
    a gbo:Slot ;
    gbo:slotName "enemy" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:enemy ;
    gbo:conceptsFrom gbl:Encounter.enemy-mix .

gbl:EntranceRoom
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:DungeonRoom, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass gbl:Ambience
    ], [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:allValuesFrom gbl:Ambience
    ] ;
    rdfs:label "Entrance"@en ;
    rdfs:comment "Where the way in arrives: the dungeon's mouth, or the stairs from the level above."@en ;
    gbo:moduleId "entrance-room" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:dungeon ;
    gbo:hasField gbl:EntranceRoom.danger, gbl:EntranceRoom.size ;
    gbo:hasSlot gbl:EntranceRoom.slot.stairs ;
    gbo:hasChildRule gbl:EntranceRoom.child.ambience ;
    gbo:origin "engine" .

gbl:EntranceRoom.danger
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "danger"@en ;
    rdfs:domain gbl:EntranceRoom ;
    gbo:fieldName "danger" ;
    gbo:fieldType gbo:count ;
    gbo:minValue 0.0 ;
    gbo:maxValue 5.0 ;
    gbo:defaultValue "0"^^rdf:JSON .

gbl:EntranceRoom.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:EntranceRoom ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 60.0 ;
    gbo:maxHeight 60.0 ;
    gbo:defaultValue "{\"h\":[8,12],\"w\":[8,12]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:EntranceRoom.slot.stairs
    a gbo:Slot ;
    gbo:slotName "stairs" ;
    gbo:essential true ;
    gbo:primary true ;
    gbo:needsRole gbr:stairs .

gbl:EntranceRoom.child.ambience
    a gbo:ChildRule ;
    gbo:child gbl:Ambience ;
    gbo:minCount 0 ;
    gbo:maxCount 1 ;
    gbo:weight 0.7 .

gbl:FactoryPlot
    a owl:Class, gbo:Module ;
    rdfs:subClassOf gbo:Parcel, gbl:Industrial, [
        a owl:Restriction ;
        owl:onProperty gbo:hasPart ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Factory plot"@en ;
    rdfs:comment "A factory hall with a yard, trucks, crates and barrels."@en ;
    gbo:moduleId "factory-plot" ;
    gbo:level gbo:Parcel ;
    gbo:allowedIn gbb:modern-city ;
    gbo:hasField gbl:FactoryPlot.setback, gbl:FactoryPlot.size, gbl:FactoryPlot.condition ;
    gbo:hasSlot gbl:FactoryPlot.slot.barrel, gbl:FactoryPlot.slot.crate, gbl:FactoryPlot.slot.factory, gbl:FactoryPlot.slot.truck, gbl:FactoryPlot.slot.utility-pole ;
    gbo:typicallyRelated [
        a gbo:RelationUse ;
        gbo:relationType gbx:faces ;
        gbo:members "[\"self.primary\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 3.0
    ], [
        a gbo:RelationUse ;
        gbo:relationType gbx:adjacent ;
        gbo:members "[\"self\",\"parent.street\"]"^^rdf:JSON ;
        gbo:weight 2.0
    ] ;
    gbo:origin "engine" .

gbl:FactoryPlot.setback
    a gbo:QuantityField, owl:DatatypeProperty ;
    rdfs:label "setback"@en ;
    rdfs:domain gbl:FactoryPlot ;
    gbo:fieldName "setback" ;
    gbo:fieldType gbo:length ;
    gbo:minValue 0.0 ;
    gbo:maxValue 8.0 ;
    gbo:defaultValue "[1,2]"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FactoryPlot.size
    a gbo:QuantityField, owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:domain gbl:FactoryPlot ;
    gbo:fieldName "size" ;
    gbo:fieldType gbo:size ;
    gbo:minWidth 3.0 ;
    gbo:minHeight 3.0 ;
    gbo:maxWidth 40.0 ;
    gbo:maxHeight 40.0 ;
    gbo:defaultValue "{\"h\":[8,14],\"w\":[10,16]}"^^rdf:JSON ;
    gbo:unit "cells" .

gbl:FactoryPlot.condition
    a gbo:QualityField, owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain gbl:FactoryPlot ;
    gbo:fieldName "condition" ;
    gbo:fieldType gbo:enum ;
    gbo:defaultValue "\"lived-in\""^^rdf:JSON ;
    gbo:vocabulary gbv:condition .

gbl:FactoryPlot.slot.barrel
    a gbo:Slot ;
    gbo:slotName "barrel" ;
    gbo:essential false ;
    gbo:needsRole gbr:barrel .

gbl:FactoryPlot.slot.crate
    a gbo:Slot ;
    gbo:slotName "crate" ;
    gbo:essential false ;
    gbo:needsRole gbr:crate .

gbl:FactoryPlot.slot.factory
    a gbo:Slot ;
