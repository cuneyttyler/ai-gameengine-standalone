    gbo:level gbo:Dressing ;
    gbo:hasField gbl:Landscape.bushes, gbl:Landscape.flowers, gbl:Landscape.grass, gbl:Landscape.rocks, gbl:Landscape.trees ;
    gbo:hasSlot gbl:Landscape.slot.bush, gbl:Landscape.slot.flower, gbl:Landscape.slot.grass, gbl:Landscape.slot.mound, gbl:Landscape.slot.rock, gbl:Landscape.slot.tree ;
    gbo:origin "engine" .

