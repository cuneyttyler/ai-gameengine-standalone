gsv:GameplayRole_companion
    a skos:Concept ;
    skos:inScheme gsv:GameplayRole ;
    skos:notation "companion" ;
    skos:prefLabel "companion"@en .

gsv:GameplayRole_enemy
    a skos:Concept ;
    skos:inScheme gsv:GameplayRole ;
    skos:notation "enemy" ;
    skos:prefLabel "enemy"@en .

gsv:GameplayRole_elite
    a skos:Concept ;
    skos:inScheme gsv:GameplayRole ;
    skos:notation "elite" ;
    skos:prefLabel "elite"@en .

gsv:GameplayRole_boss
    a skos:Concept ;
    skos:inScheme gsv:GameplayRole ;
