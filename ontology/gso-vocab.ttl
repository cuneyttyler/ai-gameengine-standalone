    skos:prefLabel "justice-injustice"@en .

# --- Structure templates ---

gsv:StructureTemplate_episodic
    gso:acts "chapters" ;
    gso:roles "protagonist" .

gsv:StructureTemplate_five_act
    gso:acts "exposition, rising-action, climax-act, falling-action, denouement" ;
    gso:roles "protagonist, antagonist" .

gsv:StructureTemplate_heros_journey
    gso:acts "departure, initiation, return" ;
    gso:roles "protagonist, mentor, antagonist, threshold-guardian, herald" .

gsv:StructureTemplate_kishotenketsu
    gso:acts "ki, sho, ten, ketsu" ;
    gso:roles "protagonist" .

gsv:StructureTemplate_save_the_cat
    gso:acts "act-1, act-2a, act-2b, act-3" ;
    gso:roles "protagonist, antagonist" .

gsv:StructureTemplate_three_act
    gso:acts "setup, confrontation, resolution" ;
    gso:roles "protagonist, antagonist" .

# --- Rules ---

gso:rule_R_S1
    a gso:StoryRule ;
    gso:ruleId "R-S1" ;
    gso:severity "error" ;
    rdfs:comment "Every act has at least one scene; acts follow the template's order."@en .

gso:rule_R_S2
    a gso:StoryRule ;
    gso:ruleId "R-S2" ;
    gso:severity "error" ;
    rdfs:comment "Every main-line scene is reachable from the first scene along next/branchesTo."@en .

gso:rule_R_S3
    a gso:StoryRule ;
    gso:ruleId "R-S3" ;
    gso:severity "error" ;
    rdfs:comment "Every branch reaches an ending or a convergence."@en .

gso:rule_R_S4
    a gso:StoryRule ;
    gso:ruleId "R-S4" ;
    gso:severity "warning" ;
    rdfs:comment "Every choice point option has consequences."@en .

gso:rule_R_S5
    a gso:StoryRule ;
    gso:ruleId "R-S5" ;
    gso:severity "warning" ;
    rdfs:comment "The climax is in the last 25% of the main line."@en .

gso:rule_R_S6
    a gso:StoryRule ;
    gso:ruleId "R-S6" ;
    gso:severity "warning" ;
    rdfs:comment "Every kernel scene turns its value."@en .

gso:rule_R_C1
    a gso:StoryRule ;
    gso:ruleId "R-C1" ;
    gso:severity "warning" ;
    rdfs:comment "Every kernel event is caused or enabled by an earlier event, or is the inciting incident."@en .

gso:rule_R_C2
    a gso:StoryRule ;
    gso:ruleId "R-C2" ;
    gso:severity "warning" ;
    rdfs:comment "Every action in a kernel scene serves an agent's goal."@en .

gso:rule_R_C3
    a gso:StoryRule ;
    gso:ruleId "R-C3" ;
    gso:severity "warning" ;
    rdfs:comment "Every setup is paid off, or marked openEnded."@en .

gso:rule_R_C4
    a gso:StoryRule ;
    gso:ruleId "R-C4" ;
    gso:severity "warning" ;
    rdfs:comment "Every conflict is resolved, or deliberately left open."@en .

gso:rule_R_T1
    a gso:StoryRule ;
    gso:ruleId "R-T1" ;
    gso:severity "error" ;
    rdfs:comment "A character participates only while alive (unless a flashback or undead)."@en .

gso:rule_R_T2
    a gso:StoryRule ;
    gso:ruleId "R-T2" ;
    gso:severity "error" ;
    rdfs:comment "A character is in one location per scene."@en .

gso:rule_R_T3
    a gso:StoryRule ;
    gso:ruleId "R-T3" ;
    gso:severity "error" ;
    rdfs:comment "A character refers only to what it knows at that scene."@en .

gso:rule_R_T4
    a gso:StoryRule ;
    gso:ruleId "R-T4" ;
    gso:severity "error" ;
    rdfs:comment "A unique item has one possessor at a time."@en .

gso:rule_R_T5
    a gso:StoryRule ;
    gso:ruleId "R-T5" ;
    gso:severity "warning" ;
    rdfs:comment "Relationship changes have a cause: a scene that presents the change."@en .

gso:rule_R_T6
    a gso:StoryRule ;
    gso:ruleId "R-T6" ;
    gso:severity "warning" ;
    rdfs:comment "Travel between consecutive scenes is possible by connections."@en .

gso:rule_R_K1
    a gso:StoryRule ;
    gso:ruleId "R-K1" ;
    gso:severity "error" ;
    rdfs:comment "Every narrative role the template requires is filled."@en .

gso:rule_R_K2
    a gso:StoryRule ;
    gso:ruleId "R-K2" ;
    gso:severity "warning" ;
    rdfs:comment "Every major character has need, desire, motivation and an arc or a reason not to change."@en .

gso:rule_R_K3
    a gso:StoryRule ;
    gso:ruleId "R-K3" ;
    gso:severity "error" ;
    rdfs:comment "Relationships are consistent both ways."@en .

gso:rule_R_K4
    a gso:StoryRule ;
    gso:ruleId "R-K4" ;
    gso:severity "warning" ;
    rdfs:comment "Names are unique and distinguishable."@en .

gso:rule_R_K5
    a gso:StoryRule ;
    gso:ruleId "R-K5" ;
    gso:severity "error" ;
    rdfs:comment "Every character with a gameplay role has what it needs."@en .

gso:rule_R_K6
    a gso:StoryRule ;
    gso:ruleId "R-K6" ;
    gso:severity "warning" ;
    rdfs:comment "Every character placed in the world has an AI package or a reason to stand still."@en .

gso:rule_R_Q1
    a gso:StoryRule ;
    gso:ruleId "R-Q1" ;
    gso:severity "error" ;
    rdfs:comment "Every main-line kernel scene in gameplay mode is advanced by a main-quest stage."@en .

gso:rule_R_Q2
    a gso:StoryRule ;
    gso:ruleId "R-Q2" ;
    gso:severity "error" ;
    rdfs:comment "Every alias is fillable."@en .

gso:rule_R_Q3
    a gso:StoryRule ;
    gso:ruleId "R-Q3" ;
    gso:severity "error" ;
    rdfs:comment "Each quest is completable: required characters are alive when needed."@en .

gso:rule_R_Q4
    a gso:StoryRule ;
    gso:ruleId "R-Q4" ;
    gso:severity "warning" ;
    rdfs:comment "A quest's giver has a motivation consistent with the quest's."@en .

gso:rule_R_Q5
    a gso:StoryRule ;
    gso:ruleId "R-Q5" ;
    gso:severity "warning" ;
    gso:judgedBy "critic" ;
    rdfs:comment "Quest levels follow the difficulty curve."@en .

gso:rule_R_Q6
    a gso:StoryRule ;
    gso:ruleId "R-Q6" ;
    gso:severity "warning" ;
    gso:judgedBy "critic" ;
    rdfs:comment "Rewards fit the economy."@en .

gso:rule_R_Q7
    a gso:StoryRule ;
    gso:ruleId "R-Q7" ;
    gso:severity "error" ;
    rdfs:comment "A quest that kills a character doesn't break a later quest that needs them."@en .

gso:rule_R_P1
    a gso:StoryRule ;
    gso:ruleId "R-P1" ;
    gso:severity "error" ;
    rdfs:comment "Every location used by a scene exists, with a build type."@en .

gso:rule_R_P2
    a gso:StoryRule ;
    gso:ruleId "R-P2" ;
    gso:severity "error" ;
    rdfs:comment "Every location is reachable from the start location by connections."@en .

gso:rule_R_P3
    a gso:StoryRule ;
    gso:ruleId "R-P3" ;
    gso:severity "error" ;
    rdfs:comment "The parts a scene needs in a location are in its required parts."@en .

gso:rule_R_P4
    a gso:StoryRule ;
    gso:ruleId "R-P4" ;
    gso:severity "warning" ;
    gso:judgedBy "critic" ;
    rdfs:comment "A location's mood agrees with the scenes set there."@en .

