# GSO vocabulary: classes, properties and concept schemes
#
# GENERATED from data/story/ by the engine (engine/story/StoryOntology.cpp).
# Don't edit: change the JSON files and regenerate (ontology/README.md).

@prefix gso:     <https://w3id.org/aige/gso#> .
@prefix gsv:     <https://w3id.org/aige/gso/vocab#> .
@prefix gss:     <https://w3id.org/aige/gso/shapes#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/aige/gso/vocab>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gso> ;
    dcterms:title "GSO vocabulary: the Game Story Ontology's classes, properties and vocabularies"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

# --- Classes ---

gso:Act
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "A top-level part of the story."@en ;
    rdfs:label "Act"@en .

gso:Action
    a owl:Class ;
    rdfs:subClassOf gso:Event ;
    gso:layer "fabula" ;
    rdfs:comment "An event done by an agent with an intention."@en ;
    rdfs:label "Action"@en .

gso:Alias
    a owl:Class ;
    gso:layer "play" ;
    rdfs:comment "A role filled when the quest starts."@en ;
    rdfs:label "Alias"@en .

gso:BackstoryEvent
    a owl:Class ;
    rdfs:subClassOf gso:Event ;
    gso:layer "fabula" ;
    rdfs:comment "Before the game starts; revealed in play."@en ;
    rdfs:label "Backstory event"@en .

gso:Bark
    a owl:Class ;
    gso:layer "presentation" ;
    rdfs:comment "A one-line remark with conditions."@en ;
    rdfs:label "Bark"@en .

gso:Beat
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "A moment inside a scene."@en ;
    rdfs:label "Beat"@en .

gso:Belief
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "What a character knows or believes."@en ;
    rdfs:label "Belief"@en .

gso:Chapter
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "A group of scenes with one dramatic question."@en ;
    rdfs:label "Chapter"@en .

gso:Character
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "A person or creature with a part in the story."@en ;
    rdfs:label "Character"@en .

gso:ChoicePoint
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "Where the player's choice changes what follows."@en ;
    rdfs:label "Choice point"@en .

gso:Conflict
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "An opposition."@en ;
    rdfs:label "Conflict"@en .

gso:Convergence
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "Where branches join again."@en ;
    rdfs:label "Convergence"@en .

gso:Cutscene
    a owl:Class ;
    gso:layer "presentation" ;
    rdfs:comment "An engine cutscene file."@en ;
    rdfs:label "Cutscene"@en .

gso:Decision
    a owl:Class ;
    gso:layer "provenance" ;
    rdfs:comment "A recorded choice by the AI or the user."@en ;
    rdfs:label "Decision"@en .

gso:Dialogue
    a owl:Class ;
    gso:layer "presentation" ;
    rdfs:comment "An engine dialogue file."@en ;
    rdfs:label "Dialogue"@en .

gso:Document
    a owl:Class ;
    gso:layer "presentation" ;
    rdfs:comment "A readable in the world."@en ;
    rdfs:label "Document"@en .

gso:Ending
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "One way the story ends."@en ;
    rdfs:label "Ending"@en .

gso:Event
    a owl:Class ;
    gso:layer "fabula" ;
    rdfs:comment "Something that happens in story time."@en ;
    rdfs:label "Event"@en .

gso:Faction
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "An organisation."@en ;
    rdfs:label "Faction"@en .

gso:GameplayRole
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "A function in play."@en ;
    rdfs:label "Gameplay role"@en .

gso:Goal
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "What a character wants, at a time."@en ;
    rdfs:label "Goal"@en .

gso:Happening
    a owl:Class ;
    rdfs:subClassOf gso:Event ;
    gso:layer "fabula" ;
    rdfs:comment "An event without an agent's intention."@en ;
    rdfs:label "Happening"@en .

gso:Item
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "A thing with a part in the story."@en ;
    rdfs:label "Item"@en .

gso:Location
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "A place in the story world."@en ;
    rdfs:label "Location"@en .

gso:Lore
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "Background: history, religion, myths."@en ;
    rdfs:label "Lore"@en .

gso:NarrativeRole
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "A function in a storyline (an archetype, sphere or actant)."@en ;
    rdfs:label "Narrative role"@en .

gso:Objective
    a owl:Class ;
    gso:layer "play" ;
    rdfs:comment "What the player must do in a stage."@en ;
    rdfs:label "Objective"@en .

gso:PlayerCharacter
    a owl:Class ;
    rdfs:subClassOf gso:Character ;
    gso:layer "world" ;
    rdfs:comment "The player's character."@en ;
    rdfs:label "Player character"@en .

gso:Quest
    a owl:Class ;
    gso:layer "play" ;
    rdfs:comment "A unit of play with a goal, given and completed."@en ;
    rdfs:label "Quest"@en .

gso:QuestStage
    a owl:Class ;
    gso:layer "play" ;
    rdfs:comment "A numbered state of a quest."@en ;
    rdfs:label "Quest stage"@en .

gso:Reward
    a owl:Class ;
    gso:layer "play" ;
    rdfs:comment "What completing a quest gives."@en ;
    rdfs:label "Reward"@en .

gso:Source
    a owl:Class ;
    gso:layer "provenance" ;
    rdfs:comment "A theory, a template, the user's request, a learned fact."@en ;
    rdfs:label "Source"@en .

gso:Story
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "The game's story."@en ;
    rdfs:label "Story"@en .

gso:StoryScene
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "One unit of story: a goal pursued against conflict to an outcome, turning a value."@en ;
    rdfs:label "Story scene"@en .

gso:StoryVariable
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "State the story remembers."@en ;
    rdfs:label "Story variable"@en .

gso:Storyline
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "A thread of scenes: main, side, companion, faction."@en ;
    rdfs:label "Storyline"@en .

gso:StructureTemplate
    a owl:Class ;
    gso:layer "plot" ;
    rdfs:comment "A shape for stories, with its beats and their positions."@en ;
    rdfs:label "Structure template"@en .

gso:Theme
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "What the story is about."@en ;
    rdfs:label "Theme"@en .

gso:WorldRule
    a owl:Class ;
    gso:layer "world" ;
    rdfs:comment "A rule of this world, judged as text by the critic."@en ;
    rdfs:label "World rule"@en .

# --- Properties ---

gso:actualizes
    a owl:ObjectProperty ;
    rdfs:domain gso:Event ;
    rdfs:range gso:Goal ;
    rdfs:label "actualizes"@en ;
    rdfs:comment "Achieves a goal."@en .

gso:advancesScene
    a owl:ObjectProperty ;
    rdfs:domain gso:QuestStage ;
    rdfs:range gso:StoryScene ;
    rdfs:label "advancesScene"@en ;
    rdfs:comment "The scene a stage plays."@en .

gso:at
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:Event ) ] ;
    rdfs:range gso:Location ;
    rdfs:label "at"@en ;
    rdfs:comment "Where it happens."@en .

gso:branchesTo
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:ChoicePoint ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:Ending gso:Convergence ) ] ;
    rdfs:label "branchesTo"@en ;
    rdfs:comment "A branch, via a choice point."@en .

gso:causes
    a owl:ObjectProperty ;
    rdfs:domain gso:Event ;
    rdfs:range gso:Event ;
    rdfs:label "causes"@en ;
    rdfs:comment "Causality."@en .

gso:connects
    a owl:ObjectProperty ;
    rdfs:domain gso:Location ;
    rdfs:range gso:Location ;
    rdfs:label "connects"@en ;
    rdfs:comment "How two locations join."@en .

gso:consequence
    a owl:ObjectProperty ;
    rdfs:domain gso:ChoicePoint ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:StoryVariable gso:StoryScene gso:Character ) ] ;
    rdfs:label "consequence"@en ;
    rdfs:comment "What a choice changes."@en .

gso:enables
    a owl:ObjectProperty ;
    rdfs:domain gso:Event ;
    rdfs:range gso:Event ;
    rdfs:label "enables"@en ;
    rdfs:comment "Makes possible."@en .

gso:excludes
    a owl:ObjectProperty ;
    rdfs:domain gso:Quest ;
    rdfs:range gso:Quest ;
    rdfs:label "excludes"@en ;
    rdfs:comment "Can't both be done."@en .

gso:fills
    a owl:ObjectProperty ;
    rdfs:domain gso:Character ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:NarrativeRole gso:GameplayRole ) ] ;
    rdfs:label "fills"@en ;
    rdfs:comment "A character fills a role."@en .

gso:gives
    a owl:ObjectProperty ;
    rdfs:domain gso:Character ;
    rdfs:range gso:Quest ;
    rdfs:label "gives"@en ;
    rdfs:comment "A quest's giver."@en .

gso:hasAlias
    a owl:ObjectProperty ;
    rdfs:domain gso:Quest ;
    rdfs:range gso:Alias ;
    rdfs:label "hasAlias"@en ;
    rdfs:comment "A quest's aliases."@en .

gso:hasChoice
    a owl:ObjectProperty ;
    rdfs:domain gso:StoryScene ;
    rdfs:range gso:ChoicePoint ;
    rdfs:label "hasChoice"@en ;
    rdfs:comment "The choice point a scene ends with."@en .

gso:hasGoal
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Character gso:Faction ) ] ;
    rdfs:range gso:Goal ;
    rdfs:label "hasGoal"@en ;
    rdfs:comment "What it wants, from when to when."@en .

gso:hasObjective
    a owl:ObjectProperty ;
    rdfs:domain gso:QuestStage ;
    rdfs:range gso:Objective ;
    rdfs:label "hasObjective"@en ;
    rdfs:comment "A stage's objectives."@en .

gso:hasRelationship
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Character gso:Faction ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:Character gso:Faction ) ] ;
    rdfs:label "hasRelationship"@en ;
    rdfs:comment "A typed, reified tie."@en .

gso:hasStage
    a owl:ObjectProperty ;
    rdfs:domain gso:Quest ;
    rdfs:range gso:QuestStage ;
    rdfs:label "hasStage"@en ;
    rdfs:comment "A quest's stages."@en .

gso:inStoryline
    a owl:ObjectProperty ;
    rdfs:domain gso:StoryScene ;
    rdfs:range gso:Storyline ;
    rdfs:label "inStoryline"@en ;
    rdfs:comment "A scene serves a storyline (it may serve several)."@en .

gso:inside
    a owl:ObjectProperty ;
    rdfs:domain gso:Location ;
    rdfs:range gso:Location ;
    rdfs:label "inside"@en ;
    rdfs:comment "Region hierarchy: room in building in settlement in region."@en .

gso:knows
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain gso:Character ;
    rdfs:range gso:Belief ;
    rdfs:label "knows"@en ;
    rdfs:comment "What a character knows."@en .

gso:locatedAt
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Character gso:Item ) ] ;
    rdfs:range gso:Location ;
    rdfs:label "locatedAt"@en ;
    rdfs:comment "Where they are by default."@en .

gso:madeBy
    a owl:ObjectProperty ;
    rdfs:range gso:Decision ;
    rdfs:label "madeBy"@en ;
    rdfs:comment "Provenance."@en .

gso:memberOf
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain gso:Character ;
    rdfs:range gso:Faction ;
    rdfs:label "memberOf"@en ;
    rdfs:comment "Membership."@en .

gso:mentions
    a owl:ObjectProperty ;
    rdfs:domain gso:Character ;
    rdfs:label "mentions"@en ;
    rdfs:comment "What a character speaks of in a scene's dialogue (checked against what it knows)."@en .

gso:motivates
    a owl:ObjectProperty ;
    rdfs:domain gso:Event ;
    rdfs:range gso:Goal ;
    rdfs:label "motivates"@en ;
    rdfs:comment "Gives an agent a goal."@en .

gso:needsCharacter
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Quest gso:QuestStage ) ] ;
    rdfs:range gso:Character ;
    rdfs:label "needsCharacter"@en ;
    rdfs:comment "A character the quest needs alive."@en .

gso:next
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:Convergence ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:Ending gso:Convergence ) ] ;
    rdfs:label "next"@en ;
    rdfs:comment "Discourse order (a convergence leads on to its scene)."@en .

gso:partOf
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Beat gso:StoryScene gso:Chapter gso:Act ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:Chapter gso:Act gso:Story ) ] ;
    rdfs:label "partOf"@en ;
    rdfs:comment "Mereology: beat, scene, chapter, act, story."@en .

gso:participant
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:StoryScene gso:Event ) ] ;
    rdfs:range gso:Character ;
    rdfs:label "participant"@en ;
    rdfs:comment "Who takes part, with a role."@en .

gso:paysOff
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Event gso:StoryScene ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:Event gso:Item ) ] ;
    rdfs:label "paysOff"@en ;
    rdfs:comment "A setup paid off."@en .

gso:possesses
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Character gso:Location ) ] ;
    rdfs:range gso:Item ;
    rdfs:label "possesses"@en ;
    rdfs:comment "Who has what."@en .

gso:presents
    a owl:ObjectProperty ;
    rdfs:domain gso:StoryScene ;
    rdfs:range gso:Event ;
    rdfs:label "presents"@en ;
    rdfs:comment "The events a scene shows."@en .

gso:prevents
    a owl:ObjectProperty ;
    rdfs:domain gso:Event ;
    rdfs:range [ a owl:Class ; owl:unionOf ( gso:Event gso:Goal ) ] ;
    rdfs:label "prevents"@en ;
    rdfs:comment "Stops."@en .

gso:realizedBy
    a owl:ObjectProperty ;
    rdfs:label "realizedBy"@en ;
    rdfs:comment "The engine file or entity that realises it."@en .

gso:requiresQuest
    a owl:ObjectProperty ;
    rdfs:domain gso:Quest ;
    rdfs:range gso:Quest ;
    rdfs:label "requiresQuest"@en ;
    rdfs:comment "Must be done first."@en .

gso:resolves
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Event gso:Ending ) ] ;
    rdfs:range gso:Conflict ;
    rdfs:label "resolves"@en ;
    rdfs:comment "Ends a conflict."@en .

gso:serves
    a owl:ObjectProperty ;
    rdfs:domain gso:Action ;
    rdfs:range gso:Goal ;
    rdfs:label "serves"@en ;
    rdfs:comment "The goal an action serves (intentionality)."@en .

gso:state
    a owl:ObjectProperty ;
    a gso:TemporalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gso:Character gso:Location gso:Item ) ] ;
    rdfs:label "state"@en ;
    rdfs:comment "A state over time: alive, dead, cursed, destroyed (byQuest: the quest that causes it)."@en .

