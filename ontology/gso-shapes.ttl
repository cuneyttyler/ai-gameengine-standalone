<https://w3id.org/aige/gso/shapes>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/aige/gso> ;
    dcterms:title "GSO shapes: SHACL for story knowledge graphs"@en ;
    dcterms:description "Types, required fields and closed vocabularies of each class. Temporal facts, causality and continuity rules are beyond SHACL Core; the engine checks them (engine/story/StoryRules)."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "AIGE project" .

gss:ActShape
    a sh:NodeShape ;
    sh:targetClass gso:Act ;
    sh:property [
        sh:path gso:order ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path gso:purpose ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

