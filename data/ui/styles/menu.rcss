/* Menus and windows: a title, a body and items to pick (the highlighted one marked). */

body.menu { background-color: transparent; }
.menu .screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.menu .screen.shade { background-color: var(--shade); }

.menu .panel
{
	position: absolute;
	left: 50%;
	top: 22%;
	width: 460dp;
	margin-left: -230dp;
	text-align: center;
}
.menu .subtitle { color: var(--text-dim); margin-bottom: 8dp; }
.menu .body { color: var(--text-dim); text-align: left; white-space: pre-line; margin: 10dp 0; font-size: 15dp; }
.menu .items { margin-top: 12dp; }
.menu .item { padding: 4dp 8dp; cursor: pointer; }
.menu .item:hover { color: var(--highlight); }
.menu .item.lit { color: var(--highlight); }
.menu .item.off { color: var(--text-dim); }
.menu .footer { color: var(--text-dim); font-size: 13dp; margin-top: 12dp; }

/* Windows (inventory, shop, journal): wider, the list beside the details. */
.window .panel { width: 680dp; margin-left: -340dp; text-align: left; top: 14%; }
.window .columns { display: flex; flex-direction: row; }
.window .items { width: 300dp; overflow-y: auto; max-height: 380dp; }
.window .body { flex: 1; margin: 12dp 0 0 16dp; }

/* Rows with an icon and a second column (an item's count, a price, a key), under headings (32.7). */
.window .heading { color: var(--accent); font-size: 13dp; margin: 8dp 0 2dp 0; padding-left: 8dp; }
.window .row { display: flex; flex-direction: row; align-items: center; text-align: left; }
.window .row .icon { width: 24dp; height: 24dp; margin-right: 8dp; }
.window .row .label { flex: 1; }
.window .row .detail { color: var(--text-dim); margin-left: 12dp; text-align: right; }
.window .row.lit .detail { color: var(--highlight); }
.window .items.wide { width: auto; max-height: 420dp; }
.window.shop .purse { color: var(--accent); margin: 4dp 0 8dp 0; }
.window.journal .panel { width: 760dp; margin-left: -380dp; }
.window.journal .page { font-size: 16dp; color: var(--text); }
.window.map .panel { width: 860dp; margin-left: -430dp; top: 8%; }
.window.map .picture { position: relative; width: 520dp; height: 400dp; margin-right: 16dp; }
.window.map .picture img { width: 520dp; height: 400dp; }
.window.map .items { width: 280dp; }
.window.sheet .panel { width: 520dp; margin-left: -260dp; }
/* You are here: a dot on the map (its middle on the player). */
.window.map .you { position: absolute; width: 12dp; height: 12dp; margin: -6dp 0 0 -6dp; background-color: var(--highlight); border: 2dp var(--panel); border-radius: 6dp; }
