          "x": 0,
          "y": 0,
          "w": 240,
          "h": 14,
          "bg": "bar-back",
          "bar": {
            "value": "health",
            "max": "health_max",
            "color": "health"
          }
        },
        {
          "id": "mana",
          "type": "bar",
          "name": "Mana",
          "anchor": "tl",
          "x": 0,
          "y": 18,
          "w": 240,
          "h": 14,
          "bg": "bar-back",
          "bar": {
            "value": "mana",
            "max": "mana_max",
            "color": "mana"
          }
        },
        {
          "id": "stamina",
          "type": "bar",
          "name": "Stamina",
          "anchor": "tl",
          "x": 0,
          "y": 36,
          "w": 240,
          "h": 14,
          "bg": "bar-back",
          "bar": {
            "value": "stamina",
            "max": "stamina_max",
            "color": "stamina"
          }
        }
      ]
    },
    {
      "id": "quest",
      "type": "panel",
