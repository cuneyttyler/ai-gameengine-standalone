          "x": 0,
          "y": 24,
          "w": 340,
          "h": 22,
          "text": "{{objective}}",
          "size": 15
        }
      ]
    },
    {
      "id": "clock",
      "type": "text",
      "name": "Clock",
      "anchor": "tr",
      "x": 20,
      "y": 20,
      "w": 200,
      "h": 30,
      "text": "{{clock}}",
      "align": "right",
      "bg": "panel",
      "padding": 6
    },
    {
      "id": "gold",
      "type": "text",
      "name": "Gold",
      "anchor": "tr",
      "x": 20,
      "y": 56,
