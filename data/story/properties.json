{
  "comment": "GSO properties, docs/systems/story-ontology.md §5. temporal: holds over an interval of scenes (from, until, branch).",
  "properties": {
    "partOf":          {"domain": ["Beat", "StoryScene", "Chapter", "Act"], "range": ["StoryScene", "Chapter", "Act", "Story"], "comment": "Mereology: beat, scene, chapter, act, story."},
    "inStoryline":     {"domain": ["StoryScene"], "range": ["Storyline"], "comment": "A scene serves a storyline (it may serve several)."},
    "next":            {"domain": ["StoryScene", "Convergence"], "range": ["StoryScene", "Ending", "Convergence"], "comment": "Discourse order (a convergence leads on to its scene)."},
    "branchesTo":      {"domain": ["StoryScene", "ChoicePoint"], "range": ["StoryScene", "Ending", "Convergence"], "comment": "A branch, via a choice point.", "fields": {"option": "text", "branch": "text"}},
    "hasChoice":       {"domain": ["StoryScene"], "range": ["ChoicePoint"], "comment": "The choice point a scene ends with."},
    "consequence":     {"domain": ["ChoicePoint"], "range": ["StoryVariable", "StoryScene", "Character"], "comment": "What a choice changes.", "fields": {"option": "text"}},
    "presents":        {"domain": ["StoryScene"], "range": ["Event"], "comment": "The events a scene shows."},
    "participant":     {"domain": ["StoryScene", "Event"], "range": ["Character"], "comment": "Who takes part, with a role.", "fields": {"role": "text"}},
    "at":              {"domain": ["StoryScene", "Event"], "range": ["Location"], "comment": "Where it happens."},
    "causes":          {"domain": ["Event"], "range": ["Event"], "comment": "Causality."},
    "enables":         {"domain": ["Event"], "range": ["Event"], "comment": "Makes possible."},
    "motivates":       {"domain": ["Event"], "range": ["Goal"], "comment": "Gives an agent a goal."},
    "prevents":        {"domain": ["Event"], "range": ["Event", "Goal"], "comment": "Stops."},
    "actualizes":      {"domain": ["Event"], "range": ["Goal"], "comment": "Achieves a goal."},
    "serves":          {"domain": ["Action"], "range": ["Goal"], "comment": "The goal an action serves (intentionality)."},
    "resolves":        {"domain": ["Event", "Ending"], "range": ["Conflict"], "comment": "Ends a conflict."},
    "paysOff":         {"domain": ["Event", "StoryScene"], "range": ["Event", "Item"], "comment": "A setup paid off."},
    "fills":           {"domain": ["Character"], "range": ["NarrativeRole", "GameplayRole"], "comment": "A character fills a role."},
    "hasGoal":         {"domain": ["Character", "Faction"], "range": ["Goal"], "temporal": true, "comment": "What it wants, from when to when."},
    "hasRelationship": {"domain": ["Character", "Faction"], "range": ["Character", "Faction"], "temporal": true, "comment": "A typed, reified tie.", "fields": {"type": "RelationshipType", "valence": "number", "secret": "boolean"}},
    "memberOf":        {"domain": ["Character"], "range": ["Faction"], "temporal": true, "comment": "Membership."},
    "knows":           {"domain": ["Character"], "range": ["Belief"], "temporal": true, "comment": "What a character knows.", "fields": {"about": "text", "true": "boolean"}},
    "mentions":        {"domain": ["Character"], "range": [], "comment": "What a character speaks of in a scene's dialogue (checked against what it knows).", "fields": {"about": "text", "scene": "StoryScene"}},
    "possesses":       {"domain": ["Character", "Location"], "range": ["Item"], "temporal": true, "comment": "Who has what."},
    "locatedAt":       {"domain": ["Character", "Item"], "range": ["Location"], "temporal": true, "comment": "Where they are by default."},
    "state":           {"domain": ["Character", "Location", "Item"], "range": [], "temporal": true, "comment": "A state over time: alive, dead, cursed, destroyed (byQuest: the quest that causes it).", "fields": {"state": "text", "byQuest": "Quest"}},
    "connects":        {"domain": ["Location"], "range": ["Location"], "comment": "How two locations join.", "fields": {"kind": "text", "gate": "text"}},
    "inside":          {"domain": ["Location"], "range": ["Location"], "comment": "Region hierarchy: room in building in settlement in region."},
    "gives":           {"domain": ["Character"], "range": ["Quest"], "comment": "A quest's giver."},
    "hasStage":        {"domain": ["Quest"], "range": ["QuestStage"], "comment": "A quest's stages."},
    "hasObjective":    {"domain": ["QuestStage"], "range": ["Objective"], "comment": "A stage's objectives."},
    "hasAlias":        {"domain": ["Quest"], "range": ["Alias"], "comment": "A quest's aliases."},
    "advancesScene":   {"domain": ["QuestStage"], "range": ["StoryScene"], "comment": "The scene a stage plays."},
    "requiresQuest":   {"domain": ["Quest"], "range": ["Quest"], "comment": "Must be done first."},
    "excludes":        {"domain": ["Quest"], "range": ["Quest"], "comment": "Can't both be done."},
    "needsCharacter":  {"domain": ["Quest", "QuestStage"], "range": ["Character"], "comment": "A character the quest needs alive.", "fields": {"at": "text"}},
    "realizedBy":      {"domain": [], "range": [], "comment": "The engine file or entity that realises it.", "fields": {"path": "text"}},
    "madeBy":          {"domain": [], "range": ["Decision"], "comment": "Provenance."}
  }
}
