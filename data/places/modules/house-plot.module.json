{
  "schema": "aige.module/1",
  "id": "house-plot",
  "name": "House plot",
  "level": "parcel",
  "description": "A house on its plot, facing the street, with a yard and maybe a garden.",
  "buildTypes": [
    "settlement"
  ],
  "classes": [
    "Dwelling"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          5,
          7
        ],
        "h": [
          6,
          10
        ]
      },
      "min": {
        "w": 3,
        "h": 4
      },
      "unit": "cells",
      "max": {
        "w": 16,
        "h": 20
      }
    },
    "setback": {
      "type": "length",
      "default": [
        0,
        2
      ],
      "min": 0,
      "unit": "cells",
      "max": 6
    }
  },
  "quality": {
    "house-kind": {
      "type": "enum",
      "vocabulary": "house-kind",
      "default": "cottage",
      "ask": true
    },
    "wealth": {
      "type": "enum",
      "vocabulary": "wealth",
      "default": "common"
    },
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in"
    },
    "fenced": {
      "type": "bool",
      "default": false,
      "ask": true
    }
  },
  "slots": {
    "house": {
      "role": "house",
      "essential": true,
      "primary": true,
      "concepts": "house-kind"
    },
    "outbuilding": {
      "role": "outbuilding",
      "essential": false
    },
    "fence": {
      "role": "fence-piece-set",
      "essential": false,
      "when": "fenced"
    }
  },
  "children": {
    "front-yard": {
      "min": 0,
      "weight": 0.6,
      "max": 1
    },
    "garden": {
      "min": 0,
      "weight": 0.5,
      "max": 2
    },
    "doorstep-set": {
      "min": 0,
      "weight": 0.7,
      "max": 1
    },
    "fence-line": {
      "min": 0,
      "weight": 0.4,
      "max": 1,
      "when": "fenced"
    }
  },
  "constraints": [
    "count(children(garden)) <= 2",
    "size.w * size.h >= 12"
  ],
  "relations": [
    {
      "type": "faces",
      "members": [
        "self.primary",
        "parent.street"
      ],
      "weight": 3.0
    },
    {
      "type": "adjacent",
      "members": [
        "self",
        "parent.street"
      ],
      "weight": 2.0
    },
    {
      "type": "behind",
      "members": [
        "self.outbuilding",
        "self.primary"
      ],
      "weight": 1.0
    }
  ]
}
