{
  "schema": "aige.module/1",
  "id": "hotel-plot",
  "name": "Hotel plot",
  "level": "parcel",
  "description": "A hotel with a drop-off forecourt and taxis.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Commercial"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          6,
          9
        ],
        "h": [
          6,
          9
        ]
      },
      "min": {
        "w": 3,
        "h": 3
      },
      "unit": "cells",
      "max": {
        "w": 40,
        "h": 40
      }
    },
    "setback": {
      "type": "length",
      "default": [
        1,
        2
      ],
      "min": 0,
      "unit": "cells",
      "max": 8
    }
  },
  "quality": {
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in"
    }
  },
  "slots": {
    "hotel": {
      "role": "hotel",
      "essential": true,
      "primary": true
    },
    "street-light": {
      "role": "street-light",
      "essential": false
    },
    "trash-bin": {
      "role": "trash-bin",
      "essential": false
    },
    "taxi": {
      "role": "taxi",
      "essential": false
    },
    "planter": {
      "role": "planter",
      "essential": false
    }
  },
  "children": {},
  "relations": [
    {
      "type": "faces",
      "members": [
        "self.primary",
        "parent.street"
      ],
      "weight": 3.0
    },
    {
      "type": "adjacent",
      "members": [
        "self",
        "parent.street"
      ],
      "weight": 2.0
    }
  ],
  "compile": {
    "contents": [
      {
        "slot": "street-light",
        "count": [
          1,
          2
        ],
        "where": "border"
      },
      {
        "slot": "taxi",
        "count": [
          0,
          2
        ],
        "near": "primary"
      },
      {
        "slot": "planter",
        "count": [
          1,
          2
        ],
        "where": "border"
      }
    ],
    "surface": "plaza"
  }
}
