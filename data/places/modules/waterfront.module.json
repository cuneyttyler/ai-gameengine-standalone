{
  "schema": "aige.module/1",
  "id": "waterfront",
  "name": "Waterfront",
  "level": "zone",
  "description": "Along the water: a promenade, restaurants, a hotel, apartments, a park.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Ward",
    "District"
  ],
  "quantity": {
    "plots": {
      "type": "count",
      "default": [
        6,
        24
      ],
      "min": 0,
      "max": 2000,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        900,
        4000
      ],
      "min": 100,
      "unit": "cells²"
    },
    "footprint-density": {
      "type": "ratio",
      "default": [
        0.35,
        0.7
      ],
      "min": 0,
      "max": 1,
      "description": "built cells / district cells"
    }
  },
  "quality": {
    "wealth": {
      "type": "enum",
      "vocabulary": "wealth",
      "default": "common",
      "ask": true
    },
    "density": {
      "type": "enum",
      "values": [
        "sparse",
        "medium",
        "dense"
      ],
      "default": "medium",
      "ask": true
    },
    "street-style": {
      "type": "enum",
      "vocabulary": "layout",
      "description": "this district's own street pattern; unset, the city's"
    }
  },
  "slots": {
    "car": {
      "role": "car",
      "essential": false
    }
  },
  "children": {
    "restaurant-plot": {
      "min": 0,
      "weight": 1.0,
      "max": 20
    },
    "hotel-plot": {
      "min": 0,
      "weight": 0.3,
      "max": 4
    },
    "apartment-plot": {
      "min": 0,
      "weight": 0.6,
      "max": 30
    },
    "plaza": {
      "min": 0,
      "weight": 0.5,
      "max": 4
    },
    "park": {
      "min": 0,
      "weight": 0.4,
      "max": 3
    },
    "road": {
      "min": 0,
      "weight": 0.6,
      "max": 40
    }
  },
  "constraints": [
    "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"
  ],
  "prefersSite": {
    "water": 3.0
  },
  "requires": [
    "class:WaterBody"
  ],
  "compile": {
    "network": {
      "class": "street",
      "terrain": "asphalt",
      "width": 4,
      "edge": "sidewalk"
    },
    "traffic": {
      "slot": "car",
      "density": 0.06
    },
    "filler": [
      "plaza",
      "park"
    ]
  }
}
