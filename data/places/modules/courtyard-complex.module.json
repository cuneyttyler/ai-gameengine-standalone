{
  "schema": "aige.module/1",
  "id": "courtyard-complex",
  "name": "Courtyard",
  "level": "site",
  "description": "A walled courtyard: an open court in the middle, the rooms round it (a hall, chambers, stores).",
  "buildTypes": [
    "courtyard"
  ],
  "quantity": {
    "rooms": {
      "type": "count",
      "default": [
        3,
        6
      ],
      "min": 1,
      "max": 60,
      "ask": true
    },
    "floors": {
      "type": "count",
      "default": 1,
      "min": 1,
      "max": 3,
      "ask": false
    }
  },
  "quality": {
    "kind": {
      "type": "enum",
      "vocabulary": "courtyard-kind",
      "default": "courtyard",
      "ask": true
    },
    "wealth": {
      "type": "enum",
      "vocabulary": "wealth",
      "default": "common",
      "ask": true
    },
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in"
    },
    "floor": {
      "type": "enum",
      "vocabulary": "floor-surface",
      "default": "stone-floor"
    },
    "notes": {
      "type": "description"
    }
  },
  "slots": {
    "wall": {
      "role": "wall-piece-set",
      "essential": true
    },
    "door": {
      "role": "door",
      "essential": true
    },
    "window": {
      "role": "window",
      "essential": false
    }
  },
  "children": {
    "floor-level": {
      "min": 1,
      "weight": 1.0,
      "max": 6,
      "count": "floors"
    }
  },
  "constraints": [
    "within(self.rooms, count(descendants(class: Room)), tol: 'count')"
  ]
}
