{
  "schema": "aige.module/1",
  "id": "retail-plot",
  "name": "Shop plot",
  "level": "parcel",
  "description": "A small shop on the street with a bench and a bike stand.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Commercial"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          4,
          6
        ],
        "h": [
          4,
          6
        ]
      },
      "min": {
        "w": 3,
        "h": 3
      },
      "unit": "cells",
      "max": {
        "w": 40,
        "h": 40
      }
    },
    "setback": {
      "type": "length",
      "default": [
        0,
        1
      ],
      "min": 0,
      "unit": "cells",
      "max": 8
    }
  },
  "quality": {
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in"
    },
    "shop-kind": {
      "type": "enum",
      "vocabulary": "shop-kind",
      "default": "convenience",
      "ask": true
    }
  },
  "slots": {
    "retail-store": {
      "role": "retail-store",
      "essential": true,
      "primary": true,
      "concepts": "shop-kind"
    },
    "street-light": {
      "role": "street-light",
      "essential": false
    },
    "trash-bin": {
      "role": "trash-bin",
      "essential": false
    },
    "park-bench": {
      "role": "park-bench",
      "essential": false
    },
    "bicycle": {
      "role": "bicycle",
      "essential": false
    }
  },
  "children": {},
  "relations": [
    {
      "type": "faces",
      "members": [
        "self.primary",
        "parent.street"
      ],
      "weight": 3.0
    },
    {
      "type": "adjacent",
      "members": [
        "self",
        "parent.street"
      ],
      "weight": 2.0
    }
  ],
  "compile": {
    "contents": [
      {
        "slot": "street-light",
        "count": [
          1,
          2
        ],
        "where": "border"
      },
      {
        "slot": "park-bench",
        "count": [
          0,
          1
        ],
        "where": "border"
      },
      {
        "slot": "bicycle",
        "count": [
          0,
          2
        ],
        "where": "border"
      }
    ]
  }
}
