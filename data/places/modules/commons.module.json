{
  "schema": "aige.module/1",
  "id": "commons",
  "name": "Commons",
  "level": "zone",
  "description": "A green, park or orchard open to all.",
  "buildTypes": [
    "settlement"
  ],
  "classes": [
    "Ward"
  ],
  "quantity": {
    "area": {
      "type": "area",
      "default": [
        200,
        2000
      ],
      "min": 50,
      "unit": "cells²"
    },
    "trees": {
      "type": "density",
      "levels": [
        0,
        0.05,
        0.15,
        0.3,
        0.5
      ],
      "unit": "per free cell",
      "default": "some"
    },
    "extent": {
      "type": "enum",
      "values": [
        "small",
        "normal",
        "big",
        "huge"
      ],
      "default": "normal",
      "ask": true,
      "description": "How big it is in the real world (a plan cell is 2 m): small = a small green (about 30 x 30 m); normal = a village green (about 55 x 55 m); big = a large common (about 90 x 90 m); huge = a town's park or common (about 140 x 140 m). The plan's size follows it."
    }
  },
  "quality": {
    "kind": {
      "type": "enum",
      "values": [
        "green",
        "park",
        "orchard"
      ],
      "default": "green"
    }
  },
  "slots": {},
  "children": {
    "meadow": {
      "min": 0,
      "weight": 0.7,
      "max": 2
    },
    "nature-scatter": {
      "min": 0,
      "weight": 0.8,
      "max": 1
    },
    "pond": {
      "min": 0,
      "weight": 0.3,
      "max": 2
    },
    "orchard": {
      "min": 0,
      "weight": 0.3,
      "max": 2
    },
    "road": {
      "min": 0,
      "weight": 0.6,
      "max": 60
    }
  },
  "realSize": {
    "small": {
      "area": 1000
    },
    "normal": {
      "area": 3000
    },
    "big": {
      "area": 8000
    },
    "huge": {
      "area": 20000
    }
  }
}
