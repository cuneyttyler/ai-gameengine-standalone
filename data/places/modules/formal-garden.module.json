{
  "schema": "aige.module/1",
  "id": "formal-garden",
  "name": "Formal garden",
  "level": "feature",
  "description": "Hedges and flowers laid out symmetrically, perhaps around a centrepiece.",
  "buildTypes": [
    "settlement"
  ],
  "classes": [
    "PlantedArea"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          8,
          14
        ],
        "h": [
          8,
          14
        ]
      },
      "min": {
        "w": 4,
        "h": 4
      },
      "unit": "cells",
      "max": {
        "w": 40,
        "h": 40
      }
    },
    "hedges": {
      "type": "count",
      "default": [
        2,
        8
      ],
      "min": 0,
      "max": 40
    },
    "flowers": {
      "type": "density",
      "levels": [
        0,
        0.05,
        0.15,
        0.3,
        0.5
      ],
      "unit": "per free cell",
      "default": "common"
    }
  },
  "quality": {
    "symmetry": {
      "type": "bool",
      "default": true
    },
    "centre": {
      "type": "enum",
      "values": [
        "fountain",
        "statue",
        "none"
      ],
      "default": "statue"
    },
    "flower-mix": {
      "type": "mix",
      "vocabulary": "flower-kind",
      "default": {
        "rose": 0.6,
        "lavender": 0.4
      }
    }
  },
  "slots": {
    "hedge": {
      "role": "hedge",
      "essential": true,
      "primary": true
    },
    "flower": {
      "role": "flower",
      "essential": true,
      "concepts": "flower-mix"
    },
    "statue": {
      "role": "statue|fountain",
      "essential": false,
      "when": "centre != 'none'"
    }
  },
  "children": {
    "hedge-line": {
      "min": 0,
      "weight": 1.0,
      "max": 40,
      "count": "hedges"
    }
  },
  "relations": [
    {
      "type": "symmetric",
      "members": [
        "self.hedge",
        "self.flower"
      ],
      "weight": 2.0,
      "args": {
        "axis": "long"
      }
    }
  ]
}
