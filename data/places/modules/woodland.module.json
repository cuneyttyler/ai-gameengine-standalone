{
  "schema": "aige.module/1",
  "id": "woodland",
  "name": "Woodland",
  "level": "site",
  "description": "A forest as a place of its own: stands of trees with organic edges, glades and clearings between them, a pond or a stream, rocks, trails through it, and what's hidden in it (a ruin, a shrine, a camp).",
  "buildTypes": [
    "forest"
  ],
  "classes": [
    "Woodland"
  ],
  "quantity": {
    "pois": {
      "type": "count",
      "default": [
        0,
        3
      ],
      "min": 0,
      "max": 30,
      "ask": true,
      "description": "what's hidden in it: a ruin, a shrine, standing stones, a camp, a cave mouth"
    },
    "area": {
      "type": "area",
      "default": [
        6400,
        60000
      ],
      "min": 400,
      "unit": "cells²"
    }
  },
  "quality": {
    "kind": {
      "type": "enum",
      "values": [
        "deciduous",
        "conifer",
        "mixed"
      ],
      "default": "mixed",
      "ask": true,
      "description": "its trees: broadleaf, pine and fir, or both"
    },
    "age": {
      "type": "enum",
      "values": [
        "young",
        "old"
      ],
      "default": "old"
    },
    "density": {
      "type": "enum",
      "values": [
        "open",
        "dense",
        "deep"
      ],
      "default": "dense",
      "ask": true,
      "description": "how close its trees stand: open woodland with glades, a dense wood, or deep dark forest"
    },
    "notes": {
      "type": "description"
    },
    "coverage": {
      "type": "enum",
      "vocabulary": "coverage",
      "default": "full",
      "description": "its woods cover all its land"
    },
    "woods": {
      "type": "enum",
      "values": [
        "none",
        "few",
        "some",
        "dense"
      ],
      "default": "none",
      "description": "no edge woods of the landscape: its own stands are its woods"
    }
  },
  "slots": {},
  "children": {
    "forest": {
      "min": 2,
      "weight": 1.0,
      "max": 10
    },
    "meadow": {
      "min": 0,
      "weight": 0.5,
      "max": 4
    },
    "pond": {
      "min": 0,
      "weight": 0.3,
      "max": 3
    },
    "lake": {
      "min": 0,
      "weight": 0.15,
      "max": 1
    },
    "rock-field": {
      "min": 0,
      "weight": 0.25,
      "max": 3
    },
    "ruin-site": {
      "min": 0,
      "weight": 0.2,
      "max": 2
    },
    "shrine-site": {
      "min": 0,
      "weight": 0.2,
      "max": 2
    },
    "standing-stones": {
      "min": 0,
      "weight": 0.15,
      "max": 1
    },
    "campsite": {
      "min": 0,
      "weight": 0.2,
      "max": 2
    },
    "cave-entrance": {
      "min": 0,
      "weight": 0.1,
      "max": 1
    },
    "ground": {
      "min": 1,
      "weight": 1.0,
      "max": 1
    }
  },
  "constraints": [
    "within(self.pois, count(descendants(class: PointOfInterest)), tol: 'count')"
  ],
  "compile": {
    "ground": "forest-floor",
    "mainRoad": false,
    "treeDensity": {
      "open": 0.3,
      "dense": 0.5,
      "deep": 0.7
    }
  }
}
