{
  "schema": "aige.module/1",
  "id": "settlement",
  "name": "Settlement",
  "level": "site",
  "description": "A hamlet, village, town or city: wards, roads, walls and the ground.",
  "buildTypes": [
    "settlement"
  ],
  "quantity": {
    "buildings": {
      "type": "count",
      "default": [
        15,
        60
      ],
      "min": 1,
      "max": 5000,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        3600,
        10000
      ],
      "min": 100,
      "unit": "cells²"
    }
  },
  "quality": {
    "layout": {
      "type": "enum",
      "values": [
        "organic",
        "grid",
        "radial",
        "linear-along-road",
        "linear-along-river"
      ],
      "default": "organic",
      "ask": true
    },
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in",
      "ask": true
    },
    "walled": {
      "type": "enum",
      "values": [
        "none",
        "palisade",
        "stone"
      ],
      "default": "none",
      "ask": true
    },
    "style": {
      "type": "tags",
      "default": []
    },
    "notes": {
      "type": "description"
    }
  },
  "slots": {},
  "children": {
    "class:Ward": {
      "min": 1,
      "weight": 1.0,
      "max": 60
    },
    "road": {
      "min": 1,
      "weight": 1.0,
      "max": 400
    },
    "river": {
      "min": 0,
      "weight": 0.3,
      "max": 3
    },
    "lake": {
      "min": 0,
      "weight": 0.1,
      "max": 2
    },
    "wall": {
      "min": 0,
      "weight": 0.3,
      "max": 2,
      "when": "walled != 'none'"
    },
    "ground": {
      "min": 1,
      "weight": 1.0,
      "max": 1
    },
    "forest": {
      "min": 0,
      "weight": 0.4,
      "max": 6
    },
    "meadow": {
      "min": 0,
      "weight": 0.3,
      "max": 6
    },
    "rock-field": {
      "min": 0,
      "weight": 0.1,
      "max": 3
    }
  },
  "constraints": [
    "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')",
    "sum(children().area) <= 0.85 * self.area",
    "walled != 'none' implies count(children(wall)) >= 1"
  ]
}
