{
  "schema": "aige.module/1",
  "id": "settlement",
  "name": "Settlement",
  "level": "site",
  "description": "A hamlet, village, town or city: wards, roads, walls and the ground.",
  "buildTypes": [
    "settlement"
  ],
  "quantity": {
    "buildings": {
      "type": "count",
      "default": [
        15,
        60
      ],
      "min": 1,
      "max": 5000,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        3600,
        10000
      ],
      "min": 100,
      "unit": "cells²"
    },
    "block-size": {
      "type": "size",
      "default": {
        "w": [
          16,
          20
        ],
        "h": [
          16,
          20
        ]
      },
      "min": {
        "w": 8,
        "h": 8
      },
      "max": {
        "w": 60,
        "h": 60
      },
      "unit": "cells",
      "ask": true,
      "description": "A block of the shared street grid, street to street"
    }
  },
  "quality": {
    "layout": {
      "type": "mix",
      "vocabulary": "layout",
      "default": {
        "organic": 1.0
      },
      "ask": true,
      "description": "street patterns and their shares; the plan gives each ward one of them"
    },
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in",
      "ask": true
    },
    "walled": {
      "type": "enum",
      "values": [
        "none",
        "palisade",
        "stone"
      ],
      "default": "none",
      "ask": true
    },
    "style": {
      "type": "tags",
      "default": []
    },
    "relief": {
      "type": "enum",
      "values": [
        "flat",
        "gentle",
        "hilly"
      ],
      "default": "gentle",
      "ask": true,
      "description": "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."
    },
    "woods": {
      "type": "enum",
      "values": [
        "none",
        "few",
        "some",
        "dense"
      ],
      "default": "some",
      "ask": true,
      "description": "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."
    },
    "notes": {
      "type": "description"
    },
    "zone-shape": {
      "type": "enum",
      "vocabulary": "zone-shape",
      "default": "grown",
      "ask": true,
      "description": "How the zones are shaped: grown from seeds (organic), or rectangles cut along the main roads (planned)"
    },
    "street-grid": {
      "type": "enum",
      "vocabulary": "street-grid",
      "default": "per-zone",
      "ask": true,
      "description": "Each zone its own streets, or one street grid for the whole place, lined up with its main roads"
    },
    "block-fill": {
      "type": "enum",
      "vocabulary": "block-fill",
      "default": "frontage",
      "ask": true,
      "description": "Lots along the streets with open land behind, or lots back to back so the blocks are built through"
    },
    "coverage": {
      "type": "enum",
      "vocabulary": "coverage",
      "default": "partial",
      "ask": true,
      "description": "Open land between the zones, or zones covering the whole place"
    },
    "arrangement": {
      "type": "enum",
      "vocabulary": "arrangement",
      "default": "natural",
      "ask": true,
      "description": "How the small things are set out (lamps, trees, benches, cars, bicycles, bushes): scattered as they come, or ordered: evenly spaced along edges, in lines and mirrored pairs"
    },
    "lot-layout": {
      "type": "enum",
      "vocabulary": "lot-layout",
      "default": "packed",
      "ask": true,
      "description": "How a block is divided into lots"
    },
    "block-use": {
      "type": "enum",
      "vocabulary": "block-use",
      "default": "mixed",
      "ask": true,
      "description": "One kind of building per block, or mixed"
    },
    "frontage": {
      "type": "enum",
      "vocabulary": "frontage",
      "default": "varied",
      "ask": true,
      "description": "One building line along a street, or each its own setback"
    },
    "building-cover": {
      "type": "enum",
      "vocabulary": "building-cover",
      "default": "planned",
      "ask": true,
      "description": "Buildings fill their lots, or keep their planned footprints"
    },
    "building-shape": {
      "type": "enum",
      "vocabulary": "building-shape",
      "default": "square",
      "ask": true,
      "description": "Buildings square, with rounded corners, or following their lots and streets"
    },
    "site-fit": {
      "type": "enum",
      "vocabulary": "site-fit",
      "default": "scale",
      "ask": true,
      "description": "How big the site is: sized to the plan's content, or to the scale"
    },
    "open-space": {
      "type": "enum",
      "vocabulary": "open-space",
      "default": "some",
      "ask": true,
      "description": "How much of each zone is open space (parks, plazas, parking) rather than buildings"
    }
  },
  "slots": {},
  "children": {
    "class:Ward": {
      "min": 1,
      "weight": 1.0,
      "max": 60
    },
    "road": {
      "min": 1,
      "weight": 1.0,
      "max": 400
    },
    "river": {
      "min": 0,
      "weight": 0.3,
      "max": 3
    },
    "lake": {
      "min": 0,
      "weight": 0.1,
      "max": 2
    },
    "wall": {
      "min": 0,
      "weight": 0.3,
      "max": 2,
      "when": "walled != 'none'"
    },
    "ground": {
      "min": 1,
      "weight": 1.0,
      "max": 1
    },
    "forest": {
      "min": 0,
      "weight": 0.4,
      "max": 6
    },
    "meadow": {
      "min": 0,
      "weight": 0.3,
      "max": 6
    },
    "rock-field": {
      "min": 0,
      "weight": 0.1,
      "max": 3
    }
  },
  "constraints": [
    "within(self.buildings, count(descendants(class: BuildingParcel)), tol: 'count')",
    "sum(children().area) <= 0.85 * self.area",
    "walled != 'none' implies count(children(wall)) >= 1"
  ]
}
