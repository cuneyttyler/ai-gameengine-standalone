{
  "schema": "aige.module/1",
  "id": "temple-ward",
  "name": "Temple ward",
  "level": "zone",
  "description": "A temple with its graveyard and the houses around it.",
  "buildTypes": [
    "settlement"
  ],
  "classes": [
    "Ward"
  ],
  "quantity": {
    "plots": {
      "type": "count",
      "default": [
        2,
        15
      ],
      "min": 0,
      "max": 2000,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        600,
        2500
      ],
      "min": 100,
      "unit": "cells²"
    }
  },
  "quality": {
    "faith": {
      "type": "enum",
      "vocabulary": "faith",
      "default": "old-faith"
    },
    "grandeur": {
      "type": "enum",
      "values": [
        "modest",
        "grand"
      ],
      "default": "modest"
    },
    "street-style": {
      "type": "enum",
      "vocabulary": "layout",
      "description": "this zone's own street pattern; unset, the place's main layout"
    }
  },
  "slots": {},
  "children": {
    "temple-plot": {
      "min": 1,
      "weight": 1.0,
      "max": 4
    },
    "graveyard": {
      "min": 0,
      "weight": 0.7,
      "max": 2
    },
    "house-plot": {
      "min": 0,
      "weight": 0.5,
      "max": 100
    },
    "road": {
      "min": 0,
      "weight": 0.6,
      "max": 60
    }
  },
  "prefersSite": {
    "high-ground": 0.6,
    "centre": 0.3
  }
}
