{
  "schema": "aige.module/1",
  "id": "park-district",
  "name": "City park",
  "level": "zone",
  "description": "A large green park: lawns, trees, paths, a pond, playgrounds and sports courts.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Ward",
    "District"
  ],
  "quantity": {
    "plots": {
      "type": "count",
      "default": [
        2,
        8
      ],
      "min": 0,
      "max": 2000,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        900,
        4000
      ],
      "min": 100,
      "unit": "cells²"
    },
    "footprint-density": {
      "type": "ratio",
      "default": [
        0.35,
        0.7
      ],
      "min": 0,
      "max": 1,
      "description": "built cells / district cells"
    }
  },
  "quality": {
    "wealth": {
      "type": "enum",
      "vocabulary": "wealth",
      "default": "common",
      "ask": true
    },
    "density": {
      "type": "enum",
      "values": [
        "sparse",
        "medium",
        "dense"
      ],
      "default": "sparse",
      "ask": true
    },
    "street-style": {
      "type": "enum",
      "vocabulary": "layout",
      "description": "this district's own street pattern; unset, the city's"
    }
  },
  "slots": {
    "car": {
      "role": "car",
      "essential": false
    }
  },
  "children": {
    "park": {
      "min": 1,
      "weight": 1.0,
      "max": 6
    },
    "playground": {
      "min": 0,
      "weight": 0.5,
      "max": 4
    },
    "sports-court": {
      "min": 0,
      "weight": 0.4,
      "max": 4
    },
    "plaza": {
      "min": 0,
      "weight": 0.3,
      "max": 2
    },
    "road": {
      "min": 0,
      "weight": 0.3,
      "max": 10
    }
  },
  "constraints": [
    "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"
  ],
  "compile": {
    "network": {
      "class": "lane",
      "terrain": "plaza",
      "width": 2
    },
    "traffic": {
      "slot": "car",
      "density": 0.06
    },
    "filler": [
      "park",
      "playground",
      "sports-court"
    ]
  }
}
