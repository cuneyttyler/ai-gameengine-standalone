{
  "schema": "aige.module/1",
  "id": "wilderness",
  "name": "Wilderness",
  "level": "site",
  "description": "Wild land: forest, meadow, rock and water, trails to its points of interest.",
  "buildTypes": [
    "wilderness"
  ],
  "quantity": {
    "pois": {
      "type": "count",
      "default": [
        2,
        6
      ],
      "min": 0,
      "max": 60,
      "ask": true,
      "description": "points of interest: ruins, shrines, cave mouths"
    },
    "area": {
      "type": "area",
      "default": [
        6400,
        40000
      ],
      "min": 400,
      "unit": "cells²"
    }
  },
  "quality": {
    "biome": {
      "type": "enum",
      "vocabulary": "biome",
      "default": "temperate",
      "ask": true
    },
    "relief": {
      "type": "enum",
      "values": [
        "flat",
        "gentle",
        "hilly"
      ],
      "default": "gentle",
      "ask": true,
      "description": "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."
    },
    "woods": {
      "type": "enum",
      "values": [
        "none",
        "few",
        "some",
        "dense"
      ],
      "default": "some",
      "ask": true,
      "description": "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."
    },
    "notes": {
      "type": "description"
    }
  },
  "slots": {},
  "children": {
    "wilds": {
      "min": 1,
      "weight": 1.0,
      "max": 8
    },
    "forest": {
      "min": 1,
      "weight": 1.0,
      "max": 10
    },
    "meadow": {
      "min": 0,
      "weight": 0.6,
      "max": 6
    },
    "rock-field": {
      "min": 0,
      "weight": 0.3,
      "max": 4
    },
    "river": {
      "min": 0,
      "weight": 0.4,
      "max": 2
    },
    "lake": {
      "min": 0,
      "weight": 0.3,
      "max": 2
    },
    "trail-network": {
      "min": 1,
      "weight": 1.0,
      "max": 1
    },
    "ground": {
      "min": 1,
      "weight": 1.0,
      "max": 1
    }
  },
  "constraints": [
    "within(self.pois, count(descendants(class: PointOfInterest)), tol: 'count')"
  ]
}
