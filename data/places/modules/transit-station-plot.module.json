{
  "schema": "aige.module/1",
  "id": "transit-station-plot",
  "name": "Transit station plot",
  "level": "parcel",
  "description": "A bus or metro station with buses and a stop.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Transit"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          8,
          12
        ],
        "h": [
          6,
          8
        ]
      },
      "min": {
        "w": 3,
        "h": 3
      },
      "unit": "cells",
      "max": {
        "w": 40,
        "h": 40
      }
    },
    "setback": {
      "type": "length",
      "default": [
        1,
        2
      ],
      "min": 0,
      "unit": "cells",
      "max": 8
    }
  },
  "quality": {
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in"
    }
  },
  "slots": {
    "transit-station": {
      "role": "transit-station",
      "essential": true,
      "primary": true
    },
    "street-light": {
      "role": "street-light",
      "essential": false
    },
    "trash-bin": {
      "role": "trash-bin",
      "essential": false
    },
    "bus": {
      "role": "bus",
      "essential": false
    },
    "bus-stop": {
      "role": "bus-stop",
      "essential": false
    },
    "park-bench": {
      "role": "park-bench",
      "essential": false
    }
  },
  "children": {},
  "relations": [
    {
      "type": "faces",
      "members": [
        "self.primary",
        "parent.street"
      ],
      "weight": 3.0
    },
    {
      "type": "adjacent",
      "members": [
        "self",
        "parent.street"
      ],
      "weight": 2.0
    }
  ],
  "compile": {
    "contents": [
      {
        "slot": "street-light",
        "count": [
          1,
          2
        ],
        "where": "border"
      },
      {
        "slot": "bus",
        "count": [
          1,
          2
        ]
      },
      {
        "slot": "bus-stop",
        "count": [
          1,
          2
        ],
        "where": "border"
      }
    ],
    "surface": "plaza"
  }
}
