{
  "schema": "aige.module/1",
  "id": "garden",
  "name": "Garden",
  "level": "feature",
  "description": "A vegetable, flower or herb garden behind the house, maybe fenced.",
  "buildTypes": [
    "settlement"
  ],
  "classes": [
    "PlantedArea"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          3,
          5
        ],
        "h": [
          2,
          4
        ]
      },
      "min": {
        "w": 2,
        "h": 2
      },
      "unit": "cells",
      "max": {
        "w": 12,
        "h": 10
      }
    },
    "beds": {
      "type": "count",
      "default": [
        1,
        3
      ],
      "min": 0,
      "max": 12
    },
    "flowers": {
      "type": "density",
      "levels": [
        0,
        0.05,
        0.15,
        0.3,
        0.5
      ],
      "unit": "per free cell",
      "default": "some"
    }
  },
  "quality": {
    "kind": {
      "type": "enum",
      "values": [
        "vegetable",
        "flower",
        "herb",
        "mixed"
      ],
      "default": "vegetable",
      "ask": true
    },
    "flower-mix": {
      "type": "mix",
      "vocabulary": "flower-kind",
      "when": "kind in [flower, mixed]"
    },
    "crop-mix": {
      "type": "mix",
      "vocabulary": "crop-kind",
      "when": "kind in [vegetable, mixed]"
    },
    "fenced": {
      "type": "bool",
      "default": true,
      "ask": true
    },
    "path": {
      "type": "enum",
      "values": [
        "none",
        "dirt",
        "gravel",
        "stone"
      ],
      "default": "dirt"
    }
  },
  "slots": {
    "plant": {
      "essential": true,
      "primary": true,
      "bind": [
        {
          "when": "kind == 'vegetable'",
          "role": "crop",
          "concepts": "crop-mix"
        },
        {
          "when": "kind == 'flower'",
          "role": "flower",
          "concepts": "flower-mix"
        },
        {
          "when": "kind == 'herb'",
          "role": "herb"
        },
        {
          "when": "kind == 'mixed'",
          "role": "crop|flower",
          "concepts": "crop-mix + flower-mix"
        }
      ]
    },
    "fence": {
      "role": "fence-piece-set",
      "essential": false,
      "when": "fenced"
    },
    "bed": {
      "role": "garden-bed",
      "essential": false,
      "fallback": {
        "fill": "tilled"
      }
    },
    "extra": {
      "role": "garden-prop",
      "concepts": [
        "scarecrow",
        "bench",
        "beehive"
      ],
      "essential": false
    }
  },
  "children": {
    "vegetable-bed": {
      "min": 0,
      "weight": 1.0,
      "max": 12,
      "count": "beds"
    },
    "fence-line": {
      "min": 0,
      "weight": 0.6,
      "max": 1,
      "when": "fenced"
    }
  },
  "constraints": [
    "size.w * size.h >= 4",
    "beds * 2 <= size.w * size.h",
    "fenced implies asset(fence) != 'missing'"
  ],
  "relations": [
    {
      "type": "behind",
      "members": [
        "self",
        "parent.primary"
      ],
      "weight": 3.0
    },
    {
      "type": "adjacent",
      "members": [
        "self",
        "parent.primary.back"
      ],
      "weight": 2.0
    },
    {
      "type": "away-from",
      "members": [
        "self",
        "parent.street"
      ],
      "weight": 1.0,
      "args": {
        "d": 2
      }
    }
  ]
}
