{
  "schema": "aige.module/1",
  "id": "camp",
  "name": "Camp",
  "level": "site",
  "description": "A camp of tents: military, nomad, bandit or hunters, round its fires.",
  "buildTypes": [
    "camp"
  ],
  "quantity": {
    "tents": {
      "type": "count",
      "default": [
        6,
        20
      ],
      "min": 1,
      "max": 400,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        1600,
        6400
      ],
      "min": 100,
      "unit": "cells²"
    }
  },
  "quality": {
    "kind": {
      "type": "enum",
      "vocabulary": "camp-kind",
      "default": "military",
      "ask": true
    },
    "walled": {
      "type": "enum",
      "values": [
        "none",
        "palisade"
      ],
      "default": "none",
      "ask": true
    },
    "condition": {
      "type": "enum",
      "vocabulary": "condition",
      "default": "lived-in"
    },
    "relief": {
      "type": "enum",
      "values": [
        "flat",
        "gentle",
        "hilly"
      ],
      "default": "gentle",
      "ask": true,
      "description": "The lie of the land outside what's built: level, low rolling hills, or high ground (place-refine.md §10)."
    },
    "woods": {
      "type": "enum",
      "values": [
        "none",
        "few",
        "some",
        "dense"
      ],
      "default": "some",
      "ask": true,
      "description": "How wooded the wild land is: stands of trees towards the edges of the place, on a forest floor (place-refine.md §7)."
    },
    "notes": {
      "type": "description"
    }
  },
  "slots": {},
  "children": {
    "camp-ground": {
      "min": 1,
      "weight": 1.0,
      "max": 6
    },
    "wall": {
      "min": 0,
      "weight": 0.3,
      "max": 1,
      "when": "walled != 'none'"
    },
    "road": {
      "min": 1,
      "weight": 1.0,
      "max": 10
    },
    "ground": {
      "min": 1,
      "weight": 1.0,
      "max": 1
    },
    "forest": {
      "min": 0,
      "weight": 0.5,
      "max": 4
    },
    "meadow": {
      "min": 0,
      "weight": 0.3,
      "max": 4
    },
    "river": {
      "min": 0,
      "weight": 0.2,
      "max": 1
    },
    "lake": {
      "min": 0,
      "weight": 0.1,
      "max": 1
    }
  },
  "constraints": [
    "within(self.tents, count(descendants(class: BuildingParcel)), tol: 'count')",
    "walled != 'none' implies count(children(wall)) >= 1"
  ]
}
