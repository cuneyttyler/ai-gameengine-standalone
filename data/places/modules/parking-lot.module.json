{
  "schema": "aige.module/1",
  "id": "parking-lot",
  "name": "Parking lot",
  "level": "parcel",
  "description": "An open car park on asphalt, its bays full of cars.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Parking",
    "OpenSpace"
  ],
  "quantity": {
    "size": {
      "type": "size",
      "default": {
        "w": [
          6,
          12
        ],
        "h": [
          6,
          12
        ]
      },
      "min": {
        "w": 3,
        "h": 3
      },
      "unit": "cells",
      "max": {
        "w": 40,
        "h": 40
      }
    },
    "cars": {
      "type": "density",
      "levels": [
        0,
        0.15,
        0.3,
        0.45,
        0.6
      ],
      "default": "common"
    }
  },
  "quality": {
    "surface": {
      "type": "enum",
      "vocabulary": "surface",
      "default": "asphalt"
    }
  },
  "slots": {
    "ground": {
      "role": "square-terrain",
      "essential": true,
      "primary": true,
      "concepts": "surface"
    },
    "car": {
      "role": "car",
      "essential": false
    },
    "street-light": {
      "role": "street-light",
      "essential": false
    },
    "parking-meter": {
      "role": "parking-meter",
      "essential": false
    }
  },
  "children": {},
  "compile": {
    "contents": [
      {
        "slot": "car",
        "density": "cars"
      },
      {
        "slot": "street-light",
        "count": [
          1,
          3
        ],
        "where": "border"
      }
    ]
  }
}
