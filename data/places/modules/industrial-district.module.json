{
  "schema": "aige.module/1",
  "id": "industrial-district",
  "name": "Industrial district",
  "level": "zone",
  "description": "Factories and logistics warehouses with yards, trucks and parking.",
  "buildTypes": [
    "modern-city"
  ],
  "classes": [
    "Ward",
    "District"
  ],
  "quantity": {
    "plots": {
      "type": "count",
      "default": [
        4,
        16
      ],
      "min": 0,
      "max": 2000,
      "ask": true
    },
    "area": {
      "type": "area",
      "default": [
        900,
        4000
      ],
      "min": 100,
      "unit": "cells²"
    },
    "footprint-density": {
      "type": "ratio",
      "default": [
        0.35,
        0.7
      ],
      "min": 0,
      "max": 1,
      "description": "built cells / district cells"
    }
  },
  "quality": {
    "wealth": {
      "type": "enum",
      "vocabulary": "wealth",
      "default": "common",
      "ask": true
    },
    "density": {
      "type": "enum",
      "values": [
        "sparse",
        "medium",
        "dense"
      ],
      "default": "sparse",
      "ask": true
    },
    "street-style": {
      "type": "enum",
      "vocabulary": "layout",
      "description": "this district's own street pattern; unset, the city's"
    }
  },
  "slots": {
    "truck": {
      "role": "truck",
      "essential": false
    }
  },
  "children": {
    "factory-plot": {
      "min": 0,
      "weight": 1.0,
      "max": 30
    },
    "logistics-plot": {
      "min": 0,
      "weight": 0.8,
      "max": 30
    },
    "parking-lot": {
      "min": 0,
      "weight": 0.4,
      "max": 8
    },
    "gas-station-plot": {
      "min": 0,
      "weight": 0.2,
      "max": 2
    },
    "road": {
      "min": 0,
      "weight": 0.6,
      "max": 60
    }
  },
  "constraints": [
    "count(children(class: BuildingParcel)) + count(children(class: OpenSpace)) >= 1"
  ],
  "relations": [
    {
      "type": "away-from",
      "members": [
        "self",
        "parent.residential-district"
      ],
      "weight": 1.0,
      "args": {
        "d": 15
      }
    }
  ],
  "prefersSite": {
    "edge": 2.0,
    "water": 0.5,
    "downstream": 0.5
  },
  "compile": {
    "network": {
      "class": "street",
      "terrain": "asphalt",
      "width": 5,
      "edge": "sidewalk"
    },
    "traffic": {
      "slot": "truck",
      "density": 0.06
    }
  }
}
