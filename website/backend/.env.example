# The website's settings (copy to .env and fill in; .env stays out of git).

# Where beta registrations are sent: the email with the "Send download link" button.
AIGE_SUPPORT_EMAIL=

# The site's public address: the links in emails start with it.
SITE_URL=http://127.0.0.1:5000

# The mail server. Left empty, emails are written to data/outbox/ (an .eml and an .html you can open) instead of sent.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Who the emails come from, e.g. AIGE <beta@yourdomain.com>
SMTP_FROM=

# The beta itself: a file on this server (served to valid links), or else an address links are sent on to.
BETA_DOWNLOAD_FILE=
BETA_DOWNLOAD_URL=
# Shown in the download email, e.g. 0.9.0
BETA_VERSION=
